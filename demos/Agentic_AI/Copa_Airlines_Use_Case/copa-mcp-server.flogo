                    "fe_metadata": "[{\"parameterName\":\"flightNumber\",\"type\":\"string\"}]"
                  }
                },
                "output": {
                  "responseBody": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"flightNumber\":{\"type\":\"string\"},\"origin\":{\"type\":\"string\"},\"originCity\":{\"type\":\"string\"},\"destination\":{\"type\":\"string\"},\"destinationCity\":{\"type\":\"string\"},\"scheduledDeparture\":{\"type\":\"string\"},\"estimatedDeparture\":{\"type\":\"string\"},\"scheduledArrival\":{\"type\":\"string\"},\"estimatedArrival\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"gate\":{\"type\":\"string\"},\"delayMinutes\":{\"type\":\"number\"},\"delayReason\":{\"type\":\"string\"},\"aircraft\":{\"type\":\"string\"}}}",
