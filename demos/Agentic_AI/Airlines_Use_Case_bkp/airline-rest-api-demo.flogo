                "flowInfo": false,
                "message": "=string.concat(\"Rebook request for PNR: \", $flow.pathParams.pnr)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Simple Return Activity",
