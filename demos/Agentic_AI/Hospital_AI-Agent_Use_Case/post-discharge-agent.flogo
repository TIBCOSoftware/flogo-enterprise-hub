    {
      "ref": "#wsserver",
      "name": "wsserver",
      "description": "Websocket server listens for connection request from the client",
      "settings": {
        "port": 8082,
        "enableTLS": false,
        "serverCert": "",
        "serverKey": "",
        "enableClientAuth": false,
        "trustStore": ""
      },
      "id": "WebsocketServer",
      "handlers": [
        {
