    {
      "id": "flow:SendEmail_Flow",
      "data": {
        "name": "SendEmail Flow",
        "description": "",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "SendMail",
            "type": "label",
            "label": "StartActivity to SendMail"
          },
          {
            "id": 2,
            "from": "SendMail",
            "to": "LogMessage",
            "type": "label",
            "label": "SendMail to LogMessage"
          },
          {
            "id": 3,
            "from": "LogMessage",
            "to": "Return",
            "type": "label",
            "label": "LogMessage to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "SendMail",
            "name": "SendMail",
            "description": "Simple Send Mail Activity",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#sendmail",
              "input": {
                "Server": "smtp.gmail.com",
                "Port": 465,
                "authorizationType": "Basic",
                "Username": "=$property[\"Email_Username\"]",
                "Password": "=$property[\"Email_App_Password\"]",
                "Connection Security": "SSL",
                "serverCertificate": "",
                "message_content_type": "text/plain",
                "sender": "=$property[\"To_Email\"]",
                "recipients": "=$property[\"To_Email\"]",
                "cc_recipients": "",
                "bcc_recipients": "",
                "reply_to": "=$property[\"Email_Username\"]",
                "subject": "=$flow.toolParams.subject",
                "message": "=$flow.toolParams.body"
              },
              "schemas": {
                "input": {
                  "attachments": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"items\":{\"properties\":{\"file\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"base64EncodedContents\":{\"type\":\"boolean\"}},\"required\":[\"file\"],\"type\":\"object\"},\"type\":\"array\"}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"items\":{\"properties\":{\"file\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"base64EncodedContents\":{\"type\":\"boolean\"}},\"required\":[\"file\"],\"type\":\"object\"},\"type\":\"array\"}"
                  },
                  "headers": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogMessage",
            "name": "LogMessage",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"****Sent Email to \",$flow.toolParams.email)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Simple Return Activity",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "=string.concat(\"Appointment Confirmation Email sent successfully to : \",$flow.toolParams.email)"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfSwiU2VuZE1haWwiOnsieCI6MjQ4LCJ5IjoxMDJ9LCJMb2dNZXNzYWdlIjp7IngiOjQ3NSwieSI6MTAxfSwiUmV0dXJuIjp7IngiOjY2NSwieSI6OTl9fQ==",
        "metadata": {
          "input": [
            {
              "name": "toolParams",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"email\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"}}"
              }
            }
          ],
          "output": [
            {
              "name": "response",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"SendEmailAgent\",\"properties\":{\"toolParams\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"email\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"}}}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"response\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}},\"required\":[]}"
          }
        }
      }
    }
