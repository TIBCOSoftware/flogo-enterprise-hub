            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogMessage",
            "name": "LogMessage",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"Request has been received for discharge summary for patient\",$flow.pathParams.patient_id)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "PostgreSQLQuery",
            "name": "PostgreSQLQuery",
            "description": "This activity executes query on a PostgreSQL database",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://e3c455be-4ee3-4b77-8c98-db7b09e81f7d",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT \n    p.patient_id,\n    pd.follow_up_required,\n    pd.specialty_code AS specialty,\n    pd.discharge_date,\n    pd.ward_id,\n    pd.bed_id,\n    COALESCE(\n        json_agg(\n            json_build_object(\n                'medication_code', dm.medication_code,\n                'days_supply', dm.days_supply\n            )\n        ) FILTER (WHERE dm.medication_code IS NOT NULL),\n        '[]'::json\n    ) AS medications\nFROM patients p\nJOIN patient_discharges pd ON p.patient_id = pd.patient_id\nLEFT JOIN discharge_medications dm ON pd.discharge_id = dm.discharge_id\nWHERE p.patient_id = $1\n  AND pd.discharge_date = (\n      SELECT MAX(discharge_date) \n      FROM patient_discharges \n      WHERE patient_id = ?patient_id\n  )\nGROUP BY p.patient_id, pd.follow_up_required, pd.specialty_code, pd.discharge_date, pd.ward_id, pd.bed_id;",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "patient_id",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "follow_up_required",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "specialty",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "discharge_date",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "ward_id",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "bed_id",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "medications",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "bf80b873-92b8-4b48-89b1-742afd60951dSELECT \n    p.patient_id,\n    pd.follow_up_required,\n    pd.specialty_code AS specialty,\n    pd.discharge_date,\n    pd.ward_id,\n    pd.bed_id,\n    COALESCE(\n        json_agg(\n            json_build_object(\n                'medication_code', dm.medication_code,\n                'days_supply', dm.days_supply\n            )\n        ) FILTER (WHERE dm.medication_code IS NOT NULL),\n        '[]'::json\n    ) AS medications\nFROM patients p\nJOIN patient_discharges pd ON p.patient_id = pd.patient_id\nLEFT JOIN discharge_medications dm ON pd.discharge_id = dm.discharge_id\nWHERE p.patient_id = $1\n  AND pd.discharge_date = (\n      SELECT MAX(discharge_date) \n      FROM patient_discharges \n      WHERE patient_id = ?patient_id\n  )\nGROUP BY p.patient_id, pd.follow_up_required, pd.specialty_code, pd.discharge_date, pd.ward_id, pd.bed_id;",
                "input": {
                  "mapping": {
                    "parameters": {
                      "patient_id": "=$flow.pathParams.patient_id"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"patient_id\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"patient_id\":{\"type\":\"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"patient_id\":{\"type\":\"string\"},\"follow_up_required\":{\"type\":\"string\"},\"specialty\":{\"type\":\"string\"},\"discharge_date\":{\"type\":\"string\"},\"ward_id\":{\"type\":\"string\"},\"bed_id\":{\"type\":\"string\"},\"medications\":{\"type\":\"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"patient_id\":{\"type\":\"string\"},\"follow_up_required\":{\"type\":\"string\"},\"specialty\":{\"type\":\"string\"},\"discharge_date\":{\"type\":\"string\"},\"ward_id\":{\"type\":\"string\"},\"bed_id\":{\"type\":\"string\"},\"medications\":{\"type\":\"string\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogMessage1",
            "name": "LogMessage1",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"Discharge summary Records found for patient id\" ,$flow.pathParams.patient_id)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "ParseJSON",
            "name": "ParseJSON",
            "description": "Parses JSON string into JSON object",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[PostgreSQLQuery].Output.records[0].medications"
              },
              "schemas": {
                "output": {
                  "jsonObject": "schema://medication"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Simple Return Activity",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "patient_id": "=$activity[PostgreSQLQuery].Output.records[0].patient_id",
                      "specialty": "=$activity[PostgreSQLQuery].Output.records[0].specialty",
                      "discharge_date": "=coerce.toString($activity[PostgreSQLQuery].Output.records[0].discharge_date)",
                      "medications": {
                        "@foreach($activity[ParseJSON].jsonObject,jsonObject)": {
                          "medication_code": "=$loop[jsonObject].medication_code",
                          "days_supply": "=$loop[jsonObject].days_supply"
                        }
                      },
                      "follow_up_required": {
                        "@conditional": [
                          {
                            "string.equals($activity[PostgreSQLQuery].Output.records[0].follow_up_required,'true')": true
                          },
                          {
                            "@otherwise": false
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfSwiTG9nTWVzc2FnZSI6eyJ4IjoyMTgsInkiOjkyfSwiUG9zdGdyZVNRTFF1ZXJ5Ijp7IngiOjQwMSwieSI6OTJ9LCJMb2dNZXNzYWdlMSI6eyJ4Ijo1ODgsInkiOjkxfSwiUGFyc2VKU09OIjp7IngiOjg1OSwieSI6OTR9LCJSZXR1cm4iOnsieCI6MTEwMywieSI6OTd9fQ==",
