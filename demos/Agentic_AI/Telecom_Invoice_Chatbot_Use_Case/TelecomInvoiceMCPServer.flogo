                "fe_metadata": "{}"
              }
            }
          },
          "name": "getCustomerProfile"
        },
        {
          "description": "Retrieve all invoices with their line items",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetInvoiceDetails",
            "handlerDescription": "Get all invoices joined with their line items. Each row contains the invoice header (invoice ID, customer ID, billing month, period, subtotal, tax, total amount, currency, due date, status) and one line item (category such as PLAN/IDD/ADDON/ROAMING/TAX, description, and line_amount). Use this to explain a bill, list charges, or find a specific invoice by customer and month.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
