        {
          "description": "Retrieve all available recharge offers",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "CheckRechargeOffers",
            "handlerDescription": "Get the catalog of available recharge offers including offer ID, offer name, offer type (DATA, IDD, ROAMING, COMBO), price, currency, data amount (GB), validity days, and a description. Use this to present recharge pack options to a subscriber (e.g. when they need more data). The chosen offer_id, offer_name, price and data amount are passed to the recharge agent to apply a pack.",
