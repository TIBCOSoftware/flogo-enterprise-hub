    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Telecom BSS MCP server for Agentic AI - Invoice Chatbot",
      "settings": {
        "serverName": "TelecomInvoiceChatbot",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/telecom-bss",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": ""
      },
      "id": "TelecomBSSMCPServer",
      "handlers": [
        {
          "description": "Retrieve all customer profile records",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetCustomerProfile",
            "handlerDescription": "Get all customer profile records from the CRM including customer ID, mobile number, first and last name, email, segment (Consumer, Premium, Business, VIP), account type (Prepaid, Postpaid), status, and active-since date. Use this to identify a subscriber by their mobile number and retrieve their customer ID and account details.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getCustomerProfile"
            },
            "input": {
              "arguments": "=$.arguments",
              "httpHeaders": "=$.httpHeaders"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
