{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/activity/agentactivity",
    "github.com/project-flogo/websocket/activity/wswritedata",
    "github.com/project-flogo/websocket/trigger/wsserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/mcpserverconfig",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/a2aserverconnection"
  ],
  "name": "TelecomInvoiceAIOrchestrator",
  "description": "Telecom Invoice Chatbot AI Orchestrator - WebSocket chat interface orchestrating MCP tools and A2A agents for billing inquiries, disputes, and recharges",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#wsserver",
      "name": "wsserver",
      "description": "Websocket server listens for connection request from the client",
      "settings": {
        "port": 9500,
        "enableTLS": false,
        "serverCert": "",
        "serverKey": "",
        "enableClientAuth": false,
        "trustStore": ""
      },
      "id": "WebsocketServer",
      "handlers": [
        {
          "description": "",
          "settings": {
            "method": "GET",
            "path": "/telecom",
            "mode": "Data",
            "format": "String",
            "jsonSchema": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:Orchestrator_Flow"
            },
            "input": {
              "pathParams": "=$.pathParams",
              "queryParams": "=$.queryParams",
              "headers": "=$.headers",
              "content": "=$.content",
              "wsconnection": "=$.wsconnection"
            }
          },
          "schemas": {
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Key\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Sec-Websocket-Version\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Upgrade\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
              }
            }
          },
          "name": "Orchestrator_Flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:Orchestrator_Flow",
      "data": {
        "name": "Orchestrator Flow",
        "description": "",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "AIAgent",
            "type": "label",
            "label": "StartActivity to AIAgent"
          },
          {
            "id": 2,
            "from": "AIAgent",
            "to": "WebsocketWriteData",
            "type": "label",
            "label": "AIAgent to WebsocketWriteData"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "AIAgent",
            "name": "AIAgent",
            "description": "Configure AI Agent in the flow",
            "activity": {
              "ref": "#agentactivity",
              "settings": {
                "llmProviderConnection": "conn://d1e2f3a4-1111-2222-3333-444455559500",
                "model": "=$property[\"LLM_Model\"]",
                "reasoning": "",
                "temperature": 0.7,
                "enableGuardrails": true,
                "rateLimit": 25,
                "tokenLimit": 2048,
                "redactSensitiveData": true,
                "responseType": "Text",
                "agentHandoffs": "",
                "remoteAgents": [
                  "conn://e1f2a3b4-aaaa-bbbb-cccc-111199999883",
                  "conn://f1a2b3c4-aaaa-bbbb-cccc-222299999884",
                  "conn://a1b2c3d4-aaaa-bbbb-cccc-333399999885"
                ],
                "mcpServers": [
                  "conn://b1c2d3e4-aaaa-bbbb-cccc-444455559882"
                ],
                "conversationStoreType": "Memory",
                "memoryMaxSize": 100,
                "systemPrompt": "You are the Telecom Invoice Chatbot AI Agent, an AI-powered billing assistant for a UAE telecom operator's postpaid and prepaid subscribers. You answer natural-language billing questions and can file disputes and apply recharges. You manage three sub-agents: billing_dispute_agent for validating and filing billing disputes, recharge_agent for applying recharge packs, and send_confirmation_email for sending a confirmation email after a billing action.\n\nCUSTOMER IDENTIFICATION: Subscribers are identified by their mobile number (e.g. +971-50-123-4567). When a user gives a mobile number, use the GetCustomerProfile MCP tool to look up their customer_id (e.g. CUST-10042871). Use that customer_id for all subsequent tool calls. If the user does not provide a mobile number and one is required, politely ask for it. The demo currency is AED.\n\nINTENT ANALYSIS: Before invoking any sub-agent, analyze the user's request to determine which tasks are needed.\n- Billing / 'why is my bill high' questions -> use MCP tools GetCustomerProfile, GetInvoiceDetails, and GetUsageBreakdown, then explain each line item against actual usage.\n- 'Show my last N payments' -> use GetPaymentHistory.\n- 'What plan am I on' -> use GetActivePlans.\n- Recharge / 'I need more data' -> use CheckRechargeOffers to present options, then after the user confirms a pack, invoke recharge_agent.\n- Dispute / 'I was charged for X but ...' -> use GetInvoiceDetails (and GetUsageBreakdown to confirm the discrepancy), then invoke billing_dispute_agent to file the dispute.\n- 'Status of my dispute' -> use the GetDisputes MCP tool.\n\nMCP TOOLS (read-only, safe to call without confirmation): The MCP server provides 7 tools - GetCustomerProfile, GetInvoiceDetails, GetUsageBreakdown, GetActivePlans, GetPaymentHistory, CheckRechargeOffers, GetDisputes. Never use MCP tools for modifications - use the billing_dispute_agent or recharge_agent sub-agents for write operations.\n\nWORKFLOW FOR DISPUTES: Step 1: Identify the customer and the invoice with GetInvoiceDetails. Step 2: Use GetUsageBreakdown to check whether the disputed charge matches actual usage (e.g. a ROAMING line item while roaming_days = 0 is a clear discrepancy). Step 3: Explain what you found and confirm with the user that they want to file a dispute. Step 4: On confirmation, invoke billing_dispute_agent with customer_id, invoice_id, a clear reason, and a generated dispute_id (format DSP-2026-XXXX). Step 5: Report the dispute ID, OPEN status, and 5 business-day estimated resolution.\n\nWORKFLOW FOR RECHARGE: Step 1: Identify the customer. Step 2: Use CheckRechargeOffers to present suitable packs. Step 3: Wait for the user to choose and confirm a pack. Step 4: Invoke recharge_agent with customer_id, offer_id, offer_name, amount, data_amount_gb, and a generated recharge_id (format RCG-2026-XXXX). Step 5: Report the activation confirmation and validity.\n\nEMAIL RULE: Only invoke send_confirmation_email if the user explicitly requests a confirmation email, and only ONCE after a dispute or recharge is complete. Compose a complete subject and full body yourself describing the action taken, and pass them as the subject and body arguments. The recipient delivery address is preconfigured in the email service, so you do NOT need the subscriber's email address to send - always proceed. Never invoke send_confirmation_email more than once in a single conversation.\n\nRESPONSE STYLE: Be warm, professional, and clear. Address subscribers by name when known. Acknowledge segment (Premium/Business/VIP subscribers get priority language). When explaining a bill, break down each line item with its amount and, where relevant, tie it to usage (e.g. 'Roaming Saudi Arabia AED 54.50 - you used 3 roaming days, so this is valid'). Always confirm before any write action (dispute or recharge).\n\nSCOPE: You only handle billing inquiries, invoice explanations, usage, plans, payments, recharge offers and activation, billing disputes, and dispute status. Politely decline requests about SIM swaps, number porting, new connections, network coverage/outages, device sales, or technical support, and clearly state what you can and cannot help with.\n\nTERMINATION RULES: Complete each sub-agent task within a maximum of 3 attempts. If any sub-agent fails after 3 attempts, collect partial results and report what was completed and what failed."
              },
              "input": {
                "userPrompt": "=coerce.toString($flow.content)",
                "conversationId": ""
              },
              "schemas": {
                "input": {
                  "filteredToolNames": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "WebsocketWriteData",
            "name": "WebsocketWriteData",
            "description": "Websocket Write Data Activity will write data to existing Websocket connection",
            "activity": {
              "ref": "#wswritedata",
              "settings": {
                "format": "String",
                "jsonSchema": ""
              },
              "input": {
                "message": "=$activity[AIAgent].response",
                "wsconnection": "=$flow.wsconnection"
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfSwiQUlBZ2VudCI6eyJ4IjoyNDgsInkiOjk2fSwiV2Vic29ja2V0V3JpdGVEYXRhIjp7IngiOjQ2OCwieSI6OTV9fQ==",
        "metadata": {
          "input": [
            {
              "name": "pathParams",
              "type": "params"
            },
            {
              "name": "queryParams",
              "type": "params"
            },
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "content",
              "type": "any"
            },
            {
              "name": "wsconnection",
              "type": "any"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"WebsocketServer\",\"properties\":{\"pathParams\":{\"type\":\"params\"},\"queryParams\":{\"type\":\"params\"},\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"content\":{\"type\":\"any\",\"required\":false},\"wsconnection\":{\"type\":\"any\",\"required\":false}}}"
          }
        }
      }
    }
  ],
