<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ApprovalSchema" xmlns:tns="http://www.example.org/ApprovalSchema" elementFormDefault="qualified">

    <element name="pendingApproval">
    	<complexType>
    		<sequence>
                        <element name="approvalId" type="string" minOccurs="0" maxOccurs="1"></element>
                        <element maxOccurs="1" minOccurs="0" name="toolName"
    					type="string" />
    				<element maxOccurs="1" minOccurs="0"
    					name="arguments">
    					<complexType>
    						<sequence>
    							<element maxOccurs="1" minOccurs="0"
    								name="sku" type="string" />
    							<element maxOccurs="1" minOccurs="0"
    								name="storeId" type="string" />
    							<element maxOccurs="1" minOccurs="0"
    								name="customerId" type="string" />
    							<element name="orderId" type="string"
    								minOccurs="0" maxOccurs="1">
    							</element>
    							<element name="promotionId"
    								type="string" minOccurs="0" maxOccurs="1">
    							</element>
    						</sequence>
    					</complexType>
    				</element>
    				<element maxOccurs="1" minOccurs="0" name="summary"
    					type="string" />
    				<element maxOccurs="1" minOccurs="0" name="status"
    					type="string" />
    			</sequence>
    	</complexType></element>

    <element name="approvalBlocked">
    	<complexType>
    		<sequence>
  		<element name="toolName" type="string" minOccurs="0" maxOccurs="1"></element>
  		<element name="reason" type="string" minOccurs="0" maxOccurs="1"></element>
  	</sequence>
    	</complexType></element>
</schema>