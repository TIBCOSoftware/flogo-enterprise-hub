<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://tns.tibco.com/bw/json/1779331907656" elementFormDefault="qualified" targetNamespace="http://tns.tibco.com/bw/json/1779331907656">
  <complexType name="PolicyRagType">
    <sequence>
    	<element maxOccurs="1" minOccurs="0" name="answer"
    		type="string" />
    	<element maxOccurs="unbounded" minOccurs="0" name="retrieval">
    		<complexType>
    			<sequence>
    				<element maxOccurs="1" minOccurs="0" name="chunkId"
    					type="string" />
    				<element maxOccurs="1" minOccurs="0"
    					name="documentId" type="string" />
    				<element maxOccurs="1" minOccurs="0" name="title"
    					type="string" />
    				<element maxOccurs="1" minOccurs="0"
    					name="documentType" type="string" />
    				<element maxOccurs="1" minOccurs="0" name="category"
    					type="string" />
    				<element maxOccurs="1" minOccurs="0" name="score"
    					type="double" />
    				<element maxOccurs="1" minOccurs="0" name="text"
    					type="string" />
    				<element maxOccurs="1" minOccurs="0" name="uri"
    					type="string" />
    			</sequence>
    		</complexType>
    	</element>
    	<element maxOccurs="unbounded" minOccurs="0" name="citations">
    		<complexType>
    			<sequence>
    				<element maxOccurs="1" minOccurs="0" name="id"
    					type="string" />
    				<element maxOccurs="1" minOccurs="0" name="title"
    					type="string" />
    				<element maxOccurs="1" minOccurs="0"
    					name="documentType" type="string" />
    				<element maxOccurs="1" minOccurs="0" name="uri"
    					type="string" />
    			</sequence>
    		</complexType>
    	</element>
            <element name="raw" minOccurs="0" maxOccurs="1">
            	<complexType>
            		<sequence>
            			<element name="selectedEmbeddings" type="string" minOccurs="0" maxOccurs="unbounded"></element>
            		</sequence>
            	</complexType></element>
            <element maxOccurs="1" minOccurs="0" name="metadata">
    		<complexType>
    			<sequence>
    				<element maxOccurs="1" minOccurs="0" name="provider"
    					type="string" />
    				<element maxOccurs="1" minOccurs="0"
    					name="collection" type="string" />
    				<element maxOccurs="1" minOccurs="0"
    					name="embedding">
    					<complexType>
    						<sequence>
    							<element maxOccurs="1" minOccurs="0"
    								name="provider" type="string" />
    							<element maxOccurs="1" minOccurs="0"
    								name="model" type="string" />
    						</sequence>
    					</complexType>
    				</element>
    				<element maxOccurs="1" minOccurs="0" name="topK"
    					type="integer" />
                        <element name="minScore" type="decimal" minOccurs="0" maxOccurs="1"></element>
                        <element maxOccurs="1" minOccurs="0"
    					name="retrievalCount" type="integer" />
    			</sequence>
    		</complexType>
    	</element>
    </sequence>
  </complexType>
  <element name="PolicyRag" type="tns:PolicyRagType"/>
</schema>
