                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns31=&quot;http://tns.tibco.com/bw/json/1778614722332&quot; xmlns:tns23=&quot;http://tns.tibco.com/bw/json/1778562475043&quot; xmlns:tns27=&quot;/T1778595978941Converted/JsonSchema&quot; xmlns:tns28=&quot;/T1778596135500Converted/JsonSchema&quot; xmlns:tns29=&quot;/T1778596217369Converted/JsonSchema&quot; xmlns:tns55=&quot;/T1779422021916Converted/JsonSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;lookup_order.item&quot;/>&#xa;    &lt;xsl:param name=&quot;find_promotions.item&quot;/>&#xa;    &lt;xsl:param name=&quot;get_product.item&quot;/>&#xa;    &lt;xsl:param name=&quot;mcp_tools_call.item&quot;/>&#xa;    &lt;xsl:param name=&quot;check_return_eligibility.item&quot;/>&#xa;    &lt;xsl:param name=&quot;check_inventory.item&quot;/>&#xa;    &lt;xsl:param name=&quot;action&quot;/>&#xa;    &lt;xsl:template name=&quot;ToolCallsMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns31:FullSchemaElement>&#xa;            &lt;xsl:for-each select=&quot;$action[tns23:requiresApproval = false()]&quot;>&#xa;                &lt;tns31:toolCalls>&#xa;                    &lt;xsl:if test=&quot;$mcp_tools_call.item/tns55:toolName&quot;>&#xa;                        &lt;tns31:name>&#xa;                            &lt;xsl:value-of select=&quot;$mcp_tools_call.item/tns55:toolName&quot;/>&#xa;                        &lt;/tns31:name>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns31:arguments>&#xa;                        &lt;xsl:if test=&quot;tns23:sku&quot;>&#xa;                            &lt;tns31:sku>&#xa;                                &lt;xsl:value-of select=&quot;tns23:sku&quot;/>&#xa;                            &lt;/tns31:sku>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns23:storeId&quot;>&#x