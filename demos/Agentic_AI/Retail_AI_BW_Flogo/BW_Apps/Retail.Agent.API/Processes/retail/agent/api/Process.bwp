                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns51=&quot;http://tns.tibco.com/bw/json/1778956582234&quot; xmlns:tns23=&quot;http://tns.tibco.com/bw/json/1778562475043&quot; xmlns:tns27=&quot;/T1778595978941Converted/JsonSchema&quot; xmlns:tns9=&quot;http://tns.tibco.com/bw/json/1778550230021&quot; xmlns:tns41=&quot;http://tns.tibco.com/bw/json/1778562607469&quot; xmlns:tns31=&quot;http://tns.tibco.com/bw/json/1778614722332&quot; xmlns:tns26=&quot;http://tns.tibco.com/bw/json/1778612190510&quot; xmlns:tns49=&quot;http://tns.tibco.com/bw/json/1778954894364&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns47=&quot;http://www.example.org/AnswerSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get_product.item&quot;/>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;Planner&quot;/>&#xa;    &lt;xsl:param name=&quot;RAGResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;ToolCallsMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;ToolCallsMapperFull&quot;/>&#xa;    &lt;xsl:param name=&quot;ApprovalMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;BuildAnswer&quot;/>&#xa;    &lt;xsl:param name=&quot;BuildRoute&quot;/>&#xa;    &lt;xsl:template name=&quot;BuildSteps-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns51:StepsSchemaElementArray>&#xa;            &lt;tns51:StepsSchemaElement>&#xa;                &lt;tns51:id>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;step-1&amp;quot;&quot;/>&#xa;                &lt;/tns51:id>&#xa;                &lt;tns51:type>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;analysis&amp;quot;&quot;/>&#xa;                &lt;/tns51:type>&#xa;                &lt;tns51:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Generated structured agent plan&amp;quot;&quot;/>&#xa;                &lt;/tns51:label>&#xa;                &lt;tns51:status>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;completed&amp;quot;&quot;/>&#xa;                &lt;/tns51:status>&#xa;                &lt;tns51:query>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns9:question&quot;/>&#xa;                &lt;/tns51:query>&#xa;                &lt;tns51:resultCount>&#xa;                    &lt;xsl:value-of select=&quot;count($RAGResponse/tns41:retrieval)&quot;/>&#xa;                &lt;/tns51:resultCount>&#xa;                &lt;xsl:for-each select=&quot;$RAGResponse/tns41:retrieval[position() &amp;lt;= 3]&quot;>&#xa;                    &lt;tns51:topResults>&#xa;                        &lt;xsl:if test=&quot;tns41:title&quot;>&#xa;                            &lt;tns51:title>&#xa;                                &lt;xsl:value-of select=&quot;tns41:title&quot;/>&#xa;                            &lt;/tns51:title>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns41:score&quot;>&#xa;                            &lt;tns51:score>&#xa;                                &lt;xsl:value-of select=&quot;tns41:score&quot;/>&#xa;                            &lt;/tns51:score>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns51:topResults>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;tns51:planner>&#xa;                    &lt;tns51:provider>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;bw6-java-deterministic&amp;quot;&quot;/>&#xa;                    &lt;/tns51:provider>&#xa;                    &lt;tns51:model>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RetailAgentPlanner&amp;quot;&quot;/>&#xa;                    &lt;/tns51:model>&#xa;                    &lt;xsl:if test=&quot;$Planner/tns23:plannerNotes&quot;>&#xa;                        &lt;tns51:notes>&#xa;                            &lt;xsl:value-of select=&quot;$Planner/tns23:plannerNotes&quot;/>&#xa;                        &lt;/tns51:notes>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns51:planner>&#xa;                &lt;tns51:observation>&#xa;                    &lt;xsl:if test=&quot;$Planner/tns23:intent&quot;>&#xa;                        &lt;tns51:intent>&#xa;                            &lt;xsl:value-of select=&quot;$Planner/tns23:intent&quot;/>&#xa;                        &lt;/tns51:intent>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Planner/tns23:entities/tns23:sku) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Planner/tns23:entities/tns23:sku&quot;>&#xa;                            &lt;tns51:detectedSku>&#xa;                                &lt;xsl:value-of select=&quot;$Planner/tns23:entities/tns23:sku&quot;/>&#xa;                            &lt;/tns51:detectedSku>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Planner/tns23:entities/tns23:orderId) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Planner/tns23:entities/tns23:orderId&quot;>&#xa;                            &lt;tns51:detectedOrderId>&#xa;                                &lt;xsl:value-of select=&quot;$Planner/tns23:entities/tns23:orderId&quot;/>&#xa;                            &lt;/tns51:detectedOrderId>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Planner/tns23:entities/tns23:category) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Planner/tns23:entities/tns23:category&quot;>&#xa;                                &lt;tns51:detectedCategory>&#xa;                                    &lt;xsl:value-of select=&quot;$Planner/tns23:entities/tns23:category&quot;/>&#xa;                                &lt;/tns51:detectedCategory>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$get_product.item/tns27:category&quot;>&#xa;                                &lt;tns51:detectedCategory>&#xa;                                    &lt;xsl:value-of select=&quot;$get_product.item/tns27:category&quot;/>&#xa;                                &lt;/tns51:detectedCategory>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Planner/tns23:entities/tns23:maxPrice&quot;>&#xa;                        &lt;tns51:maxPrice>&#xa;                            &lt;xsl:value-of select=&quot;$Planner/tns23:entities/tns23:maxPrice&quot;/>&#xa;                        &lt;/tns51:maxPrice>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;$Planner/tns23:actions&quot;>&#xa;                        &lt;tns51:actions>&#xa;                            &lt;xsl:if test=&quot;tns23:toolName&quot;>&#xa;                                &lt;tns51:toolName>&#xa;                                    &lt;xsl:value-of select=&quot;tns23:toolName&quot;/>&#xa;                                &lt;/tns51:toolName>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns23:sku&quot;>&#xa;                                &lt;tns51:sku>&#xa;                                    &lt;xsl:value-of select=&quot;tns23:sku&quot;/>&#xa;                                &lt;/tns51:sku>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns23:orderId&quot;>&#xa;                                &lt;tns51:orderId>&#xa;                                    &lt;xsl:value-of select=&quot;tns23:orderId&quot;/>&#xa;                                &lt;/tns51:orderId>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns23:storeId&quot;>&#xa;                                &lt;tns51:storeId>&#xa;                                    &lt;xsl:value-of select=&quot;tns23:storeId&quot;/>&#xa;                                &lt;/tns51:storeId>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns23:customerId&quot;>&#xa;                                &lt;tns51:customerId>&#xa;                                    &lt;xsl:value-of select=&quot;tns23:customerId&quot;/>&#xa;                                &lt;/tns51:customerId>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns23:category&quot;>&#xa;                                &lt;tns51:category>&#xa;                                    &lt;xsl:value-of select=&quot;tns23:category&quot;/>&#xa;                                &lt;/tns51:category>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns23:promotionId&quot;>&#xa;                                &lt;tns51:promotionId>&#xa;                                    &lt;xsl:value-of select=&quot;tns23:promotionId&quot;/>&#xa;                                &lt;/tns51:promotionId>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns23:requiresApproval&quot;>&#xa;                                &lt;tns51:requiresApproval>&#xa;                                    &lt;xsl:value-of select=&quot;tns23:requiresApproval&quot;/>&#xa;                                &lt;/tns51:requiresApproval>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns23:rationale&quot;>&#xa;                                &lt;tns51:rationale>&#xa;                                    &lt;xsl:value-of select=&quot;tns23:rationale&quot;/>&#xa;                                &lt;/tns51:rationale>&