                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns47=&quot;http://www.example.org/AnswerSchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns26=&quot;http://tns.tibco.com/bw/json/1778612190510&quot; xmlns:tns55=&quot;/T1779422021916Converted/JsonSchema&quot; xmlns:tns54=&quot;http://tns.tibco.com/bw/json/1779331907656&quot; xmlns:tns59=&quot;http://tns.tibco.com/bw/json/1779514682713&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ApprovalMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;mcp_tools_call&quot;/>&#xa;    &lt;xsl:param name=&quot;PolicyRag&quot;/>&#xa;    &lt;xsl:param name=&quot;AnswerGenerator&quot;/>&#xa;    &lt;xsl:template name=&quot;BuildAnswer-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($AnswerGenerator)&quot;>&#xa;                &lt;tns47:AnswerResource>&#xa;                    &lt;xsl:if test=&quot;$AnswerGenerator/tns59:answer&quot;>&#xa;                        &lt;tns47:answer>&#xa;                            &lt;xsl:value-of select=&quot;$AnswerGenerator/tns59:answer&quot;/>&#xa;                        &lt;/tns47:answer>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$AnswerGenerator/tns59:answerSource&quot;>&#xa;                        &lt;tns47:answerSource>&#xa;                            &lt;xsl:value-of select=&quot;$AnswerGenerator/tns59:answerSource&quot;/>&#xa;                        &lt;/tns47:answerSource>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$AnswerGenerator/tns59:citationsUsed&quot;>&#xa;                        &lt;tns47:citationsUsed>&#xa;                            &lt;xsl:value-of select=&quot;$AnswerGenerator/tns59:citationsUsed&quot;/>&#xa;                        &lt;/tns47:citationsUsed>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$AnswerGenerator/tns59:reasoningSummary&quot;>&#xa;                        &lt;tns47:reasoningSummary>&#xa;                            &lt;xsl:value-of select=&quot;$AnswerGenerator/tns59:reasoningSummary&quot;/>&#xa;                        &lt;/tns47:reasoningSummary>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$AnswerGenerator/tns59:confidence&quot;>&#xa;                        &lt;tns47:confidence>&#xa;                            &lt;xsl:value-of select=&quot;$AnswerGenerator/tns59:confidence&quot;/>&#xa;                        &lt;/tns47:confidence>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns47:AnswerResource>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($ApprovalMapper/tns26:pendingApproval)&quot;>&#xa;                &lt;tns47:AnswerResource>&#xa;                    &lt;tns47:answer>&#xa;                        &lt;xsl:value-of select=&quot;concat($ApprovalMapper/tns26:pendingApproval/tns26:summary, &amp;quot;  I paused before taking the action because it changes retail state and needs approval.&amp;quot;)&quot;/>&#xa;                    &lt;/tns47:answer>&#xa;                    &lt;tns47:answerSource>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;approval&amp;quot;&quot;/>&#xa;                    &lt;/tns47:answerSource>&#xa;                &lt;/tns47:AnswerResource>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($ApprovalMapper/tns26:approvalBlocked)&quot;>&#xa;                &lt;tns47:AnswerResource>&#xa;                    &lt;xsl:if test=&quot;$ApprovalMapper/tns26:approvalBlocked/tns26:reason&quot;>&#xa;                        &lt;tns47:answer>&#xa;                            &lt;xsl:value-of select=&quot;$ApprovalMapper/tns26:approvalBlocked/tns26:reason&quot;/>&#xa;                        &lt;/tns47:answer>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns47:answerSource>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;approval_blocked&amp;quot;&quot;/>&#xa;                    &lt;/tns47:answerSource>&#xa;                &lt;/tns47:AnswerResource>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:toolName = &amp;quot;check_inventory&amp;quot;&quot;>&#xa;                &lt;tns47:AnswerResource>&#xa;                    &lt;tns47:answer>&#xa;                        &lt;xsl:value-of select=&quot;concat($mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:result/tns55:productName, &amp;quot; has &amp;quot;, xsd:string($mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:result/tns55:quantity), &amp;quot; units at &amp;quot;, $mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:result/tns55:storeId, &amp;quot;. Status is &amp;quot;, $mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:result/tns55:status, &amp;quot; in aisle , &amp;quot;,$mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:result/tns55:aisle)&quot;/>&#xa;                    &lt;/tns47:answer>&#xa;                    &lt;tns47:answerSource>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;domain_tool&amp;quot;&quot;/>&#xa;                    &lt;/tns47:answerSource>&#xa;                &lt;/tns47:AnswerResource>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:toolName = &amp;quot;check_return_eligibility&amp;quot;&quot;>&#xa;                &lt;tns47:AnswerResource>&#xa;                    &lt;xsl:if test=&quot;$mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:result/tns55:reason&quot;>&#xa;                        &lt;tns47:answer>&#xa;                            &lt;xsl:value-of select=&quot;$mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:result/tns55:reason&quot;/>&#xa;                        &lt;/tns47:answer>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns47:answerSource>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;domain_tool&amp;quot;&quot;/>&#xa;                    &lt;/tns47:answerSource>&#xa;                &lt;/tns47:AnswerResource>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:toolName = &amp;quot;find_promotions&amp;quot;&quot;>&#xa;                &lt;tns47:AnswerResource>&#xa;                    &lt;xsl:if test=&quot;$mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:result/tns55:message&quot;>&#xa;                        &lt;tns47:answer>&#xa;                            &lt;xsl:value-of select=&quot;$mcp_tools_call/item/tns55:MCPToolCallResponseElement/tns55:result/tns55:message&quot;/>&#xa;                        &lt;/tns47:answer>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns47:answerSource>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;domain_tool&amp;quot;&quot;/>&#xa;                    &lt;/tns47:answerSource>&#xa;                &lt;/tns47:AnswerResource>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($PolicyRag/tns54:answer) > 0&quot;>&#xa;                &lt;tns47:AnswerResource>&#xa;                    &lt;xsl:if test=&quot;$PolicyRag/tns54:answer&quot;>&#xa;                        &lt;tns47:answer>&#xa;                            &lt;xsl:value-of select=&quot;$PolicyRag/tns54:answer&quot;/>&#xa;                        &lt;/tns47:answer>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns47:answerSource>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;rag&amp;quot;&quot;/>&#xa;                    &lt;/tns47:answerSource>&#xa;                &lt;/tns47:AnswerResource>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns47:AnswerResource>&#xa;                    &lt;tns47:answer>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;I could not find enough retail context to answer confidently.&amp;quot;&quot;/>&#xa;                    &lt;/tns47:answer>&#xa;                    &lt;tns47:answerSource>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;fallback&amp;quot;&quot;/>&#xa;                    &lt;/tns47:answerSource>&#xa;                &lt;/tns47:AnswerResource>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
