                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns40=&quot;http://tns.tibco.com/bw/json/1778621229768&quot; xmlns:tns23=&quot;http://tns.tibco.com/bw/json/1778562475043&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns51=&quot;http://tns.tibco.com/bw/json/1778956582234&quot; xmlns:tns52=&quot;http://tns.tibco.com/bw/json/1778966201686&quot; xmlns:tns26=&quot;http://tns.tibco.com/bw/json/1778612190510&quot; xmlns:tns49=&quot;http://tns.tibco.com/bw/json/1778954894364&quot; xmlns:tns31=&quot;http://tns.tibco.com/bw/json/1778614722332&quot; xmlns:tns48=&quot;http://tns.tibco.com/bw/json/1778954662748&quot; xmlns:tns50=&quot;http://tns.tibco.com/bw/json/1778956139708&quot; xmlns:tns11=&quot;http://tns.tibco.com/bw/json/1778558788803&quot; xmlns:tns9=&quot;http://tns.tibco.com/bw/json/1778550230021&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns54=&quot;http://tns.tibco.com/bw/json/1779331907656&quot; xmlns:tns47=&quot;http://www.example.org/AnswerSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;Planner&quot;/>&#xa;    &lt;xsl:param name=&quot;EnrichedPendingApproval&quot;/>&#xa;    &lt;xsl:param name=&quot;BuildAnswer&quot;/>&#xa;    &lt;xsl:param name=&quot;BuildSteps&quot;/>&#xa;    &lt;xsl:param name=&quot;ApprovalMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;BuildRoute&quot;/>&#xa;    &lt;xsl:param name=&quot;ToolCallsMapperFull&quot;/>&#xa;    &lt;xsl:param name=&quot;ResolveUser&quot;/>&#xa;    &lt;xsl:param name=&quot;BuildAnswerGeneration&quot;/>&#xa;    &lt;xsl:param name=&quot;BuildObservability&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:param name=&quot;query_retail_conversation_messages&quot;/>&#xa;    &lt;xsl:param name=&quot;PolicyRag&quot;/>&#xa;    &