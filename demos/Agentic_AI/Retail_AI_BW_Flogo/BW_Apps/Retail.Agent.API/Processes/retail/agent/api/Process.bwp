                                    expression="$action/ns29:toolName = &quot;check_inventory&quot; and $action/ns29:requiresApproval = false() and 1=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$action/ns29:toolName = "check_inventory" and $action/ns29:requiresApproval = false() and 1=2]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToget2_lookuporder">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$action/ns29:toolName = &quot;lookup_order&quot; and $action/ns29:requiresApproval = false() and 1=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$action/ns29:toolName = "lookup_order" and $action/ns29:requiresApproval = false() and 1=2]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToget3_checkreturneligibility">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$action/ns29:toolName = &quot;check_return_eligibility&quot; and $action/ns29:requiresApproval = false() and 1=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$action/ns29:toolName = "check_return_eligibility" and $action/ns29:requiresApproval = false() and 1=2]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToget4_findpromotions">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$action/ns29:toolName = &quot;find_promotions&quot; and $action/ns29:requiresApproval = false() and 1=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$action/ns29:toolName = "find_promotions" and $action/ns29:requiresApproval = false() and 1=2]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToEmpty">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartTomcp_tools_call">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$action/ns29:requiresApproval = false()&#xa;and (&#xa;  (&#xa;    $action/ns29:toolName = &quot;get_product&quot;&#xa;    and string-length($action/ns29:sku) > 0&#xa;  )&#xa;  or&#xa;  (&#xa;    $action/ns29:toolName = &quot;check_inventory&quot;&#xa;    and string-length($action/ns29:sku) > 0&#xa;    and string-length($action/ns29:storeId) > 0&#xa;  )&#xa;  or&#xa;  (&#xa;    $action/ns29:toolName = &quot;lookup_order&quot;&#xa;    and string-length($action/ns29:orderId) > 0&#xa;  )&#xa;  or&#xa;  (&#xa;    $action/ns29:toolName = &quot;check_return_eligibility&quot;&#xa;    and string-length($action/ns29:orderId) > 0&#xa;  )&#xa;  or&#xa;  (&#xa;    $action/ns29:toolName = &quot;find_promotions&quot;&#xa;    and string-length($action/ns29:customerId) > 0&#xa;  )&#xa;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$action/ns29:requiresApproval = false()
and (
  (
    $action/ns29:toolName = "get_product"
    and string-length($action/ns29:sku) > 0
  )
  or
  (
    $action/ns29:toolName = "check_inventory"
    and string-length($action/ns29:sku) > 0
    and string-length($action/ns29:storeId) > 0
  )
  or
  (
    $action/ns29:toolName = "lookup_order"
    and string-length($action/ns29:orderId) > 0
  )
  or
  (
    $action/ns29:toolName = "check_return_eligibility"
    and string-length($action/ns29:orderId) > 0
  )
  or
  (
    $action/ns29:toolName = "find_promotions"
    and string-length($action/ns29:customerId) > 0
  )
)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
