         &lt;/tns54:documentType>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns53:category&quot;>&#xa;                        &lt;tns54:category>&#xa;                            &lt;xsl:value-of select=&quot;tns53:category&quot;/>&#xa;                        &lt;/tns54:category>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns53:score&quot;>&#xa;                        &lt;tns54:score>&#xa;                            &lt;xsl:value-of select=&quot;tns53:score&quot;/>&#xa;                        &lt;/tns54:score>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns53:text&quot;>&#xa;                        &lt;tns54:text>&#xa;                            &lt;xsl:value-of select=&quot;tns53:text&quot;/>&#xa;                        &lt;/tns54:text>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns53:uri&quot;>&#xa;                        &lt;tns54:uri>&#xa;                            &lt;xsl:value-of select=&quot;tns53:uri&quot;/>&#xa;                        &lt;/tns54:uri>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns54:retrieval>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$query_policy.item/tns53:citations&quot;>&#xa;                &lt;tns54:citations>&#xa;                    &lt;xsl:if test=&quot;tns53:id&quot;>&#xa;                        &lt;tns54:id>&#xa;                            &lt;xsl:value-of select=&quot;tns53:id&quot;/>&#xa;                        &lt;/tns54:id>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns53:title&quot;>&#xa;                        &lt;tns54:title>&#xa;                            &lt;xsl:value-of select=&quot;tns53:title&quot;/>&#xa;                        &lt;/tns54:title>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns53:documentType&quot;>&#xa;                        &lt;tns54:documentType>&#xa;                            &lt;xsl:value-of select=&quot;tns53:documentType&quot;/>&#xa;                        &lt;/tns54:documentType>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns53:uri&quot;>&#xa;                        &lt;tns54:uri>&#xa;                            &lt;xsl:value-of select=&quot;tns53:uri&quot;/>&#xa;                        &lt;/tns54:uri>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns54:citations>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$query_policy.item/tns53:raw&quot;>&#xa;                &lt;tns54:raw>&#xa;                    &lt;xsl:for-each select=&quot;tns53:selectedEmbeddings&quot;>&#xa;                        &lt;tns54:selectedEmbeddings>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/tns54:selectedEmbeddings>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns54:raw>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$query_policy.item/tns53:metadata&quot;>&#xa;                &lt;tns54:metadata>&#xa;                    &lt;xsl:if test=&quot;tns53:provider&quot;>&#xa;                        &lt;tns54:provider>&#xa;                            &lt;xsl:value-of select=&quot;tns53:provider&quot;/>&#xa;                        &lt;/tns54:provider>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns53:collection&quot;>&#xa;                        &lt;tns54:collection>&#xa;                            &lt;xsl:value-of select=&quot;tns53:collection&quot;/>&#xa;                        &lt;/tns54:collection>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;tns53:embedding&quot;>&#xa;                        &lt;tns54:embedding>&#xa;                            &lt;xsl:if test=&quot;tns53:provider&quot;>&#xa;                                &lt;tns54:provider>&#xa;                                    &lt;xsl:value-of select=&quot;tns53:provider&quot;/>&#xa;                                &lt;/tns54:provider>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns53:model&quot;>&#xa;                                &lt;tns54:model>&#xa;                                    &lt;xsl:value-of select=&quot;tns53:model&quot;/>&#xa;                                &lt;/tns54:model>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns54:embedding>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;tns53:topK&quot;>&#xa;                        &lt;tns54:topK>&#xa;                            &lt;xsl:value-of select=&quot;tns53:topK&quot;/>&#xa;                        &lt;/tns54:topK>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns53:minScore&quot;>&#xa;                        &lt;tns54:minScore>&#xa;                            &lt;xsl:value-of select=&quot;tns53:minScore&quot;/>&#xa;                        &lt;/tns54:minScore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns53:retrievalCount&quot;>&#xa;                        &lt;tns54:retrievalCount>&#xa;                            &lt;xsl:value-of select=&quot;tns53:retrievalCount&quot;/>&#xa;                        &lt;/tns54:retrievalCount>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns54:metadata>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns54:PolicyRag>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
