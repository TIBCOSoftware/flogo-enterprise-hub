ct=&quot;$ToolCallsMapper/tns31:toolCalls&quot;>&lt;tns51:StepsSchemaElement>&lt;xsl:variable name=&quot;index&quot; select=&quot;position()&quot;/>&lt;tns51:id>&lt;xsl:value-of select=&quot;concat(&amp;quot;step-&amp;quot;, xsd:string(($index + 3)))&quot;/>&lt;/tns51:id>&lt;tns51:type>&lt;xsl:value-of select=&quot;&amp;quot;tool_call&amp;quot;&quot;/>&lt;/tns51:type>&lt;tns51:label>&lt;xsl:value-of select=&quot;concat(&amp;quot;Called tool &amp;quot;, $ToolCallsMapperFull/tns31:toolCalls[$index]/tns31:name)&quot;/>&lt;/tns51:label>&lt;tns51:status>&lt;xsl:value-of select=&quot;&amp;quot;completed&amp;quot;&quot;/>&lt;/tns51:status>&lt;tns51:toolCall>&lt;xsl:if test=&quot;tns31:name&quot;>&lt;tns51:name>&lt;xsl:value-of select=&quot;tns31:name&quot;/>&lt;/tns51:name>&lt;/xsl:if>&lt;xsl:for-each select=&quot;tns31:arguments&quot;>&lt;tns51:arguments>&lt;xsl:if test=&quot;tns31:sku&quot;>&lt;tns51:sku>&lt;xsl:value-of select=&quot;tns31:sku&quot;/>&lt;/tns51:sku>&lt;/xsl:if>&lt;xsl:if test=&quot;tns31:storeId&quot;>&lt;tns51:storeId>&lt;xsl:value-of select=&quot;tns31:storeId&quot;/>&lt;/tns51:storeId>&lt;/xsl:if>&lt;/tns51:arguments>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;tns31:result&quot;>&lt;tns51:result>&lt;xsl:if test=&quot;tns31:sku&quot;>&lt;tns51:sku>&lt;xsl:value-of select=&quot;tns31:sku&quot;/>&lt;/tns51:sku>&lt;/xsl:if>&lt;xsl:if test=&quot;tns31:storeId&quot;>&lt;tns51:storeId>&lt;xsl:value-of select=&quot;tns31:storeId&quot;/>&lt;/tns51:storeId>&lt;/xsl:if>&lt;xsl:if test=&quot;tns31:productName&quot;>&lt;tns51:productName>&lt;xsl:value-of select=&quot;tns31:productName&quot;/>&lt;/tns51:productName>&lt;/xsl:if>&lt;xsl:if test=&quot;tns31:quantity&quot;>&lt;tns51:quantity>&lt;xsl:value-of select=&quot;tns31:quantity&quot;/>&lt;/tns51:quantity>&lt;/xsl:if>&lt;xsl:if test=&quot;tns31:aisle&quot;>&lt;tns51:aisle>&lt;xsl:value-of select=&quot;tns31:aisle&quot;/>&lt;/tns51:aisle>&lt;/xsl:if>&lt;xsl:if test=&quot;tns31:status&quot;>&lt;tns51:status>&l