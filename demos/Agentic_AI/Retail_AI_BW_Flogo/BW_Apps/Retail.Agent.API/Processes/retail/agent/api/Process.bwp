ovalMapper/tns26:pendingApproval/tns26:toolName&quot;/>&lt;/tns51:toolName>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$ApprovalMapper/tns26:pendingApproval/tns26:arguments&quot;>&lt;tns51:arguments>&lt;xsl:if test=&quot;tns26:sku&quot;>&lt;tns51:sku>&lt;xsl:value-of select=&quot;tns26:sku&quot;/>&lt;/tns51:sku>&lt;/xsl:if>&lt;xsl:if test=&quot;tns26:storeId&quot;>&lt;tns51:storeId>&lt;xsl:value-of select=&quot;tns26:storeId&quot;/>&lt;/tns51:storeId>&lt;/xsl:if>&lt;xsl:if test=&quot;tns26:customerId&quot;>&lt;tns51:customerId>&lt;xsl:value-of select=&quot;tns26:customerId&quot;/>&lt;/tns51:customerId>&lt;/xsl:if>&lt;xsl:if test=&quot;tns26:orderId&quot;>&lt;tns51:orderId>&lt;xsl:value-of select=&quot;tns26:orderId&quot;/>&lt;/tns51:orderId>&lt;/xsl:if>&lt;xsl:if test=&quot;tns26:promotionId&quot;>&lt;tns51:promotionId>&lt;xsl:value-of select=&quot;tns26:promotionId&quot;/>&lt;/tns51:promotionId>&lt;/xsl:if>&lt;/tns51:arguments>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$ApprovalMapper/tns26:pendingApproval/tns26:summary&quot;>&lt;tns51:summary>&lt;xsl:value-of select=&quot;$ApprovalMapper/tns26:pendingApproval/tns26:summary&quot;/>&lt;/tns51:summary>&lt;/xsl:if>&lt;xsl:if test=&quot;$ApprovalMapper/tns26:pendingApproval/tns26:status&quot;>&lt;tns51:status>&lt;xsl:value-of select=&quot;$ApprovalMapper/tns26:pendingApproval/tns26:status&quot;/>&lt;/tns51:status>&lt;/xsl:if>&lt;/tns51:approval>&lt;/tns51:StepsSchemaElement>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($ApprovalMapper/tns26:approvalBlocked)&quot;>&lt;tns51:StepsSchemaElement>&lt;xsl:variable name=&quot;blockedStepNumber&quot; select=&quot;count($ToolCallsMapperFull/tns31:toolCalls) + 3&quot;/>&lt;tns51:id>&lt;xsl:value-of select=&quot;concat(&amp;quot;step-&amp;quot;, xsd:string($blockedStepNumber))&quot;/>&lt;/tns51:id>&lt;tns51:type>&lt;xsl:value-of select=&quot;&amp;quot;approval&amp;quot;&quot;/>&lt;/tns51:type>&lt;xsl:choose>&lt;xsl:when test=&quot;$ApprovalMapper/tns26:pendingApproval/tns26:toolName = &amp;quot;reserve_inventory&amp;quot;&quot;>&lt;tns51:label>&lt;xsl:value-of select=&quot;&amp;quot;Paused for inventory reservation approval&amp;quot;&quot;/>&lt;/tns51:label>&lt;/xsl:when>&lt;xsl:when test=&quot;$ApprovalMapper/tns26:pendingApproval/tns26:toolName = &amp;quot;reserve_inventory&amp;quot;&quot;>&lt;tns51:label>&lt;xsl:value-of select=&quot;&amp;quot;Paused for return authorization approval&amp;quot;&quot;/>&lt;/tns51:label>&lt;/xsl:when>&lt;xsl:when test=&quot;$ApprovalMapper/tns26:pendingApproval/tns26:toolName = &amp;quot;reserve_inventory&amp;quot;&quot;>&lt;tns51:label>&lt;xsl:value-of select=&quot;&amp;quot;Paused for promotion approval&amp;quot;&quot;/>&lt;/tns51:label>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns51:label>&lt;xsl:value-of select=&quot;&amp;quot;Paused for approval&amp;quot;&quot;/>&lt;/tns51:label>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns51:status>&lt;xsl:value-of select=&quot;&amp;quot;completed&amp;quot;&quot;/>&lt;/tns51:status>&lt;tns51:approvalBlocked>&lt;xsl:if test=&quot;$ApprovalMapper/tns26:approvalBlocked/tns26:toolName&quot;>&lt;tns51:toolName>&lt;xsl:value-of select=&quot;$ApprovalMapper/tns26:approvalBlocked/tns26:toolName&quot;/>&lt;/tns51:toolName>&lt;/xsl:if>&lt;xsl:if test=&quot;$ApprovalMapper/tns26:approvalBlocked/tns26:reason&quot;>&lt;tns51:reason>&lt;xsl:value-of select=&quot;$ApprovalMapper/tns26:approvalBlocked/tns26:reason&quot;/>&lt;/tns51:reason>&lt;/xsl:if>&lt;/tns51:approvalBlocked>&lt;/tns51:StepsSchemaElement>&lt;/xsl:if>&lt;tns51:StepsSchemaElement>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ApprovalMapper/tns26:pendingApproval) or exists($ApprovalMapper/tns26:approvalBlocked)&quot;>&lt;tns51:id>&lt;xsl:value-of select=&quot;concat(&amp;quot;step-&amp;quot;, xsd:string(4 + count($ToolCallsMapperFull/tns31:toolCalls)))&quot;/>&lt;/tns51:id>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns51:id>&lt;xsl:value-of select=&quot;concat(&amp;quot;step-&amp;quot;, xsd:string(3 + count($ToolCallsMapperFull/tns31:toolCalls)))&quot;/>&lt;/tns51:id>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns51:type>&lt;xsl:value-of select=&quot;&amp;quot;final&amp;quot;&quot;/>&lt;/tns51:type>&lt;tns51:label>&lt;xsl:value-of select=&quot;&amp;quot;Synthesized structured final answer&amp;quot;&quot;/>&lt;/tns51:label>&lt;tns51:status>&lt;xsl:value-of select=&quot;&amp;quot;completed&amp;quot;&quot;/>&lt;/tns51:status>&lt;xsl:if test=&quot;$BuildAnswer/tns47:answer&quot;>&lt;tns51:answer>&lt;xsl:value-of select=&quot;$BuildAnswer/tns47:answer&quot;/>&lt;/tns51:answer>&lt;/xsl:if>&lt;tns51:answerGenerator>&lt;xsl:if test=&quot;$BuildRoute/tns49:answerGenerator/tns49:provider&quot;>&lt;tns51:provider>&lt;xsl:value-of select=&quot;$BuildRoute/tns49:answerGenerator/tns49:provider&quot;/>&lt;/tns51:provider>&lt;/xsl:if>&lt;xsl:if test=&quot;$BuildRoute/tns49:answerGenerator/tns49:model&quot;>&lt;tns51:model>&lt;xsl:value-of select=&quot;$BuildRoute/tns49:answerGenerator/tns49:model&quot;/>&lt;/tns51:model>&lt;/xsl:if>&lt;xsl:if test=&quot;$BuildRoute/tns49:answerGenerator/tns49:warning&quot;>&lt;tns51:warning>&lt;xsl:value-of select=&quot;$BuildRoute/tns49:answerGenerator/tns49:warning&quot;/>&lt;/tns51:warning>&lt;/xsl:if>&lt;xsl:if test=&quot;$BuildRoute/tns49:answerGenerator/tns49:confidence&quot;>&lt;tns51:confidence>&lt;xsl:value-of select=&quot;$BuildRoute/tns49:answerGenerator/tns49:confidence&quot;/>&lt;/tns51:confidence>&lt;/xsl:if>&lt;xsl:if test=&quot;$BuildRoute/tns49:answerGenerator/tns49:approvalStatus&quot;>&lt;tns51:approvalStatus>&lt;xsl:value-of select=&quot;$BuildRoute/tns49:answerGenerator/tns49:approvalStatus&quot;/>&lt;/tns51:approvalStatus>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$BuildRoute/tns49:answerGenerator/tns49:citedToolCalls&quot;>&lt;tns51:citedToolCalls>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns51:citedToolCalls>&lt;/xsl:for-each>&lt;/tns51:answerGenerator>&lt;xsl:if test=&quot;$RAGResponse/tns41:citations/tns41:id&quot;>&lt;tns51:citationIds>&lt;xsl:value-of select=&quot;$RAGResponse/tns41:citations/tns41:id&quot;/>&lt;/tns51:citationIds>&lt;/xsl:if>&lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:toolCalls/tns31:name&quot;>&lt;tns51:citedToolCalls>&lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:toolCalls/tns31:name&quot;/>&lt;/tns51:citedToolCalls>&lt;/xsl:if>&lt;tns51:notes>&lt;xsl:value-of select=&quot;&amp;quot;Generated by BW6 deterministic answer builder.&amp;quot;&quot;/>&lt;/tns51:notes>&lt;/tns51:StepsSchemaElement>&lt;/tns51:StepsSchemaElementArray>&lt;/xsl:template>&lt;/xsl:stylesheet>"
