                                    <bpws:sources>
                                    <bpws:source linkName="ApprovalMapperToRenderJSON1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://tns.tibco.com/bw/json/1778612190510&quot; xmlns:tns31=&quot;http://tns.tibco.com/bw/json/1778614722332&quot; xmlns:tns27=&quot;/T1778595978941Converted/JsonSchema&quot; xmlns:tns28=&quot;/T1778596135500Converted/JsonSchema&quot; xmlns:tns29=&quot;/T1778596217369Converted/JsonSchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns23=&quot;http://tns.tibco.com/bw/json/1778562475043&quot; xmlns:tns55=&quot;/T1779422021916Converted/JsonSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;mcp_tools_call.item&quot;/>&#xa;    &lt;xsl:param name=&quot;ToolCallsMapperFull&quot;/>&#xa;    &lt;xsl:param name=&quot;Planner&quot;/>&#xa;    &lt;xsl:template name=&quot;ApprovalMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($ToolCallsMapperFull/tns31:approvalActions) = 0&quot;>&#xa;                &lt;tns26:PendingApprovalSchemaElement/>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ToolCallsMapperFull/tns31:approvalActions[tns31:toolName = &amp;quot;reserve_inventory&amp;quot;]&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$mcp_tools_call.item[tns55:toolName = &amp;quot;check_inventory&amp;quot;]/tns55:result/tns55:quantity > 0&quot;>&#xa;                                &lt;tns26:PendingApprovalSchemaElement>&#xa;                                    &lt;tns26:pendingApproval>&#xa;                                        &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;>&#xa;                                            &lt;tns26:toolName>&#xa;                                                &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;/>&#xa;                                            &lt;/tns26:toolName>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;tns26:arguments>&#xa;                                            &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:sku&quot;>&#xa;                                                &lt;tns26:sku>&#xa;                                                    &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:sku&quot;/>&#xa;                                                &lt;/tns26:sku>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:storeId&quot;>&#xa;                                                &lt;tns26:storeId>&#xa;                                                    &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:storeId&quot;/>&#xa;                                                &lt;/tns26:storeId>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:customerId&quot;>&#xa;                                                &lt;tns26:customerId>&#xa;                                                    &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:customerId&quot;/>&#xa;                                                &lt;/tns26:customerId>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/tns26:arguments>&#xa;                                        &lt;tns26:summary>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Approval required to reserve &amp;quot;, $mcp_tools_call.item[tns55:toolName = &amp;quot;check_inventory&amp;quot;]/tns55:result/tns55:productName, &amp;quot; at &amp;quot; , $ToolCallsMapperFull/tns31:approvalActions[1]/tns31:storeId, &amp;quot; for &amp;quot; , $ToolCallsMapperFull/tns31:approvalActions[1]/tns31:customerId, &amp;quot; .&amp;quot;)&quot;/>&#xa;                                        &lt;/tns26:summary>&#xa;                                        &lt;tns26:status>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;pending&amp;quot;&quot;/>&#xa;                                        &lt;/tns26:status>&#xa;                                    &lt;/tns26:pendingApproval>&#xa;                                &lt;/tns26:PendingApprovalSchemaElement>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns26:PendingApprovalSchemaElement>&#xa;                                    &lt;tns26:approvalBlocked>&#xa;                                        &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;>&#xa;                                            &lt;tns26:toolName>&#xa;                                                &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;/>&#xa;                                            &lt;/tns26:toolName>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;tns26:reason>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;The item is not available to reserve at this store.&amp;quot;&quot;/>&#xa;                                        &lt;/tns26:reason>&#xa;                                    &lt;/tns26:approvalBlocked>&#xa;                                &lt;/tns26:PendingApprovalSchemaElement>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$ToolCallsMapperFull/tns31:approvalActions[tns31:toolName = &amp;quot;create_return_authorization&amp;quot;]&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$mcp_tools_call.item[tns55:toolName = &amp;quot;check_return_eligibility&amp;quot;]/tns55:result/tns55:eligible = true()&quot;>&#xa;                                &lt;tns26:PendingApprovalSchemaElement>&#xa;                                    &lt;tns26:pendingApproval>&#xa;                                        &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;>&#xa;                                            &lt;tns26:toolName>&#xa;                                                &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;/>&#xa;                                            &lt;/tns26:toolName>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;tns26:arguments>&#xa;                                            &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:orderId&quot;>&#xa;                                                &lt;tns26:orderId>&#xa;                                                    &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:orderId&quot;/>&#xa;                                                &lt;/tns26:orderId>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/tns26:arguments>&#xa;                                        &lt;tns26:summary>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Approval required to create a return authorization &amp;quot;, $mcp_tools_call.item[tns55:toolName = &amp;quot;check_return_eligbility&amp;quot;]/tns55:result/tns55:productName , &amp;quot; at &amp;quot; , $ToolCallsMapperFull/tns31:approvalActions[1]/tns31:storeId, &amp;quot; from &amp;quot; , $ToolCallsMapperFull/tns31:approvalActions[1]/tns31:orderId, &amp;quot; .&amp;quot;)&quot;/>&#xa;                                        &lt;/tns26:summary>&#xa;                                        &lt;tns26:status>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;pending&amp;quot;&quot;/>&#xa;                                        &lt;/tns26:status>&#xa;                                    &lt;/tns26:pendingApproval>&#xa;                                &lt;/tns26:PendingApprovalSchemaElement>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns26:PendingApprovalSchemaElement>&#xa;                                    &lt;tns26:approvalBlocked>&#xa;                                        &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;>&#xa;                                            &lt;tns26:toolName>&#xa;                                                &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;/>&#xa;                                            &lt;/tns26:toolName>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($mcp_tools_call.item[tns55:toolName = &amp;quot;check_return_eligbility&amp;quot;]/tns55:result/tns55:reason) > 0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$mcp_tools_call.item[tns55:toolName = &amp;quot;check_return_eligbility&amp;quot;]/tns55:result/tns55:reason&quot;>&#xa;                                                    &lt;tns26:reason>&#xa;                                                        &lt;xsl:value-of select=&quot;$mcp_tools_call.item[tns55:toolName = &amp;quot;check_return_eligbility&amp;quot;]/tns55:result/tns55:reason&quot;/>&#xa;                                                    &lt;/tns26:reason>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns26:reason>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;The order is not eligible for return.&amp;quot;&quot;/>&#xa;                                                &lt;/tns26:reason>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/tns26:approvalBlocked>&#xa;                                &lt;/tns26:PendingApprovalSchemaElement>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$ToolCallsMapperFull/tns31:approvalActions[tns31:toolName = &amp;quot;apply_promotion&amp;quot;]&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($ToolCallsMapperFull/tns31:approvalActions[1]/tns31:sku) = 0 and string-length($Planner/tns23:entities/tns23:sku) = 0&quot;>&#xa;                                &lt;tns26:PendingApprovalSchemaElement>&#xa;                                    &lt;tns26:approvalBlocked>&#xa;                                        &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;>&#xa;                                            &lt;tns26:toolName>&#xa;                                                &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;/>&#xa;                                            &lt;/tns26:toolName>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;tns26:reason>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;No product SKU was selected for promotion application.&amp;quot;&quot;/>&#xa;                                        &lt;/tns26:reason>&#xa;                                    &lt;/tns26:approvalBlocked>&#xa;                                &lt;/tns26:PendingApprovalSchemaElement>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;count($mcp_tools_call.item[tns55:toolName = &amp;quot;find_promotions&amp;quot;]/tns55:result/tns55:promotions) = 0&quot;>&#xa;                                &lt;tns26:PendingApprovalSchemaElement>&#xa;                                    &lt;tns26:approvalBlocked>&#xa;                                        &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;>&#xa;                                            &lt;tns26:toolName>&#xa;                                                &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;/>&#xa;                                            &lt;/tns26:toolName>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;tns26:reason>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;No eligible promotion was found.&amp;quot;&quot;/>&#xa;                                        &lt;/tns26:reason>&#xa;                                    &lt;/tns26:approvalBlocked>&#xa;                                &lt;/tns26:PendingApprovalSchemaElement>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns26:PendingApprovalSchemaElement>&#xa;                                    &lt;tns26:pendingApproval>&#xa;                                        &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;>&#xa;                                            &lt;tns26:toolName>&#xa;                                                &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:toolName&quot;/>&#xa;                                            &lt;/tns26:toolName>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;tns26:arguments>&#xa;                                            &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:sku&quot;>&#xa;                                                &lt;tns26:sku>&#xa;                                                    &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:sku&quot;/>&#xa;                                                &lt;/tns26:sku>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:customerId&quot;>&#xa;                                                &lt;tns26:customerId>&#xa;                                                    &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:customerId&quot;/>&#xa;                                                &lt;/tns26:customerId>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($ToolCallsMapperFull/tns31:approvalActions[1]/tns31:promotionId) > 0&quot;>&#xa;                                                    &lt;xsl:if test=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:promotionId&quot;>&#xa;                                                        &lt;tns26:promotionId>&#xa;                                                            &lt;xsl:value-of select=&quot;$ToolCallsMapperFull/tns31:approvalActions[1]/tns31:promotionId&quot;/>&#xa;                                                        &lt;/tns26:promotionId>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;xsl:if test=&quot;$mcp_tools_call.item[tns55:toolName = &amp;quot;find_promotions&amp;quot;]/tns55:result/tns55:promotions[1]/tns55:id&quot;>&#xa;                                                        &lt;tns26:promotionId>&#xa;                                                            &lt;xsl:value-of select=&quot;$mcp_tools_call.item[tns55:toolName = &amp;quot;find_promotions&amp;quot;]/tns55:result/tns55:promotions[1]/tns55:id&quot;/>&#xa;                                                        &lt;/tns26:promotionId>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/tns26:arguments>&#xa;                                        &lt;tns26:summary>&#xa;                                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Approval required to apply &amp;quot; , xsd:string($mcp_tools_call.item[tns55:toolName = &amp;quot;find_promotions&amp;quot;]/tns55:result/tns55:promotions[1]/tns55:discountPercent) , &amp;quot;% off to &amp;quot; , $ToolCallsMapperFull/tns31:approvalActions[1]/tns31:sku, &amp;quot;.&amp;quot;)&quot;/>&#xa;                                        &lt;/tns26:summary>&#xa;                                        &lt;tns26:status>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;pending&amp;quot;&quot;/>&#xa;                                        &lt;/tns26:status>&#xa;                                    &lt;/tns26:pendingApproval>&#xa;                                &lt;/tns26:PendingApprovalSchemaElement>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
