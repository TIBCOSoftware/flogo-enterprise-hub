                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns23=&quot;activity.jsonParser.input+fc6b04d9-c67a-4fec-b026-38f3c1b36a1e+ActivityInputType&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;ParseJSON-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns23:ActivityInputClass>&#xa;            &lt;jsonString>&#xa;                &lt;xsl:value-of select=&quot;'[&amp;#xA;  {&amp;#xA;    &amp;quot;id&amp;quot;: &amp;quot;policy-returns-general&amp;quot;,&amp;#xA;    &amp;quot;title&amp;quot;: &amp;quot;General Return Policy&amp;quot;,&amp;#xA;    &amp;quot;documentType&amp;quot;: &amp;quot;policy&amp;quot;,&amp;#xA;    &amp;quot;body&amp;quot;: &amp;quot;Most footwear, apparel, bags, fitness, and accessories can be returned within 30 days of purchase when the item is clean, undamaged, and includes proof of purchase. Outerwear has an extended 45 day return window. Final sale items cannot be returned. Gold and Platinum loyalty members receive free return shipping.&amp;quot;&amp;#xA;  },&amp;#xA;  {&amp;#xA;    &amp;quot;id&amp;quot;: &amp;quot;policy-electronics-returns&amp;quot;,&amp;#xA;    &amp;quot;title&amp;quot;: &amp;quot;Electronics Return Policy&amp;quot;,&amp;#xA;    &amp;quot;documentType&amp;quot;: &amp;quot;policy&amp;quot;,&amp;#xA;    &amp;quot;body&amp;quot;: &amp;quot;Electronics including sport watches and wireless earbuds can be returned within 14 days of purchase. The item must include the charging cable, case, manuals, and original packaging. Open-box electronics may be subject to inspection before a refund is issued.&amp;quot;&amp;#xA;  },&amp;#xA;  {&amp;#xA;    &amp;quot;id&amp;quot;: &amp;quot;policy-warranty&amp;quot;,&amp;#xA;    &amp;quot;title&amp;quot;: &amp;quot;Warranty Policy&amp;quot;,&amp;#xA;    &amp;quot;documentType&amp;quot;: &amp;quot;policy&amp;quot;,&amp;#xA;    &amp;quot;body&amp;quot;: &amp;quot;Warranty coverage applies to manufacturing defects and does not cover normal wear, misuse, cosmetic damage, or accidental damage. Bags include a 24 month warranty. Outerwear and electronics include a 12 month warranty. Footwear and bottles include a 6 month warranty. Fitness mats include a 3 month warranty.&amp;quot;&amp;#xA;  },&amp;#xA;  {&amp;#xA;    &amp;quot;id&amp;quot;: &amp;quot;faq-inventory&amp;quot;,&amp;#xA;    &amp;quot;title&amp;quot;: &amp;quot;Inventory and Pickup FAQ&amp;quot;,&amp;#xA;    &amp;quot;documentType&amp;quot;: &amp;quot;faq&amp;quot;,&amp;#xA;    &amp;quot;body&amp;quot;: &amp;quot;In-stock items can usually be reserved for same-day store pickup. Low-stock items may require associate confirmation before reservation. Out-of-stock items can be shipped from another store when network inventory is available. Store locations are SFO-001 in San Francisco, OAK-002 in Oakland, and SJC-003 in San Jose.&amp;quot;&amp;#xA;  },&amp;#xA;  {&amp;#xA;    &amp;quot;id&amp;quot;: &amp;quot;promo-spring&amp;quot;,&amp;#xA;    &amp;quot;title&amp;quot;: &amp;quot;Spring Trail Promotion&amp;quot;,&amp;#xA;    &amp;quot;documentType&amp;quot;: &amp;quot;promotion&amp;quot;,&amp;#xA;    &amp;quot;body&amp;quot;: &amp;quot;Through May 31 2026, loyalty members receive 10 percent off trail running shoes, rain jackets, water bottles, and daypacks. Platinum members receive 15 percent off qualifying items. Electronics are excluded from the Spring Trail Promotion.&amp;quot;&amp;#xA;  }&amp;#xA;]'&quot;/>&#xa;            &lt;/jsonString>&#xa;        &lt;/tns23:ActivityInputClass>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
