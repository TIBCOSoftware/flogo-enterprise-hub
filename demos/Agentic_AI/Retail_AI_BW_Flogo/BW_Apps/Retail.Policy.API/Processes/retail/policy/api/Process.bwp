                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Query-input"
                                    name="Query" outputVariable="Query"
                                    tibex:xpdlId="9400b33d-312b-46ca-82a6-806346b02c08" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="NormalizePolicyQueryRequestToQueryTechPreview"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="QueryToBuildRetrieval"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns21=&quot;http://www.tibco.com/RAG/query&quot; xmlns:tns20=&quot;http://www.example.org/NormalizedQuery&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NormalizePolicyQueryRequest&quot;/>&lt;xsl:template name=&quot;QueryTechPreview-input&quot; match=&quot;/&quot;>&lt;tns21:queryInput>&lt;question>&lt;xsl:value-of select=&quot;$NormalizePolicyQueryRequest/tns20:question&quot;/>&lt;/question>&lt;systemPrompt>&lt;xsl:value-of select=&quot;&amp;quot;You are a retail policy retrieval assistant. Answer only from the retrieved retail knowledge. Prefer concise answers. Include policy-specific details such as return window, conditions, exclusions, and loyalty benefits when available. If the retrieved knowledge does not answer the question, say that no matching policy information was found.&amp;quot;&quot;/>&lt;/systemPrompt>&lt;maxResult>&lt;xsl:value-of select=&quot;5&quot;/>&lt;/maxResult>&lt;minScore>&lt;xsl:value-of select=&quot;0.0&quot;/>&lt;/minScore>&lt;/tns21:queryInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.rag.query"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:rag="http://ns.tibco.com/bw/palette/rag" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/rag#//Query"/>
                                    <value
                                    ragConnection="ragConnectorResource" xsi:type="rag:Query"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="BuildRetrieval-input"
                                    name="BuildRetrieval"
                                    outputVariable="BuildRetrieval"
                                    tibex:xpdlId="7af5abc5-8b55-4a3b-b14e-4fa723accc47" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="QueryToBuildRetrieval"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="BuildRetrievalToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns22=&quot;http://tns.tibco.com/bw/json/1779331907656&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Query&quot;/>&lt;xsl:template name=&quot;BuildRetrieval-input&quot; match=&quot;/&quot;>&lt;tns22:QueryResponseElement>&lt;xsl:for-each select=&quot;$Query/selectedEmbeddings&quot;>&lt;xsl:variable name=&quot;selectedText&quot; select=&quot;.&quot;/>&lt;xsl:variable name=&quot;title&quot; select=&quot;if(starts-with($selectedText, &amp;quot;#&amp;quot;)) then substring-after($selectedText, &amp;quot;#&amp;quot;) else if(contains($selectedText, &amp;quot;Electronics including&amp;quot;)) then &amp;quot;Electronics Return Policy&amp;quot; else if(contains($selectedText, &amp;quot;Most footwear&amp;quot;)) then &amp;quot;General Return Policy&amp;quot; else if(contains($selectedText, &amp;quot;Warranty coverage&amp;quot;)) then &amp;quot;Warranty Policy&amp;quot; else if(contains($selectedText, &amp;quot;In-stock items&amp;quot;)) then &amp;quot;Inventory and Pickup FAQ&amp;quot; else if(contains($selectedText, &amp;quot;Spring Trail Promotion&amp;quot;)) then &amp;quot;Spring Trail Promotion&amp;quot; else &amp;quot;Retrieved policy source&amp;quot;&quot;/>&lt;xsl:variable name=&quot;index&quot; select=&quot;position()&quot;/>&lt;xsl:variable name=&quot;documentId&quot; select=&quot;if($title = &amp;quot;Electronics Return Policy&amp;quot;) then &amp;quot;policy-electronics-returns&amp;quot; else if($title = &amp;quot;General Return Policy&amp;quot;) then &amp;quot;policy-returns-general&amp;quot; else if($title = &amp;quot;Warranty Policy&amp;quot;) then &amp;quot;policy-warranty&amp;quot; else if($title = &amp;quot;Inventory and Pickup FAQ&amp;quot;) then &amp;quot;faq-inventory&amp;quot; else if($title = &amp;quot;Spring Trail Promotion&amp;quot;) then &amp;quot;promo-spring&amp;quot; else concat(&amp;quot;rag-selected-&amp;quot;,tib:pad-front(xsd:string($index), 3, xsd:string(0)))&quot;/>&lt;xsl:variable name=&quot;documentType&quot; select=&quot;if(contains($title, &amp;quot;FAQ&amp;quot;)) then &amp;quot;faq&amp;quot; else if(contains($title, &amp;quot;Promotion&amp;quot;)) then &amp;quot;promotion&amp;quot; else if(starts-with($selectedText, &amp;quot;#&amp;quot;)) then &amp;quot;document&amp;quot; else &amp;quot;policy&amp;quot;&quot;/>&lt;xsl:variable name=&quot;category&quot; select=&quot;if(contains($selectedText, &amp;quot;return&amp;quot;) or contains($selectedText, &amp;quot;refund&amp;quot;)) then &amp;quot;returns&amp;quot; else if(contains($selectedText, &amp;quot;warranty&amp;quot;)) then &amp;quot;warranty&amp;quot; else if(contains($selectedText, &amp;quot;inventory&amp;quot;) or contains($selectedText, &amp;quot;pickup&amp;quot;) or contains($selectedText, &amp;quot;stock&amp;quot;)) then &amp;quot;inventory&amp;quot; else if(contains($selectedText, &amp;quot;promotion&amp;quot;) or contains($selectedText, &amp;quot;discount&amp;quot;)) then &amp;quot;promotions&amp;quot; else &amp;quot;knowledge&amp;quot;&quot;/>&lt;tns22:retrieval>&lt;tns22:chunkId>&lt;xsl:value-of select=&quot;concat(&amp;quot;rag-selected-&amp;quot;, tib:pad-front(xsd:string($index), 3, xsd:string(0)))&quot;/>&lt;/tns22:chunkId>&lt;tns22:documentId>&lt;xsl:value-of select=&quot;$documentId&quot;/>&lt;/tns22:documentId>&lt;tns22:title>&lt;xsl:value-of select=&quot;$title&quot;/>&lt;/tns22:title>&lt;tns22:documentType>&lt;xsl:value-of select=&quot;$documentType&quot;/>&lt;/tns22:documentType>&lt;tns22:category>&lt;xsl:value-of select=&quot;$category&quot;/>&lt;/tns22:category>&lt;tns22:score>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns22:score>&lt;tns22:text>&lt;xsl:value-of select=&quot;$selectedText&quot;/>&lt;/tns22:text>&lt;xsl:choose>&lt;xsl:when test=&quot;$documentId != &amp;quot;unknown&amp;quot;&quot;>&lt;tns22:uri>&lt;xsl:value-of select=&quot;concat(&amp;quot;policy://&amp;quot;,$documentId)&quot;/>&lt;/tns22:uri>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns22:uri>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns22:uri>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns22:retrieval>&lt;/xsl:for-each>&lt;/tns22:QueryResponseElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:json_1779331907656="http://tns.tibco.com/bw/json/1779331907656" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="json_1779331907656:QueryResponseElement" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="BuildCitations-input"
                                    name="BuildCitations"
                                    outputVariable="BuildCitations"
                                    tibex:xpdlId="2973da78-12df-4ba3-a37c-723250db1f3b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="BuildRetrievalToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="BuildCitationsTopostOut2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns22=&quot;http://tns.tibco.com/bw/json/1779331907656&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;BuildRetrieval&quot;/>&lt;xsl:template name=&quot;BuildCitations-input&quot; match=&quot;/&quot;>&lt;tns22:QueryResponseElement>&lt;xsl:for-each select=&quot;$BuildRetrieval/tns22:retrieval&quot;>&lt;tns22:citations>&lt;xsl:if test=&quot;tns22:chunkId&quot;>&lt;tns22:id>&lt;xsl:value-of select=&quot;tns22:chunkId&quot;/>&lt;/tns22:id>&lt;/xsl:if>&lt;xsl:if test=&quot;tns22:title&quot;>&lt;tns22:title>&lt;xsl:value-of select=&quot;tns22:title&quot;/>&lt;/tns22:title>&lt;/xsl:if>&lt;xsl:if test=&quot;tns22:documentType&quot;>&lt;tns22:documentType>&lt;xsl:value-of select=&quot;tns22:documentType&quot;/>&lt;/tns22:documentType>&lt;/xsl:if>&lt;xsl:if test=&quot;tns22:uri&quot;>&lt;tns22:uri>&lt;xsl:value-of select=&quot;tns22:uri&quot;/>&lt;/tns22:uri>&lt;/xsl:if>&lt;/tns22:citations>&lt;/xsl:for-each>&lt;/tns22:QueryResponseElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:json_1779331907656="http://tns.tibco.com/bw/json/1779331907656" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="json_1779331907656:QueryResponseElement" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
