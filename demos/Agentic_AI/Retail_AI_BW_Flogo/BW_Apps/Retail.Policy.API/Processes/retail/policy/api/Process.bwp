                                        &lt;tns2:title&gt;
                                            &lt;xsl:value-of select="tns6:title"/&gt;
                                        &lt;/tns2:title&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns2:description&gt;
                                        &lt;xsl:value-of select="''"/&gt;
