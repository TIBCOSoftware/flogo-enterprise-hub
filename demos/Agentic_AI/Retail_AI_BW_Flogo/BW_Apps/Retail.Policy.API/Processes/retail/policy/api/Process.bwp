                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xmlns.example.com/20260510155639PLT&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/json/1778541051064&quot; xmlns:tns3=&quot;http://xmlns.example.com/Policy/parameters&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/json/1778541685476&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseJSON1&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut1-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$ParseJSON1/tns6:PolicySchemaElement[tns6:id = $get1.parameters/tns3:id]&quot;>&#xa;            &lt;tns4:GetPolicyIDResponseElement>&#xa;                &lt;tns4:uri>&#xa;                    &lt;xsl:value-of select=&quot;concat('retail://',tns6:documentType,'/',tns6:id)&quot;/>&#xa;                &lt;/tns4:uri>&#xa;                &lt;tns4:name>&#xa;                    &lt;xsl:value-of select=&quot;$get1.parameters/tns3:id&quot;/>&#xa;                &lt;/tns4:name>&#xa;                &lt;xsl:if test=&quot;tns6:title&quot;>&#xa;                    &lt;tns4:title>&#xa;                        &lt;xsl:value-of select=&quot;tns6:title&quot;/>&#xa;                    &lt;/tns4:title>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:description>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                &lt;/tns4:description>&#xa;                &lt;tns4:mimeType>&#xa;                    &lt;xsl:value-of select=&quot;'text/plain'&quot;/>&#xa;                &lt;/tns4:mimeType>&#xa;                &lt;xsl:if test=&quot;tns6:body&quot;>&#xa;                    &lt;tns4:text>&#xa;                        &lt;xsl:value-of select=&quot;tns6:body&quot;/>&#xa;                    &lt;/tns4:text>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns4:GetPolicyIDResponseElement>&#xa;        &lt;/xsl:for-each>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://xmlns.example.com/20260510155639PLT" xmlns:tns4="http://tns.tibco.com/bw/json/1778541051064" xmlns:tns3="http://xmlns.example.com/Policy/parameters" xmlns:tns6="http://tns.tibco.com/bw/json/1778541685476" version="2.0"&gt;&lt;xsl:param name="get1"/&gt;&lt;xsl:param name="ParseJSON1"/&gt;&lt;xsl:template name="getOut1-input" match="/"&gt;&lt;tns1:getResponse1&gt;&lt;item&gt;&lt;xsl:for-each select="$ParseJSON1/tns6:PolicySchemaElement[tns6:id = $get1/parameters/tns3:api-policy-resources1GetParameters/tns3:id]"&gt;&lt;tns4:GetPolicyIDResponseElement&gt;&lt;tns4:uri&gt;&lt;xsl:value-of select="concat('retail://',tns6:documentType,'/',tns6:id)"/&gt;&lt;/tns4:uri&gt;&lt;tns4:name&gt;&lt;xsl:value-of select="$get1/parameters/tns3:api-policy-resources1GetParameters/tns3:id"/&gt;&lt;/tns4:name&gt;&lt;xsl:if test="tns6:title"&gt;&lt;tns4:title&gt;&lt;xsl:value-of select="tns6:title"/&gt;&lt;/tns4:title&gt;&lt;/xsl:if&gt;&lt;tns4:description&gt;&lt;xsl:value-of select="&amp;quot;&amp;quot;"/&gt;&lt;/tns4:description&gt;&lt;tns4:mimeType&gt;&lt;xsl:value-of select="'text/plain'"/&gt;&lt;/tns4:mimeType&gt;&lt;xsl:if test="tns6:body"&gt;&lt;tns4:text&gt;&lt;xsl:value-of select="tns6:body"/&gt;&lt;/tns4:text&gt;&lt;/xsl:if&gt;&lt;/tns4:GetPolicyIDResponseElement&gt;&lt;/xsl:for-each&gt;&lt;/item&gt;&lt;/tns1:getResponse1&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
