                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns20=&quot;http://www.example.org/NormalizedQuery&quot; xmlns:tns19=&quot;http://tns.tibco.com/bw/json/1779331872166&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParsePolicyQueryRequest&quot;/>&lt;xsl:template name=&quot;NormalizePolicyQueryRequest-input&quot; match=&quot;/&quot;>&lt;tns20:NormalizePolicyQuery>&lt;xsl:if test=&quot;$ParsePolicyQueryRequest/tns19:question&quot;>&lt;tns20:question>&lt;xsl:value-of select=&quot;$ParsePolicyQueryRequest/tns19:question&quot;/>&lt;/tns20:question>&lt;/xsl:if>&lt;tns20:topK>&lt;xsl:value-of select=&quot;5&quot;/>&lt;/tns20:topK>&lt;tns20:minScore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns20:minScore>&lt;xsl:for-each select=&quot;$ParsePolicyQueryRequest/tns19:filters/tns19:documentTypes&quot;>&lt;tns20:documentTypes>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns20:documentTypes>&lt;/xsl:for-each>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($ParsePolicyQueryRequest/tns19:question, &amp;quot;return&amp;quot;) or contains($ParsePolicyQueryRequest/tns19:question, &amp;quot;refund&amp;quot;)&quot;>&lt;tns20:category>&lt;xsl:value-of select=&quot;&amp;quot;returns&amp;quot;&quot;/>&lt;/tns20:category>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($ParsePolicyQueryRequest/tns19:question, &amp;quot;return&amp;quot;) or contains($ParsePolicyQueryRequest/tns19:question, &amp;quot;refund&amp;quot;)&quot;>&lt;tns20:category>&lt;xsl:value-of select=&quot;&amp;quot;warranty&amp;quot;&quot;/>&lt;/tns20:category>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($ParsePolicyQueryRequest/tns19:question, &amp;quot;inventory&amp;quot;) or contains($ParsePolicyQueryRequest/tns19:question, &amp;quot;pickup&amp;quot;)  or contains($ParsePolicyQueryRequest/tns19:question, &amp;quot;stock&amp;quot;)&quot;>&lt;tns20:category>&lt;xsl:value-of select=&quot;&amp;quot;inventory&amp;quot;&quot;/>&lt;/tns20:category>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($ParsePolicyQueryRequest/tns19:question, &amp;quot;promotion&amp;quot;) or contains($ParsePolicyQueryRequest/tns19:question, &amp;quot;promo&amp;quot;) or contains($ParsePolicyQueryRequest/tns19:question, &amp;quot;discount&amp;quot;) or contains($ParsePolicyQueryRequest/tns19:question, &amp;quot;coupon&amp;quot;)&quot;>&lt;tns20:category>&lt;xsl:value-of select=&quot;&amp;quot;promotions&amp;quot;&quot;/>&lt;/tns20:category>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns20:category>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns20:category>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns20:NormalizePolicyQuery>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:NormalizedQuery="http://www.example.org/NormalizedQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="NormalizedQuery:NormalizePolicyQuery" xsi:type="generalactivities:Mapper"/>
