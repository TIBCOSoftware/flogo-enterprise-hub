                                        &lt;xsl:value-of select="'text/plain'"/&gt;
                                    &lt;/tns2:mimeType&gt;
                                &lt;/tns2:resources&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:for-each select="$ParseJSON/tns6:PolicySchemaElement"&gt;
                                &lt;tns2:resources&gt;
                                    &lt;tns2:uri&gt;
