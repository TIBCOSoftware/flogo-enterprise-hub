                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($get/parameters/tns3:api-policy-resourcesGetParameters/tns3:type) and string-length($get/parameters/tns3:api-policy-resourcesGetParameters/tns3:type) &gt; 0"&gt;
