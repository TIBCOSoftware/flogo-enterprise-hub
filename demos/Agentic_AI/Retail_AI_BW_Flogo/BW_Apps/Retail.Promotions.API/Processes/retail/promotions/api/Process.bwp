                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xmlns.example.com/20260510155622PLT&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/json/1778539007138&quot; xmlns:tns5=&quot;http://tns.tibco.com/bw/json/1778536925151&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/json/1778538981056&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:PostPromotionApplyResponseElement>&#xa;            &lt;tns6:approvalRequired>&#xa;                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;            &lt;/tns6:approvalRequired>&#xa;            &lt;tns6:tool>&#xa;                &lt;xsl:value-of select=&quot;'apply_promotion'&quot;/>&#xa;            &lt;/tns6:tool>&#xa;            &lt;tns6:arguments>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:customerId&quot;>&#xa;                    &lt;tns6:customerId>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:customerId&quot;/>&#xa;                    &lt;/tns6:customerId>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:promotionId>&#xa;                    &lt;xsl:value-of select=&quot;'promo-spring-trail'&quot;/>&#xa;                &lt;/tns6:promotionId>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:sku&quot;>&#xa;                    &lt;tns6:sku>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:sku&quot;/>&#xa;                    &lt;/tns6:sku>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns6:arguments>&#xa;            &lt;tns6:message>&#xa;                &lt;xsl:value-of select=&quot;'This operation changes retail state and must be approved through the agent approval flow.'&quot;/>&#xa;            &lt;/tns6:message>&#xa;        &lt;/tns6:PostPromotionApplyResponseElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
