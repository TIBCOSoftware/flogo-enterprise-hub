            </plnk:partnerLinkType>
            <wsdl:import namespace="http://tns.tibco.com/bw/json/1778538943845"/>
            <wsdl:import namespace="http://tns.tibco.com/bw/REST"/>
            <wsdl:import namespace="http://xmlns.example.com/promotions/parameters"/>
            <wsdl:import namespace="http://tns.tibco.com/bw/json/1778538981056"/>
            <wsdl:import namespace="http://tns.tibco.com/bw/json/1778539007138"/>
            <wsdl:message name="getRequest">
                <wsdl:part element="extns1:httpHeaders"
                    name="httpHeaders" tibex:source="bw.rest"/>
                <wsdl:part
                    element="extns2:api-promotionscustomerIdcustomerIdcategorycategoryGetParameters"
                    name="parameters" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="getResponse">
                <wsdl:part element="extns:GetPromotionsResponseElement"
                    name="item" tibex:hasMultipleNamespaces="false"/>
            </wsdl:message>
            <wsdl:message name="get4XXFaultMessage">
                <wsdl:part element="extns1:client4XXError" name="clientError"/>
            </wsdl:message>
            <wsdl:message name="get5XXFaultMessage">
                <wsdl:part element="extns1:server5XXError" name="serverError"/>
            </wsdl:message>
            <wsdl:message name="postRequest">
                <wsdl:part
                    element="extns3:PostPromotionApplyRequestElement"
                    name="item" tibex:hasMultipleNamespaces="false"/>
                <wsdl:part element="extns1:httpHeaders"
                    name="httpHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="postResponse">
                <wsdl:part
                    element="extns4:PostPromotionApplyResponseElement"
                    name="item" tibex:hasMultipleNamespaces="false"/>
            </wsdl:message>
            <wsdl:message name="post4XXFaultMessage">
                <wsdl:part element="extns1:client4XXError" name="clientError"/>
            </wsdl:message>
            <wsdl:message name="post5XXFaultMessage">
                <wsdl:part element="extns1:server5XXError" name="serverError"/>
            </wsdl:message>
            <wsdl:portType
                name="api-promotionscustomerIdcustomerIdcategorycategory"
                tibex:bw.rest.apipath="/api/promotions?customerId={customerId}&amp;category={category}"
                tibex:bw.rest.basepath="promotions"
                tibex:bw.rest.resource="Service Descriptors/retail.promotions.api.Process-promotions.json"
                tibex:bw.rest.resource.source="generated" tibex:source="bw.rest.service">
                <wsdl:documentation>promotions service</wsdl:documentation>
                <wsdl:operation name="get">
                    <wsdl:documentation>getPromotions</wsdl:documentation>
                    <wsdl:input message="tns:getRequest" name="getInput"/>
                    <wsdl:output message="tns:getResponse" name="getOutput"/>
                    <wsdl:fault message="tns:get4XXFaultMessage" name="clientFault"/>
                    <wsdl:fault message="tns:get5XXFaultMessage" name="serverFault"/>
                </wsdl:operation>
            </wsdl:portType>
            <wsdl:portType name="api-promotions-applications"
                tibex:bw.rest.apipath="/api/promotions/applications"
                tibex:bw.rest.basepath="promotions"
                tibex:bw.rest.resource="Service Descriptors/retail.promotions.api.Process-promotions.json"
                tibex:bw.rest.resource.source="generated" tibex:source="bw.rest.service">
                <wsdl:documentation>promotions service</wsdl:documentation>
                <wsdl:operation name="post">
                    <wsdl:documentation>postPromotions</wsdl:documentation>
                    <wsdl:input message="tns:postRequest" name="postInput"/>
                    <wsdl:output message="tns:postResponse" name="postOutput"/>
                    <wsdl:fault message="tns:post4XXFaultMessage" name="clientFault"/>
                    <wsdl:fault message="tns:post5XXFaultMessage" name="serverFault"/>
                </wsdl:operation>
            </wsdl:portType>
        </wsdl:definitions>
