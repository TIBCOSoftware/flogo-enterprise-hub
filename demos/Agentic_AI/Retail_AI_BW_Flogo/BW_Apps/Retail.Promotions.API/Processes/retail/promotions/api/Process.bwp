                <variable>get</variable>
                <variable>ParseCustomerJSON</variable>
            </endingVariables>
        </task>
        <task name="ParseCustomerJSON">
            <endingVariables>
                <variable>ParseCustomerJSON-input</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>post</variable>
            </endingVariables>
        </task>
