                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xmlns.example.com/20260510155622PLT&quot; xmlns:tns5=&quot;http://tns.tibco.com/bw/json/1778536925151&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/json/1778538943845&quot; xmlns:tns3=&quot;http://xmlns.example.com/promotions/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseCustomerJSON&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$ParseCustomerJSON/tns5:CustomersSchemaElement[tns5:customerId = $get.parameters/tns3:customerId][1]&quot;>&#xa;            &lt;tns2:GetPromotionsResponseElement>&#xa;                &lt;xsl:if test=&quot;tns5:customerId&quot;>&#xa;                    &lt;tns2:customerId>&#xa;                        &lt;xsl:value-of select=&quot;tns5:customerId&quot;/>&#xa;                    &lt;/tns2:customerId>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:category>&#xa;                    &lt;xsl:value-of select=&quot;$get.parameters/tns3:category&quot;/>&#xa;                &lt;/tns2:category>&#xa;                &lt;xsl:if test=&quot;tns5:loyaltyTier&quot;>&#xa;                    &lt;tns2:customerTier>&#xa;                        &lt;xsl:value-of select=&quot;tns5:loyaltyTier&quot;/>&#xa;                    &lt;/tns2:customerTier>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:promotions>&#xa;                    &lt;tns2:id>&#xa;                        &lt;xsl:value-of select=&quot;'promo-spring-trail'&quot;/>&#xa;                    &lt;/tns2:id>&#xa;                    &lt;tns2:name>&#xa;                        &lt;xsl:value-of select=&quot;'Spring Trail Promotion'&quot;/>&#xa;                    &lt;/tns2:name>&#xa;                    &lt