              "type": "string"
            },
            "example": "PH-001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PharmacyOrderUpdate"
              },
              "example": {
                "status": "ready",
                "quantity": 30
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pharmacy order updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PharmacyOrder"
                },
                "example": {
                  "id": "PH-001",
                  "patientId": "P-2024-001",
                  "medication": "Aspirin",
                  "quantity": 30,
                  "status": "ready"
                }
              }
            }
          }
        }
      }
    },
    "/registration": {
      "get": {
        "summary": "Get all registered patients",
        "description": "Retrieves a list of all registered patients in the system",
