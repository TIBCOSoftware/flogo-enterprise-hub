  "components": {
    "schemas": {
      "Appointment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "APT-001"
          },
          "patientId": {
            "type": "string",
            "example": "P-2024-001"
          },
          "doctorId": {
            "type": "string",
            "example": "DOC-101"
          },
          "dateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-20T10:00:00Z"
          },
          "status": {
            "type": "string",
            "enum": ["scheduled", "confirmed", "completed", "cancelled"],
            "example": "scheduled"
          }
        },
        "required": ["id", "patientId", "doctorId", "dateTime", "status"]
      },
      "AppointmentRequest": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "example": "P-2024-001"
          },
          "doctorId": {
            "type": "string",
            "example": "DOC-101"
          },
          "dateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-20T10:00:00Z"
          },
          "reason": {
            "type": "string",
            "example": "Routine checkup"
          }
        },
        "required": ["patientId", "doctorId", "dateTime"]
      },
      "AppointmentUpdate": {
        "type": "object",
        "properties": {
          "dateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-20T14:00:00Z"
          },
          "status": {
            "type": "string",
            "enum": ["scheduled", "confirmed", "completed", "cancelled"],
            "example": "confirmed"
          }
        }
      },
      "PharmacyOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "PH-001"
          },
          "patientId": {
            "type": "string",
            "example": "P-2024-001"
          },
          "medication": {
            "type": "string",
            "example": "Aspirin"
          },
          "quantity": {
            "type": "integer",
            "example": 30
          },
          "status": {
            "type": "string",
            "enum": ["processing", "ready", "dispensed", "cancelled"],
            "example": "processing"
          }
        },
        "required": ["id", "patientId", "medication", "quantity", "status"]
      },
      "PharmacyOrderRequest": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "example": "P-2024-001"
          },
          "medication": {
            "type": "string",
            "example": "Aspirin"
          },
          "quantity": {
            "type": "integer",
            "example": 30
          },
          "dosage": {
            "type": "string",
            "example": "100mg"
          }
        },
        "required": ["patientId", "medication", "quantity"]
      },
      "PharmacyOrderUpdate": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["processing", "ready", "dispensed", "cancelled"],
            "example": "ready"
          },
          "quantity": {
            "type": "integer",
            "example": 30
          }
        }
      },
      "Registration": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "P-2024-001"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+1234567890"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "1980-05-15"
          }
        },
        "required": ["id", "name", "email", "phone", "dateOfBirth"]
      },
      "RegistrationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+1234567890"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "1980-05-15"
          }
        },
        "required": ["name", "email", "phone", "dateOfBirth"]
      },
      "RegistrationUpdate": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe.new@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+1234567891"
          }
        }
      },
      "Billing": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "BIL-001"
          },
          "patientId": {
            "type": "string",
            "example": "P-2024-001"
          },
          "amount": {
            "type": "number",
            "format": "float",
            "example": 1500.00
          },
          "status": {
            "type": "string",
            "enum": ["pending", "paid", "overdue", "cancelled"],
