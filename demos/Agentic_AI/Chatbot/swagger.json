{
  "openapi": "3.0.0",
  "info": {
    "title": "Hospital Management API",
    "version": "1.0.0",
    "description": "REST API for hospital operations including appointments, pharmacy orders, patient registration, and billing"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/appointments": {
      "get": {
        "summary": "Get all appointments",
        "description": "Retrieves a list of all appointments in the system",
        "operationId": "getAppointments",
        "tags": ["Appointments"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Appointment"
                  }
                },
                "example": [
                  {
                    "id": "APT-001",
                    "patientId": "P-2024-001",
                    "doctorId": "DOC-101",
                    "dateTime": "2024-01-20T10:00:00Z",
                    "status": "scheduled"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create new appointment",
        "description": "Creates a new appointment for a patient with a doctor",
        "operationId": "createAppointment",
        "tags": ["Appointments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentRequest"
              },
              "example": {
                "patientId": "P-2024-001",
                "doctorId": "DOC-101",
                "dateTime": "2024-01-20T10:00:00Z",
                "reason": "Routine checkup"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Appointment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                },
                "example": {
                  "id": "APT-001",
                  "patientId": "P-2024-001",
                  "doctorId": "DOC-101",
                  "dateTime": "2024-01-20T10:00:00Z",
                  "status": "scheduled"
                }
              }
            }
          }
        }
      }
    },
    "/appointments/{id}": {
      "get": {
        "summary": "Get appointment by ID",
        "description": "Retrieves a specific appointment by its unique identifier",
        "operationId": "getAppointmentById",
        "tags": ["Appointments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "APT-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                },
                "example": {
                  "id": "APT-001",
                  "patientId": "P-2024-001",
                  "doctorId": "DOC-101",
                  "dateTime": "2024-01-20T10:00:00Z",
                  "status": "scheduled"
                }
              }
            }
          },
          "404": {
            "description": "Appointment not found"
          }
        }
      },
      "put": {
        "summary": "Update appointment",
        "description": "Updates an existing appointment's details or status",
        "operationId": "updateAppointment",
        "tags": ["Appointments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "APT-001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentUpdate"
              },
              "example": {
                "dateTime": "2024-01-20T14:00:00Z",
                "status": "confirmed"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Appointment updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                },
                "example": {
                  "id": "APT-001",
                  "patientId": "P-2024-001",
                  "doctorId": "DOC-101",
                  "dateTime": "2024-01-20T14:00:00Z",
                  "status": "confirmed"
                }
              }
            }
          }
        }
      }
    },
    "/pharmacy/orders": {
      "get": {
        "summary": "Get all pharmacy orders",
        "description": "Retrieves a list of all pharmacy orders",
        "operationId": "getPharmacyOrders",
        "tags": ["Pharmacy"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PharmacyOrder"
                  }
                },
                "example": [
                  {
                    "id": "PH-001",
                    "patientId": "P-2024-001",
                    "medication": "Aspirin",
                    "quantity": 30,
                    "status": "processing"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create pharmacy order",
        "description": "Creates a new pharmacy order for medication",
        "operationId": "createPharmacyOrder",
        "tags": ["Pharmacy"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PharmacyOrderRequest"
              },
              "example": {
                "patientId": "P-2024-001",
                "medication": "Aspirin",
                "quantity": 30,
                "dosage": "100mg"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pharmacy order created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PharmacyOrder"
                },
                "example": {
                  "id": "PH-001",
                  "patientId": "P-2024-001",
                  "medication": "Aspirin",
                  "quantity": 30,
                  "status": "processing"
                }
              }
            }
          }
        }
      }
    },
