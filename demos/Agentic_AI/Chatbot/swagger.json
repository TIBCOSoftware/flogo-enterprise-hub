    },
    "/billing": {
      "get": {
        "summary": "Get all bills",
        "description": "Retrieves a list of all billing records in the system",
        "operationId": "getBills",
        "tags": ["Billing"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Billing"
                  }
                },
                "example": [
                  {
                    "id": "BIL-001",
                    "patientId": "P-2024-001",
                    "amount": 1500.00,
                    "status": "pending",
                    "dueDate": "2024-02-01"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create new bill",
        "description": "Creates a new billing record for a patient",
        "operationId": "createBill",
        "tags": ["Billing"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BillingRequest"
              },
              "example": {
                "patientId": "P-2024-001",
                "amount": 1500.00,
                "description": "Consultation and tests"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bill created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Billing"
                },
                "example": {
                  "id": "BIL-001",
                  "patientId": "P-2024-001",
                  "amount": 1500.00,
                  "status": "pending",
                  "dueDate": "2024-02-01"
                }
              }
            }
          }
        }
      }
    },
    "/billing/{id}": {
      "get": {
        "summary": "Get bill by ID",
        "description": "Retrieves a specific billing record by its unique identifier",
        "operationId": "getBillById",
