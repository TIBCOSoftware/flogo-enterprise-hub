            "type": "string",
            "example": "Consultation and tests"
          }
        },
        "required": ["patientId", "amount"]
      },
      "BillingUpdate": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "paid", "overdue", "cancelled"],
            "example": "paid"
          },
          "amount": {
            "type": "number",
            "format": "float",
            "example": 1500.00
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Appointments",
      "description": "Operations for managing patient appointments"
    },
    {
      "name": "Pharmacy",
