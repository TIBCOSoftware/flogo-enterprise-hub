            "type": "string",
            "format": "date",
            "example": "2024-02-01"
          }
        },
        "required": ["id", "patientId", "amount", "status", "dueDate"]
      },
      "BillingRequest": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "example": "P-2024-001"
          },
          "amount": {
            "type": "number",
            "format": "float",
            "example": 1500.00
