{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/flogo-general/src/app/General/activity/rest",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/string",
    "github.com/project-flogo/contrib/function/coerce"
  ],
  "name": "airline-mcp-server",
  "description": "Airline MCP Server — Exposes flight status, booking, and rebooking as AI tools",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Airline MCP Server for Agentic AI",
      "settings": {
        "serverName": "AirlinePassengerServices",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": true,
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": ""
      },
      "id": "AirlineMCPServer",
      "handlers": [
        {
          "description": "Returns flight status for Airline flights",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "CheckFlightStatus",
            "handlerDescription": "Check the current status of a Airline flight. Returns flight details including origin, destination, scheduled and estimated times, delay information, gate assignment, and aircraft type. Use this tool when a passenger asks about a flight status or delay.",
            "toolTitle": "Check Flight Status",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:checkFlightStatus"
            },
            "input": {
              "httpHeaders": "=$.httpHeaders",
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"flightNumber\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"flightNumber\":\"FL801\"}"
              }
            }
          },
          "name": "checkFlightStatus"
        },
        {
          "description": "Returns booking details by PNR",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetBooking",
            "handlerDescription": "Look up a passenger booking by PNR confirmation code. Returns passenger information including name, FrequentFlyer loyalty tier, and all flight segments with seat assignments and status. Use this tool when a passenger provides their PNR or booking reference.",
            "toolTitle": "Get Booking",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:getBooking"
            },
            "input": {
              "httpHeaders": "=$.httpHeaders",
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"pnr\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"pnr\":\"ABCDE1\"}"
              }
            }
          },
          "name": "getBooking"
        },
        {
          "description": "Rebooks a disrupted passenger to an alternative flight",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "RebookPassenger",
            "handlerDescription": "Rebook a disrupted passenger to an alternative flight. Updates the affected segment in the booking and returns the updated itinerary. Use this tool only after confirming with the passenger that they want to be rebooked.",
            "toolTitle": "Rebook Passenger",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:rebookPassenger"
            },
            "input": {
              "httpHeaders": "=$.httpHeaders",
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"pnr\":{\"type\":\"string\"},\"newFlightNumber\":{\"type\":\"string\"}},\"required\":[\"pnr\",\"newFlightNumber\"]}",
                "fe_metadata": "{\"pnr\":\"ABCDE1\",\"newFlightNumber\":\"FL447\"}"
              }
            }
          },
          "name": "rebookPassenger"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:checkFlightStatus",
      "data": {
        "name": "checkFlightStatus",
        "description": "Returns flight status for Airline flights",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogMessage",
            "type": "label",
            "label": "StartActivity to LogMessage"
          },
          {
            "id": 2,
            "from": "LogMessage",
            "to": "Return",
            "type": "label",
            "label": "LogMessage to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogMessage",
            "name": "LogMessage",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"MCP CheckFlightStatus: \", $flow.arguments.flightNumber)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Returns hardcoded flight data based on flight number",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "@conditional": [
                      {
                        "$flow.arguments.flightNumber == 'FL801'": {
                          "data": "{\"flightNumber\":\"FL801\",\"origin\":\"BOG\",\"originCity\":\"Bogota\",\"destination\":\"PTY\",\"destinationCity\":\"Panama City\",\"scheduledDeparture\":\"2026-06-15T08:30:00-05:00\",\"estimatedDeparture\":\"2026-06-15T10:00:00-05:00\",\"scheduledArrival\":\"2026-06-15T11:15:00-05:00\",\"estimatedArrival\":\"2026-06-15T12:45:00-05:00\",\"status\":\"DELAYED\",\"gate\":\"B12\",\"delayMinutes\":90,\"delayReason\":\"Late arriving aircraft from GYE\",\"aircraft\":\"Boeing 737 MAX 9\"}"
                        }
                      },
                      {
                        "$flow.arguments.flightNumber == 'FL445'": {
                          "data": "{\"flightNumber\":\"FL445\",\"origin\":\"PTY\",\"originCity\":\"Panama City\",\"destination\":\"MIA\",\"destinationCity\":\"Miami\",\"scheduledDeparture\":\"2026-06-15T12:30:00-05:00\",\"estimatedDeparture\":\"2026-06-15T12:30:00-05:00\",\"scheduledArrival\":\"2026-06-15T16:45:00-04:00\",\"estimatedArrival\":\"2026-06-15T16:45:00-04:00\",\"status\":\"ON_TIME\",\"gate\":\"A05\",\"delayMinutes\":0,\"delayReason\":\"\",\"aircraft\":\"Boeing 737-800\"}"
                        }
                      },
                      {
                        "$flow.arguments.flightNumber == 'FL447'": {
                          "data": "{\"flightNumber\":\"FL447\",\"origin\":\"PTY\",\"originCity\":\"Panama City\",\"destination\":\"MIA\",\"destinationCity\":\"Miami\",\"scheduledDeparture\":\"2026-06-15T15:30:00-05:00\",\"estimatedDeparture\":\"2026-06-15T15:30:00-05:00\",\"scheduledArrival\":\"2026-06-15T19:45:00-04:00\",\"estimatedArrival\":\"2026-06-15T19:45:00-04:00\",\"status\":\"ON_TIME\",\"gate\":\"A08\",\"delayMinutes\":0,\"delayReason\":\"\",\"aircraft\":\"Boeing 737 MAX 9\"}"
                        }
                      },
                      {
                        "$flow.arguments.flightNumber == 'FL302'": {
                          "data": "{\"flightNumber\":\"FL302\",\"origin\":\"GYE\",\"originCity\":\"Guayaquil\",\"destination\":\"PTY\",\"destinationCity\":\"Panama City\",\"scheduledDeparture\":\"2026-06-15T07:00:00-05:00\",\"estimatedDeparture\":\"2026-06-15T07:45:00-05:00\",\"scheduledArrival\":\"2026-06-15T09:15:00-05:00\",\"estimatedArrival\":\"2026-06-15T10:00:00-05:00\",\"status\":\"DELAYED\",\"gate\":\"C03\",\"delayMinutes\":45,\"delayReason\":\"Weather conditions at GYE\",\"aircraft\":\"Airbus A320neo\"}"
                        }
                      },
                      {
                        "$flow.arguments.flightNumber == 'FL510'": {
                          "data": "{\"flightNumber\":\"FL510\",\"origin\":\"PTY\",\"originCity\":\"Panama City\",\"destination\":\"GRU\",\"destinationCity\":\"Sao Paulo\",\"scheduledDeparture\":\"2026-06-15T11:00:00-05:00\",\"estimatedDeparture\":\"2026-06-15T11:00:00-05:00\",\"scheduledArrival\":\"2026-06-15T19:30:00-03:00\",\"estimatedArrival\":\"2026-06-15T19:30:00-03:00\",\"status\":\"ON_TIME\",\"gate\":\"D12\",\"delayMinutes\":0,\"delayReason\":\"\",\"aircraft\":\"Boeing 787-9 Dreamliner\"}"
                        }
                      },
                      {
                        "$flow.arguments.flightNumber == 'FL612'": {
                          "data": "{\"flightNumber\":\"FL612\",\"origin\":\"PTY\",\"originCity\":\"Panama City\",\"destination\":\"GRU\",\"destinationCity\":\"Sao Paulo\",\"scheduledDeparture\":\"2026-06-15T14:30:00-05:00\",\"estimatedDeparture\":\"2026-06-15T14:30:00-05:00\",\"scheduledArrival\":\"2026-06-15T23:00:00-03:00\",\"estimatedArrival\":\"2026-06-15T23:00:00-03:00\",\"status\":\"ON_TIME\",\"gate\":\"D15\",\"delayMinutes\":0,\"delayReason\":\"\",\"aircraft\":\"Boeing 787-9 Dreamliner\"}"
                        }
                      },
                      {
                        "$flow.arguments.flightNumber == 'FL215'": {
                          "data": "{\"flightNumber\":\"FL215\",\"origin\":\"MDE\",\"originCity\":\"Medellin\",\"destination\":\"PTY\",\"destinationCity\":\"Panama City\",\"scheduledDeparture\":\"2026-06-15T06:00:00-05:00\",\"estimatedDeparture\":\"2026-06-15T06:00:00-05:00\",\"scheduledArrival\":\"2026-06-15T08:00:00-05:00\",\"estimatedArrival\":\"2026-06-15T08:00:00-05:00\",\"status\":\"ON_TIME\",\"gate\":\"B07\",\"delayMinutes\":0,\"delayReason\":\"\",\"aircraft\":\"Embraer E195-E2\"}"
                        }
                      },
                      {
                        "@otherwise": {
                          "error": "=string.concat(\"Flight \", $flow.arguments.flightNumber, \" not found in Airline system\")"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkxvZ01lc3NhZ2UiOnsieCI6MjUwLCJ5Ijo1MH0sIlJldHVybiI6eyJ4Ijo0NTAsInkiOjUwfX0=",
        "metadata": {
          "input": [
            {
              "name": "arguments",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"flightNumber\":{\"type\":\"string\"}}"
              }
            },
            {
              "name": "httpHeaders",
              "type": "params"
            }
          ],
          "output": [
            {
              "name": "response",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"data\":{\"type\":\"string\"},\"audience\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"priority\":{\"type\":\"number\"},\"error\":{\"type\":\"string\"}}"
              }
            },
            {
              "name": "structuredContent",
              "type": "object"
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"AirlineMCPServer\",\"properties\":{\"arguments\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"flightNumber\":{\"type\":\"string\"}}},\"httpHeaders\":{\"type\":\"params\"}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"audience\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"priority\":{\"type\":\"number\"},\"error\":{\"type\":\"string\"}}},\"structuredContent\":{\"type\":\"object\"}},\"required\":[\"response\"]}"
          }
        }
      }
    },
    {
      "id": "flow:getBooking",
      "data": {
        "name": "getBooking",
        "description": "Returns booking details by PNR",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogMessage",
            "type": "label",
            "label": "StartActivity to LogMessage"
          },
          {
            "id": 2,
            "from": "LogMessage",
            "to": "Return",
            "type": "label",
            "label": "LogMessage to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogMessage",
            "name": "LogMessage",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"MCP GetBooking: \", $flow.arguments.pnr)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Returns hardcoded booking data based on PNR",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "@conditional": [
                      {
                        "$flow.arguments.pnr == 'ABCDE1'": {
                          "data": "{\"pnr\":\"ABCDE1\",\"passenger\":{\"name\":\"Carlos Martinez\",\"passengerId\":\"PAX-2026-00101\",\"email\":\"carlos.martinez@email.com\",\"phone\":\"+57-310-555-0101\",\"loyaltyTier\":\"Gold\",\"loyaltyNumber\":\"FF-98765432\"},\"segments\":[{\"flightNumber\":\"FL801\",\"origin\":\"BOG\",\"destination\":\"PTY\",\"departureTime\":\"2026-06-15T08:30:00-05:00\",\"arrivalTime\":\"2026-06-15T11:15:00-05:00\",\"seatNumber\":\"4A\",\"cabin\":\"Business\",\"status\":\"CHECKED_IN\"},{\"flightNumber\":\"FL445\",\"origin\":\"PTY\",\"destination\":\"MIA\",\"departureTime\":\"2026-06-15T12:30:00-05:00\",\"arrivalTime\":\"2026-06-15T16:45:00-04:00\",\"seatNumber\":\"3C\",\"cabin\":\"Business\",\"status\":\"CONFIRMED\"}]}"
                        }
                      },
                      {
                        "$flow.arguments.pnr == 'FGHIJ2'": {
                          "data": "{\"pnr\":\"FGHIJ2\",\"passenger\":{\"name\":\"Ana Rodriguez\",\"passengerId\":\"PAX-2026-00205\",\"email\":\"ana.rodriguez@email.com\",\"phone\":\"+593-99-555-0205\",\"loyaltyTier\":\"Platinum\",\"loyaltyNumber\":\"FF-11223344\"},\"segments\":[{\"flightNumber\":\"FL302\",\"origin\":\"GYE\",\"destination\":\"PTY\",\"departureTime\":\"2026-06-15T07:00:00-05:00\",\"arrivalTime\":\"2026-06-15T09:15:00-05:00\",\"seatNumber\":\"1A\",\"cabin\":\"Business\",\"status\":\"CHECKED_IN\"},{\"flightNumber\":\"FL510\",\"origin\":\"PTY\",\"destination\":\"GRU\",\"departureTime\":\"2026-06-15T11:00:00-05:00\",\"arrivalTime\":\"2026-06-15T19:30:00-03:00\",\"seatNumber\":\"2D\",\"cabin\":\"Business\",\"status\":\"CONFIRMED\"}]}"
                        }
                      },
                      {
                        "$flow.arguments.pnr == 'KLMNO3'": {
                          "data": "{\"pnr\":\"KLMNO3\",\"passenger\":{\"name\":\"Roberto Silva\",\"passengerId\":\"PAX-2026-00312\",\"email\":\"roberto.silva@email.com\",\"phone\":\"+57-301-555-0312\",\"loyaltyTier\":\"Silver\",\"loyaltyNumber\":\"FF-55667788\"},\"segments\":[{\"flightNumber\":\"FL215\",\"origin\":\"MDE\",\"destination\":\"PTY\",\"departureTime\":\"2026-06-15T06:00:00-05:00\",\"arrivalTime\":\"2026-06-15T08:00:00-05:00\",\"seatNumber\":\"14F\",\"cabin\":\"Economy\",\"status\":\"CHECKED_IN\"}]}"
                        }
                      },
                      {
                        "@otherwise": {
                          "error": "=string.concat(\"Booking \", $flow.arguments.pnr, \" not found in Airline system\")"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkxvZ01lc3NhZ2UiOnsieCI6MjUwLCJ5Ijo1MH0sIlJldHVybiI6eyJ4Ijo0NTAsInkiOjUwfX0=",
        "metadata": {
          "input": [
