    {
      "id": "flow:rebookPassenger",
      "data": {
        "name": "rebookPassenger",
        "description": "Rebooks a disrupted passenger to an alternative flight",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogMessage",
            "type": "label",
            "label": "StartActivity to LogMessage"
          },
          {
            "id": 2,
            "from": "LogMessage",
            "to": "Return",
            "type": "label",
            "label": "LogMessage to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogMessage",
            "name": "LogMessage",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"MCP RebookPassenger: \", $flow.arguments.pnr, \" -> \", $flow.arguments.newFlightNumber)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Returns hardcoded rebook data based on PNR",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "@conditional": [
                      {
                        "$flow.arguments.pnr == 'ABCDE1'": {
                          "data": "=string.concat(\"{\\\"success\\\":true,\\\"message\\\":\\\"Passenger Carlos Martinez rebooked from FL445 to \", $flow.arguments.newFlightNumber, \"\\\",\\\"updatedSegments\\\":[{\\\"flightNumber\\\":\\\"FL801\\\",\\\"origin\\\":\\\"BOG\\\",\\\"destination\\\":\\\"PTY\\\",\\\"departureTime\\\":\\\"2026-06-15T08:30:00-05:00\\\",\\\"arrivalTime\\\":\\\"2026-06-15T12:45:00-05:00\\\",\\\"seatNumber\\\":\\\"4A\\\",\\\"cabin\\\":\\\"Business\\\",\\\"status\\\":\\\"CHECKED_IN\\\"},{\\\"flightNumber\\\":\\\"\", $flow.arguments.newFlightNumber, \"\\\",\\\"origin\\\":\\\"PTY\\\",\\\"destination\\\":\\\"MIA\\\",\\\"departureTime\\\":\\\"2026-06-15T15:30:00-05:00\\\",\\\"arrivalTime\\\":\\\"2026-06-15T19:45:00-04:00\\\",\\\"seatNumber\\\":\\\"5A\\\",\\\"cabin\\\":\\\"Business\\\",\\\"status\\\":\\\"CONFIRMED\\\"}]}\")"
                        }
                      },
                      {
                        "$flow.arguments.pnr == 'FGHIJ2'": {
                          "data": "=string.concat(\"{\\\"success\\\":true,\\\"message\\\":\\\"Passenger Ana Rodriguez rebooked from FL510 to \", $flow.arguments.newFlightNumber, \"\\\",\\\"updatedSegments\\\":[{\\\"flightNumber\\\":\\\"FL302\\\",\\\"origin\\\":\\\"GYE\\\",\\\"destination\\\":\\\"PTY\\\",\\\"departureTime\\\":\\\"2026-06-15T07:00:00-05:00\\\",\\\"arrivalTime\\\":\\\"2026-06-15T10:00:00-05:00\\\",\\\"seatNumber\\\":\\\"1A\\\",\\\"cabin\\\":\\\"Business\\\",\\\"status\\\":\\\"CHECKED_IN\\\"},{\\\"flightNumber\\\":\\\"\", $flow.arguments.newFlightNumber, \"\\\",\\\"origin\\\":\\\"PTY\\\",\\\"destination\\\":\\\"GRU\\\",\\\"departureTime\\\":\\\"2026-06-15T14:30:00-05:00\\\",\\\"arrivalTime\\\":\\\"2026-06-15T23:00:00-03:00\\\",\\\"seatNumber\\\":\\\"2A\\\",\\\"cabin\\\":\\\"Business\\\",\\\"status\\\":\\\"CONFIRMED\\\"}]}\")"
                        }
                      },
                      {
                        "@otherwise": {
                          "error": "=string.concat(\"Booking \", $flow.arguments.pnr, \" not found for rebooking\")"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ],
