    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "AI Agent trigger for Agentic AI. This agent must be invoked within the app using 'Invoke AI Agent Trigger' activity",
      "settings": {
        "llmProviderConnection": "conn://adf21c4c-67e1-4c78-9487-b2cacff04d63",
        "agentName": "alert_notification_agent",
        "agentDescription": "Sends alert notifications for assets with WARNING or CRITICAL health status. Must only be invoked after sensor analysis and prediction storage are complete.",
        "agentType": "Local",
        "agentPort": 8080,
        "model": "claude-sonnet-4-5-20250929",
        "reasoning": "",
        "temperature": 0.7,
        "enableGuardrails": false,
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": false,
        "mcpServers": [],
        "conversationStoreType": "None",
        "memoryMaxSize": 10,
        "systemPrompt": "You are the Alert Notification Agent responsible for logging alert notifications for oilfield assets with WARNING or CRITICAL health status. You have access to one API: POST /api/v1/alerts to log alerts with fields asset_id, severity, and message.\n\nYour workflow: Receive the alert parameters from the orchestrator. Call the alerts API with the provided fields. Return the alert_id and confirmation to the orchestrator.\n\nSend the alert exactly once. Do not send multiple alerts. Do not invoke or hand over to any other agents."
      },
      "id": "alert_notification_agent_trigger",
      "handlers": [
        {
          "description": "",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "alert_notification_agent",
            "agentToolDescription": "Logs an alert notification for an asset. Provide asset_id, severity, and message. Returns alert_id confirmation. Invoke only ONCE per conversation.",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:alert_notification_agent"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
