  "resources": [
    {
      "id": "flow:get-sensor-data",
      "data": {
        "name": "get-sensor-data",
        "description": "",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "PostgreSQLQuery",
            "type": "label",
            "label": "StartActivity to PostgreSQLQuery"
          },
          {
            "id": 2,
            "from": "PostgreSQLQuery",
            "to": "Return",
            "type": "label",
            "label": "PostgreSQLQuery to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "PostgreSQLQuery",
            "name": "PostgreSQLQuery",
            "description": "This activity executes query on a PostgreSQL database",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://e3c455be-4ee3-4b77-8c98-db7b09e81f7d",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT a.asset_id, a.asset_type, a.well_site_id, a.description, a.status, sr.reading_timestamp, sr.vibration_rms, sr.temperature_c, sr.pressure_psi, sr.flow_rate, sr.power_consumption FROM public.assets a LEFT JOIN public.sensor_readings sr ON a.asset_id = sr.asset_id WHERE a.asset_id = $1 ORDER BY sr.id DESC LIMIT 1",
                "manualmode": true,
                "Fields": [
                  {
                    "FieldName": "asset_id",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": true,
                    "isEditable": true
                  },
                  {
                    "FieldName": "asset_type",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "well_site_id",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "description",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "status",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "reading_timestamp",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "vibration_rms",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "temperature_c",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "pressure_psi",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "flow_rate",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "power_consumption",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  }
                ],
                "RuntimeQuery": "",
                "State": "0e8be336-69ff-4915-8d38-bee2cd4b3755SELECT a.asset_id, a.asset_type, a.well_site_id, a.description, a.status, sr.reading_timestamp, sr.vibration_rms, sr.temperature_c, sr.pressure_psi, sr.flow_rate, sr.power_consumption FROM public.assets a LEFT JOIN public.sensor_readings sr ON a.asset_id = sr.asset_id WHERE a.asset_id = $1 ORDER BY sr.id DESC LIMIT 1",
                "input": {
                  "mapping": {
                    "parameters": {
                      "asset_id": "=$flow.pathParams.asset_id"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"asset_id\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"asset_id\":{\"type\":\"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"asset_id\":{\"type\":\"string\"},\"asset_type\":{\"type\":\"string\"},\"well_site_id\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"reading_timestamp\":{\"type\":\"string\"},\"vibration_rms\":{\"type\":\"string\"},\"temperature_c\":{\"type\":\"string\"},\"pressure_psi\":{\"type\":\"string\"},\"flow_rate\":{\"type\":\"string\"},\"power_consumption\":{\"type\":\"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"asset_id\":{\"type\":\"string\"},\"asset_type\":{\"type\":\"string\"},\"well_site_id\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"reading_timestamp\":{\"type\":\"string\"},\"vibration_rms\":{\"type\":\"string\"},\"temperature_c\":{\"type\":\"string\"},\"pressure_psi\":{\"type\":\"string\"},\"flow_rate\":{\"type\":\"string\"},\"power_consumption\":{\"type\":\"string\"}}}}}}"
