    {
      "id": "flow:Get_Customers",
      "data": {
        "name": "Get_Customers",
        "description": "Get a list of customers.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogStart",
            "type": "label",
            "label": "StartActivity to LogMessage1"
          },
          {
            "id": 2,
            "from": "LogStart",
            "to": "Mapper",
            "type": "label",
            "label": "LogStart to Mapper"
