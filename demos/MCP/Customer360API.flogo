                "logLevel": ""
              }
            }
          },
          {
            "id": "Mapper",
            "name": "Mapper",
            "description": "Mapper Activity",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": "=coerce.toObject(\"{\\\"customers\\\":[{\\\"customer_id\\\":1,\\\"company_name\\\":\\\"QuantumLeap B.V.\\\",\\\"contact_email\\\":\\\"contact@quantumleap.nl\\\",\\\"contact_phone\\\":\\\"+31 6 12345678\\\",\\\"billing_address\\\":\\\"123 High Tech Campus, Eindhoven, Netherlands\\\",\\\"shipping_address\\\":\\\"123 High Tech Campus, Eindhoven, Netherlands\\\",\\\"created_at\\\":\\\"2025-07-22 08:34:15.276517+00\\\"},{\\\"customer_id\\\":2,\\\"company_name\\\":\\\"Rhine Automata GmbH\\\",\\\"contact_email\\\":\\\"info@rhineauto.de\\\",\\\"contact_phone\\\":\\\"+49 30 98765432\\\",\\\"billing_address\\\":\\\"45 Schillerstra, Berlin, Germany\\\",\\\"shipping_address\\\":\\\"45 Schillerstra, Berlin, Germany\\\",\\\"created_at\\\":\\\"2025-07-22 08:34:15.276517+00\\\"},{\\\"customer_id\\\":3,\\\"company_name\\\":\\\"Silicon Valley Robotics\\\",\\\"contact_email\\\":\\\"procurement@svrobotics.com\\\",\\\"contact_phone\\\":\\\"+1 415 555 0101\\\",\\\"billing_address\\\":\\\"789 Innovation Dr, Palo Alto, CA, USA\\\",\\\"shipping_address\\\":\\\"789 Innovation Dr, Palo Alto, CA, USA\\\",\\\"created_at\\\":\\\"2025-07-22 08:34:15.276517+00\\\"},{\\\"customer_id\\\":4,\\\"company_name\\\":\\\"Kyoto Dynamics\\\",\\\"contact_email\\\":\\\"orders@kyotodynamics.jp\\\",\\\"contact_phone\\\":\\\"+81 75 234 5678\\\",\\\"billing_address\\\":\\\"321 Kiyamachi Dori, Kyoto, Japan\\\",\\\"shipping_address\\\":\\\"321 Kiyamachi Dori, Kyoto, Japan\\\",\\\"created_at\\\":\\\"2025-07-22 08:34:15.276517+00\\\"},{\\\"customer_id\\\":5,\\\"company_name\\\":\\\"Seoul AI Systems\\\",\\\"contact_email\\\":\\\"sourcing@seoulaisys.kr\\\",\\\"contact_phone\\\":\\\"+82 2 1234 5678\\\",\\\"billing_address\\\":\\\"101 Gangnam-daero, Seoul, South Korea\\\",\\\"shipping_address\\\":\\\"101 Gangnam-daero, Seoul, South Korea\\\",\\\"created_at\\\":\\\"2025-07-22 08:34:15.276517+00\\\"},{\\\"customer_id\\\":6,\\\"company_name\\\":\\\"Taipei Logic Inc.\\\",\\\"contact_email\\\":\\\"contact@taipeilogic.tw\\\",\\\"contact_phone\\\":\\\"+886 2 8765 4321\\\",\\\"billing_address\\\":\\\"55 Xinyi Rd, Taipei, Taiwan\\\",\\\"shipping_address\\\":\\\"55 Xinyi Rd, Taipei, Taiwan\\\",\\\"created_at\\\":\\\"2025-07-22 08:34:15.276517+00\\\"},{\\\"customer_id\\\":7,\\\"company_name\\\":\\\"Britannic Circuits Ltd.\\\",\\\"contact_email\\\":\\\"accounts@britcircuits.co.uk\\\",\\\"contact_phone\\\":\\\"+44 20 7946 0123\\\",\\\"billing_address\\\":\\\"7 London Wall, London, UK\\\",\\\"shipping_address\\\":\\\"7 London Wall, London, UK\\\",\\\"created_at\\\":\\\"2025-07-22 08:34:15.276517+00\\\"},{\\\"customer_id\\\":8,\\\"company_name\\\":\\\"Parisian Tech Group\\\",\\\"contact_email\\\":\\\"achats@paristech.fr\\\",\\\"contact_phone\\\":\\\"+33 1 9876 5432\\\",\\\"billing_address\\\":\\\"15 Rue de Rivoli, Paris, France\\\",\\\"shipping_address\\\":\\\"15 Rue de Rivoli, Paris, France\\\",\\\"created_at\\\":\\\"2025-07-22 08:34:15.276517+00\\\"},{\\\"customer_id\\\":9,\\\"company_name\\\":\\\"Maple Innovations\\\",\\\"contact_email\\\":\\\"buy@mapleinnovations.ca\\\",\\\"contact_phone\\\":\\\"+1 416 555 0199\\\",\\\"billing_address\\\":\\\"200 University Ave, Toronto, ON, Canada\\\",\\\"shipping_address\\\":\\\"200 University Ave, Toronto, ON, Canada\\\",\\\"created_at\\\":\\\"2025-07-22 08:34:15.276517+00\\\"},{\\\"customer_id\\\":10,\\\"company_name\\\":\\\"Dragon Chip Corp.\\\",\\\"contact_email\\\":\\\"admin@dragonchip.cn\\\",\\\"contact_phone\\\":\\\"+86 755 8888 9999\\\",\\\"billing_address\\\":\\\"8 Keji South Road, Shenzhen, China\\\",\\\"shipping_address\\\":\\\"8 Keji South Road, Shenzhen, China\\\",\\\"created_at\\\":\\\"2025-07-22 08:34:15.276517+00\\\"}]}\")"
              },
              "schemas": {
                "input": {
                  "input": "schema://CustomersSchema"
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"customers\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"customer_id\": {\n            \"type\": \"number\"\n          },\n          \"company_name\": {\n            \"type\": \"string\"\n          },\n          \"contact_email\": {\n            \"type\": \"string\"\n          },\n          \"contact_phone\": {\n            \"type\": \"string\"\n          },\n          \"billing_address\": {\n            \"type\": \"string\"\n          },\n          \"shipping_address\": {\n            \"type\": \"string\"\n          },\n          \"created_at\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"customer_id\",\n          \"company_name\",\n          \"contact_email\",\n          \"contact_phone\",\n          \"billing_address\",\n          \"shipping_address\",\n          \"created_at\"\n        ]\n      }\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"customers\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"customer_id\": {\n            \"type\": \"number\"\n          },\n          \"company_name\": {\n            \"type\": \"string\"\n          },\n          \"contact_email\": {\n            \"type\": \"string\"\n          },\n          \"contact_phone\": {\n            \"type\": \"string\"\n          },\n          \"billing_address\": {\n            \"type\": \"string\"\n          },\n          \"shipping_address\": {\n            \"type\": \"string\"\n          },\n          \"created_at\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"customer_id\",\n          \"company_name\",\n          \"contact_email\",\n          \"contact_phone\",\n          \"billing_address\",\n          \"shipping_address\",\n          \"created_at\"\n        ]\n      }\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
