        {
          "description": "Get Product Sales Report",
          "settings": {
            "handlerType": "Prompt",
            "resourceUri": "",
            "handlerName": "Product Sales Prompt",
            "handlerDescription": "A prompt that generates sales report of a product in last n months",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:Get_Product_Sales_Prompt"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "product_name": "=$.arguments.product_name",
                  "number_of_months": "=$.arguments.number_of_months"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"description\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"messages\": {\r\n      \"type\": \"array\",\r\n      \"items\": \r\n        {\r\n          \"type\": \"object\",\r\n          \"properties\": {\r\n            \"role\": {\r\n              \"type\": \"string\"\r\n            },\r\n            \"content\": {\r\n              \"type\": \"string\"\r\n            }\r\n          },\r\n          \"required\": [\r\n            \"role\",\r\n            \"content\"\r\n          ]\r\n        }\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"description\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"messages\": {\r\n      \"type\": \"array\",\r\n      \"items\": \r\n        {\r\n          \"type\": \"object\",\r\n          \"properties\": {\r\n            \"role\": {\r\n              \"type\": \"string\"\r\n            },\r\n            \"content\": {\r\n              \"type\": \"string\"\r\n            }\r\n          },\r\n          \"required\": [\r\n            \"role\",\r\n            \"content\"\r\n          ]\r\n        }\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\r\n  \"title\": \"Product Sale arguments\",\r\n  \"description\": \"Schema for input parameters for the product sale report\",\r\n  \"type\": \"object\",\r\n  \"required\": [\r\n    \"product_name\",\r\n    \"number_of_months\"\r\n  ],\r\n  \"properties\": {\r\n    \"product_name\": {\r\n      \"type\": \"string\",\r\n      \"description\": \"The product name\"\r\n    },\r\n    \"number_of_months\": {\r\n      \"type\": \"number\",\r\n      \"description\": \"The number of months to report on from today's date\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\r\n  \"title\": \"Product Sale arguments\",\r\n  \"description\": \"Schema for input parameters for the product sale report\",\r\n  \"type\": \"object\",\r\n  \"required\": [\r\n    \"product_name\",\r\n    \"number_of_months\"\r\n  ],\r\n  \"properties\": {\r\n    \"product_name\": {\r\n      \"type\": \"string\",\r\n      \"description\": \"The product name\"\r\n    },\r\n    \"number_of_months\": {\r\n      \"type\": \"number\",\r\n      \"description\": \"The number of months to report on from today's date\"\r\n    }\r\n  }\r\n}"
              }
            }
          },
          "name": "Get_Product_Sales_Prompt"
