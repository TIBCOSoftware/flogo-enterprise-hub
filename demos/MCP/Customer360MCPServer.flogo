    {
      "id": "flow:Get_Product_Sales_Prompt",
      "data": {
        "name": "Get_Product_Sales_Prompt",
        "description": "Get Product Sales Report",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Return",
            "type": "label",
            "label": "StartActivity to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Simple Return Activity",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "description": "=string.concat(\"Give me a sales report for  \", $flow.arguments.product_name,\"over the last \",coerce.toString($flow.arguments.number_of_months) , \" months\")",
                      "messages": [
                        {
                          "role": "user",
                          "content": "=string.concat($flow.arguments.product_name, \" \",coerce.toString($flow.arguments.number_of_months))"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfSwiUmV0dXJuIjp7IngiOjI5NSwieSI6OTd9fQ==",
        "metadata": {
          "input": [
            {
              "name": "arguments",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"product_name\":{\"type\":\"string\",\"description\":\"The product name\"},\"number_of_months\":{\"type\":\"number\",\"description\":\"The number of months to report on from today's date\"}}"
              }
            },
            {
              "name": "httpHeaders",
              "type": "params"
            }
          ],
          "output": [
            {
              "name": "response",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"description\":{\"type\":\"string\"},\"messages\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"role\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"role\",\"content\"]}},\"error\":{\"type\":\"string\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"MCPServer\",\"properties\":{\"arguments\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"title\":\"Product Sale arguments\",\"description\":\"Schema for input parameters for the product sale report\",\"type\":\"object\",\"required\":[\"product_name\",\"number_of_months\"],\"properties\":{\"product_name\":{\"type\":\"string\",\"description\":\"The product name\"},\"number_of_months\":{\"type\":\"number\",\"description\":\"The number of months to report on from today's date\"}}},\"httpHeaders\":{\"type\":\"params\"}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"description\":{\"type\":\"string\"},\"messages\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"role\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},\"required\":[\"role\",\"content\"]}},\"error\":{\"type\":\"string\"}}}},\"required\":[]}"
