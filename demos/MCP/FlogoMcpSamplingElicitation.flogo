{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-mcp/src/app/MCP/activity/elicitation",
    "github.com/tibco/flogo-mcp/src/app/MCP/activity/sampling",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/flogo-mcp/src/app/MCP/activity/sendlogmessage",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/array",
    "github.com/project-flogo/contrib/function/coerce"
  ],
  "name": "FlogoMcpServerNewText",
  "description": "",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Flogo MCP server for Agentic AI",
      "settings": {
        "serverName": "FlogoMcpServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "8089",
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": ""
      },
      "id": "MCPServer",
      "handlers": [
        {
          "description": "",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "book_recommendation_tool",
            "handlerDescription": "Get personalized book recommendations based on user preferences including genre, author preferences, themes, and reading level. Returns a list of recommended books with titles, authors, descriptions, and ratings."
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:NewFeaturesFlow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"genre\": {\n      \"type\": \"string\",\n      \"description\": \"The genre of books (e.g., Mystery, Fiction, Romance)\"\n    },\n    \"count\": {\n      \"type\": \"integer\",\n      \"description\": \"Number of recommendations to return\",\n      \"default\": 5\n    }\n  },\n  \"required\": [\"genre\"]\n}",
                "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"genre\": {\n      \"type\": \"string\",\n      \"description\": \"The genre of books (e.g., Mystery, Fiction, Romance)\"\n    },\n    \"count\": {\n      \"type\": \"integer\",\n      \"description\": \"Number of recommendations to return\",\n      \"default\": 5\n    }\n  },\n  \"required\": [\"genre\"]\n}"
              }
            }
          },
          "name": "NewFeaturesFlow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:NewFeaturesFlow",
      "data": {
        "name": "NewFeaturesFlow",
        "description": "",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "MCPElicitationActivity",
            "type": "label",
            "label": "StartActivity to MCPElicitationActivity"
          },
          {
            "id": 2,
            "from": "MCPElicitationActivity",
            "to": "MCPSamplingActivity",
            "type": "label",
            "label": "MCPElicitationActivity to MCPSamplingActivity"
          },
          {
            "id": 3,
            "from": "MCPSamplingActivity",
            "to": "LogMessage",
            "type": "label",
            "label": "MCPSamplingActivity to LogMessage"
          },
          {
            "id": 4,
            "from": "LogMessage",
            "to": "MCPLoggingActivity",
            "type": "label",
            "label": "LogMessage to MCPLoggingActivity"
          },
          {
            "id": 5,
            "from": "MCPLoggingActivity",
            "to": "Return",
            "type": "label",
            "label": "MCPLoggingActivity to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "MCPElicitationActivity",
            "name": "MCPElicitationActivity",
            "description": "Allows MCP server to receive additional inputs from MCP client in Flogo workflow",
            "activity": {
              "ref": "#elicitation",
              "settings": {
                "elicitationMode": "FORM"
              },
              "input": {
                "elicitationRequest": {
                  "mapping": {
                    "message": "What book genre would you like recommendations for?"
                  }
                }
              },
              "schemas": {
                "input": {
                  "elicitationRequest": {
                    "type": "json",
                    "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"message\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"message\"\r\n  ]\r\n}",
                    "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"message\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"message\"\r\n  ]\r\n}"
                  }
                },
                "output": {
                  "content": {
                    "type": "json",
                    "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"type\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"type\",\r\n    \"data\"\r\n  ]\r\n}",
                    "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"type\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"type\",\r\n    \"data\"\r\n  ]\r\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "MCPSamplingActivity",
            "name": "MCPSamplingActivity",
            "description": "Allows MCP server to send LLM sampling requests to agent from Flogo workflow",
            "activity": {
              "ref": "#sampling",
              "input": {
                "samplingMessageRequest": {
                  "mapping": {
                    "maxTokens": 4096,
                    "messages": [
                      {
                        "role": "user",
                        "content": {
                          "type": "Text",
                          "data": "=$activity[MCPElicitationActivity].content.data",
                          "mimeType": ""
                        }
                      }
                    ],
                    "modelPreferences": {
                      "hints": [
                        {
                          "name": "copilot/claude-sonnet-4.5"
                        }
                      ],
                      "costPriority": 0.3,
                      "intelligencePriority": 0.5,
                      "speedPriority": 0.2
                    },
                    "systemPrompt": "You are a knowledgeable book recommendation assistant. Provide thoughtful and personalized book recommendations based on user preferences. Include the book title, author, publication year, and a brief compelling description for each recommendation.",
                    "temperature": 0.7
                  }
                }
              },
              "schemas": {
                "input": {
                  "samplingMessageRequest": {
                    "type": "json",
                    "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"maxTokens\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"messages\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"properties\": {\r\n          \"role\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"content\": {\r\n            \"type\": \"object\",\r\n            \"properties\": {\r\n              \"type\": {\r\n                \"type\": \"string\",\r\n                \"enum\": [\r\n                  \"Text\",\r\n                  \"Image\"\r\n                ]\r\n              },\r\n              \"data\": {\r\n                \"type\": \"string\"\r\n              },\r\n              \"mimeType\": {\r\n                \"type\": \"string\"\r\n              }\r\n            },\r\n            \"required\": [\r\n              \"type\",\r\n              \"data\"\r\n            ]\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"modelPreferences\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"hints\": {\r\n          \"type\": \"array\",\r\n          \"items\": {\r\n            \"type\": \"object\",\r\n            \"properties\": {\r\n              \"name\": {\r\n                \"type\": \"string\"\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"costPriority\": {\r\n          \"type\": \"number\"\r\n        },\r\n        \"intelligencePriority\": {\r\n          \"type\": \"number\"\r\n        },\r\n        \"speedPriority\": {\r\n          \"type\": \"number\"\r\n        }\r\n      }\r\n    },\r\n    \"systemPrompt\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"temperature\": {\r\n      \"type\": \"number\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"messages\"\r\n  ]\r\n}",
                    "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"maxTokens\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"messages\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"properties\": {\r\n          \"role\": {\r\n            \"type\": \"string\"\r\n          },\r\n          \"content\": {\r\n            \"type\": \"object\",\r\n            \"properties\": {\r\n              \"type\": {\r\n                \"type\": \"string\",\r\n                \"enum\": [\r\n                  \"Text\",\r\n                  \"Image\"\r\n                ]\r\n              },\r\n              \"data\": {\r\n                \"type\": \"string\"\r\n              },\r\n              \"mimeType\": {\r\n                \"type\": \"string\"\r\n              }\r\n            },\r\n            \"required\": [\r\n              \"type\",\r\n              \"data\"\r\n            ]\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"modelPreferences\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"hints\": {\r\n          \"type\": \"array\",\r\n          \"items\": {\r\n            \"type\": \"object\",\r\n            \"properties\": {\r\n              \"name\": {\r\n                \"type\": \"string\"\r\n              }\r\n            }\r\n          }\r\n        },\r\n        \"costPriority\": {\r\n          \"type\": \"number\"\r\n        },\r\n        \"intelligencePriority\": {\r\n          \"type\": \"number\"\r\n        },\r\n        \"speedPriority\": {\r\n          \"type\": \"number\"\r\n        }\r\n      }\r\n    },\r\n    \"systemPrompt\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"temperature\": {\r\n      \"type\": \"number\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"messages\"\r\n  ]\r\n}"
                  }
                },
                "output": {
                  "samplingMessageResponse": {
                    "type": "json",
                    "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"role\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"content\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"type\": {\r\n          \"type\": \"string\",\r\n          \"enum\": [\"Text\", \"Image\"]\r\n        },\r\n        \"data\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"mimeType\": {\r\n          \"type\": \"string\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"type\",\r\n        \"data\"\r\n      ]\r\n    },\r\n    \"model\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"stopReason\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"role\",\r\n    \"content\",\r\n    \"model\"\r\n  ]\r\n}",
                    "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"role\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"content\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"type\": {\r\n          \"type\": \"string\",\r\n          \"enum\": [\"Text\", \"Image\"]\r\n        },\r\n        \"data\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"mimeType\": {\r\n          \"type\": \"string\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"type\",\r\n        \"data\"\r\n      ]\r\n    },\r\n    \"model\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"stopReason\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"role\",\r\n    \"content\",\r\n    \"model\"\r\n  ]\r\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogMessage",
            "name": "LogMessage",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=coerce.toString($activity[MCPSamplingActivity].samplingMessageResponse)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "MCPLoggingActivity",
            "name": "MCPLoggingActivity",
            "description": "Allows MCP server to send structured log messages to MCP client from Flogo workflow",
            "activity": {
              "ref": "#sendlogmessage",
              "input": {
                "loggingMessageParams": {
                  "mapping": {
                    "data": "=$activity[MCPSamplingActivity].samplingMessageResponse.content.data",
                    "level": "info",
                    "logger": "Flogo-Mcp-Sever"
                  }
                }
              },
              "schemas": {
                "input": {
                  "loggingMessageParams": {
                    "type": "json",
                    "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"level\": {\r\n      \"type\": \"string\",\r\n      \"enum\": [\"alert\",\"critical\",\"debug\",\"emergency\",\"error\",\"info\",\"notice\",\"warning\"]\r\n    },\r\n    \"logger\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\r\n    \"level\"\r\n  ]\r\n}",
                    "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"level\": {\r\n      \"type\": \"string\",\r\n      \"enum\": [\"alert\",\"critical\",\"debug\",\"emergency\",\"error\",\"info\",\"notice\",\"warning\"]\r\n    },\r\n    \"logger\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\r\n    \"level\"\r\n  ]\r\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Simple Return Activity",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "=$activity[MCPSamplingActivity].samplingMessageResponse.content.data"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjAsInkiOjQyfSwiTUNQRWxpY2l0YXRpb25BY3Rpdml0eSI6eyJ4IjoxMDIsInkiOjM2fSwiTUNQU2FtcGxpbmdBY3Rpdml0eSI6eyJ4IjoyNzYsInkiOjM0fSwiTG9nTWVzc2FnZSI6eyJ4Ijo0NzYsInkiOjMzfSwiTUNQTG9nZ2luZ0FjdGl2aXR5Ijp7IngiOjg3LCJ5IjoxNjR9LCJSZXR1cm4iOnsieCI6MjkxLCJ5IjoxNzB9fQ==",
        "errorHandler": {
          "tasks": [
            {
              "id": "Return1",
              "name": "Return1",
              "description": "Simple Return Activity",
              "activity": {
                "ref": "#actreturn",
                "settings": {
                  "mappings": {
                    "response": {
                      "mapping": {
                        "data": "dummy data"
                      }
                    }
                  }
                }
              }
            }
          ],
          "links": [],
          "fe_metadata": "eyJSZXR1cm4xIjp7IngiOjQ1NSwieSI6OTh9fQ=="
        },
        "metadata": {
          "input": [
            {
              "name": "arguments",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"genre\":{\"type\":\"string\",\"description\":\"The genre of books (e.g., Mystery, Fiction, Romance)\"},\"count\":{\"type\":\"integer\",\"description\":\"Number of recommendations to return\",\"default\":5}}"
              }
            },
            {
              "name": "httpHeaders",
              "type": "params"
            }
          ],
          "output": [
            {
              "name": "response",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"MCPServer\",\"properties\":{\"arguments\":{\"type\":\"object\",\"properties\":{\"genre\":{\"type\":\"string\",\"description\":\"The genre of books (e.g., Mystery, Fiction, Romance)\"},\"count\":{\"type\":\"integer\",\"description\":\"Number of recommendations to return\",\"default\":5}},\"required\":[\"genre\"]},\"httpHeaders\":{\"type\":\"params\"}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}},\"required\":[\"response\"]}"
          }
        }
      }
    }
  ],
  "properties": [],
  "connections": {},
  "contrib": "",
  "metadata": {
    "endpoints": [
      {
        "protocol": "http",
        "port": "8089",
        "title": "MCPServer",
        "type": "public"
      }
    ],
    "flogoVersion": "2.26.2"
  }
}