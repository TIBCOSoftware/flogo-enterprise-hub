.DS_Store
.vscode
.mcp.json
bin

# --- Node.js ---
# Installed dependencies for the demo chatbots / mcp-proxy. Never commit these;
# they are restored with `npm install`.
node_modules/
npm-debug.log*

# --- Build artifacts ---
# Windows executables / libraries
*.exe
*.dll
# macOS / Linux shared libraries
*.dylib
*.so

# Flogo_Apps/ is the local working folder for building and experimenting with
# Flogo apps. It is not shipped as repo content — keep the entire folder out of
# git so local scratch apps (and any live secrets baked into their .flogo files)
# can never be committed by accident.
Flogo_Apps/

# Flogo build output: any "builds/" directory holds packaged artifacts
# (flogo-engine binaries, .zip bundles, values.yaml, deploy payloads).
builds/
# Extension-less Flogo engine binaries wherever they land.
flogo-engine
# Running a locally-built Flogo .exe drops a copy of the real licence file next
# to it (TIB_ACTIVATION). It is licence material, never repo content.
FlogoLicense.bin
*_linux
*_darwin
# Runtime / build logs.
*.log
# Packaged archives (build outputs, backups).
*.zip
# Architecture decks, slide exports and the scripts/assets that build them are kept local
# (personal use; they reference local template decks). Never commit them.
*.pptx
*.ppt
*slide*.py
*deck*.py
slides.html
**/_rebuild/assets/
# Test run output.
test-results/
# TIBCO Platform deploy scratch: local artifacts from tibcop deploy runs
# (auth tokens, endpoint/publish JSONs, generated values.yaml with SECRET: blobs).
tp_build/
# Platform build variant of a .flogo (generated for deployment; not source content).
*.platform.flogo

# --- Python ---
# Byte-compiled / cache files from the demo build/helper scripts.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Secrets & environment files ---
# Never commit real credentials. Environment files are ignored by default;
# the tracked *.env.example templates (safe placeholders) are re-included.
.env
*.env
!*.env.example
!.env.example
# Defensive: keys / certs / keystores should not be committed. (Any demo certs
# already tracked upstream are unaffected; this only blocks NEW accidental adds.)
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks

# --- Local scratch / generated artifacts (not shipped) ---
# Generated report artifacts.
reports/
# Local conversation dumps (may contain PII / PHI).
conversations/

# Local skills config holds real credentials (API keys, tokens, passwords).
# Track config.example.md instead; each user copies it to config.md locally.
skills-library/.claude/skills/config.md

# Helm values generated by `tibcop flogo:generate-values-from-build` (flogo-deploy skill).
# Per-app deploy output with a buildId, not a skill asset.
skills-library/values.yaml

# FDA-rebuilt Hospital apps: local verification copies whose .flogo files have
# live secrets (OpenAI key, SMTP app password, DB password) baked in as property
# values. Kept out of the repo so they can't be committed by accident.
samples/Agentic_AI/Hospital_FDA_Rebuild/

# Air Liquide demo (BW6 stack): kept local — carries obfuscated provider creds
# and third-party fixture docs not cleared for redistribution.
samples/Agentic_AI/air_liquide_demo/

# Local scratch / scaffold projects at the repo root (throwaway experiments,
# not demo content). Root-anchored so real demo .flogo files are unaffected.
/flogo-project.flogo
/flogo3.flogo
/testflogo3/

# Pre-governance agentic samples, superseded by the governed samples under
# Industry_Use_Cases/. Kept locally for reference only; not shipped.
samples/Agentic_AI/Industry_Use_Cases_old/

# Deprecated agentic skill, superseded by agentic-ai-use-case-builder.
# Kept locally for reference only; not shipped.
skills-library/.claude/skills/agentic-ai-use-case/

# Internal build cost/time + model estimates for the agentic skill — not shipped to end users.
skills-library/.claude/skills/agentic-ai-use-case-builder/references/build-cost-and-time.md
