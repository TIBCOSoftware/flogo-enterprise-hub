# skills-library/.gitignore
#
# These rules are duplicated from the repo-root .gitignore so they still apply
# when `skills-library/` is opened as its own workspace or distributed on its own
# (a nested .gitignore only ever adds rules — it never loosens the parent's).
# Keep it in sync with the repo-root .gitignore for anything under skills-library/.

# --- Local skills config: holds real credentials (API keys, tokens, passwords) ---
# Track config.example.md instead; each user copies it to config.md locally.
.claude/skills/config.md

# --- Helm values generated by `tibcop flogo:generate-values-from-build` (flogo-deploy skill) ---
# Per-app deploy output with a buildId, not a skill asset.
/values.yaml

# --- Flogo working folder (FLOGO_APPS_DIR default = ../../Flogo_Apps) ---
# Local scratch apps whose .flogo files may have live secrets baked in as
# property values. Never committed.
Flogo_Apps/

# --- Build output ---
bin/
builds/
flogo-engine
*.exe
*.dll
*.dylib
*.so
*_linux
*_darwin
# Running a locally-built Flogo .exe drops a copy of the licence file beside it.
FlogoLicense.bin

# --- Logs / archives / decks ---
*.log
*.zip
*.pptx
*.ppt

# --- Python cache from helper/validator scripts ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Test / scratch output ---
test-results/
reports/
