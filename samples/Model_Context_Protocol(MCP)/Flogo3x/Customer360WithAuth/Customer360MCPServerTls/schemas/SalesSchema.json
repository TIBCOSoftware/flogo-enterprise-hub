{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
        "sale": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "sale_id": {
                        "type": "number"
                    },
                    "sale_date": {
                        "type": "string"
                    },
                    "sale_price": {
                        "type": "string"
                    },
                    "product_name": {
                        "type": "string"
                    },
                    "customer_name": {
                        "type": "string"
                    }
                }
            }
        }
    }
}