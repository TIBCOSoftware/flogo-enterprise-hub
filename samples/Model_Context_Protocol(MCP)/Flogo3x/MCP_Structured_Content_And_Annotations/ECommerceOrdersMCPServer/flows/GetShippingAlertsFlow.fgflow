          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "audience": [
                    "user"
                  ],
                  "data": "SHIPPING ALERTS: [CRITICAL] ORD-2026-78845 — Package stuck at customs (Miami hub) for 5 days. Customer contacted support twice. Escalation required. | [CRITICAL] ORD-2026-78902 — Delivery attempt failed: incorrect address on file. Package returning to sender. Contact customer immediately. | [WARNING] ORD-2026-78867 — Carrier reports weather delay in Pacific Northwest. New ETA: 2 days later than original estimate. | [WARNING] ORD-2026-78910 — Fragile item shipped without protective packaging. Monitor for damage claim.",
                  "priority": 1
                }
              }
            }
          }
        },
        "description": "Simple Return Activity",
        "id": "Return",
        "name": "Return"
      }
    ],
    "triggerHandlers": [
      {
        "action": {
          "input": {
            "arguments": "=$.arguments"
          },
          "output": {
