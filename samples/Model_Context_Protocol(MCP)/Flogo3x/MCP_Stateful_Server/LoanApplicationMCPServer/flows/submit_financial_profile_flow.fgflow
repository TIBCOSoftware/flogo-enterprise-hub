        {
          "name": "arguments",
          "schema": {
            "type": "json",
            "value": "{\"application_ref\":{\"type\":\"string\"},\"annual_income_usd\":{\"type\":\"number\"},\"employment_status\":{\"type\":\"string\"},\"employer_name\":{\"type\":\"string\"},\"monthly_expenses_usd\":{\"type\":\"number\"},\"existing_debt_usd\":{\"type\":\"number\"},\"credit_score\":{\"type\":\"number\"}}"
          },
          "type": "object"
        },
