    "metadata": {
      "fe_metadata": {
        "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"arguments\":{\"type\":\"object\",\"properties\":{\"application_ref\":{\"type\":\"string\"},\"annual_income_usd\":{\"type\":\"number\"},\"employment_status\":{\"type\":\"string\"},\"employer_name\":{\"type\":\"string\"},\"monthly_expenses_usd\":{\"type\":\"number\"},\"existing_debt_usd\":{\"type\":\"number\"},\"credit_score\":{\"type\":\"number\"}}},\"httpHeaders\":{\"type\":\"object\",\"properties\":{}}}}",
        "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}}}"
      },
