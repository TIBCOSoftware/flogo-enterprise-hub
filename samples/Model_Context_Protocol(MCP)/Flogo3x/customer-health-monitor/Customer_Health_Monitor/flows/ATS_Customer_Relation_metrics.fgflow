    "name": "ATS_Customer_Relation_metrics",
    "tasks": [
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/noop"
        },
        "description": "NoOp Activity",
        "id": "StartActivity",
        "name": "StartActivity"
      },
      {
        "activity": {
          "feSchemaMap": {},
          "input": {
            "Connection": "conn://ats-tracker-gsheet.fgconn",
            "Input": {
              "mapping": {
                "cellRange": "A1:H103",
                "sheetId": "TIBCO Accounts",
                "spreadsheetId": "1PRpxypo6tGEQ1zP62DuCw03RaVgNFy52FSJvPKEMXKE"
              }
            },
            "dateTimeRenderOption": "FORMATTED_STRING",
            "majorDimension": "ROWS",
            "valueRenderOption": "FORMATTED_VALUE"
          },
          "ref": "github.com/tibco/wi-gsheets/src/app/GoogleSheets/activity/get",
          "schemas": {
            "input": {
              "Input": {
                "fe_metadata": "{\"type\":\"object\",\"definitions\":{},\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"properties\":{\"spreadsheetId\":{\"type\":\"string\"},\"sheetId\":{\"type\":\"string\",\"description\":\"Enter the sheet name\"},\"cellRange\":{\"type\":\"string\",\"description\":\"Enter the range of cells to get\"}}}",
                "type": "json",
                "value": "{\"type\":\"object\",\"definitions\":{},\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"properties\":{\"spreadsheetId\":{\"type\":\"string\"},\"sheetId\":{\"type\":\"string\",\"description\":\"Enter the sheet name\"},\"cellRange\":{\"type\":\"string\",\"description\":\"Enter the range of cells to get\"}}}"
              }
            },
            "output": {
              "Output": {
                "fe_metadata": "{\"type\":\"object\",\"definitions\":{},\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"properties\":{\"majorDimension\":{\"type\":\"string\"},\"spreadsheetId\":{\"type\":\"string\"},\"sheetId\":{\"type\":\"string\",\"description\":\"Enter the sheet name\"},\"cellRange\":{\"type\":\"string\",\"description\":\"Enter the range of cells to get\"},\"Rows\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"Row\":{\"type\":\"array\",\"items\":{\"type\":\"any\"}}}}}}}",
                "type": "json",
                "value": "{\"type\":\"object\",\"definitions\":{},\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"properties\":{\"majorDimension\":{\"type\":\"string\"},\"spreadsheetId\":{\"type\":\"string\"},\"sheetId\":{\"type\":\"string\",\"description\":\"Enter the sheet name\"},\"cellRange\":{\"type\":\"string\",\"description\":\"Enter the range of cells to get\"},\"Rows\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"Row\":{\"type\":\"array\",\"items\":{\"type\":\"any\"}}}}}}}"
              }
            }
          }
        },
        "description": "Get Google Sheet Data",
        "id": "QueryATSTrackerSheet",
        "name": "QueryATSTrackerSheet"
      },
      {
        "activity": {
          "input": {
            "Log Level": "INFO",
            "flowInfo": false,
            "logLevel": "",
            "message": "=coerce.toString($activity[QueryATSTrackerSheet].Output.Rows)"
          },
          "ref": "github.com/tibco/flogo-general/src/app/General/activity/log"
        },
        "description": "Simple Log Message Activity",
        "id": "LogATSInsights",
        "name": "LogATSInsights"
      },
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/actreturn",
          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "data": "=coerce.toString($activity[QueryATSTrackerSheet].Output)"
                }
              }
            }
          }
        },
        "description": "Simple Return Activity",
        "id": "ReturnSuccess",
        "name": "ReturnSuccess"
      },
      {
        "activity": {
          "input": {
            "Log Level": "INFO",
            "flowInfo": false,
            "logLevel": "",
            "message": "=coerce.toString($error[QueryATSTrackerSheet])"
          },
          "ref": "github.com/tibco/flogo-general/src/app/General/activity/log"
        },
        "description": "Simple Log Message Activity",
        "id": "LogError",
        "name": "LogError"
      },
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/actreturn",
          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "error": "=coerce.toString($error[QueryATSTrackerSheet])"
                }
              }
            }
          }
        },
        "description": "Simple Return Activity",
        "id": "ReturnError",
        "name": "ReturnError"
      }
    ],
