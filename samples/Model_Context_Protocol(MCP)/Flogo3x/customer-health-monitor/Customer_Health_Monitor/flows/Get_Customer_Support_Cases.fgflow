ngth\":80},\"ContactFax\":{\"type\":\"string\",\"maxLength\":40},\"Comments\":{\"type\":\"string\",\"maxLength\":4000},\"LastViewedDate\":{\"type\":\"string\",\"format\":\"date-time\"},\"LastReferencedDate\":{\"type\":\"string\",\"format\":\"date-time\"},\"EngineeringReqNumber__c\":{\"type\":\"string\",\"maxLength\":12},\"SLAViolation__c\":{\"type\":\"string\",\"maxLength\":255},\"Product__c\":{\"type\":\"string\",\"maxLength\":255},\"PotentialLiability__c\":{\"type\":\"string\",\"maxLength\":255},\"Customer_ID__c\":{\"type\":\"string\",\"maxLength\":255},\"Account_Name__c\":{\"type\":\"string\",\"maxLength\":255},\"CaseNumber__c\":{\"type\":\"string\",\"maxLength\":255}}}},\"done\":{\"type\":\"boolean\"},\"totalSize\":{\"type\":\"number\"}}}}}",
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Case\":{\"type\":\"object\",\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"Id\":{\"type\":\"string\",\"maxLength\":18},\"IsDeleted\":{\"type\":\"boolean\"},\"MasterRecordId\":{\"type\":\"string\",\"maxLength\":18},\"CaseNumber\":{\"type\":\"string\",\"maxLength\":30},\"ContactId\":{\"type\":\"string\",\"maxLength\":18},\"AccountId\":{\"type\":\"string\",\"maxLength\":18},\"AssetId\":{\"type\":\"string\",\"maxLength\":18},\"SourceId\":{\"type\":\"string\",\"maxLength\":18},\"ParentId\":{\"type\":\"string\",\"maxLength\":18},\"SuppliedName\":{\"type\":\"string\",\"maxLength\":80},\"SuppliedEmail\":{\"type\":\"string\",\"format\":\"email\",\"maxLength\":80},\"SuppliedPhone\":{\"type\":\"string\",\"maxLength\":40},\"SuppliedCompany\":{\"type\":\"string\",\"maxLength\":80},\"Type\":{\"type\":\"string\",\"maxLength\":255},\"Status\":{\"type\":\"string\",\"maxLength\":255},\"Reason\":{\"type\":\"string\",\"maxLength\":255},\"Origin\":{\"type\":\"string\",\"maxLength\":255},\"Subject\":{\"type\":\"string\",\"maxLength\":255},\"Priority\":{\"type\":\"string\",\"maxLength\":255},\"Description\":{\"type\":\"string\",\"maxLength\":32000},\"IsClosed\":{\"type\":\"boolean\"},\"ClosedDate\":{\"type\":\"string\",\"format\":\"date-time\"},\"IsEscalated\":{\"type\":\"boolean\"},\"OwnerId\":{\"type\":\"string\",\"maxLength\":18},\"CreatedDate\":{\"type\":\"string\",\"format\":\"date-time\"},\"CreatedById\":{\"type\":\"string\",\"maxLength\":18},\"LastModifiedDate\":{\"type\":\"string\",\"format\":\"date-time\"},\"LastModifiedById\":{\"type\":\"string\",\"maxLength\":18},\"SystemModstamp\":{\"type\":\"string\",\"format\":\"date-time\"},\"ContactPhone\":{\"type\":\"string\",\"maxLength\":40},\"ContactMobile\":{\"type\":\"string\",\"maxLength\":40},\"ContactEmail\":{\"type\":\"string\",\"format\":\"email\",\"maxLength\"