                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Account\":{\"type\":\"object\",\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"Id\":{\"type\":\"string\",\"maxLength\":18},\"IsDeleted\":{\"type\":\"boolean\"},\"MasterRecordId\":{\"type\":\"string\",\"maxLength\":18},\"Name\":{\"type\":\"string\",\"maxLength\":255},\"Type\":{\"type\":\"string\",\"maxLength\":255},\"ParentId\":{\"type\":\"string\",\"maxLength\":18},\"BillingStreet\":{\"type\":\"string\",\"maxLength\":255},\"BillingCity\":{\"type\":\"string\",\"maxLength\":40},\"BillingState\":{\"type\":\"string\",\"maxLength\":80},\"BillingPostalCode\":{\"type\":\"string\",\"maxLength\":20},\"BillingCountry\":{\"type\":\"string\",\"maxLength\":80},\"BillingLatitude\":{\"type\":\"number\"},\"BillingLongitude\":{\"type\":\"number\"},\"BillingGeocodeAccuracy\":{\"type\":\"string\",\"maxLength\":40},\"BillingAddress\":{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"},\"country\":{\"type\":\"string\"},\"countryCode\":{\"type\":\"string\"},\"geocodeAccuracy\":{\"type\":\"string\"},\"postalCode\":{\"type\":\"string\"},\"state\":{\"type\":\"string\"},\"stateCode\":{\"type\":\"string\"},\"street\":{\"type\":\"string\"},\"latitude\":{\"type\":\"string\"},\"longitude\":{\"type\":\"string\"}}},\"ShippingStreet\":{\"type\":\"string\",\"maxLength\":255},\"ShippingCity\":{\"type\":\"string\",\"maxLength\":40},\"ShippingState\":{\"type\":\"string\",\"maxLength\":80},\"ShippingPostalCode\":{\"type\":\"string\",\"maxLength\":20},\"ShippingCountry\":{\"type\":\"string\",\"maxLength\":80},\"ShippingLatitude\":{\"type\":\"number\"},\"ShippingLongitude\":{\"type\":\"number\"},\"ShippingGeocodeAccuracy\":{\"type\":\"string\",\"maxLength\":40},\"ShippingAddress\":{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"},\"country\":{\"type\":\"string\"},\"countryCode\":{\"type\":\"string\"},\"ge