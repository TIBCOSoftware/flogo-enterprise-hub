ength\":4},\"SicDesc\":{\"type\":\"string\",\"maxLength\":80},\"DandbCompanyId\":{\"type\":\"string\",\"maxLength\":18},\"CustomerPriority__c\":{\"type\":\"string\",\"maxLength\":255},\"SLA__c\":{\"type\":\"string\",\"maxLength\":255},\"Active__c\":{\"type\":\"string\",\"maxLength\":255},\"NumberofLocations__c\":{\"type\":\"number\"},\"UpsellOpportunity__c\":{\"type\":\"string\",\"maxLength\":255},\"SLASerialNumber__c\":{\"type\":\"string\",\"maxLength\":10},\"SLAExpirationDate__c\":{\"type\":\"string\",\"format\":\"date\"},\"BVG_Agency_Name__c\":{\"type\":\"string\",\"maxLength\":32768},\"Customer_ID__c\":{\"type\":\"string\",\"maxLength\":255},\"TCV__c\":{\"type\":\"number\"},\"Customer_Since__c\":{\"type\":\"string\",\"format\":\"date\"},\"Total_Contract_Value__c\":{\"type\":\"number\"},\"Region__c\":{\"type\":\"string\",\"maxLength\":255},\"Next_Renewal_Date__c\":{\"type\":\"string\",\"format\":\"date\"},\"Licensed_Applications__c\":{\"type\":\"string\",\"maxLength\":255},\"Active_Users__c\":{\"type\":\"number\"},\"Usage_Score__c\":{\"type\":\"number\"},\"Support_Case_Count__c\":{\"type\":\"number\"},\"CSAT_Score__c\":{\"type\":\"number\"},\"Health_Score__c\":{\"type\":\"number\"},\"Churn_Risk__c\":{\"type\":\"string\",\"maxLength\":20}}}},\"done\":{\"type\":\"boolean\"},\"totalSize\":{\"type\":\"number\"}}}}}"
              }
            }
          }
        },
        "description": "Salesforce Query Activity",
        "id": "SalesforceAccountsQuery",
        "name": "SalesforceAccountsQuery"
      },
      {
        "activity": {
          "input": {
            "Log Level": "INFO",
            "flowInfo": false,
            "logLevel": "",
            "message": "=utility.renderJSON( $activity[SalesforceAccountsQuery].output,boolean.false())"
          },
          "ref": "github.com/tibco/flogo-general/src/app/General/activity/log"
        },
        "description": "Simple Log Message Activity",
        "id": "LogAccountsResultFromSF",
        "name": "LogAccountsResultFromSF"
      },
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/actreturn",
          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "data": "=coerce.toString($activity[SalesforceAccountsQuery].output.Account)"
                }
              }
            }
          }
        },
        "description": "Simple Return Activity",
        "id": "ReturnSuccess",
        "name": "ReturnSuccess"
      },
      {
        "activity": {
          "input": {
            "Log Level": "INFO",
            "flowInfo": false,
            "logLevel": "",
            "message": "=coerce.toString($error[coerce.toString($error[SalesforceAccountsQuery])])"
          },
          "ref": "github.com/tibco/flogo-general/src/app/General/activity/log"
        },
        "description": "Simple Log Message Activity",
        "id": "LogErrorFromSalesforceAccounts",
        "name": "LogErrorFromSalesforceAccounts"
      },
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/actreturn",
          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "error": "=coerce.toString($error[SalesforceAccountsQuery])"
                }
              }
            }
          }
        },
        "description": "Simple Return Activity",
        "id": "ReturnError",
        "name": "ReturnError"
      }
    ],
    "triggerHandlers": [
      {
        "action": {
          "input": {
            "arguments": "=$.arguments"
          },
          "output": {
            "response": "=$.response"
          }
        },
        "description": "Tool to query the salesforce accounts object to get customers data",
        "schemas": {
