},\"geocodeAccuracy\":{\"type\":\"string\"},\"postalCode\":{\"type\":\"string\"},\"state\":{\"type\":\"string\"},\"stateCode\":{\"type\":\"string\"},\"street\":{\"type\":\"string\"},\"latitude\":{\"type\":\"string\"},\"longitude\":{\"type\":\"string\"}}},\"Phone\":{\"type\":\"string\",\"maxLength\":40},\"Fax\":{\"type\":\"string\",\"maxLength\":40},\"AccountNumber\":{\"type\":\"string\",\"maxLength\":40},\"Website\":{\"type\":\"string\",\"maxLength\":255},\"PhotoUrl\":{\"type\":\"string\",\"maxLength\":255},\"Sic\":{\"type\":\"string\",\"maxLength\":20},\"Industry\":{\"type\":\"string\",\"maxLength\":255},\"AnnualRevenue\":{\"type\":\"number\"},\"NumberOfEmployees\":{\"type\":\"integer\"},\"Ownership\":{\"type\":\"string\",\"maxLength\":255},\"TickerSymbol\":{\"type\":\"string\",\"maxLength\":20},\"Description\":{\"type\":\"string\",\"maxLength\":32000},\"Rating\":{\"type\":\"string\",\"maxLength\":255},\"Site\":{\"type\":\"string\",\"maxLength\":80},\"OwnerId\":{\"type\":\"string\",\"maxLength\":18},\"CreatedDate\":{\"type\":\"string\",\"format\":\"date-time\"},\"CreatedById\":{\"type\":\"string\",\"maxLength\":18},\"LastModifiedDate\":{\"type\":\"string\",\"format\":\"date-time\"},\"LastModifiedById\":{\"type\":\"string\",\"maxLength\":18},\"SystemModstamp\":{\"type\":\"string\",\"format\":\"date-time\"},\"LastActivityDate\":{\"type\":\"string\",\"format\":\"date\"},\"LastViewedDate\":{\"type\":\"string\",\"format\":\"date-time\"},\"LastReferencedDate\":{\"type\":\"string\",\"format\":\"date-time\"},\"Jigsaw\":{\"type\":\"string\",\"maxLength\":20},\"JigsawCompanyId\":{\"type\":\"string\",\"maxLength\":20},\"CleanStatus\":{\"type\":\"string\",\"maxLength\":40},\"AccountSource\":{\"type\":\"string\",\"maxLength\":255},\"DunsNumber\":{\"type\":\"string\",\"maxLength\":9},\"Tradestyle\":{\"type\":\"string\",\"maxLength\":255},\"NaicsCode\":{\"type\":\"string\",\"maxLength\":8},\"NaicsDesc\":{\"type\":\"string\",\"maxLength\":120},\"YearStarted\":{\"type\":\"string\",