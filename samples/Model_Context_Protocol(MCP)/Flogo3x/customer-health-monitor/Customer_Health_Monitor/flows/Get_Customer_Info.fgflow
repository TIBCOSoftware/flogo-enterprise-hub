            "value": "{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}"
          },
          "type": "object"
        }
      ]
    },
    "name": "Get_Customer_Info",
    "tasks": [
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/noop"
        },
        "description": "NoOp Activity",
        "id": "StartActivity",
        "name": "StartActivity"
      },
      {
        "activity": {
          "feSchemaMap": {},
          "input": {
            "Connection Name": "conn://customer-account-info-sf.fgconn",
            "Object Name": "Account",
            "query": "SELECT Customer_ID__c,Name, Customer_Since__c, Total_Contract_Value__c, Region__c, Next_Renewal_Date__c, Licensed_Applications__c, Active_Users__c, Usage_Score__c, Support_Case_Count__c, CSAT_Score__c, Health_Score__c, Churn_Risk__c FROM Account",
            "queryType": "Query"
          },
          "ref": "github.com/tibco/wi-salesforce/src/app/Salesforce/activity/query",
