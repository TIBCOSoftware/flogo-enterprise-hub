{
  "contrib": "",
  "data": {
    "description": "Tool to query the salesforce accounts object to get customers data",
    "fe_metadata": "",
    "links": [
      {
        "from": "StartActivity",
        "id": 1,
        "label": "StartActivity to SalesforceQuery",
        "to": "SalesforceAccountsQuery",
        "type": "label"
      },
      {
        "from": "SalesforceAccountsQuery",
        "id": 2,
        "label": "SalesforceQuery to LogMessage",
        "to": "LogAccountsResultFromSF",
        "type": "label"
      },
      {
        "from": "LogAccountsResultFromSF",
        "id": 3,
        "label": "LogMessage to Return",
        "to": "ReturnSuccess",
        "type": "label"
      },
      {
        "from": "SalesforceAccountsQuery",
        "id": 4,
        "label": "SalesforceQuery to LogMessage1",
        "to": "LogErrorFromSalesforceAccounts",
        "type": "error"
      },
      {
        "from": "LogErrorFromSalesforceAccounts",
        "id": 5,
        "label": "LogMessage1 to Return1",
        "to": "ReturnError",
        "type": "label"
      }
    ],
    "metadata": {
      "fe_metadata": {
        "input": "{\"type\":\"object\",\"title\":\"MCPServer\",\"properties\":{\"arguments\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{}},\"httpHeaders\":{\"type\":\"params\"}}}",
        "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}},\"required\":[\"response\"]}"
      },
