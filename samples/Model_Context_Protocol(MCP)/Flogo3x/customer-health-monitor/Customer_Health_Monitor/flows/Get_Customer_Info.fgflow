              "type": "json",
              "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
            }
          }
        },
        "settings": {
          "handlerDescription": "get all  customers information from the salesforce account object",
          "handlerName": "GetCustomerInformation",
          "handlerType": "Tool",
          "resourceUri": ""
        },
        "trigger": "trigger://MCPServer.fgtrigger"
      }
    ]
  },
  "imports": [
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/wi-salesforce/src/app/Salesforce/activity/query",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
