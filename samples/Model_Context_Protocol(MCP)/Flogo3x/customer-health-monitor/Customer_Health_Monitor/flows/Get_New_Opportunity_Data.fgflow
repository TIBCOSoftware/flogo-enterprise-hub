        "description": "NoOp Activity",
        "id": "StartActivity",
        "name": "StartActivity"
      },
      {
        "activity": {
          "feSchemaMap": {},
          "input": {
            "Connection": "conn://pg-new-opportunities-data.fgconn",
            "Fields": [
              {
                "FieldName": "opportunity_id",
