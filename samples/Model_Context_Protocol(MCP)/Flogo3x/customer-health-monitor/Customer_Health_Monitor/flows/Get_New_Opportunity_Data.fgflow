                "Type": "LONGVARCHAR",
                "isEditable": false
              },
              {
                "FieldName": "contact_roles",
                "Parameter": false,
                "Selected": true,
                "Type": "LONGVARCHAR",
                "isEditable": false
              }
            ],
            "Query": "SELECT\n    opportunity_id,\n    opportunity_name,\n    customer_id,\n    customer_name,\n    product_name,\n    stage,\n    close_date,\n    amount,\n    opportunity_type,\n    description,\n    contact_roles\nFROM\n    opportunities\nORDER BY\n    close_date DESC;",
            "QueryName": "",
            "RuntimeQuery": "",
            "Schema": "public",
            "State": "f83efa1b-7ba9-41b1-b858-403389f8f02eSELECT\n    opportunity_id,\n    opportunity_name,\n    customer_id,\n    customer_name,\n    product_name,\n    stage,\n    close_date,\n    amount,\n    opportunity_type,\n    description,\n    contact_roles\nFROM\n    opportunities\nORDER BY\n    close_date DESC;",
            "manualmode": false
          },
