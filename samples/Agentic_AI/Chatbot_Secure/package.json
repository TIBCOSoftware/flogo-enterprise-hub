{
  "name": "flogo-chatbot-secure",
  "version": "1.0.0",
  "description": "Secure variant of the Flogo chatbot: a server-side WebSocket proxy that adds Authorization: Bearer <jwt> to the upstream Flogo orchestrator connection",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test/proxy_smoke.js",
    "test:ui": "node test/ui_history.js"
  },
  "keywords": [
    "chatbot",
    "websocket",
    "flogo",
    "express",
    "jwt",
    "proxy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
