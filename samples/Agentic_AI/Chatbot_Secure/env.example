# Server Configuration
PORT=3001
# Interface to bind. Loopback by default; use 0.0.0.0 only behind HTTPS.
HOST=127.0.0.1

# Upstream WebSocket URLs the proxy may open (comma-separated, exact match).
# The first one is pre-filled in the browser.
ALLOWED_UPSTREAMS=ws://localhost:9970/retailbanking

# Optional: URL pre-filled in the browser (must be in ALLOWED_UPSTREAMS)
# WS_URL=ws://localhost:9970/retailbanking

# Session lifetime in minutes (also capped by the JWT's exp claim)
SESSION_TTL_MINUTES=480
# Most sessions kept in memory; when full, new sign-ins get HTTP 429 (live sessions are never ended)
# MAX_SESSIONS=1000
# Sign-in attempts per client address per minute (HTTP 429 above it)
# SIGNIN_PER_MINUTE=10

# Secure cookie flag: auto | true | false  (auto = Secure when served over HTTPS)
COOKIE_SECURE=auto
# Set to true when a TLS-terminating reverse proxy sets X-Forwarded-Proto
TRUST_PROXY=false
# Optional: allowed browser origins (comma-separated, scheme://host[:port], no path). Empty = this server's own origin.
# ALLOWED_ORIGINS=https://chat.example.com
# Optional: extra Host header values to answer to (host or host:port). Loopback names on PORT and the hosts of
# ALLOWED_ORIGINS are always accepted; any other Host gets HTTP 421 (DNS-rebinding defence).
# ALLOWED_HOSTS=chat.internal:3001

# Proxied WebSocket connections: per signed-in session, and in total (HTTP 429 / 503 above them)
# MAX_CONNECTIONS_PER_SESSION=5
# MAX_CONNECTIONS=200
# Seconds between pings to each browser connection (one that misses a pong is closed)
# HEARTBEAT_SECONDS=30

# Direct mode lets the browser connect straight to an upstream with NO token.
# Leave false for JWT-secured samples.
DIRECT_MODE=false
