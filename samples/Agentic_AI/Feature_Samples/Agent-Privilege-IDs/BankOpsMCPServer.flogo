{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "BankOpsMCPServer",
  "description": "Harbor Bank back-office MCP server - every agent has its own privilege ID (JWT sub + scopes)",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "BankOps MCP server - JWT authenticated",
      "settings": {
        "serverName": "BankOpsMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/bankops-mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "JWT Token",
        "authToken": "=$property[\"MCP.JWT_Secret\"]",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "BankOpsMCPServer",
      "handlers": [
        {
          "description": "Show this agent&#39;s own privilege ID as the bank&#39;s agent registry sees it: display name, accountable owner, status, expiry, the scopes in its token and the tools it is entitled to. Use it when asked what you are allowed to do.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "whoami",
            "handlerDescription": "Show this agent's own privilege ID as the bank's agent registry sees it: display name, accountable owner, status, expiry, the scopes in its token and the tools it is entitled to. Use it when asked what you are allowed to do.",
            "toolTitle": "Whoami",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:whoami_flow"
            },
            "input": {
              "arguments": "=$.arguments",
              "tokenInfo": "=$.tokenInfo"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://whoami_Args",
              "tokenInfo": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n      }\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"iss\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"sub\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"aud\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n        }\r\n    },\r\n    \"name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"email\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"given_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"family_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"preferred_username\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n      }\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"iss\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"sub\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"aud\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n        }\r\n    },\r\n    \"name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"email\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"given_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"family_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"preferred_username\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            }
          },
          "name": "whoami_flow"
        },
        {
          "description": "Get an account&#39;s summary: customer name, account type, balance, daily transfer limit, status and its cards (card id, type, last 4 digits, status). Returns access DENIED with a reason if this agent is not permitted, or NOT_FOUND for an unknown account.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_account_summary",
            "handlerDescription": "Get an account's summary: customer name, account type, balance, daily transfer limit, status and its cards (card id, type, last 4 digits, status). Returns access DENIED with a reason if this agent is not permitted, or NOT_FOUND for an unknown account.",
