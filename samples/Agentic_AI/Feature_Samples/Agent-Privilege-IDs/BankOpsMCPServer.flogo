  "resources": [
    {
      "id": "flow:whoami_flow",
      "data": {
        "name": "whoami_flow",
        "description": "Show this agent&#39;s own privilege ID as the bank&#39;s agent registry sees it: display name, accountable owner, status, expiry, the scopes in its token and the tools it is entitled to. Use it when asked what you are allowed to do.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GuardedWrite",
            "name": "GuardedWrite",
            "description": "PostgreSQL Insert",
