  "resources": [
    {
      "id": "flow:oauth_token_flow",
      "data": {
        "name": "oauth_token_flow",
        "description": "OAuth 2.0 client-credentials token endpoint",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "TokenCheck",
            "type": "label",
            "label": "StartActivity to TokenCheck"
          },
          {
            "id": 2,
            "from": "TokenCheck",
            "to": "SignToken",
            "type": "expression",
            "label": "TokenCheck to SignToken",
            "value": "$activity[TokenCheck].Output.records[0].status == 200"
          },
          {
            "id": 3,
            "from": "SignToken",
            "to": "ReturnToken",
            "type": "label",
            "label": "SignToken to ReturnToken"
          },
          {
            "id": 4,
            "from": "TokenCheck",
            "to": "ReturnTokenError",
            "type": "expression",
            "label": "TokenCheck to ReturnTokenError",
            "value": "$activity[TokenCheck].Output.records[0].status != 200"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "TokenCheck",
            "name": "TokenCheck",
            "description": "Check the client, compute claims",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://ff56a8bb-c006-435f-a422-69b02b67143b",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT t.*, '{\"alg\":\"HS256\",\"typ\":\"JWT\"}' AS jwt_header FROM token_request(CAST(?r_auth AS text), CAST(?r_grant AS text), CAST(?r_cid AS text), CAST(?r_sec AS text), CAST(?r_scope AS text), CAST(?r_ttl AS text)) t;",
                "manualmode": false,
                "fetchMetadata": false,
                "Fields": [
                  {
                    "FieldName": "r_auth",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "r_grant",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "r_cid",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "r_sec",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "r_scope",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "r_ttl",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "status",
                    "Type": "INTEGER",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "error",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "client_id",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "scope",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "expires_in",
                    "Type": "INTEGER",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "claims",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "jwt_header",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "d6ed6b72-770b-49b2-be0a-78faa0976f7cSELECT t.*, '{\"alg\":\"HS256\",\"typ\":\"JWT\"}' AS jwt_header FROM token_request(CAST(?r_auth AS text), CAST(?r_grant AS text), CAST(?r_cid AS text), CAST(?r_sec AS text), CAST(?r_scope AS text), CAST(?r_ttl AS text)) t;",
                "input": {
                  "mapping": {
                    "parameters": {
                      "r_auth": "=coerce.toString($flow.headers.Authorization)",
                      "r_grant": "=coerce.toString($flow.body.grant_type)",
                      "r_cid": "=coerce.toString($flow.body.client_id)",
                      "r_sec": "=coerce.toString($flow.body.client_secret)",
                      "r_scope": "=coerce.toString($flow.body.scope)",
                      "r_ttl": "=$property[\"Gateway.Token_TTL_Seconds\"]"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"r_auth\":{\"type\":\"string\"},\"r_grant\":{\"type\":\"string\"},\"r_cid\":{\"type\":\"string\"},\"r_sec\":{\"type\":\"string\"},\"r_scope\":{\"type\":\"string\"},\"r_ttl\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"r_auth\":{\"type\":\"string\"},\"r_grant\":{\"type\":\"string\"},\"r_cid\":{\"type\":\"string\"},\"r_sec\":{\"type\":\"string\"},\"r_scope\":{\"type\":\"string\"},\"r_ttl\":{\"type\":\"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"integer\"},\"error\":{\"type\":\"string\"},\"client_id\":{\"type\":\"string\"},\"scope\":{\"type\":\"string\"},\"expires_in\":{\"type\":\"integer\"},\"claims\":{\"type\":\"string\"},\"jwt_header\":{\"type\":\"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"integer\"},\"error\":{\"type\":\"string\"},\"client_id\":{\"type\":\"string\"},\"scope\":{\"type\":\"string\"},\"expires_in\":{\"type\":\"integer\"},\"claims\":{\"type\":\"string\"},\"jwt_header\":{\"type\":\"string\"}}}}}}"
                  }
                }
              },
