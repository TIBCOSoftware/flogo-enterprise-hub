                    "type": "json",
                    "value": "{\"properties\":{\"header\":{\"type\":\"string\"},\"payload\":{\"type\":\"string\"},\"secret\":{\"type\":\"string\"},\"algorithm\":{\"type\":\"string\",\"enum\":[\"HS256\",\"HS384\",\"HS512\",\"RS256\",\"RS384\",\"RS512\",\"ES256\",\"ES384\",\"ES512\"]}},\"required\":[\"header\",\"payload\",\"secret\",\"algorithm\"],\"type\":\"object\"}",
