                    "fe_metadata": "{\"properties\":{\"token\":{\"type\":\"string\"},\"secret\":{\"type\":\"string\"},\"algorithm\":{\"type\":\"string\",\"enum\":[\"HS256\",\"HS384\",\"HS512\",\"RS256\",\"RS384\",\"RS512\",\"ES256\",\"ES384\",\"ES512\"]}},\"required\":[\"token\",\"secret\",\"algorithm\"],\"type\":\"object\"}"
