            "activity": {
              "ref": "#jwt",
              "settings": {
                "mode": "Sign"
              },
              "input": {
                "input": {
                  "mapping": {
                    "header": "=$activity[TokenCheck].Output.records[0].jwt_header",
                    "payload": "=$activity[TokenCheck].Output.records[0].claims",
