    {
      "id": "flow:ask_insight_agent_flow",
      "data": {
        "name": "ask_insight_agent_flow",
        "description": "Delegate a READ-ONLY question to the Customer Insight Agent: account summaries (balance, limit, cards) and recent transactions. Pass the staff member&#39;s request in full, including account ids. Returns the agent&#39;s answer, or DELEGATION_REFUSED with a reason.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "GateCheck",
            "type": "label",
            "label": "GuardedWrite to GateCheck"
          },
          {
            "id": 3,
            "from": "GateCheck",
            "to": "CustomerInsightAgent",
            "type": "expression",
            "label": "GateCheck to CustomerInsightAgent",
            "value": "$activity[GateCheck].Output.records[0].decision == \"ALLOWED\""
          },
          {
            "id": 4,
            "from": "CustomerInsightAgent",
            "to": "ReturnOK",
            "type": "label",
            "label": "CustomerInsightAgent to ReturnOK"
          },
          {
            "id": 5,
            "from": "GateCheck",
            "to": "ReturnDenied",
            "type": "expression",
            "label": "GateCheck to ReturnDenied",
            "value": "$activity[GateCheck].Output.records[0].decision != \"ALLOWED\""
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Connection": "conn://0f6971ac-bfd2-413b-aac8-296dd8689aee",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO agent_audit (agent_id, tool, target, decision, reason, detail) SELECT * FROM delegation_audit_row(CAST(?w_caller AS text), 'ask_insight_agent', CAST(?w_req AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_caller",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_req",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "fdab95a1-ea29-4304-83dc-87413566f243INSERT INTO agent_audit (agent_id, tool, target, decision, reason, detail) SELECT * FROM delegation_audit_row(CAST(?w_caller AS text), 'ask_insight_agent', CAST(?w_req AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "w_caller": "=$flow.tokenInfo.sub",
                      "w_req": "=$flow.arguments.request"
                    }
                  }
                }
              },
