              "name": "tokenInfo",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"scopes\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"expiration\": {\"type\": \"number\"}, \"iss\": {\"type\": \"string\"}, \"sub\": {\"type\": \"string\"}, \"aud\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"name\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}}"
              }
            }
          ],
          "output": [
            {
              "name": "response",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"type\": \"object\", \"title\": \"BankOpsSpecialists\", \"properties\": {\"arguments\": {\"type\": \"object\", \"properties\": {\"request\": {\"type\": \"string\", \"description\": \"The staff member's request in full, in plain words, including account ids, card details and the reason\"}}, \"required\": [\"request\"]}, \"tokenInfo\": {\"type\": \"object\", \"properties\": {\"scopes\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"expiration\": {\"type\": \"number\"}, \"iss\": {\"type\": \"string\"}, \"sub\": {\"type\": \"string\"}, \"aud\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"name\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}}}}}",
            "output": "{\"type\": \"object\", \"title\": \"Inputs\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}, \"required\": [\"response\"]}"
          }
        }
      }
