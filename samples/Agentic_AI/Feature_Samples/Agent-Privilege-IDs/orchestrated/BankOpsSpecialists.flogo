  "name": "BankOpsSpecialists",
  "description": "Harbor Bank specialist AI agents exposed as JWT-protected MCP tools (orchestrated variant)",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "BankOpsSpecialists",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/bankops-specialists-mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "JWT Token",
        "authToken": "=$property[\"MCP.JWT_Secret\"]",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "BankOpsSpecialists",
      "name": "BankOpsSpecialists",
      "description": "Specialist agents as MCP tools - JWT authenticated",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "ask_insight_agent",
            "handlerDescription": "Delegate a READ-ONLY question to the Customer Insight Agent: account summaries (balance, limit, cards) and recent transactions. Pass the staff member's request in full, including account ids. Returns the agent's answer, or DELEGATION_REFUSED with a reason.",
            "toolTitle": "Ask Insight Agent",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": "agent:insight"
          },
          "action": {
            "input": {
              "arguments": "=$.arguments",
              "tokenInfo": "=$.tokenInfo"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:ask_insight_agent_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "ask_insight_agent_flow",
          "description": "Delegate a READ-ONLY question to the Customer Insight Agent: account summaries (balance, limit, cards) and recent transactions. Pass the staff member's request in full, including account ids. Returns the agent's answer, or DELEGATION_REFUSED with a reason.",
          "schemas": {
            "output": {
              "arguments": "schema://ask_insight_agent_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "ask_servicing_agent",
            "handlerDescription": "Delegate a SERVICING request to the Card Servicing Agent: block a lost, stolen or compromised card; request a higher daily transfer limit (always decided by a human supervisor); check an approval request's status. Pass the staff member's request in full, including account and card details and the reason. Returns the agent's answer, or DELEGATION_REFUSED with a reason.",
            "toolTitle": "Ask Servicing Agent",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": "agent:servicing"
          },
          "action": {
            "input": {
              "arguments": "=$.arguments",
              "tokenInfo": "=$.tokenInfo"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:ask_servicing_agent_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "ask_servicing_agent_flow",
          "description": "Delegate a SERVICING request to the Card Servicing Agent: block a lost, stolen or compromised card; request a higher daily transfer limit (always decided by a human supervisor); check an approval request's status. Pass the staff member's request in full, including account and card details and the reason. Returns the agent's answer, or DELEGATION_REFUSED with a reason.",
          "schemas": {
            "output": {
              "arguments": "schema://ask_servicing_agent_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        }
      ]
    }
  ],
