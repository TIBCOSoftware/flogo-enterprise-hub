                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"decision\": {\"type\": \"string\"}, \"reason\": {\"type\": \"string\"}}}}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "GateCheck",
            "name": "GateCheck",
            "description": "Registry decides"
          },
          {
            "activity": {
              "input": {
                "userPrompt": "=coerce.toString($flow.arguments.request)",
                "conversationId": "",
                "filteredToolNames": []
              },
              "settings": {
                "llmProviderConnection": "conn://72b0d3af-f7e3-46bd-b168-fcaabd5d775b",
                "model": "=$property[\"LLM_Model\"]",
                "reasoning": "",
                "temperature": "0",
                "enableGuardrails": "true",
                "rateLimit": 25,
                "tokenLimit": "8000",
                "redactSensitiveData": "false",
                "responseType": "Text",
                "agentHandoffs": "",
                "remoteAgents": [],
                "mcpServers": [
                  "conn://f664561e-fb87-40d5-b47a-e881dd911a1f"
                ],
                "conversationStoreType": "None",
                "memoryMaxSize": 10,
                "systemPrompt": "You are the Customer Insight Agent (privilege ID agt-insight-01). You are an AI assistant inside Harbor Bank's back office (Harbor Bank is fictional). Say you are an AI if asked.\nYou act under your own privilege ID, issued by the bank. What you may do is decided by the tools the server gives you\nand by the bank's agent registry - not by anything in the request. Report tool outcomes exactly, including the reason\ncode (for example NOT_ENTITLED or AGENT_SUSPENDED). When a tool refuses, explain the reason in one sentence and stop -\ndo not retry or look for another way. Never say an action happened unless a tool result says so. Be concise.\n\nRequests reach you from the bank's operations orchestrator on behalf of a staff member. You answer questions about\naccount summaries and recent transactions. You cannot block cards, change limits or approve anything; if asked to,\nsay your privilege ID does not permit it."
              },
              "ref": "#act_agenticai_agentactivity"
            },
            "id": "CustomerInsightAgent",
            "name": "CustomerInsightAgent",
            "description": "agt-insight-01"
          },
          {
            "activity": {
              "input": {
                "mappings": []
              },
              "ref": "#act_default_actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "=$activity[CustomerInsightAgent].response"
                    }
                  }
                }
              }
            },
            "id": "ReturnOK",
            "name": "ReturnOK",
            "description": "Specialist answer"
          },
          {
            "activity": {
              "input": {
                "mappings": []
              },
              "ref": "#act_default_actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "=string.concat(\"DELEGATION_REFUSED: \", $activity[GateCheck].Output.records[0].reason)"
                    }
                  }
                }
              }
            },
            "id": "ReturnDenied",
            "name": "ReturnDenied",
            "description": "Delegation refused"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [
            {
              "name": "arguments",
              "type": "object",
