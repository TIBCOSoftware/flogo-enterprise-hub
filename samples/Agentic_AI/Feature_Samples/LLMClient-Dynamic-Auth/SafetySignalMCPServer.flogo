                    "mapping": {
                      "data": "{\"product_code\":\"IMP-4471\",\"reaction_term\":\"Hepatic failure\",\"reference_safety_information\":\"Investigator's Brochure v6.0, Section 6.3 (effective 2026-02-01)\",\"listed\":false,\"expectedness\":\"UNEXPECTED\",\"rationale\":\"Hepatic failure is not described in the Reference Safety Information in force. Section 6.3 lists asymptomatic transaminase elevation only, which is not of the same nature, severity or specificity as hepatic failure and therefore does not make this event listed.\",\"nearest_listed_term\":\"Transaminases increased (Grade 1-2, asymptomatic)\",\"regulatory_consequence\":\"If the case is also serious and the investigator or sponsor assesses at least a reasonable possibility of causal relationship, it meets the definition of a SUSAR under ICH E2A and EU CT Regulation 536/2014 Article 42.\",\"reporting_clock\":{\"fatal_or_life_threatening\":\"7 calendar days for the initial report, 8 further days for the follow-up report\",\"other_serious\":\"15 calendar days\"},\"clock_start_definition\":\"Day zero is the date the sponsor first receives the minimum criteria: identifiable patient, identifiable reporter, suspect product, and suspect reaction.\"}",
                      "error": ""
                    }
