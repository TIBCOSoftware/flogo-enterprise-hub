            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "{\"product_code\":\"IMP-4471\",\"reaction_term\":\"Hepatic failure\",\"meddra_soc\":\"Hepatobiliary disorders\",\"meddra_version\":\"29.0\",\"subjects_exposed\":1240,\"matching_cases\":3,\"cases\":[{\"case_number\":\"ICSR-2026-00874\",\"onset_date\":\"2026-03-18\",\"country\":\"DE\",\"seriousness\":\"Serious - Hospitalisation\",\"outcome\":\"Recovered with sequelae\",\"causality_investigator\":\"Possible\",\"dechallenge\":\"Positive - ALT normalised 21 days after discontinuation\"},{\"case_number\":\"ICSR-2026-01133\",\"onset_date\":\"2026-04-02\",\"country\":\"US\",\"seriousness\":\"Serious - Hospitalisation\",\"outcome\":\"Recovering\",\"causality_investigator\":\"Probable\",\"dechallenge\":\"Positive\"},{\"case_number\":\"ICSR-2026-01402\",\"onset_date\":\"2026-05-27\",\"country\":\"JP\",\"seriousness\":\"Serious - Life-threatening\",\"outcome\":\"Recovered\",\"causality_investigator\":\"Probable\",\"dechallenge\":\"Positive\"}],\"observed_rate_per_1000\":2.42,\"background_rate_per_1000\":0.14,\"signal_status\":\"Under evaluation\",\"signal_opened\":\"2026-04-11\",\"signal_owner\":\"Global Drug Safety - Hepatology Signal Team\",\"note\":\"Observed rate exceeds the population background rate by roughly 17-fold. Any new hepatic case must be routed to the signal team in parallel with expedited reporting.\"}",
                      "error": ""
                    }
                  }
                }
              }
            }
          }
