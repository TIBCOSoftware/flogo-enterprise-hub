{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver"
  ],
  "name": "SafetySignalMCPServer",
  "description": "Authenticated MCP server with read only drug safety lookup tools",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Drug safety MCP server protected with bearer token authentication",
      "settings": {
        "serverName": "SafetySignalMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"FlogoMcpServer.PORT\"]",
        "statelessServer": true,
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "=$property[\"FlogoMcpServer.AUTH_TYPE\"]",
        "authToken": "=$property[\"FlogoMcpServer.AUTH_TOKEN\"]",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "SafetySignalServer",
      "handlers": [
        {
          "description": "Returns mock investigational product details",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "lookup_investigational_product",
            "handlerDescription": "Look up an investigational product by product code. Returns the product name, study protocol, phase, indication, route, sponsor and the reference safety information version in force. Requires the product:read scope in JWT Token mode.",
            "toolTitle": "Lookup Investigational Product",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": "product:read"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:LookupInvestigationalProductFlow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"product_code\":{\"type\":\"string\",\"description\":\"Investigational product code, for example IMP-4471\"}},\"required\":[\"product_code\"],\"additionalProperties\":false}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"product_code\":{\"type\":\"string\",\"description\":\"Investigational product code, for example IMP-4471\"}},\"required\":[\"product_code\"],\"additionalProperties\":false}"
              }
            }
          },
          "name": "LookupInvestigationalProductFlow"
        },
        {
          "description": "Returns mock prior case history",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "search_case_history",
            "handlerDescription": "Search the safety database for earlier cases with the same product and reaction term. Returns the matching case count, the number of subjects exposed, the outcomes and whether a safety signal is already under review. Requires the cases:read scope in JWT Token mode.",
            "toolTitle": "Search Case History",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": "cases:read"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:SearchCaseHistoryFlow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"product_code\":{\"type\":\"string\",\"description\":\"Investigational product code, for example IMP-4471\"},\"reaction_term\":{\"type\":\"string\",\"description\":\"Reaction term, for example Hepatic failure\"}},\"required\":[\"product_code\",\"reaction_term\"],\"additionalProperties\":false}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"product_code\":{\"type\":\"string\",\"description\":\"Investigational product code, for example IMP-4471\"},\"reaction_term\":{\"type\":\"string\",\"description\":\"Reaction term, for example Hepatic failure\"}},\"required\":[\"product_code\",\"reaction_term\"],\"additionalProperties\":false}"
              }
            }
          },
          "name": "SearchCaseHistoryFlow"
        },
        {
          "description": "Returns mock expectedness assessment",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "check_label_expectedness",
            "handlerDescription": "Check whether a reaction is listed or unlisted in the reference safety information for a product. A serious unlisted reaction with a reasonable causal relationship is a SUSAR and needs expedited reporting. Requires the labeling:read scope in JWT Token mode.",
            "toolTitle": "Check Label Expectedness",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": "labeling:read"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:CheckLabelExpectednessFlow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"product_code\":{\"type\":\"string\",\"description\":\"Investigational product code, for example IMP-4471\"},\"reaction_term\":{\"type\":\"string\",\"description\":\"Reaction term to check against the reference safety information\"}},\"required\":[\"product_code\",\"reaction_term\"],\"additionalProperties\":false}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"product_code\":{\"type\":\"string\",\"description\":\"Investigational product code, for example IMP-4471\"},\"reaction_term\":{\"type\":\"string\",\"description\":\"Reaction term to check against the reference safety information\"}},\"required\":[\"product_code\",\"reaction_term\"],\"additionalProperties\":false}"
              }
            }
          },
          "name": "CheckLabelExpectednessFlow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:LookupInvestigationalProductFlow",
      "data": {
        "name": "LookupInvestigationalProductFlow",
        "description": "Returns mock investigational product details",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Return",
