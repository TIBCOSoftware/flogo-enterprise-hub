            "label": "StartActivity to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Simple Return Activity",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "{\"product_code\":\"IMP-4471\",\"inn\":\"Velcaridine\",\"product_class\":\"Anti-IL-6R monoclonal antibody\",\"sponsor\":\"Northwind Therapeutics\",\"protocol_id\":\"VEL-301\",\"phase\":\"Phase III\",\"indication\":\"Moderate-to-severe rheumatoid arthritis in adults with inadequate response to methotrexate\",\"route_of_administration\":\"Subcutaneous injection, 162 mg every 2 weeks\",\"blinding\":\"Double-blind, placebo-controlled\",\"subjects_exposed\":1240,\"reference_safety_information\":{\"document\":\"Investigator's Brochure v6.0, Section 6.3\",\"effective_date\":\"2026-02-01\",\"listed_adverse_reactions\":[\"Injection site reaction\",\"Headache\",\"Upper respiratory tract infection\",\"Nausea\",\"Neutropenia\",\"Hypercholesterolaemia\"]},\"active_safety_concerns\":[\"Hepatic events under signal evaluation since 2026-04-11\"],\"pv_contact\":\"drugsafety@northwind-tx.example\"}",
                      "error": ""
                    }
                  }
                }
              }
            }
