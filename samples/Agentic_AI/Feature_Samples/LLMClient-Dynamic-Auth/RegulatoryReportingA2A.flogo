{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/trigger/agent",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider"
  ],
  "name": "RegulatoryReportingA2A",
  "description": "Token authenticated A2A server that creates safety cases and files expedited reports",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "Regulatory reporting A2A server on port 9222 with static token authentication",
      "settings": {
        "llmProviderConnection": "conn://pv2a1111-2222-3333-4444-555566667777",
        "agentName": "=$property[\"Trigger_Settings.AgentName\"]",
        "agentDescription": "=$property[\"Trigger_Settings.AgentDescription\"]",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"A2A.port\"]",
        "agentUrl": "=$property[\"A2A.AgentUrl\"]",
        "agentAuthMode": "=$property[\"A2A.AuthMode\"]",
        "agentToken": "=$property[\"A2A.AuthToken\"]",
        "model": "=$property[\"Trigger_Settings.LLM_Model\"]",
        "reasoning": "",
        "temperature": "=$property[\"Trigger_Settings.LLM_temperature\"]",
        "enableGuardrails": false,
        "rateLimit": "=$property[\"Trigger_Settings.Rate_Limit\"]",
        "tokenLimit": "=$property[\"Trigger_Settings.Token_Limit\"]",
        "redactSensitiveData": true,
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": 20,
        "systemPrompt": "You are a regulatory reporting agent for a pharmaceutical sponsor's Global Drug Safety function, exposed over the A2A protocol.\n\nYou are called by safety intake agents once a case has been triaged and needs to be recorded in the safety database or filed with a health authority. Every caller is authenticated with a static bearer token before reaching you — treat an authenticated call as authorisation to write.\n\n## Your Tools\n\n- **create_safety_case**: Open a new Individual Case Safety Report (ICSR) in the safety database. Returns the case number, the SUSAR determination, and the regulatory reporting clock.\n- **submit_expedited_report**: File an E2B(R3) expedited report for an existing case to one named health authority. `destination` must be exactly `FDA` or `EMA`, and each call files with that one authority only — to file with both, call the tool twice and report both acknowledgements. Returns the submission identifier and the acknowledgement code.\n- **get_case_status**: Look up the current workflow status, reporting clock, and submission history of an existing case.\n\n## Behavior Guidelines\n\n- Never invent a case number. Only reference case numbers returned by create_safety_case or supplied by the caller.\n- Do not call submit_expedited_report unless the case has already been created and the caller has confirmed that an expedited submission is required.\n- Always state the regulatory clock (7-day or 15-day) and the due date in your reply so the caller can relay it.\n- Report the SUSAR determination explicitly: a case is a SUSAR only when it is serious, unexpected against the Reference Safety Information, and has at least a reasonable possibility of causal relationship.\n- Keep replies concise and factual — the caller is another agent, not a person."
      },
      "id": "RegulatoryReportingA2AServer",
      "handlers": [
        {
          "description": "Creates a new safety case with mock data",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "create_safety_case",
            "agentToolDescription": "Create a new safety case from a triaged adverse event. All fields are required: the product code, reaction term, seriousness, expectedness, causality, a de-identified subject reference and the case narrative. The SUSAR decision needs all three ICH E2A criteria together: the case must be serious, UNEXPECTED against the reference safety information, and assessed as Related, Probable or Possible. Miss any one of them and the case is opened without an expedited clock and aggregated into the next DSUR. When it is a SUSAR the clock comes from the seriousness criterion - 7 calendar days for death or a life-threatening event, 15 calendar days for the other serious criteria. Returns the case number, the SUSAR decision and the reporting due date.",
            "agentSkillTags": "create_safety_case,icsr,adverse event,pharmacovigilance,case intake,susar",
            "agentSkillExamples": "Open an ICSR for IMP-4471, hepatic failure, serious due to hospitalisation, unexpected, probable causality.|Create a safety case for subject VEL-301-0442 with hepatic failure on Velcaridine, unexpected and probably related.|Record the same reaction as listed in the Investigator's Brochure so it is captured without starting an expedited clock.|Log a life-threatening unexpected hepatic event on VEL-301 that is probably related to the study drug.|Open a case for a serious unexpected event the investigator assessed as unrelated.",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:create_safety_case_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"product_code\":{\"type\":\"string\",\"description\":\"Investigational product code, for example IMP-4471\"},\"reaction_term\":{\"type\":\"string\",\"description\":\"MedDRA preferred term for the reaction, for example Hepatic failure\"},\"seriousness\":{\"type\":\"string\",\"description\":\"ICH E2A seriousness criterion met. Non-serious cases cannot be SUSARs; Death and Life-threatening carry the 7-day clock, the other serious criteria carry 15 days\",\"enum\":[\"Non-serious\",\"Serious - Death\",\"Serious - Life-threatening\",\"Serious - Hospitalisation\",\"Serious - Disability\",\"Serious - Congenital anomaly\",\"Serious - Other medically important\"]},\"expectedness\":{\"type\":\"string\",\"description\":\"Whether the reaction is listed in the reference safety information\",\"enum\":[\"LISTED\",\"UNEXPECTED\"]},\"causality\":{\"type\":\"string\",\"description\":\"Investigator causality assessment. Related, Probable and Possible all count as a reasonable possibility of causal relationship; Unlikely and Unrelated do not\",\"enum\":[\"Related\",\"Probable\",\"Possible\",\"Unlikely\",\"Unrelated\"]},\"patient_reference\":{\"type\":\"string\",\"description\":\"De-identified subject reference, for example VEL-301-0442\"},\"narrative\":{\"type\":\"string\",\"description\":\"Clinical narrative describing the event and its clinical course\"}},\"required\":[\"product_code\",\"reaction_term\",\"seriousness\",\"expectedness\",\"causality\",\"patient_reference\",\"narrative\"],\"additionalProperties\":false}",
                "fe_metadata": "{\"product_code\":\"IMP-4471\",\"reaction_term\":\"Hepatic failure\",\"seriousness\":\"Serious - Hospitalisation\",\"expectedness\":\"UNEXPECTED\",\"causality\":\"Probable\",\"patient_reference\":\"VEL-301-0442\",\"narrative\":\"Subject presented with jaundice and ALT 14x ULN on day 63 of treatment; admitted for observation.\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "create_safety_case_flow"
        },
        {
          "description": "Files an expedited report with mock data",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "submit_expedited_report",
            "agentToolDescription": "File an expedited report for an existing safety case to one health authority. The destination must be exactly FDA or EMA - each call files with a single authority, so call this tool twice to file with both. Returns the submission id, the acknowledgement code, the timestamp and the time left on the reporting clock. Only call this for a case that already exists and needs expedited reporting.",
            "agentSkillTags": "submit_expedited_report,e2b,susar,expedited reporting,fda,ema,regulatory submission",
            "agentSkillExamples": "Submit the expedited report for ICSR-2026-01588 to the FDA.|File case ICSR-2026-01588 with EMA EudraVigilance.|Transmit the 15-day report for this SUSAR to both agencies.",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:submit_expedited_report_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"case_number\":{\"type\":\"string\",\"description\":\"Existing safety case number, for example ICSR-2026-01588\"},\"destination\":{\"type\":\"string\",\"description\":\"The single health authority to file this report with. Filing with both requires two separate calls.\",\"enum\":[\"FDA\",\"EMA\"]}},\"required\":[\"case_number\",\"destination\"],\"additionalProperties\":false}",
                "fe_metadata": "{\"case_number\":\"ICSR-2026-01588\",\"destination\":\"FDA\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "submit_expedited_report_flow"
        },
        {
          "description": "Returns mock safety case status",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "get_case_status",
            "agentToolDescription": "Look up the current status of a safety case by case number. Returns the case state, the medical reviewer, the reporting due date, the submission history and any open follow up requests.",
            "agentSkillTags": "get_case_status,icsr,case tracking,regulatory clock,follow-up",
            "agentSkillExamples": "What is the status of ICSR-2026-01588?|Has case ICSR-2026-01588 been submitted to EMA yet?|How many days are left on the reporting clock for ICSR-2026-01588?",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_case_status_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"case_number\":{\"type\":\"string\",\"description\":\"Existing safety case number, for example ICSR-2026-01588\"}},\"required\":[\"case_number\"],\"additionalProperties\":false}",
                "fe_metadata": "{\"case_number\":\"ICSR-2026-01588\"}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "get_case_status_flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:create_safety_case_flow",
      "data": {
        "name": "create_safety_case_flow",
        "description": "Creates a new safety case with mock data",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Return",
            "type": "label",
            "label": "StartActivity to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Returns the mock case record, classified from seriousness, expectedness and causality together.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "@conditional": [
                      {
                        "$flow.toolParams.expectedness == 'UNEXPECTED' && ($flow.toolParams.causality == 'Related' || $flow.toolParams.causality == 'Probable' || $flow.toolParams.causality == 'Possible') && ($flow.toolParams.seriousness == 'Serious - Death' || $flow.toolParams.seriousness == 'Serious - Life-threatening')": {
                          "data": "{\"case_number\":\"ICSR-2026-01587\",\"case_version\":1,\"status\":\"Open - Awaiting medical review\",\"product_code\":\"IMP-4471\",\"inn\":\"Velcaridine\",\"protocol_id\":\"VEL-301\",\"patient_reference\":\"VEL-301-0442\",\"reaction_term\":\"Hepatic failure\",\"meddra_soc\":\"Hepatobiliary disorders\",\"seriousness\":\"Serious - Life-threatening\",\"expectedness\":\"UNEXPECTED\",\"causality_sponsor\":\"Probable\",\"susar\":true,\"susar_rationale\":\"Life-threatening, unexpected against Investigator's Brochure v6.0, and a reasonable possibility of causal relationship. ICH E2A puts fatal and life-threatening SUSARs on the shorter 7-day clock.\",\"receipt_date\":\"2026-09-25\",\"clock_start_date\":\"2026-09-25\",\"reporting_clock\":\"7 calendar days\",\"submission_due_date\":\"2026-10-02\",\"assigned_to\":\"Dr. Priya Raman - Medical Safety Physician\",\"signal_team_notified\":true,\"signal_reference\":\"SIG-2026-0033 (Hepatic events, IMP-4471)\",\"blinding_status\":\"Unblinding requested for regulatory submission\",\"next_action\":\"Immediate medical review, then expedited submission to FDA and EMA before 2026-10-02. A follow-up report with the complete narrative is due within a further 8 days.\",\"message\":\"Case ICSR-2026-01587 created and classified as a SUSAR. Because the event is life-threatening the 7-day expedited clock applies: it started on 2026-09-25 and expires on 2026-10-02.\"}",
                          "error": ""
                        }
                      },
                      {
                        "$flow.toolParams.expectedness == 'UNEXPECTED' && ($flow.toolParams.causality == 'Related' || $flow.toolParams.causality == 'Probable' || $flow.toolParams.causality == 'Possible') && ($flow.toolParams.seriousness == 'Serious - Hospitalisation' || $flow.toolParams.seriousness == 'Serious - Disability' || $flow.toolParams.seriousness == 'Serious - Congenital anomaly' || $flow.toolParams.seriousness == 'Serious - Other medically important')": {
                          "data": "{\"case_number\":\"ICSR-2026-01588\",\"case_version\":1,\"status\":\"Open - Awaiting medical review\",\"product_code\":\"IMP-4471\",\"inn\":\"Velcaridine\",\"protocol_id\":\"VEL-301\",\"patient_reference\":\"VEL-301-0442\",\"reaction_term\":\"Hepatic failure\",\"meddra_soc\":\"Hepatobiliary disorders\",\"seriousness\":\"Serious - Hospitalisation\",\"expectedness\":\"UNEXPECTED\",\"causality_sponsor\":\"Probable\",\"susar\":true,\"susar_rationale\":\"Serious plus unexpected against Investigator's Brochure v6.0 plus a reasonable possibility of causal relationship.\",\"receipt_date\":\"2026-09-25\",\"clock_start_date\":\"2026-09-25\",\"reporting_clock\":\"15 calendar days\",\"submission_due_date\":\"2026-10-10\",\"assigned_to\":\"Dr. Priya Raman - Medical Safety Physician\",\"signal_team_notified\":true,\"signal_reference\":\"SIG-2026-0033 (Hepatic events, IMP-4471)\",\"blinding_status\":\"Unblinding requested for regulatory submission\",\"next_action\":\"Medical review then expedited submission to FDA and EMA before 2026-10-10.\",\"message\":\"Case ICSR-2026-01588 created and classified as a SUSAR. The 15-day regulatory clock started on 2026-09-25 and expires on 2026-10-10. The hepatology signal team has been notified under SIG-2026-0033.\"}",
                          "error": ""
                        }
                      },
                      {
                        "$flow.toolParams.expectedness == 'UNEXPECTED' && ($flow.toolParams.causality == 'Unlikely' || $flow.toolParams.causality == 'Unrelated') && $flow.toolParams.seriousness != 'Non-serious'": {
                          "data": "{\"case_number\":\"ICSR-2026-01590\",\"case_version\":1,\"status\":\"Open - Awaiting medical review\",\"product_code\":\"IMP-4471\",\"inn\":\"Velcaridine\",\"protocol_id\":\"VEL-301\",\"patient_reference\":\"VEL-301-0442\",\"reaction_term\":\"Hepatic failure\",\"meddra_soc\":\"Hepatobiliary disorders\",\"seriousness\":\"Serious - Hospitalisation\",\"expectedness\":\"UNEXPECTED\",\"causality_sponsor\":\"Unrelated\",\"susar\":false,\"susar_rationale\":\"Serious and unexpected, but the investigator did not assess a reasonable possibility of causal relationship. All three ICH E2A criteria must be met, so this is not a SUSAR and no expedited clock starts.\",\"receipt_date\":\"2026-09-25\",\"clock_start_date\":\"Not applicable - no expedited clock when causality is not assessed as related\",\"reporting_clock\":\"None - not expedited\",\"submission_due_date\":\"Not applicable\",\"assigned_to\":\"Dr. Priya Raman - Medical Safety Physician\",\"signal_team_notified\":false,\"signal_reference\":\"Not raised - no causal relationship assessed\",\"blinding_status\":\"Remains blinded - no expedited submission\",\"next_action\":\"Medical review, then aggregate into the next DSUR. Re-assess if the causality assessment is revised on follow-up.\",\"message\":\"Case ICSR-2026-01590 created. The event is serious and unexpected but was assessed as unrelated to the investigational product, so it is not a SUSAR and no 15-day clock starts.\"}",
                          "error": ""
                        }
                      },
                      {
                        "$flow.toolParams.expectedness == 'LISTED' && $flow.toolParams.seriousness != 'Non-serious'": {
                          "data": "{\"case_number\":\"ICSR-2026-01589\",\"case_version\":1,\"status\":\"Open - Awaiting medical review\",\"product_code\":\"IMP-4471\",\"inn\":\"Velcaridine\",\"protocol_id\":\"VEL-301\",\"patient_reference\":\"VEL-301-0442\",\"reaction_term\":\"Hepatic failure\",\"meddra_soc\":\"Hepatobiliary disorders\",\"seriousness\":\"Serious - Hospitalisation\",\"expectedness\":\"LISTED\",\"causality_sponsor\":\"Probable\",\"susar\":false,\"susar_rationale\":\"Serious and causally related, but the reaction is listed in Investigator's Brochure v6.0. A listed reaction is not a SUSAR, so no expedited reporting clock starts.\",\"receipt_date\":\"2026-09-25\",\"clock_start_date\":\"Not applicable - no expedited clock for a listed reaction\",\"reporting_clock\":\"None - not expedited\",\"submission_due_date\":\"Not applicable\",\"assigned_to\":\"Dr. Priya Raman - Medical Safety Physician\",\"signal_team_notified\":false,\"signal_reference\":\"Not raised - listed reaction within the expected safety profile\",\"blinding_status\":\"Remains blinded - no expedited submission\",\"next_action\":\"Medical review, then aggregate into the next DSUR. Re-assess expectedness if the Investigator's Brochure is revised.\",\"message\":\"Case ICSR-2026-01589 created. The reaction is serious and causally related but is listed in the reference safety information, so it is not a SUSAR and no 15-day clock starts. It will be reported in aggregate in the next DSUR.\"}",
                          "error": ""
                        }
                      },
                      {
                        "$flow.toolParams.seriousness == 'Non-serious'": {
                          "data": "{\"case_number\":\"ICSR-2026-01591\",\"case_version\":1,\"status\":\"Open - Awaiting medical review\",\"product_code\":\"IMP-4471\",\"inn\":\"Velcaridine\",\"protocol_id\":\"VEL-301\",\"patient_reference\":\"VEL-301-0442\",\"reaction_term\":\"Injection site erythema\",\"meddra_soc\":\"General disorders and administration site conditions\",\"seriousness\":\"Non-serious\",\"expectedness\":\"LISTED\",\"causality_sponsor\":\"Probable\",\"susar\":false,\"susar_rationale\":\"The case is non-serious. A non-serious reaction cannot be a SUSAR whatever its expectedness or causality, so no expedited clock starts.\",\"receipt_date\":\"2026-09-25\",\"clock_start_date\":\"Not applicable - no expedited clock for a non-serious case\",\"reporting_clock\":\"None - not expedited\",\"submission_due_date\":\"Not applicable\",\"assigned_to\":\"Dr. Priya Raman - Medical Safety Physician\",\"signal_team_notified\":false,\"signal_reference\":\"Not raised - non-serious event\",\"blinding_status\":\"Not applicable - no unblinding required\",\"next_action\":\"Routine data entry and medical review. Include in the next DSUR.\",\"message\":\"Case ICSR-2026-01591 created as a non-serious case. It is not a SUSAR and no expedited clock starts; it will be reported in aggregate in the next DSUR.\"}",
                          "error": ""
                        }
                      },
                      {
                        "@otherwise": {
                          "data": "",
                          "error": "seriousness, expectedness and causality are required and must each be one of the values in the tool schema. No safety case was created."
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfSwiUmV0dXJuIjp7IngiOjMwMCwieSI6MTAwfX0=",
