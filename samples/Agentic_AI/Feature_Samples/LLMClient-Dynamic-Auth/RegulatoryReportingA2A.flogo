          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"RegulatoryReportingA2AServer\",\"properties\":{\"toolParams\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"product_code\":{\"type\":\"string\",\"description\":\"Investigational product code, for example IMP-4471\"},\"reaction_term\":{\"type\":\"string\",\"description\":\"MedDRA preferred term for the reaction, for example Hepatic failure\"},\"seriousness\":{\"type\":\"string\",\"description\":\"ICH E2A seriousness criterion met. Non-serious cases cannot be SUSARs; Death and Life-threatening carry the 7-day clock, the other serious criteria carry 15 days\",\"enum\":[\"Non-serious\",\"Serious - Death\",\"Serious - Life-threatening\",\"Serious - Hospitalisation\",\"Serious - Disability\",\"Serious - Congenital anomaly\",\"Serious - Other medically important\"]},\"expectedness\":{\"type\":\"string\",\"description\":\"Whether the reaction is listed in the reference safety information\",\"enum\":[\"LISTED\",\"UNEXPECTED\"]},\"causality\":{\"type\":\"string\",\"description\":\"Investigator causality assessment. Related, Probable and Possible all count as a reasonable possibility of causal relationship; Unlikely and Unrelated do not\",\"enum\":[\"Related\",\"Probable\",\"Possible\",\"Unlikely\",\"Unrelated\"]},\"patient_reference\":{\"type\":\"string\",\"description\":\"De-identified subject reference, for example VEL-301-0442\"},\"narrative\":{\"type\":\"string\",\"description\":\"Clinical narrative describing the event and its clinical course\"}},\"required\":[\"product_code\",\"reaction_term\",\"seriousness\",\"expectedness\",\"causality\",\"patient_reference\",\"narrative\"],\"additionalProperties\":false}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"response\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}},\"required\":[]}"
          }
        }
      }
    },
    {
      "id": "flow:submit_expedited_report_flow",
      "data": {
        "name": "submit_expedited_report_flow",
        "description": "Files an expedited report with mock data",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Return",
            "type": "label",
            "label": "StartActivity to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Returns the mock submission receipt for the requested health authority.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "@conditional": [
                      {
                        "$flow.toolParams.destination == 'FDA'": {
                          "data": "{\"case_number\":\"ICSR-2026-01588\",\"case_version\":1,\"submission_id\":\"SUB-2026-FDA-004417\",\"destination\":\"FDA FAERS Electronic Submissions Gateway\",\"standard\":\"ICH E2B(R3)\",\"message_type\":\"ichicsr - initial expedited report\",\"transmitted_at\":\"2026-09-25T16:42:11Z\",\"acknowledgement\":{\"ack_code\":\"AA\",\"ack_meaning\":\"Application acknowledgement accepted - message loaded successfully\",\"received_at\":\"2026-09-25T16:43:05Z\",\"authority_case_id\":\"FAERS-29104778\"},\"reporting_clock\":\"15 calendar days\",\"submission_due_date\":\"2026-10-10\",\"days_remaining_at_submission\":15,\"compliance_status\":\"On time\",\"distribution\":[{\"recipient\":\"FDA FAERS\",\"status\":\"Accepted\",\"authority_case_id\":\"FAERS-29104778\"},{\"recipient\":\"EMA EudraVigilance\",\"status\":\"Not submitted - file separately with destination EMA\"},{\"recipient\":\"Investigator sites and IRB/IEC\",\"status\":\"Safety letter scheduled\"}],\"audit\":\"Submission recorded in the 21 CFR Part 11 audit trail under user svc-pv-gateway.\",\"message\":\"Expedited E2B(R3) report for ICSR-2026-01588 accepted by FDA (ack AA, authority case FAERS-29104778). This submission covers FDA only - call submit_expedited_report again with destination EMA to file with EudraVigilance. Submitted 15 days ahead of the 2026-10-10 deadline.\"}",
                          "error": ""
                        }
                      },
                      {
                        "$flow.toolParams.destination == 'EMA'": {
                          "data": "{\"case_number\":\"ICSR-2026-01588\",\"case_version\":1,\"submission_id\":\"SUB-2026-EMA-004418\",\"destination\":\"EMA EudraVigilance Gateway\",\"standard\":\"ICH E2B(R3)\",\"message_type\":\"ichicsr - initial expedited report\",\"transmitted_at\":\"2026-09-25T18:00:04Z\",\"acknowledgement\":{\"ack_code\":\"AA\",\"ack_meaning\":\"Application acknowledgement accepted - message loaded successfully\",\"received_at\":\"2026-09-25T18:01:12Z\",\"authority_case_id\":\"EV-2026-DE-0088431\"},\"reporting_clock\":\"15 calendar days\",\"submission_due_date\":\"2026-10-10\",\"days_remaining_at_submission\":15,\"compliance_status\":\"On time\",\"distribution\":[{\"recipient\":\"EMA EudraVigilance\",\"status\":\"Accepted\",\"authority_case_id\":\"EV-2026-DE-0088431\"},{\"recipient\":\"BfArM - national competent authority for site 0044 (DE)\",\"status\":\"Re-routed by EudraVigilance\"},{\"recipient\":\"Investigator sites and IRB/IEC\",\"status\":\"Safety letter scheduled\"}],\"audit\":\"Submission recorded in the 21 CFR Part 11 audit trail under user svc-pv-gateway.\",\"message\":\"Expedited E2B(R3) report for ICSR-2026-01588 accepted by EMA EudraVigilance (ack AA, authority case EV-2026-DE-0088431). BfArM was notified through the EudraVigilance re-routing rules. Submitted 15 days ahead of the 2026-10-10 deadline.\"}",
                          "error": ""
                        }
                      },
                      {
                        "@otherwise": {
                          "data": "",
                          "error": "destination is required and must be exactly FDA or EMA. No report was submitted."
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ],
