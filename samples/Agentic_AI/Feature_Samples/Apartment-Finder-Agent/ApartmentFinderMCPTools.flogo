{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-general/src/app/General/activity/mapper",
    "github.com/tibco/flogo-general/src/app/General/activity/sendmail",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/string",
    "github.com/project-flogo/contrib/function/coerce"
  ],
  "name": "ApartmentFinderMCPTools",
  "description": "Stateless MCP server exposing Apartment Finder mock data for the Houston-metro pilot slice (77477, 77479, 77494): locations, communities, rent and availability, amenities, proximity, and safety records.",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Stateless MCP server for apartment-search lookups. Each tool call is independent.",
      "settings": {
        "serverName": "ApartmentFinderMCPTools",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"FlogoMcpServer.PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "ApartmentFinderMCPTools",
      "handlers": [
        {
          "description": "Resolve a city name to the zip codes served by the apartment finder: county, metro area, cost-of-living index, major highways, and per-zip neighborhood, median one-bedroom rent, community count and community IDs. Call this first when the user names a place rather than a zip code. Passing 'Houston' returns the whole serviced Houston metro (Katy, Stafford, Sugar Land) in one call. Read-only.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "search_locations",
            "handlerDescription": "Resolve a city name to the zip codes served by the apartment finder: county, metro area, cost-of-living index, major highways, and per-zip neighborhood, median one-bedroom rent, community count and community IDs. Call this first when the user names a place rather than a zip code. Passing 'Houston' returns the whole serviced Houston metro (Katy, Stafford, Sugar Land) in one call. Read-only.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:search_locations_flow"
            },
            "input": {
              "arguments": "=$.arguments",
              "httpHeaders": "=$.httpHeaders",
              "tokenInfo": "=$.tokenInfo"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"city\": {\n      \"type\": \"string\",\n      \"description\": \"City name, exactly as spelled and capitalised in the dataset, e.g. Katy. Pass 'Houston' for any Houston-area request -- it resolves to every serviced Houston-metro city at once.\"\n    }\n  },\n  \"required\": [\n    \"city\"\n  ],\n  \"additionalProperties\": false\n}",
                "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"city\": {\n      \"type\": \"string\",\n      \"description\": \"City name, exactly as spelled and capitalised in the dataset, e.g. Katy. Pass 'Houston' for any Houston-area request -- it resolves to every serviced Houston-metro city at once.\"\n    }\n  },\n  \"required\": [\n    \"city\"\n  ],\n  \"additionalProperties\": false\n}"
              },
              "httpHeaders": {
                "type": "json",
                "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"Authorization\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"Authorization\": {\n      \"type\": \"string\"\n    }\n  }\n}"
              },
              "tokenInfo": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": [\r\n        {\r\n          \"type\": \"string\"\r\n        }\r\n      ]\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": [\r\n        {\r\n          \"type\": \"string\"\r\n        }\r\n      ]\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    }\r\n  }\r\n}"
              }
            }
          },
          "name": "search_locations_flow"
        },
        {
          "description": "List every apartment community in a zip code with address, property type, price tier, year built, total units, management company, phone, website, pet/senior/student/income-restricted flags, resident rating, and a rentSummary (median 1BR rent, overall rent range, available units, availability status, unit types offered). Use the returned communityId with the pricing, amenity, proximity and safety tools. Read-only.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
