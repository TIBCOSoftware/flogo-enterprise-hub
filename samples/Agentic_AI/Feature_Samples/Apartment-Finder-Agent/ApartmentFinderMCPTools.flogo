    {
      "id": "flow:schedule_visit_flow",
      "data": {
        "name": "schedule_visit_flow",
        "description": "Schedule an apartment tour and email the confirmation to BOTH the renter and the community's leasing office. Confirm the date, time and unit type with the renter, and collect their name and email address, before calling this. Returns the confirmation details that were emailed as key=value lines (status, communityName, visitDate, visitTime, unitLabel, address, officeHours, communityPhone, arriveMinutesEarly, emailSentTo), including the community phone number the renter should call ahead on.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ResolveCommunity",
            "type": "label",
            "label": "StartActivity to ResolveCommunity"
          },
          {
            "id": 2,
            "from": "ResolveCommunity",
            "to": "SendAppointmentEmail",
            "type": "label",
            "label": "ResolveCommunity to SendAppointmentEmail"
          },
          {
            "id": 3,
            "from": "SendAppointmentEmail",
            "to": "Return",
            "type": "label",
            "label": "SendAppointmentEmail to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ResolveCommunity",
            "name": "ResolveCommunity",
            "description": "Resolve community_id to the leasing office contact card, and unit_type to a human-readable label, so the email body never depends on the caller.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "contact": {
                      "@conditional": [
                        {
                          "$flow.arguments.community_id == 'CMTY-0077'": {
                            "communityName": "Camden Sugar Grove",
                            "email": "camden-sugar-grove@mailinator.com",
                            "phone": "(713) 555-5628",
                            "address": "5657 Silverleaf Lane, Suite 187, Stafford, TX 77477",
                            "officeHours": "Mon-Fri 09:00-18:00, Sat 09:00-15:00, Sun Closed (America/Chicago)",
                            "leasingAgentName": "Camille Mensah",
                            "arriveMinutesEarly": 10
                          }
                        },
                        {
                          "$flow.arguments.community_id == 'CMTY-0078'": {
                            "communityName": "The Fountains at Lakes",
                            "email": "the-fountains-at-lakes@mailinator.com",
                            "phone": "(832) 555-7079",
                            "address": "6200 Summerfield Circle, Suite 272, Stafford, TX 77477",
                            "officeHours": "Mon-Fri 08:30-17:30, Sat 10:00-16:00, Sun 12:00-16:00 (America/Chicago)",
                            "leasingAgentName": "Simone Pemberton",
                            "arriveMinutesEarly": 10
                          }
                        },
                        {
                          "$flow.arguments.community_id == 'CMTY-0079'": {
                            "communityName": "Harmony Apartments",
                            "email": "harmony-apartments@mailinator.com",
                            "phone": "(281) 555-3422",
                            "address": "4187 Silverleaf Avenue, Suite 273, Stafford, TX 77477",
                            "officeHours": "Mon-Fri 10:00-19:00, Sat 11:00-16:00, Sun 12:00-16:00 (America/Chicago)",
                            "leasingAgentName": "Desmond Kirby",
                            "arriveMinutesEarly": 10
                          }
                        },
                        {
                          "$flow.arguments.community_id == 'CMTY-0080'": {
                            "communityName": "Stafford Oaks Residences",
                            "email": "stafford-oaks-residences@mailinator.com",
                            "phone": "(210) 555-1263",
                            "address": "5679 Silverleaf Court, Suite 441, Stafford, TX 77477",
                            "officeHours": "Mon-Fri 10:00-19:00, Sat 10:00-17:00, Sun 12:00-16:00 (America/Chicago)",
                            "leasingAgentName": "Rafael Castellano",
                            "arriveMinutesEarly": 10
                          }
                        },
                        {
                          "$flow.arguments.community_id == 'CMTY-0085'": {
                            "communityName": "The Park at First Colony",
                            "email": "the-park-at-first-colony@mailinator.com",
                            "phone": "(210) 555-2499",
                            "address": "9772 Cypress Avenue, Suite 128, Sugar Land, TX 77479",
                            "officeHours": "Mon-Fri 09:00-18:00, Sat 10:00-16:00, Sun 13:00-17:00 (America/Chicago)",
                            "leasingAgentName": "Rosa Alvarez",
                            "arriveMinutesEarly": 10
                          }
                        },
                        {
                          "$flow.arguments.community_id == 'CMTY-0086'": {
                            "communityName": "The Fountains at First Colony",
                            "email": "the-fountains-at-first-colony@mailinator.com",
                            "phone": "(832) 555-3852",
                            "address": "6801 Ravenswood Lane, Suite 206, Sugar Land, TX 77479",
                            "officeHours": "Mon-Fri 08:00-17:00, Sat 11:00-16:00, Sun 12:00-16:00 (America/Chicago)",
                            "leasingAgentName": "Desmond Pemberton",
                            "arriveMinutesEarly": 10
                          }
                        },
                        {
                          "$flow.arguments.community_id == 'CMTY-0087'": {
                            "communityName": "First Colony Meadows",
                            "email": "first-colony-meadows@mailinator.com",
                            "phone": "(832) 555-5552",
                            "address": "169 Rosewood Court, Suite 206, Sugar Land, TX 77479",
                            "officeHours": "Mon-Fri 10:00-19:00, Sat 09:00-15:00, Sun Closed (America/Chicago)",
                            "leasingAgentName": "Naomi Sandoval",
                            "arriveMinutesEarly": 10
                          }
                        },
                        {
                          "$flow.arguments.community_id == 'CMTY-0073'": {
                            "communityName": "Woodland Meadows Apartment Community",
                            "email": "woodland-meadows-apartment-community@mailinator.com",
                            "phone": "(210) 555-2752",
                            "address": "7525 Meadow Parkway, Suite 103, Katy, TX 77494",
                            "officeHours": "Mon-Fri 09:00-18:00, Sat 11:00-16:00, Sun 13:00-17:00 (America/Chicago)",
                            "leasingAgentName": "Tobias Holloway",
                            "arriveMinutesEarly": 10
                          }
                        },
                        {
                          "$flow.arguments.community_id == 'CMTY-0074'": {
                            "communityName": "Katy West Bend",
                            "email": "katy-west-bend@mailinator.com",
                            "phone": "(832) 555-2903",
                            "address": "9143 Autumn Boulevard, Suite 452, Katy, TX 77494",
                            "officeHours": "Mon-Fri 09:00-18:00, Sat 11:00-16:00, Sun Closed (America/Chicago)",
                            "leasingAgentName": "Naomi Sowell",
                            "arriveMinutesEarly": 10
                          }
                        },
                        {
                          "$flow.arguments.community_id == 'CMTY-0075'": {
                            "communityName": "Katy West Enclave",
                            "email": "katy-west-enclave@mailinator.com",
                            "phone": "(713) 555-4000",
                            "address": "3319 Providence Avenue, Suite 196, Katy, TX 77494",
                            "officeHours": "Mon-Fri 09:00-17:00, Sat 10:00-17:00, Sun Closed (America/Chicago)",
                            "leasingAgentName": "Jonah Kirby",
                            "arriveMinutesEarly": 10
                          }
                        },
                        {
                          "$flow.arguments.community_id == 'CMTY-0076'": {
                            "communityName": "Springs at Katy",
                            "email": "springs-at-katy@mailinator.com",
                            "phone": "(281) 555-1467",
                            "address": "8250 Cypress Circle, Suite 246, Katy, TX 77494",
                            "officeHours": "Mon-Fri 09:00-18:00, Sat 10:00-17:00, Sun 13:00-17:00 (America/Chicago)",
                            "leasingAgentName": "Renee Dupree",
                            "arriveMinutesEarly": 10
                          }
                        },
                        {
                          "@otherwise": {
                            "communityName": "Unknown community",
                            "email": "apartment-finder-unknown@mailinator.com",
                            "phone": "not available",
                            "address": "not available",
                            "officeHours": "not available",
                            "leasingAgentName": "the leasing team",
                            "arriveMinutesEarly": 10
                          }
                        }
                      ]
                    },
                    "unitLabel": {
                      "@conditional": [
                        {
                          "$flow.arguments.unit_type == 'STUDIO'": "studio"
                        },
                        {
                          "$flow.arguments.unit_type == '1BR'": "1 bedroom"
                        },
                        {
                          "$flow.arguments.unit_type == '2BR'": "2 bedroom"
                        },
                        {
                          "$flow.arguments.unit_type == '3BR'": "3 bedroom"
                        },
                        {
                          "$flow.arguments.unit_type == '4BR'": "4 bedroom"
                        },
                        {
                          "@otherwise": "=$flow.arguments.unit_type"
                        }
                      ]
                    }
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"contact\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"communityName\": {\n          \"type\": \"string\"\n        },\n        \"email\": {\n          \"type\": \"string\"\n        },\n        \"phone\": {\n          \"type\": \"string\"\n        },\n        \"address\": {\n          \"type\": \"string\"\n        },\n        \"officeHours\": {\n          \"type\": \"string\"\n        },\n        \"leasingAgentName\": {\n          \"type\": \"string\"\n        },\n        \"arriveMinutesEarly\": {\n          \"type\": \"integer\"\n        }\n      }\n    },\n    \"unitLabel\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"contact\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"communityName\": {\n          \"type\": \"string\"\n        },\n        \"email\": {\n          \"type\": \"string\"\n        },\n        \"phone\": {\n          \"type\": \"string\"\n        },\n        \"address\": {\n          \"type\": \"string\"\n        },\n        \"officeHours\": {\n          \"type\": \"string\"\n        },\n        \"leasingAgentName\": {\n          \"type\": \"string\"\n        },\n        \"arriveMinutesEarly\": {\n          \"type\": \"integer\"\n        }\n      }\n    },\n    \"unitLabel\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "SendAppointmentEmail",
            "name": "SendAppointmentEmail",
            "description": "Email the tour confirmation to the renter and the leasing office.",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#sendmail",
              "input": {
                "Server": "=$property[\"SendMail.Server\"]",
                "Port": "=$property[\"SendMail.Port\"]",
                "authorizationType": "Basic",
                "Username": "=$property[\"SendMail.username\"]",
                "Password": "=$property[\"SendMail.Password\"]",
                "Connection Security": "SSL",
                "serverCertificate": "",
                "message_content_type": "text/plain",
                "sender": "=$property[\"SendMail.username\"]",
                "recipients": "=string.concat($flow.arguments.customer_email, \",\", $activity[ResolveCommunity].output.contact.email)",
                "cc_recipients": "",
                "bcc_recipients": "",
                "reply_to": "=$property[\"SendMail.username\"]",
                "subject": "=string.concat(\"Tour confirmed: \", $activity[ResolveCommunity].output.contact.communityName, \" on \", $flow.arguments.visit_date, \" at \", $flow.arguments.visit_time)",
                "message": "=string.concat(\"Hello \", $flow.arguments.customer_name, \",\\n\\n\",\"Your appointment is scheduled for \", $activity[ResolveCommunity].output.unitLabel, \" apartment at \", $activity[ResolveCommunity].output.contact.communityName, \".\\n\\n\",\"Date: \", $flow.arguments.visit_date, \"\\n\",\"Time: \", $flow.arguments.visit_time, \"\\n\",\"Unit type: \", $activity[ResolveCommunity].output.unitLabel, \" (\", $flow.arguments.unit_type, \")\\n\",\"Address: \", $activity[ResolveCommunity].output.contact.address, \"\\n\",\"Leasing office hours: \", $activity[ResolveCommunity].output.contact.officeHours, \"\\n\",\"Your host: \", $activity[ResolveCommunity].output.contact.leasingAgentName, \"\\n\\n\",\"Please reach \", coerce.toString($activity[ResolveCommunity].output.contact.arriveMinutesEarly), \" minutes before your appointment time, and call on this number \", $activity[ResolveCommunity].output.contact.phone, \" before your visit.\\n\\n\",\"This confirmation has also been sent to the leasing office at \", $activity[ResolveCommunity].output.contact.email, \".\\n\\n\",\"-- Apartment Finder\\n\",\"Demo message. All community details are synthetic test data.\")"
              },
              "schemas": {
                "input": {
                  "attachments": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"items\":{\"properties\":{\"file\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"base64EncodedContents\":{\"type\":\"boolean\"}},\"required\":[\"file\"],\"type\":\"object\"},\"type\":\"array\"}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"items\":{\"properties\":{\"file\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"base64EncodedContents\":{\"type\":\"boolean\"}},\"required\":[\"file\"],\"type\":\"object\"},\"type\":\"array\"}"
                  },
                  "headers": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return what was emailed so the agent can confirm it in chat.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "=string.concat(\"status=scheduled\\n\",\"communityId=\", $flow.arguments.community_id, \"\\n\",\"communityName=\", $activity[ResolveCommunity].output.contact.communityName, \"\\n\",\"visitDate=\", $flow.arguments.visit_date, \"\\n\",\"visitTime=\", $flow.arguments.visit_time, \"\\n\",\"unitType=\", $flow.arguments.unit_type, \"\\n\",\"unitLabel=\", $activity[ResolveCommunity].output.unitLabel, \"\\n\",\"address=\", $activity[ResolveCommunity].output.contact.address, \"\\n\",\"officeHours=\", $activity[ResolveCommunity].output.contact.officeHours, \"\\n\",\"communityPhone=\", $activity[ResolveCommunity].output.contact.phone, \"\\n\",\"communityEmail=\", $activity[ResolveCommunity].output.contact.email, \"\\n\",\"customerEmail=\", $flow.arguments.customer_email, \"\\n\",\"arriveMinutesEarly=\", coerce.toString($activity[ResolveCommunity].output.contact.arriveMinutesEarly), \"\\n\",\"emailSentTo=\", $flow.arguments.customer_email, \" and \", $activity[ResolveCommunity].output.contact.email)"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIlJlc29sdmVDb21tdW5pdHkiOnsieCI6MjUwLCJ5Ijo1MH0sIlNlbmRBcHBvaW50bWVudEVtYWlsIjp7IngiOjQ2MCwieSI6NTB9LCJSZXR1cm4iOnsieCI6NzAwLCJ5Ijo1MH19",
        "metadata": {
          "input": [
            {
              "name": "arguments",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"community_id\":{\"type\":\"string\",\"description\":\"The community ID to tour, e.g. CMTY-0077\"},\"visit_date\":{\"type\":\"string\",\"description\":\"Tour date in YYYY-MM-DD format, e.g. 2026-09-19\"},\"visit_time\":{\"type\":\"string\",\"description\":\"Tour start time in 24-hour HH:MM format, local to the community, e.g. 14:30\"},\"customer_name\":{\"type\":\"string\",\"description\":\"Full name of the renter attending the tour\"},\"customer_email\":{\"type\":\"string\",\"description\":\"The renter's email address. The confirmation is sent here and to the community's leasing office.\"},\"unit_type\":{\"type\":\"string\",\"description\":\"Unit type being toured, spelled as in the rent data: STUDIO, 1BR, 2BR, 3BR or 4BR\"}}"
              }
            },
            {
              "name": "httpHeaders",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Authorization\":{\"type\":\"string\"}}"
              }
            }
          ],
          "output": [
            {
              "name": "response",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"ApartmentFinderMCPTools\",\"properties\":{\"arguments\":{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"community_id\": {\n      \"type\": \"string\",\n      \"description\": \"The community ID to tour, e.g. CMTY-0077\"\n    },\n    \"visit_date\": {\n      \"type\": \"string\",\n      \"description\": \"Tour date in YYYY-MM-DD format, e.g. 2026-09-19\"\n    },\n    \"visit_time\": {\n      \"type\": \"string\",\n      \"description\": \"Tour start time in 24-hour HH:MM format, local to the community, e.g. 14:30\"\n    },\n    \"customer_name\": {\n      \"type\": \"string\",\n      \"description\": \"Full name of the renter attending the tour\"\n    },\n    \"customer_email\": {\n      \"type\": \"string\",\n      \"description\": \"The renter's email address. The confirmation is sent here and to the community's leasing office.\"\n    },\n    \"unit_type\": {\n      \"type\": \"string\",\n      \"description\": \"Unit type being toured, spelled as in the rent data: STUDIO, 1BR, 2BR, 3BR or 4BR\"\n    }\n  },\n  \"required\": [\n    \"community_id\",\n    \"visit_date\",\n    \"visit_time\",\n    \"customer_name\",\n    \"customer_email\",\n    \"unit_type\"\n  ],\n  \"additionalProperties\": false\n},\"httpHeaders\":{\"type\":\"object\",\"properties\":{\"Authorization\":{\"type\":\"string\"}}}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}},\"required\":[\"response\"]}"
          }
        }
      }
    }
  ],
  "properties": [
    {
      "name": "FlogoMcpServer.PORT",
      "type": "string",
      "value": "9606"
    },
