        {
          "description": "Schedule an apartment tour and email the confirmation to BOTH the renter and the community's leasing office. Confirm the date, time and unit type with the renter, and collect their name and email address, before calling this. Returns the confirmation details that were emailed as key=value lines (status, communityName, visitDate, visitTime, unitLabel, address, officeHours, communityPhone, arriveMinutesEarly, emailSentTo), including the community phone number the renter should call ahead on.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "schedule_visit",
            "handlerDescription": "Schedule an apartment tour and email the confirmation to BOTH the renter and the community's leasing office. Confirm the date, time and unit type with the renter, and collect their name and email address, before calling this. Returns the confirmation details that were emailed as key=value lines (status, communityName, visitDate, visitTime, unitLabel, address, officeHours, communityPhone, arriveMinutesEarly, emailSentTo), including the community phone number the renter should call ahead on.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:schedule_visit_flow"
            },
            "input": {
              "arguments": "=$.arguments",
              "httpHeaders": "=$.httpHeaders",
              "tokenInfo": "=$.tokenInfo"
            },
            "output": {
              "response": "=$.response"
            }
          },
