      "id": "flow:search_locations_flow",
      "data": {
        "name": "search_locations_flow",
        "description": "Resolve a city name to the zip codes served by the apartment finder: county, metro area, cost-of-living index, major highways, and per-zip neighborhood, median one-bedroom rent, community count and community IDs. Call this first when the user names a place rather than a zip code. Passing 'Houston' returns the whole serviced Houston metro (Katy, Stafford, Sugar Land) in one call. Read-only.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Return",
            "type": "label",
            "label": "StartActivity to Return"
          }
        ],
