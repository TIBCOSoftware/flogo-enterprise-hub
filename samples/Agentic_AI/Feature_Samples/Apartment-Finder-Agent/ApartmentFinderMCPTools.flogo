              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"community_id\": {\n      \"type\": \"string\",\n      \"description\": \"The community ID to tour, e.g. CMTY-0077\"\n    },\n    \"visit_date\": {\n      \"type\": \"string\",\n      \"description\": \"Tour date in YYYY-MM-DD format, e.g. 2026-09-19\"\n    },\n    \"visit_time\": {\n      \"type\": \"string\",\n      \"description\": \"Tour start time in 24-hour HH:MM format, local to the community, e.g. 14:30\"\n    },\n    \"customer_name\": {\n      \"type\": \"string\",\n      \"description\": \"Full name of the renter attending the tour\"\n    },\n    \"customer_email\": {\n      \"type\": \"string\",\n      \"description\": \"The renter's email address. The confirmation is sent here and to the community's leasing office.\"\n    },\n    \"unit_type\": {\n      \"type\": \"string\",\n      \"description\": \"Unit type being toured, spelled as in the rent data: STUDIO, 1BR, 2BR, 3BR or 4BR\"\n    }\n  },\n  \"required\": [\n    \"community_id\",\n    \"visit_date\",\n    \"visit_time\",\n    \"customer_name\",\n    \"customer_email\",\n    \"unit_type\"\n  ],\n  \"additionalProperties\": false\n}",
                "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"community_id\": {\n      \"type\": \"string\",\n      \"description\": \"The community ID to tour, e.g. CMTY-0077\"\n    },\n    \"visit_date\": {\n      \"type\": \"string\",\n      \"description\": \"Tour date in YYYY-MM-DD format, e.g. 2026-09-19\"\n    },\n    \"visit_time\": {\n      \"type\": \"string\",\n      \"description\": \"Tour start time in 24-hour HH:MM format, local to the community, e.g. 14:30\"\n    },\n    \"customer_name\": {\n      \"type\": \"string\",\n      \"description\": \"Full name of the renter attending the tour\"\n    },\n    \"customer_email\": {\n      \"type\": \"string\",\n      \"description\": \"The renter's email address. The confirmation is sent here and to the community's leasing office.\"\n    },\n    \"unit_type\": {\n      \"type\": \"string\",\n      \"description\": \"Unit type being toured, spelled as in the rent data: STUDIO, 1BR, 2BR, 3BR or 4BR\"\n    }\n  },\n  \"required\": [\n    \"community_id\",\n    \"visit_date\",\n    \"visit_time\",\n    \"customer_name\",\n    \"customer_email\",\n    \"unit_type\"\n  ],\n  \"additionalProperties\": false\n}"
