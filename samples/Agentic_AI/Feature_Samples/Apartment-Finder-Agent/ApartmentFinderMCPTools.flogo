    {
      "id": "flow:get_proximity_flow",
      "data": {
        "name": "get_proximity_flow",
        "description": "Retrieve location and commute context for one community: location/walk/transit/bike scores, a valueException flag for communities that are cheap yet unusually well located, distance summary (nearest highway, public school, grocery, shopping mall, hospital and the within-X-miles booleans), and the nearby places list with type, distance in miles, drive time, and GreatSchools rating and district for schools. Read-only.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Return",
            "type": "label",
            "label": "StartActivity to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return mock data for get_proximity (exact-match lookup).",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "@conditional": [
