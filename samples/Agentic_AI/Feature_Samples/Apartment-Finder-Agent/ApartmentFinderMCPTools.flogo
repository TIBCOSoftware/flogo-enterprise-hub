                          "data": "{\"communityId\": \"CMTY-0074\", \"communityName\": \"Katy West Bend\", \"leasingOfficeName\": \"Katy West Bend Leasing Office\", \"leasingAgentName\": \"Naomi Sowell\", \"leasingAgentTitle\": \"Leasing Manager\", \"email\": \"katy-west-bend@mailinator.com\", \"mailinatorInbox\": \"https://www.mailinator.com/v4/public/inboxes.jsp?to=katy-west-bend\", \"phone\": \"(832) 555-2903\", \"leasingOfficeDirect\": \"(832) 555-7219\", \"afterHoursPhone\": \"(832) 555-3000\", \"website\": \"https://www.example-apartments.com/katy-west-bend\", \"address\": {\"streetAddress\": \"9143 Autumn Boulevard, Suite 452\", \"city\": \"Katy\", \"county\": \"Harris\", \"state\": \"Texas\", \"stateAbbreviation\": \"TX\", \"zipCode\": \"77494\", \"fullAddress\": \"9143 Autumn Boulevard, Suite 452, Katy, TX 77494\"}, \"officeHours\": {\"mondayToFriday\": \"09:00-18:00\", \"saturday\": \"11:00-16:00\", \"sunday\": \"Closed\", \"timeZone\": \"America/Chicago\"}, \"tourTypesOffered\": [\"In-Person Guided Tour\", \"Self-Guided Tour\"], \"appointmentLeadTimeHours\": 48, \"arriveMinutesEarly\": 10, \"walkInsAccepted\": true, \"preferredContactMethod\": \"Phone\", \"languagesSpoken\": [\"English\"]}"
                        }
