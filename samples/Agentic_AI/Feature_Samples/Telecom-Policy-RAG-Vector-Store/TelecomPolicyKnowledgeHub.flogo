        "username": "=$property[\"ActiveSpaces.PolicyVectorStore.Username\"]",
        "password": "=$property[\"ActiveSpaces.PolicyVectorStore.Password\"]"
      }
    },
    "7c1e5a90-3b2d-4f6a-9e41-2a9d0c7b5e02": {
