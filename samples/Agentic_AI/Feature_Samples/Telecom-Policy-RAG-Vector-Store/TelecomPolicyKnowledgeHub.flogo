    {
      "id": "flow:SearchPolicies",
      "data": {
        "name": "SearchPolicies",
        "description": "Semantic search: ChunkAndEmbed (embed the question) -> VectorSearch. Query: ?q=<question>",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "EmbedQuestion",
            "type": "label",
            "label": "StartActivity to EmbedQuestion"
          },
          {
            "id": 2,
            "from": "EmbedQuestion",
            "to": "VectorSearch",
            "type": "label",
            "label": "EmbedQuestion to VectorSearch"
          },
          {
            "id": 3,
            "from": "VectorSearch",
            "to": "ProjectMatches",
            "type": "label",
            "label": "VectorSearch to ProjectMatches"
          },
          {
            "id": 4,
            "from": "ProjectMatches",
            "to": "LogSearch",
            "type": "label",
            "label": "ProjectMatches to LogSearch"
          },
          {
            "id": 5,
            "from": "LogSearch",
            "to": "Return",
            "type": "label",
            "label": "LogSearch to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "EmbedQuestion",
            "name": "EmbedQuestion",
            "description": "Embed the question with the same model used at ingestion (one chunk, one vector).",
            "activity": {
              "ref": "#chunkandembeddocuments",
              "settings": {
                "contentSource": "Text",
                "fileEncoding": "UTF-8",
                "maxFileSizeMB": 25,
                "onFileError": "Skip",
                "chunkingStrategy": "Recursive",
                "chunkSize": 1500,
                "chunkOverlap": 0,
                "delimiterIsRegex": false,
                "separators": "",
                "delimiter": "",
                "markdownHeadingLevel": 2,
                "minChunkSize": 0,
                "embeddingProvider": "OpenAI",
                "embeddingModel": "text-embedding-3-small",
                "dimensions": 0,
                "requestTimeoutSeconds": 30
              },
              "input": {
                "text": "=$flow.queryParams.q",
                "documentId": "query",
                "apiKey": "=$property[\"AgenticAI.OpenAI_LLMProvider.API_Key\"]",
                "baseUrl": "=$property[\"AgenticAI.OpenAI_LLMProvider.Embedding_Base_URL\"]",
                "filePaths": {
                  "mapping": []
                }
              },
              "schemas": {
                "input": {
                  "filePaths": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                },
                "output": {
                  "embeddings": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"index\":{\"type\":\"number\"},\"text\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"startOffset\":{\"type\":\"number\"},\"endOffset\":{\"type\":\"number\"},\"charCount\":{\"type\":\"number\"},\"headings\":{\"type\":\"array\",\"items\":{}},\"metadata\":{\"type\":\"object\",\"properties\":{}},\"embedding\":{\"type\":\"array\",\"items\":{}},\"dimensions\":{\"type\":\"number\"}}}}",
                    "fe_metadata": "[{\"id\": \"\", \"index\": 0, \"text\": \"\", \"source\": \"\", \"startOffset\": 0, \"endOffset\": 0, \"charCount\": 0, \"headings\": [], \"metadata\": {}, \"embedding\": [], \"dimensions\": 0}]"
                  },
                  "skippedFiles": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"}}}}",
                    "fe_metadata": "[{\"path\": \"\", \"reason\": \"\"}]"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "VectorSearch",
            "name": "VectorSearch",
            "description": "Cosine-similarity search over telecore_policy_kb.embedding using the query embedding.",
            "type": "iterator",
            "settings": {
              "iterate": "=$activity[EmbedQuestion].embeddings",
              "accumulate": false,
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectorsearch",
              "settings": {
                "asConnection": "conn://7c1e5a90-3b2d-4f6a-9e41-2a9d0c7b5e01",
                "tableName": "telecore_policy_kb",
                "vectorColumn": "embedding",
                "similarityFunction": "Cosine"
              },
              "input": {
                "filter": "",
                "maxResults": "=$property[\"Search.Max_Results\"]",
                "minScore": "=$property[\"Search.Min_Score\"]",
                "queryTimeoutInSeconds": 0,
                "queryVector": "=coerce.toArray($iteration[value].embedding)"
              },
              "schemas": {
                "input": {
                  "queryVector": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"number\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"number\"\r\n  }\r\n}\r\n"
                  }
                },
                "output": {
                  "rows": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"metadata\":{\"type\":\"string\"},\"embedding\":{\"type\":\"array\",\"items\":{}},\"score\":{\"type\":\"number\"}}}}",
                    "fe_metadata": "[{\"key\": \"\", \"content\": \"\", \"metadata\": \"\", \"embedding\": [], \"score\": 0}]"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ProjectMatches",
            "name": "ProjectMatches",
            "description": "Project the matching rows to {key, content, source, score} - drop the raw vectors.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "matches": {
                      "@foreach($activity[VectorSearch].rows,row)": {
                        "key": "=$loop.key",
                        "content": "=$loop.content",
                        "source": "=$loop.metadata",
                        "score": "=$loop.score"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"matches\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"score\":{\"type\":\"number\"}}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"matches\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"score\":{\"type\":\"number\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogSearch",
            "name": "LogSearch",
            "description": "Log the match count",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=\"[search] \\\"\" + $flow.queryParams.q + \"\\\" -> \" + coerce.toString($activity[VectorSearch].rowCount) + \" match(es)\"",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": ""
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                }
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return the ranked matches",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "query": "=$flow.queryParams.q",
                      "matchCount": "=$activity[VectorSearch].rowCount",
                      "matches": "=$activity[ProjectMatches].output.matches"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjYwLCJ5Ijo4MH0sIkVtYmVkUXVlc3Rpb24iOnsieCI6MjUwLCJ5Ijo4MH0sIlZlY3RvclNlYXJjaCI6eyJ4Ijo0NDAsInkiOjgwfSwiUHJvamVjdE1hdGNoZXMiOnsieCI6NjMwLCJ5Ijo4MH0sIkxvZ1NlYXJjaCI6eyJ4Ijo4MjAsInkiOjgwfSwiUmV0dXJuIjp7IngiOjEwMTAsInkiOjgwfX0=",
        "metadata": {
          "input": [
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "queryParams",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"q\":{\"type\":\"string\"}}"
              }
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "data",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"query\":{\"type\":\"string\"},\"matchCount\":{\"type\":\"integer\"},\"matches\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"score\":{\"type\":\"number\"}}}}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"ReceiveHTTPMessage\",\"properties\":{\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"queryParams\":{\"type\":\"object\",\"properties\":{\"q\":{\"type\":\"string\"}},\"required\":[]}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"data\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"},\"matchCount\":{\"type\":\"integer\"},\"matches\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"score\":{\"type\":\"number\"}}}}}}},\"required\":[]}"
          }
        }
      }
    },
    {
      "id": "flow:RetirePolicyDocument",
      "data": {
        "name": "RetirePolicyDocument",
        "description": "Retire a superseded policy: VectorDelete (Filter) removes every chunk whose metadata names the document. documentId must match ^[A-Za-z0-9-]{3,40}$ - it is validated before it is put into the filter.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "DeleteDocumentChunks",
            "type": "expression",
            "label": "StartActivity to DeleteDocumentChunks",
            "value": "string.matchRegEx(\"^[A-Za-z0-9-]{3,40}$\", $flow.pathParams.documentId)"
          },
          {
            "id": 2,
            "from": "DeleteDocumentChunks",
            "to": "LogDelete",
            "type": "label",
            "label": "DeleteDocumentChunks to LogDelete"
          },
          {
            "id": 3,
            "from": "LogDelete",
            "to": "Return",
            "type": "label",
            "label": "LogDelete to Return"
          },
          {
            "id": 4,
            "from": "StartActivity",
            "to": "Rejected",
            "type": "expression",
            "label": "StartActivity to Rejected",
            "value": "!string.matchRegEx(\"^[A-Za-z0-9-]{3,40}$\", $flow.pathParams.documentId)"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "DeleteDocumentChunks",
            "name": "DeleteDocumentChunks",
            "description": "Delete by filter: metadata LIKE '%<documentId>%' (documentId already validated).",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectordelete",
              "settings": {
                "asConnection": "conn://7c1e5a90-3b2d-4f6a-9e41-2a9d0c7b5e01",
                "deleteBy": "Filter",
                "tableName": "telecore_policy_kb"
              },
              "input": {
                "filter": "=\"metadata LIKE '%\" + $flow.pathParams.documentId + \"%'\""
              },
              "schemas": {
                "input": {
                  "keys": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogDelete",
            "name": "LogDelete",
            "description": "Log the delete count",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=\"[retire] \" + $flow.pathParams.documentId + \": \" + coerce.toString($activity[DeleteDocumentChunks].rowCount) + \" chunk(s) deleted\"",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": ""
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                }
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return the delete count",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "status": "RETIRED",
                      "documentId": "=$flow.pathParams.documentId",
                      "rowsDeleted": "=$activity[DeleteDocumentChunks].rowCount",
                      "message": "All chunks for this document were removed from the vector store."
                    }
                  }
                }
              }
            }
          },
          {
            "id": "Rejected",
            "name": "Rejected",
            "description": "Reject an unsafe documentId before it can reach the filter",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 400,
                  "data": {
                    "mapping": {
                      "status": "REJECTED",
                      "documentId": "=$flow.pathParams.documentId",
                      "rowsDeleted": 0,
                      "message": "documentId must be 3-40 characters of letters, digits and '-'."
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjYwLCJ5Ijo4MH0sIkRlbGV0ZURvY3VtZW50Q2h1bmtzIjp7IngiOjI1MCwieSI6ODB9LCJMb2dEZWxldGUiOnsieCI6NDQwLCJ5Ijo4MH0sIlJldHVybiI6eyJ4Ijo2MzAsInkiOjgwfSwiUmVqZWN0ZWQiOnsieCI6ODIwLCJ5Ijo4MH19",
        "metadata": {
          "input": [
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "pathParams",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"documentId\":{\"type\":\"string\"}}"
              }
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "data",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"status\":{\"type\":\"string\"},\"documentId\":{\"type\":\"string\"},\"rowsDeleted\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"ReceiveHTTPMessage\",\"properties\":{\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"pathParams\":{\"type\":\"object\",\"properties\":{\"documentId\":{\"type\":\"string\"}},\"required\":[]}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"data\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"string\"},\"documentId\":{\"type\":\"string\"},\"rowsDeleted\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}}}},\"required\":[]}"
          }
        }
      }
    },
    {
      "id": "flow:DeleteChunksByKey",
      "data": {
        "name": "DeleteChunksByKey",
        "description": "Remove individual chunks by primary key: VectorDelete (Key). Body: {\"keys\": [\"<key from /policy/search>\", ...]}",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "DeleteByKeys",
            "type": "label",
            "label": "StartActivity to DeleteByKeys"
          },
          {
            "id": 2,
            "from": "DeleteByKeys",
            "to": "LogDelete",
            "type": "label",
            "label": "DeleteByKeys to LogDelete"
          },
          {
            "id": 3,
            "from": "LogDelete",
            "to": "Return",
            "type": "label",
            "label": "LogDelete to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "DeleteByKeys",
            "name": "DeleteByKeys",
            "description": "Delete the listed primary keys.",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectordelete",
              "settings": {
                "asConnection": "conn://7c1e5a90-3b2d-4f6a-9e41-2a9d0c7b5e01",
                "deleteBy": "Key",
                "tableName": "telecore_policy_kb"
              },
              "input": {
                "filter": "",
                "keys": {
                  "mapping": {
                    "@foreach($flow.body.keys,k)": {
                      "=": "$loop"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "keys": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogDelete",
            "name": "LogDelete",
            "description": "Log the keys submitted",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=\"[chunks/delete] submitted \" + coerce.toString(array.count($flow.body.keys)) + \" key(s)\"",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": ""
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                }
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return the number of keys submitted",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "status": "DELETED",
                      "keysSubmitted": "=$activity[DeleteByKeys].rowCount"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjYwLCJ5Ijo4MH0sIkRlbGV0ZUJ5S2V5cyI6eyJ4IjoyNTAsInkiOjgwfSwiTG9nRGVsZXRlIjp7IngiOjQ0MCwieSI6ODB9LCJSZXR1cm4iOnsieCI6NjMwLCJ5Ijo4MH19",
        "metadata": {
          "input": [
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "body",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"keys\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}}"
              }
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "data",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"status\":{\"type\":\"string\"},\"keysSubmitted\":{\"type\":\"integer\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"ReceiveHTTPMessage\",\"properties\":{\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"body\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"keys\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}}}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"data\":{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"string\"},\"keysSubmitted\":{\"type\":\"integer\"}}}},\"required\":[]}"
          }
        }
      }
    },
    {
      "id": "flow:SearchTelecomPolicies",
      "data": {
        "name": "SearchTelecomPolicies",
        "description": "Tool: semantic search over the TeleCore policy library (ChunkAndEmbed -> VectorSearch).",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogQuestion",
            "type": "label",
            "label": "StartActivity to LogQuestion"
          },
          {
            "id": 2,
            "from": "LogQuestion",
            "to": "EmbedQuestion",
            "type": "label",
            "label": "LogQuestion to EmbedQuestion"
          },
          {
            "id": 3,
            "from": "EmbedQuestion",
            "to": "VectorSearch",
            "type": "label",
            "label": "EmbedQuestion to VectorSearch"
          },
          {
            "id": 4,
            "from": "VectorSearch",
            "to": "ProjectMatches",
            "type": "expression",
            "label": "VectorSearch to ProjectMatches",
            "value": "$activity[VectorSearch].rowCount > 0"
          },
          {
            "id": 5,
            "from": "ProjectMatches",
            "to": "ReturnMatches",
            "type": "label",
            "label": "ProjectMatches to ReturnMatches"
          },
          {
            "id": 6,
            "from": "VectorSearch",
            "to": "ReturnNoMatch",
            "type": "expression",
            "label": "VectorSearch to ReturnNoMatch",
            "value": "$activity[VectorSearch].rowCount == 0"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogQuestion",
            "name": "LogQuestion",
            "description": "Log the tool call",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=\"[agent tool] SearchTelecomPolicies: \" + $flow.toolParams.question",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": ""
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                }
              }
            }
          },
          {
            "id": "EmbedQuestion",
            "name": "EmbedQuestion",
            "description": "Embed the agent's search query.",
            "activity": {
              "ref": "#chunkandembeddocuments",
              "settings": {
                "contentSource": "Text",
                "fileEncoding": "UTF-8",
                "maxFileSizeMB": 25,
                "onFileError": "Skip",
                "chunkingStrategy": "Recursive",
                "chunkSize": 1500,
                "chunkOverlap": 0,
                "delimiterIsRegex": false,
                "separators": "",
                "delimiter": "",
                "markdownHeadingLevel": 2,
                "minChunkSize": 0,
                "embeddingProvider": "OpenAI",
                "embeddingModel": "text-embedding-3-small",
                "dimensions": 0,
                "requestTimeoutSeconds": 30
              },
              "input": {
                "text": "=$flow.toolParams.question",
                "documentId": "agent-query",
                "apiKey": "=$property[\"AgenticAI.OpenAI_LLMProvider.API_Key\"]",
                "baseUrl": "=$property[\"AgenticAI.OpenAI_LLMProvider.Embedding_Base_URL\"]",
                "filePaths": {
                  "mapping": []
                }
              },
              "schemas": {
                "input": {
                  "filePaths": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"string\"\r\n  }\r\n}\r\n"
                  }
                },
                "output": {
                  "embeddings": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"index\":{\"type\":\"number\"},\"text\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"startOffset\":{\"type\":\"number\"},\"endOffset\":{\"type\":\"number\"},\"charCount\":{\"type\":\"number\"},\"headings\":{\"type\":\"array\",\"items\":{}},\"metadata\":{\"type\":\"object\",\"properties\":{}},\"embedding\":{\"type\":\"array\",\"items\":{}},\"dimensions\":{\"type\":\"number\"}}}}",
                    "fe_metadata": "[{\"id\": \"\", \"index\": 0, \"text\": \"\", \"source\": \"\", \"startOffset\": 0, \"endOffset\": 0, \"charCount\": 0, \"headings\": [], \"metadata\": {}, \"embedding\": [], \"dimensions\": 0}]"
                  },
                  "skippedFiles": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"}}}}",
                    "fe_metadata": "[{\"path\": \"\", \"reason\": \"\"}]"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "VectorSearch",
            "name": "VectorSearch",
            "description": "Cosine-similarity search over telecore_policy_kb.embedding using the query embedding.",
            "type": "iterator",
            "settings": {
              "iterate": "=$activity[EmbedQuestion].embeddings",
              "accumulate": false,
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#vectorsearch",
              "settings": {
                "asConnection": "conn://7c1e5a90-3b2d-4f6a-9e41-2a9d0c7b5e01",
                "tableName": "telecore_policy_kb",
                "vectorColumn": "embedding",
                "similarityFunction": "Cosine"
              },
              "input": {
                "filter": "",
                "maxResults": "=$property[\"Search.Max_Results\"]",
                "minScore": "=$property[\"Search.Min_Score\"]",
                "queryTimeoutInSeconds": 0,
                "queryVector": "=coerce.toArray($iteration[value].embedding)"
              },
              "schemas": {
                "input": {
                  "queryVector": {
                    "type": "json",
                    "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"number\"\r\n  }\r\n}\r\n",
                    "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"array\",\r\n  \"items\": {\r\n    \"type\": \"number\"\r\n  }\r\n}\r\n"
                  }
                },
                "output": {
                  "rows": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"metadata\":{\"type\":\"string\"},\"embedding\":{\"type\":\"array\",\"items\":{}},\"score\":{\"type\":\"number\"}}}}",
                    "fe_metadata": "[{\"key\": \"\", \"content\": \"\", \"metadata\": \"\", \"embedding\": [], \"score\": 0}]"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ProjectMatches",
            "name": "ProjectMatches",
            "description": "Project the matching rows to {key, content, source, score} - drop the raw vectors.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "matches": {
                      "@foreach($activity[VectorSearch].rows,row)": {
                        "key": "=$loop.key",
                        "content": "=$loop.content",
                        "source": "=$loop.metadata",
                        "score": "=$loop.score"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"matches\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"score\":{\"type\":\"number\"}}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"matches\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"score\":{\"type\":\"number\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnMatches",
            "name": "ReturnMatches",
            "description": "Return the passages to the agent as JSON text",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "=coerce.toString($activity[ProjectMatches].output)",
                      "error": ""
                    }
                  }
                }
              }
            }
          },
          {
            "id": "ReturnNoMatch",
            "name": "ReturnNoMatch",
            "description": "Tell the agent nothing relevant was found",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "{\"matches\":[],\"note\":\"NO_MATCHING_POLICY - no published policy passage is relevant to this question.\"}",
                      "error": ""
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "toolParams",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"question\":{\"type\":\"string\",\"description\":\"The customer's question rephrased as a self-contained policy search query, e.g. 'roaming data rate per GB in Japan'\"}}"
              }
            }
          ],
          "output": [
            {
              "name": "response",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"toolParams\":{\"type\":\"object\",\"properties\":{\"question\":{\"type\":\"string\",\"description\":\"The customer's question rephrased as a self-contained policy search query, e.g. 'roaming data rate per GB in Japan'\"}},\"required\":[\"question\"]}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}}}"
          }
        }
      }
    },
    {
      "id": "flow:ChatWithPolicyAssistant",
      "data": {
        "name": "ChatWithPolicyAssistant",
        "description": "WebSocket message -> Invoke AI Agent (TelecomPolicyAssistant) -> write the answer back to the socket",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "AskPolicyAssistant",
            "type": "label",
            "label": "StartActivity to AskPolicyAssistant"
          },
          {
            "id": 2,
            "from": "AskPolicyAssistant",
            "to": "WebsocketWriteData",
            "type": "label",
            "label": "AskPolicyAssistant to WebsocketWriteData"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "AskPolicyAssistant",
            "name": "AskPolicyAssistant",
            "description": "Invoke the TelecomPolicyAssistant agent. conversationId = the WebSocket connection key, so each chat window keeps its own memory.",
            "activity": {
              "ref": "#callagent",
              "input": {
                "agentName": "TelecomPolicyAssistant",
                "prompt": "=coerce.toString($flow.content)",
                "structuredOutput": false,
                "conversationId": "=$flow.headers[\"Sec-Websocket-Key\"]"
              }
            }
          },
          {
            "id": "WebsocketWriteData",
            "name": "WebsocketWriteData",
            "description": "Send the agent's answer back to the chat client",
            "activity": {
              "ref": "#wswritedata",
              "settings": {
                "format": "String",
                "jsonSchema": ""
              },
              "input": {
                "message": "=$activity[AskPolicyAssistant].response",
                "wsconnection": "=$flow.wsconnection"
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjYwLCJ5Ijo4MH0sIkFza1BvbGljeUFzc2lzdGFudCI6eyJ4IjoyNTAsInkiOjgwfSwiV2Vic29ja2V0V3JpdGVEYXRhIjp7IngiOjQ0MCwieSI6ODB9fQ==",
        "metadata": {
          "input": [
            {
              "name": "pathParams",
              "type": "params"
            },
            {
              "name": "queryParams",
              "type": "params"
            },
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "content",
              "type": "any"
            },
            {
              "name": "wsconnection",
              "type": "any"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"WebsocketServer\",\"properties\":{\"pathParams\":{\"type\":\"params\"},\"queryParams\":{\"type\":\"params\"},\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Key\":{\"type\":\"string\",\"visible\":false},\"Sec-Websocket-Version\":{\"type\":\"string\",\"visible\":false},\"Upgrade\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"content\":{\"type\":\"any\",\"required\":false},\"wsconnection\":{\"type\":\"any\",\"required\":false}}}"
          }
        }
      }
    }
  ],
