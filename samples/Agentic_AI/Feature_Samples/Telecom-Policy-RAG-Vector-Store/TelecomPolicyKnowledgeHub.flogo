                      "embeddingModel": "=$activity[ChunkAndEmbedText].model",
                      "totalTokens": "=$activity[ChunkAndEmbedText].totalTokens",
                      "skippedFiles": "=$activity[ChunkAndEmbedText].skippedFiles"
                    }
                  }
                }
              }
            }
          }
        ],
