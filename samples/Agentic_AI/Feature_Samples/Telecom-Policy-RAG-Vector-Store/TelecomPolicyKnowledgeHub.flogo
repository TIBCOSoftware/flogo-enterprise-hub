            "name": "LogIngest",
            "description": "Log what was ingested",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=\"[ingest/text] \" + $flow.body.documentId + \": embedded \" + coerce.toString($activity[ChunkAndEmbedText].count) + \" chunks\"",
                "logLevel": "",
                "loggerName": "",
                "fieldPrefix": ""
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
