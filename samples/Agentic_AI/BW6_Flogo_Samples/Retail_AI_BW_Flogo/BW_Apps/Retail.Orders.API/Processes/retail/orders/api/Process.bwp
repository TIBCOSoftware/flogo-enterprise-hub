                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20260510155603PLT&quot; xmlns:tns8=&quot;http://tns.tibco.com/bw/json/1778536847926&quot; xmlns:tns11=&quot;http://tns.tibco.com/bw/json/1778534870025&quot; xmlns:tns3=&quot;http://xmlns.example.com/order/parameters&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/json/1778525283809&quot; xmlns:tns5=&quot;http://tns.tibco.com/bw/json/1778536925151&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseProductsJSON&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseOrderJSON&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseCustomerJSON&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$ParseOrderJSON/tns8:OrdersSchemaElement[tns8:orderId = $get.parameters/tns3:orderId][1]&quot;>&#xa;            &lt;tns11:GetOrderResponseElement>&#xa;                &lt;xsl:if test=&quot;tns8:orderId&quot;>&#xa;                    &lt;tns11:orderId>&#xa;                        &lt;xsl:value-of select=&quot;tns8:orderId&quot;/>&#xa;                    &lt;/tns11:orderId>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tns8:customerId&quot;>&#xa;                    &lt;tns11:customerId>&#xa;                        &lt;xsl:value-of select=&quot;tns8:customerId&quot;/>&#xa;                    &lt;/tns11:customerId>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tns8:sku&quot;>&#xa;                    &lt;tns11:sku>&#xa;                        &lt;xsl:value-of select=&quot;tns8:sku&quot;/>&#xa;                    &lt;/tns11:sku>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tns8:purchaseDate&quot;>&#xa;                    &lt;tns11:purchaseDate>&#xa;                        &lt;xsl:value-of select=&quot;tns8:purchaseDate&quot;/>&#xa;                    &lt;/tns11:purchaseDate>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tns8:channel&quot;>&#xa;                    &lt;tns11:channel>&#xa;                        &lt;xsl:value-of select=&quot;tns8:channel&quot;/>&#xa;                    &lt;/tns11:channel>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tns8:storeId&quot;>&#xa;                    &lt;tns11:storeId>&#xa;                        &lt;xsl:value-of select=&quot;tns8:storeId&quot;/>&#xa;                    &lt;/tns11:storeId>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$ParseProductsJSON/tns4:ProductElement[tns4:sku = current()/tns8:sku]&quot;>&#xa;                    &lt;tns11:product>&#xa;                        &lt;xsl:if test=&quot;tns4:sku&quot;>&#xa;                            &lt;tns11:sku>&#xa;                                &lt;xsl:value-of select=&quot;tns4:sku&quot;/>&#xa;                            &lt;/tns11:sku>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns4:name&quot;>&#xa;                            &lt;tns11:name>&#xa;                                &lt;xsl:value-of select=&quot;tns4:name&quot;/>&#xa;                            &lt;/tns11:name>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns4:brand&quot;>&#xa;                            &lt;tns11:brand>&#xa;                                &lt;xsl:value-of select=&quot;tns4:brand&quot;/>&#xa;                            &lt;/tns11:brand>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns4:category&quot;>&#xa;                            &lt;tns11:category>&#xa;                                &lt;xsl:value-of select=&quot;tns4:category&quot;/>&#xa;                            &lt;/tns11:category>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns4:price&quot;>&#xa;                            &lt;tns11:price>&#xa;                                &lt;xsl:value-of select=&quot;tns4:price&quot;/>&#xa;                            &lt;/tns11:price>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns4:description&quot;>&#xa;                            &lt;tns11:description>&#xa;                                &lt;xsl:value-of select=&quot;tns4:description&quot;/>&#xa;                            &lt;/tns11:description>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns11:product>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:for-each select=&quot;$ParseCustomerJSON/tns5:CustomersSchemaElement[tns5:customerId = current()/tns8:customerId]&quot;>&#xa;                    &lt;tns11:customer>&#xa;                        &lt;xsl:if test=&quot;tns5:customerId&quot;>&#xa;                            &lt;tns11:customerId>&#xa;                                &lt;xsl:value-of select=&quot;tns5:customerId&quot;/>&#xa;                            &lt;/tns11:customerId>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns5:loyaltyTier&quot;>&#xa;                            &lt;tns11:loyaltyTier>&#xa;                                &lt;xsl:value-of select=&quot;tns5:loyaltyTier&quot;/>&#xa;                            &lt;/tns11:loyaltyTier>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns5:preferredStoreId&quot;>&#xa;                            &lt;tns11:preferredStoreId>&#xa;                                &lt;xsl:value-of select=&quot;tns5:preferredStoreId&quot;/>&#xa;                            &lt;/tns11:preferredStoreId>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns11:customer>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns11:GetOrderResponseElement>&#xa;        &lt;/xsl:for-each>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20260510155603PLT" xmlns:tns8="http://tns.tibco.com/bw/json/1778536847926" xmlns:tns11="http://tns.tibco.com/bw/json/1778534870025" xmlns:tns3="http://xmlns.example.com/order/parameters" xmlns:tns4="http://tns.tibco.com/bw/json/1778525283809" xmlns:tns5="http://tns.tibco.com/bw/json/1778536925151" version="2.0"&gt;
    &lt;xsl:param name="get"/&gt;
    &lt;xsl:param name="ParseProductsJSON"/&gt;
    &lt;xsl:param name="ParseOrderJSON"/&gt;
    &lt;xsl:param name="ParseCustomerJSON"/&gt;
    &lt;xsl:template name="getOut-input" match="/"&gt;
        &lt;tns2:getResponse&gt;
            &lt;item&gt;
                &lt;xsl:for-each select="$ParseOrderJSON/tns8:OrdersSchemaElement[tns8:orderId = $get/parameters/tns3:api-ordersGetParameters/tns3:orderId][1]"&gt;
                    &lt;tns11:GetOrderResponseElement&gt;
                        &lt;xsl:if test="tns8:orderId"&gt;
                            &lt;tns11:orderId&gt;
                                &lt;xsl:value-of select="tns8:orderId"/&gt;
                            &lt;/tns11:orderId&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="tns8:customerId"&gt;
                            &lt;tns11:customerId&gt;
                                &lt;xsl:value-of select="tns8:customerId"/&gt;
                            &lt;/tns11:customerId&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="tns8:sku"&gt;
                            &lt;tns11:sku&gt;
                                &lt;xsl:value-of select="tns8:sku"/&gt;
                            &lt;/tns11:sku&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="tns8:purchaseDate"&gt;
                            &lt;tns11:purchaseDate&gt;
                                &lt;xsl:value-of select="tns8:purchaseDate"/&gt;
                            &lt;/tns11:purchaseDate&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="tns8:channel"&gt;
                            &lt;tns11:channel&gt;
                                &lt;xsl:value-of select="tns8:channel"/&gt;
                            &lt;/tns11:channel&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="tns8:storeId"&gt;
                            &lt;tns11:storeId&gt;
                                &lt;xsl:value-of select="tns8:storeId"/&gt;
                            &lt;/tns11:storeId&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:for-each select="$ParseProductsJSON/tns4:ProductElement[tns4:sku = current()/tns8:sku]"&gt;
                            &lt;tns11:product&gt;
                                &lt;xsl:if test="tns4:sku"&gt;
                                    &lt;tns11:sku&gt;
                                        &lt;xsl:value-of select="tns4:sku"/&gt;
                                    &lt;/tns11:sku&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="tns4:name"&gt;
                                    &lt;tns11:name&gt;
                                        &lt;xsl:value-of select="tns4:name"/&gt;
                                    &lt;/tns11:name&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="tns4:brand"&gt;
                                    &lt;tns11:brand&gt;
                                        &lt;xsl:value-of select="tns4:brand"/&gt;
                                    &lt;/tns11:brand&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="tns4:category"&gt;
                                    &lt;tns11:category&gt;
                                        &lt;xsl:value-of select="tns4:category"/&gt;
                                    &lt;/tns11:category&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="tns4:price"&gt;
                                    &lt;tns11:price&gt;
                                        &lt;xsl:value-of select="tns4:price"/&gt;
                                    &lt;/tns11:price&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="tns4:description"&gt;
                                    &lt;tns11:description&gt;
                                        &lt;xsl:value-of select="tns4:description"/&gt;
                                    &lt;/tns11:description&gt;
                                &lt;/xsl:if&gt;
                            &lt;/tns11:product&gt;
                        &lt;/xsl:for-each&gt;
                        &lt;xsl:for-each select="$ParseCustomerJSON/tns5:CustomersSchemaElement[tns5:customerId = current()/tns8:customerId]"&gt;
                            &lt;tns11:customer&gt;
                                &lt;xsl:if test="tns5:customerId"&gt;
                                    &lt;tns11:customerId&gt;
                                        &lt;xsl:value-of select="tns5:customerId"/&gt;
                                    &lt;/tns11:customerId&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="tns5:loyaltyTier"&gt;
                                    &lt;tns11:loyaltyTier&gt;
                                        &lt;xsl:value-of select="tns5:loyaltyTier"/&gt;
                                    &lt;/tns11:loyaltyTier&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="tns5:preferredStoreId"&gt;
                                    &lt;tns11:preferredStoreId&gt;
                                        &lt;xsl:value-of select="tns5:preferredStoreId"/&gt;
                                    &lt;/tns11:preferredStoreId&gt;
                                &lt;/xsl:if&gt;
                            &lt;/tns11:customer&gt;
                        &lt;/xsl:for-each&gt;
                    &lt;/tns11:GetOrderResponseElement&gt;
                &lt;/xsl:for-each&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
