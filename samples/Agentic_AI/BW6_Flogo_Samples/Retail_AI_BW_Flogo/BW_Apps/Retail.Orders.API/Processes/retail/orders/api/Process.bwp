ate"/&gt;&lt;/tns9:purchaseDate&gt;&lt;/xsl:if&gt;&lt;tns9:ageDays&gt;&lt;xsl:value-of select="$ageDaysVar"/&gt;&lt;/tns9:ageDays&gt;&lt;xsl:if test="$returnWindowsDaysVar"&gt;&lt;tns9:returnWindowDays&gt;&lt;xsl:value-of select="$returnWindowsDaysVar"/&gt;&lt;/tns9:returnWindowDays&gt;&lt;/xsl:if&gt;&lt;tns9:eligible&gt;&lt;xsl:value-of select="$eligibleVar"/&gt;&lt;/tns9:eligible&gt;&lt;xsl:if test="$ParseCustomerJSON1/tns5:CustomersSchemaElement[tns5:customerId = current()/tns8:customerId]/tns5:loyaltyTier"&gt;&lt;tns9:loyaltyTier&gt;&lt;xsl:value-of select="$ParseCustomerJSON1/tns5:CustomersSchemaElement[tns5:customerId = current()/tns8:customerId]/tns5:loyaltyTier"/&gt;&lt;/tns9:loyaltyTier&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$eligibleVar = true()"&gt;&lt;tns9:reason&gt;&lt;xsl:value-of select="concat(&amp;quot;The item is within the &amp;quot;, xsd:string($returnWindowsDaysVar) ,  &amp;quot; day return window.&amp;quot;)"/&gt;&lt;/tns9:reason&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns9:reason&gt;&lt;xsl:value-of select="concat(&amp;quot;The item is &amp;quot;, xsd:string($ageDaysVar - $returnWindowsDaysVar), &amp;quot; days past the &amp;quot;, xsd:string($returnWindowsDaysVar), &amp;quot; day return window.&amp;quot;)"/&gt;&lt;/tns9:reason&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns9:GetOrderReturnResponseElement&gt;&lt;/xsl:for-each&gt;&lt;/item&gt;&lt;/tns2:getResponse1&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
