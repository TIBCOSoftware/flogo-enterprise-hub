&lt;xsl:if test=&quot;tns8:sku&quot;>&#xa;                    &lt;tns9:sku>&#xa;                        &lt;xsl:value-of select=&quot;tns8:sku&quot;/>&#xa;                    &lt;/tns9:sku>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseProductsJSON1/tns4:ProductElement[tns4:sku = current()/tns8:sku]/tns4:name&quot;>&#xa;                    &lt;tns9:productName>&#xa;                        &lt;xsl:value-of select=&quot;$ParseProductsJSON1/tns4:ProductElement[tns4:sku = current()/tns8:sku]/tns4:name&quot;/>&#xa;                    &lt;/tns9:productName>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tns8:purchaseDate&quot;>&#xa;                    &lt;tns9:purchaseDate>&#xa;                        &lt;xsl:value-of select=&quot;tns8:purchaseDate&quot;/>&#xa;                    &lt;/tns9:purchaseDate>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns9:ageDays>&#xa;                    &lt;xsl:value-of select=&quot;$ageDaysVar&quot;/>&#xa;                &lt;/tns9:ageDays>&#xa;                &lt;xsl:if test=&quot;$returnWindowsDaysVar&quot;>&#xa;                    &lt;tns9:returnWindowDays>&#xa;                        &lt;xsl:value-of select=&quot;$returnWindowsDaysVar&quot;/>&#xa;                    &lt;/tns9:returnWindowDays>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns9:eligible>&#xa;                    &lt;xsl:value-of select=&quot;$eligibleVar&quot;/>&#xa;                &lt;/tns9:eligible>&#xa;                &lt;xsl:if test=&quot;$ParseCustomerJSON1/tns5:CustomersSchemaElement[tns5:customerId = current()/tns8:customerId]/tns5:loyaltyTier&quot;>&#xa;                    &lt;tns9:loyaltyTier>&#xa;                        &lt;xsl:value-of select=&quot;$ParseCustomerJSON1/tns5:CustomersSchemaElement[tns5:customerId = current()/tns8:customerId]/tns5:loyaltyTier&quot;/>&#xa;                    &lt;/tns9:loyaltyTier>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$eligibleVar = true()&quot;>&#xa;                        &lt;tns9:reason>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;The item is within the &amp;quot;, xsd:string($returnWindowsDaysVar) ,  &amp;quot; day return window.&amp;quot;)&quot;/>&#xa;                        &lt;/tns9:reason>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns9:reason>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;The item is &amp;quot;, xsd:string($ageDaysVar - $returnWindowsDaysVar), &amp;quot; days past the &amp;quot;, xsd:string($returnWindowsDaysVar), &amp;quot; day return window.&amp;quot;)&quot;/>&#xa;                        &lt;/tns9:reason>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns9:GetOrderReturnResponseElement>&#xa;        &lt;/xsl:for-each>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
