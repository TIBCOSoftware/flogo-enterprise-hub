<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns:tns="http://simple.schema/ProcessVars" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://simple.schema/ProcessVars">
    
  <xsd:element name="uuid">
