                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20260510203245PLT&quot; xmlns:tns17=&quot;http://tns.tibco.com/bw/json/1778455331925&quot; xmlns:tns20=&quot;http://tns.tibco.com/bw/json/1778455296819&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post3.item&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns17:PostToolsInventoryReserveResponseElement>&#xa;            &lt;tns17:requiresApproval>&#xa;                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;            &lt;/tns17:requiresApproval>&#xa;            &lt;tns17:toolName>&#xa;                &lt;xsl:value-of select=&quot;'reserve_inventory'&quot;/>&#xa;            &lt;/tns17:toolName>&#xa;            &lt;tns17:arguments>&#xa;                &lt;xsl:if test=&quot;$post3.item/tns20:sku&quot;>&#xa;                    &lt;tns17:sku>&#xa;                        &lt;xsl:value-of select=&quot;$post3.item/tns20:sku&quot;/>&#xa;                    &lt;/tns17:sku>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$post3.item/tns20:storeId&quot;>&#xa;                    &lt;tns17:storeId>&#xa;                        &lt;xsl:value-of select=&quot;$post3.item/tns20:storeId&quot;/>&#xa;                    &lt;/tns17:storeId>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$post3.item/tns20:customerId&quot;>&#xa;                    &lt;tns17:customerId>&#xa;                        &lt;xsl:value-of select=&quot;$post3.item/tns20:customerId&quot;/>&#xa;                    &lt;/tns17:customerId>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns17:arguments>&#xa;            &lt;tns17:message>&#xa;                &lt;xsl:value-of select=&quot;'This operation changes retail state and must be approved through the agent approval flow.'&quot;/>&#xa;            &lt;/tns17:message>&#xa;        &lt;/tns17:PostToolsInventoryReserveResponseElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20260510203245PLT" xmlns:tns17="http://tns.tibco.com/bw/json/1778455331925" xmlns:tns20="http://tns.tibco.com/bw/json/1778455296819" version="2.0"&gt;
    &lt;xsl:param name="post3"/&gt;
    &lt;xsl:template name="postOut3-input" match="/"&gt;
        &lt;tns:postResponse3&gt;
            &lt;item&gt;
                &lt;tns17:PostToolsInventoryReserveResponseElement&gt;
                    &lt;tns17:requiresApproval&gt;
                        &lt;xsl:value-of select="true()"/&gt;
                    &lt;/tns17:requiresApproval&gt;
                    &lt;tns17:toolName&gt;
                        &lt;xsl:value-of select="'reserve_inventory'"/&gt;
                    &lt;/tns17:toolName&gt;
                    &lt;tns17:arguments&gt;
                        &lt;xsl:if test="$post3/item/tns20:PostToolsReserveInventoryRequestElement/tns20:sku"&gt;
                            &lt;tns17:sku&gt;
                                &lt;xsl:value-of select="$post3/item/tns20:PostToolsReserveInventoryRequestElement/tns20:sku"/&gt;
                            &lt;/tns17:sku&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$post3/item/tns20:PostToolsReserveInventoryRequestElement/tns20:storeId"&gt;
                            &lt;tns17:storeId&gt;
                                &lt;xsl:value-of select="$post3/item/tns20:PostToolsReserveInventoryRequestElement/tns20:storeId"/&gt;
                            &lt;/tns17:storeId&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$post3/item/tns20:PostToolsReserveInventoryRequestElement/tns20:customerId"&gt;
                            &lt;tns17:customerId&gt;
                                &lt;xsl:value-of select="$post3/item/tns20:PostToolsReserveInventoryRequestElement/tns20:customerId"/&gt;
                            &lt;/tns17:customerId&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns17:arguments&gt;
                    &lt;tns17:message&gt;
                        &lt;xsl:value-of select="'This operation changes retail state and must be approved through the agent approval flow.'"/&gt;
                    &lt;/tns17:message&gt;
                &lt;/tns17:PostToolsInventoryReserveResponseElement&gt;
            &lt;/item&gt;
        &lt;/tns:postResponse3&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            </bpws:reply>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
