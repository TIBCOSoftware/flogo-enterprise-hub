<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="products">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" name="product">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="sku" type="xs:string" />
              <xs:element name="name" type="xs:string" />
              <xs:element name="brand" type="xs:string" />
              <xs:element name="category" type="xs:string" />
              <xs:element name="price" type="xs:integer" />
              <xs:element name="description" type="xs:string" />
              <xs:element name="attributes">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="color" type="xs:string" minOccurs="0" maxOccurs="1"/>
                    <xs:element minOccurs="0" name="batteryHours" type="xs:integer" />
                    <xs:element minOccurs="0" name="capacityOz" type="xs:integer" />
                    <xs:element minOccurs="0" name="thicknessMm" type="xs:integer" />
                    <xs:element minOccurs="0" name="batteryDays" type="xs:integer" />
                    <xs:element minOccurs="0" name="capacityLiters" type="xs:integer" />
                    <xs:element minOccurs="0" name="gender" type="xs:string" />
                    <xs:element minOccurs="0" name="use" type="xs:string" />
                    <xs:element minOccurs="0" name="returnWindowDays" type="xs:integer" />
                    <xs:element minOccurs="0" name="warrantyMonths" type="xs:integer" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>