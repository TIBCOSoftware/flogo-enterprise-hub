<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://tns.tibco.com/bw/json/1779305569562" elementFormDefault="qualified" targetNamespace="http://tns.tibco.com/bw/json/1779305569562">
  <complexType name="IngestionSummarySchemaElementType">
    <sequence>
      <element maxOccurs="1" minOccurs="0" name="sourceCount" type="integer"/>
      <element maxOccurs="1" minOccurs="0" name="chunkCount" type="integer"/>
      <element maxOccurs="1" minOccurs="0" name="embedding">
        <complexType>
          <sequence>
          	<element maxOccurs="1" minOccurs="0" name="provider"
          		type="string" />
          	<element name="model" type="string" minOccurs="0" maxOccurs="1"></element>
          </sequence>
        </complexType>
      </element>
      <element maxOccurs="1" minOccurs="0" name="storage">
        <complexType>
          <sequence>
            <element maxOccurs="1" minOccurs="0" name="provider" type="string"/>
            <element maxOccurs="1" minOccurs="0" name="collection" type="string"/>
          </sequence>
        </complexType>
      </element>
      <element maxOccurs="unbounded" minOccurs="0" name="sampleChunks">
        <complexType>
          <sequence>
            <element maxOccurs="1" minOccurs="0" name="chunkId" type="string"/>
            <element maxOccurs="1" minOccurs="0" name="documentId" type="string"/>
            <element maxOccurs="1" minOccurs="0" name="title" type="string"/>
            <element maxOccurs="1" minOccurs="0" name="documentType" type="string"/>
            <element maxOccurs="1" minOccurs="0" name="tokenCount" type="integer"/>
          </sequence>
        </complexType>
      </element>
      <element maxOccurs="unbounded" minOccurs="0" name="errors" type="string"/>
    </sequence>
  </complexType>
  <element name="IngestionSummarySchemaElement" type="tns:IngestionSummarySchemaElementType"/>
</schema>
