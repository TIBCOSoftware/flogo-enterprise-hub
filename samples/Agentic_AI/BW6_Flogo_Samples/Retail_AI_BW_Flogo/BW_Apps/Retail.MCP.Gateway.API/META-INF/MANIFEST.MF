 .bw.palette; filter:="(name=bw.restjson)",com.tibco.bw.palette; filter:
 ="(name=bw.java)",com.tibco.bw.sharedresource.model; filter:="(name=bw.
 httpconnector)",com.tibco.bw.binding.model; filter:="(name=bw.rest)"
