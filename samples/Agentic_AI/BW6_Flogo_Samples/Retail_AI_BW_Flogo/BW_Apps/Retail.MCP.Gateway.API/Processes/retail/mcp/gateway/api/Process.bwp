    <tibex:VariableDescriptor type="MemorySaving">
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
                <variable>ParseJSON</variable>
            </endingVariables>
        </task>
        <task name="JavaInvokeListTools">
            <endingVariables>
                <variable>JavaInvokeListTools-input</variable>
            </endingVariables>
        </task>
        <task name="ParseJSON">
            <endingVariables>
                <variable>ParseJSON-input</variable>
                <variable>JavaInvokeListTools</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>ParseJSON1</variable>
            </endingVariables>
        </task>
        <task name="BuildArgumentsJson">
            <endingVariables>
                <variable>BuildArgumentsJson-input</variable>
            </endingVariables>
        </task>
        <task name="JavaInvokeToolCall">
            <endingVariables>
                <variable>JavaInvokeToolCall-input</variable>
                <variable>post</variable>
                <variable>BuildArgumentsJson</variable>
            </endingVariables>
        </task>
        <task name="ParseJSON1">
            <endingVariables>
                <variable>ParseJSON1-input</variable>
                <variable>JavaInvokeToolCall</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
