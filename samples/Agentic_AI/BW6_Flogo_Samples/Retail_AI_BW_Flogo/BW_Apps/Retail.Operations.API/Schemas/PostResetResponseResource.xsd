<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://tns.tibco.com/bw/json/1778544477268" elementFormDefault="qualified" targetNamespace="http://tns.tibco.com/bw/json/1778544477268">
  <complexType name="PostResetResponseElementType">
    <sequence>
      <element maxOccurs="1" minOccurs="0" name="reset">
        <complexType>
          <sequence>
            <element maxOccurs="1" minOccurs="0" name="uploads">
              <complexType>
                <sequence>
                  <element maxOccurs="1" minOccurs="0" name="provider" type="string"/>
                  <element maxOccurs="1" minOccurs="0" name="uploads" type="integer"/>
                </sequence>
              </complexType>
            </element>
            <element maxOccurs="1" minOccurs="0" name="operations">
              <complexType>
                <sequence>
                  <element maxOccurs="1" minOccurs="0" name="provider" type="string"/>
                  <element maxOccurs="1" minOccurs="0" name="warning" type="string"/>
                </sequence>
              </complexType>
            </element>
            <element maxOccurs="1" minOccurs="0" name="conversations">
              <complexType>
                <sequence>
                  <element maxOccurs="1" minOccurs="0" name="provider" type="string"/>
                  <element maxOccurs="1" minOccurs="0" name="warning" type="string"/>
                </sequence>
              </complexType>
            </element>
            <element maxOccurs="1" minOccurs="0" name="resetAt" type="string"/>
          </sequence>
        </complexType>
      </element>
      <element maxOccurs="1" minOccurs="0" name="status">
        <complexType>
          <sequence>
          	<element name="dataset" minOccurs="0" maxOccurs="1">
          		<complexType>
          			<sequence>
          				<element name="products" type="string" minOccurs="0" maxOccurs="1"></element>
          				<element name="inventory" type="string" minOccurs="0" maxOccurs="1"></element>
          				<element name="customers" type="string" minOccurs="0" maxOccurs="1"></element>
          				<element name="orders" type="string" minOccurs="0" maxOccurs="1"></element>
          				<element name="policies" type="string" minOccurs="0" maxOccurs="1"></element>
          			</sequence>
          		</complexType>
          	</element>
                        <element name="ingestion" minOccurs="0" maxOccurs="1">
                        	<complexType>
                        		<sequence>
                        			<element name="sourceCount"
                        				type="string" minOccurs="0" maxOccurs="1">
                        			</element>
                        			<element name="chunkCount"
                        				type="string" minOccurs="0" maxOccurs="1">
                        			</element>
                        			<element name="embeddedAt"
                        				type="string" minOccurs="0" maxOccurs="1">
                        			</element>
                        			<element name="embedding"
                        				minOccurs="0" maxOccurs="1">
                        				<complexType>
                        					<sequence>
                        						<element
                        							name="provider" type="string" minOccurs="0" maxOccurs="1">
                        						</element>
                        					</sequence>
                        				</complexType>
                        			</element>
                        			<element name="storage"
                        				minOccurs="0" maxOccurs="1">
                        				<complexType>
                        					<sequence>
                        						<element
                        							name="provider" type="string" minOccurs="0" maxOccurs="1">
                        						</element>
                        					</sequence>
                        				</complexType>
                        			</element>
                        			<element name="uploads"
                        				minOccurs="0" maxOccurs="unbounded"
                        				type="string" nillable="true">
                        			</element>
                        			<element name="sampleChunks"
                        				type="string" minOccurs="0" maxOccurs="unbounded" nillable="true">
                        			</element>
                        		</sequence>
                        	</complexType></element>
                        <element maxOccurs="1" minOccurs="0" name="operations">
          		<complexType>
          			<sequence>
          				<element maxOccurs="1" minOccurs="0"
          					name="provider" type="string" />
          				<element maxOccurs="1" minOccurs="0"
          					name="approvals" type="integer" />
          				<element maxOccurs="1" minOccurs="0"
          					name="reservations" type="integer" />
          				<element maxOccurs="1" minOccurs="0"
          					name="returnAuthorizations" type="integer" />
          				<element maxOccurs="1" minOccurs="0"
          					name="promotionApplications" type="integer" />
          			</sequence>
          		</complexType>
          	</element>
          	<element maxOccurs="1" minOccurs="0"
          		name="conversations">
          		<complexType>
          			<sequence>
          				<element maxOccurs="1" minOccurs="0"
          					name="provider" type="string" />
          				<element maxOccurs="1" minOccurs="0"
          					name="warning" type="string" />
          				<element maxOccurs="1" minOccurs="0"
          					name="conversations" type="integer" />
          				<element maxOccurs="1" minOccurs="0"
          					name="messages" type="integer" />
          			</sequence>
          		</complexType>
          	</element>
          </sequence>
        </complexType>
      </element>
    </sequence>
  </complexType>
  <element name="PostResetResponseElement" type="tns:PostResetResponseElementType"/>
</schema>
