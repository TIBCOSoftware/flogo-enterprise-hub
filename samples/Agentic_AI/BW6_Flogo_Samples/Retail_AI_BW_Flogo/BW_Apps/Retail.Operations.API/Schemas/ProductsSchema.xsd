<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://tns.tibco.com/bw/json/1778525283809" elementFormDefault="qualified" targetNamespace="http://tns.tibco.com/bw/json/1778525283809">
    
  <complexType name="ProductElementType">
        
    <sequence>
            
      <element maxOccurs="1" minOccurs="0" name="sku" type="string"/>
            
      <element maxOccurs="1" minOccurs="0" name="name" type="string"/>
            
      <element maxOccurs="1" minOccurs="0" name="brand" type="string"/>
            
      <element maxOccurs="1" minOccurs="0" name="category" type="string"/>
            
      <element maxOccurs="1" minOccurs="0" name="price" type="integer"/>
            
      <element maxOccurs="1" minOccurs="0" name="description" type="string"/>
      
      <element maxOccurs="1" minOccurs="0" name="attributes">
          
        <complexType>
              
          <all>
          	<element maxOccurs="1" minOccurs="0" name="color"
          		type="string" />
          	<element maxOccurs="1" minOccurs="0" name="gender"
          		type="string" />
          	<element maxOccurs="1" minOccurs="0" name="use"
          		type="string" />
          	<element maxOccurs="1" minOccurs="0"
          		name="returnWindowDays" type="integer" />
          	<element maxOccurs="1" minOccurs="0" name="warrantyMonths"
          		type="integer" />
          	<element maxOccurs="1" minOccurs="0" name="capacityLiters"
          		type="integer" />
          	<element name="batteryDays" type="integer" minOccurs="0"
          		maxOccurs="1">
          	</element>
          	<element maxOccurs="1" minOccurs="0" name="thicknessMm"
          		type="integer" />
                        <element name="capacityOz" type="integer" minOccurs="0" maxOccurs="1"></element>
                        <element maxOccurs="1" minOccurs="0" name="batteryHours"
          		type="integer" />
          </all>
        </complexType>
        
      </element>
          
    </sequence>
      
  </complexType>
    
  <element name="ProductElement" type="tns:ProductElementType"/>
    
  <complexType name="ProductElementArrayType">
        
    <sequence>
            
      <element maxOccurs="unbounded" minOccurs="0" ref="tns:ProductElement"/>
          
    </sequence>
      
  </complexType>
    
  <element name="ProductElementArray" type="tns:ProductElementArrayType"/>
  
</schema>
