t;inventory tool&amp;quot;, &amp;quot;aisle result&amp;quot;]&amp;#xA;    },&amp;#xA;    {&amp;#xA;      &amp;quot;id&amp;quot;: &amp;quot;return-flow&amp;quot;,&amp;#xA;      &amp;quot;title&amp;quot;: &amp;quot;Return Eligibility&amp;quot;,&amp;#xA;      &amp;quot;goal&amp;quot;: &amp;quot;Show order lookup, policy retrieval, and return eligibility.&amp;quot;,&amp;#xA;      &amp;quot;question&amp;quot;: &amp;quot;Can I return order ORD-1001?&amp;quot;,&amp;#xA;      &amp;quot;userId&amp;quot;: &amp;quot;USR-ASSOCIATE-001&amp;quot;,&amp;#xA;      &amp;quot;customerId&amp;quot;: &amp;quot;CUST-001&amp;quot;,&amp;#xA;      &amp;quot;storeId&amp;quot;: &amp;quot;SFO-001&amp;quot;,&amp;#xA;      &amp;quot;expected&amp;quot;: [&amp;quot;order tool&amp;quot;, &amp;quot;return tool&amp;quot;, &amp;quot;policy citation&amp;quot;]&amp;#xA;    },&amp;#xA;    {&amp;#xA;      &amp;quot;id&amp;quot;: &amp;quot;approval-reservation&amp;quot;,&amp;#xA;      &amp;quot;title&amp;quot;: &amp;quot;Approval Gate&amp;quot;,&amp;#xA;      &amp;quot;goal&amp;quot;: &amp;quot;Show the agent pausing before a state-changing reservation.&amp;quot;,&amp;#xA;      &amp;quot;question&amp;quot;: &amp;quot;Reserve RUN-PEG-001 at SFO-001 for CUST-001.&amp;quot;,&amp;#xA;      &amp;quot;userId&amp;quot;: &amp;quot;USR-MANAGER-001&amp;quot;,&amp;#xA;      &amp;quot;customerId&amp;quot;: &amp;quot;CUST-001&amp;quot;,&amp;#xA;      &amp;quot;storeId&amp;quot;: &amp;quot;SFO-001&amp;quot;,&amp;#xA;      &amp;quot;expected&amp;quot;: [&amp;quot;approval required&amp;quot;, &amp;quot;manager approval&amp;quot;, &amp;quot;persisted reservation&amp;quot;]&amp;#xA;    },&amp;#xA;    {&amp;#xA;      &amp;quot;id&amp;quot;: &amp;quot;promotion-agent&amp;quot;,&amp;#xA;      &amp;quot;title&amp;quot;: &amp;quot;Recommendation + Promotion&amp;quot;,&amp;#xA;      &amp;quot;goal&amp;quot;: &amp;quot;Show recommendation reasoning, promotion lookup, and approval safety.&amp;quot;,&amp;#xA;      &amp;quot;question&