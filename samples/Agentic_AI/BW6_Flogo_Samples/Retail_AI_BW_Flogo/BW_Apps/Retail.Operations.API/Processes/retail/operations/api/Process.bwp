                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns33=&quot;activity.jsonParser.input+0ce3042f-8232-4b88-b465-a5e84de4d2d1+ActivityInputType&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;ParseCustomerJSON-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns33:ActivityInputClass>&#xa;            &lt;jsonString>&#xa;                &lt;xsl:value-of select=&quot;'[&amp;#xA;  {&amp;#xA;    &amp;quot;customerId&amp;quot;: &amp;quot;CUST-001&amp;quot;,&amp;#xA;    &amp;quot;name&amp;quot;: &amp;quot;Avery Chen&amp;quot;,&amp;#xA;    &amp;quot;loyaltyTier&amp;quot;: &amp;quot;Gold&amp;quot;,&amp;#xA;    &amp;quot;preferredStoreId&amp;quot;: &amp;quot;SFO-001&amp;quot;,&amp;#xA;    &amp;quot;preferences&amp;quot;: [&amp;quot;running&amp;quot;, &amp;quot;lightweight gear&amp;quot;, &amp;quot;blue&amp;quot;]&amp;#xA;  },&amp;#xA;  {&amp;#xA;    &amp;quot;customerId&amp;quot;: &amp;quot;CUST-002&amp;quot;,&amp;#xA;    &amp;quot;name&amp;quot;: &amp;quot;Jordan Lee&amp;quot;,&amp;#xA;    &amp;quot;loyaltyTier&amp;quot;: &amp;quot;Silver&amp;quot;,&amp;#xA;    &amp;quot;preferredStoreId&amp;quot;: &amp;quot;OAK-002&amp;quot;,&amp;#xA;    &amp;quot;preferences&amp;quot;: [&amp;quot;hiking&amp;quot;, &amp;quot;waterproof outerwear&amp;quot;]&amp;#xA;  },&amp;#xA;  {&amp;#xA;    &amp;quot;customerId&amp;quot;: &amp;quot;CUST-003&amp;quot;,&amp;#xA;    &amp;quot;name&amp;quot;: &amp;quot;Priya Shah&amp;quot;,&amp;#xA;    &amp;quot;loyaltyTier&amp;quot;: &amp;quot;Member&amp;quot;,&amp;#xA;    &amp;quot;preferredStoreId&amp;quot;: &amp;quot;SFO-001&amp;quot;,&amp;#xA;    &amp;quot;preferences&amp;quot;: [&amp;quot;fitness electronics&amp;quot;, &amp;quot;commuting&amp;quot;]&amp;#xA;  },&amp;#xA;  {&amp;#xA;    &amp;quot;customerId&amp;quot;: &amp;quot;CUST-004&amp;quot;,&amp;#xA;    &amp;quot;name&amp;quot;: &amp;q