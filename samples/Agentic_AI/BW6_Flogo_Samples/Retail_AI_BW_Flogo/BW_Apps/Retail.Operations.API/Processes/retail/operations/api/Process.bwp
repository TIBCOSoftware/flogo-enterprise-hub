                                    sqlStatement="SELECT&#xa;  c.conversation_id,&#xa;  c.user_id,&#xa;  c.customer_id,&#xa;  c.store_id,&#xa;  c.title,&#xa;  COUNT(m.message_id) AS message_count&#xa;FROM retail_conversations c&#xa;LEFT JOIN retail_conversation_messages m&#xa;  ON m.conversation_id = c.conversation_id&#xa;WHERE c.conversation_id = ?&#xa;GROUP BY&#xa;  c.conversation_id,&#xa;  c.user_id,&#xa;  c.customer_id,&#xa;  c.store_id,&#xa;  c.title,&#xa;  c.created_at,&#xa;  c.updated_at;&#xa;"
