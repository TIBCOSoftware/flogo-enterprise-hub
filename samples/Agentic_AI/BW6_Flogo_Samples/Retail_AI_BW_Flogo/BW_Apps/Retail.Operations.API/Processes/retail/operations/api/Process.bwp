vel&amp;quot;,&amp;#xA;      &amp;quot;returnWindowDays&amp;quot;: 45,&amp;#xA;      &amp;quot;warrantyMonths&amp;quot;: 12&amp;#xA;    }&amp;#xA;  },&amp;#xA;  {&amp;#xA;    &amp;quot;sku&amp;quot;: &amp;quot;BAG-DAY-502&amp;quot;,&amp;#xA;    &amp;quot;name&amp;quot;: &amp;quot;MetroLite Daypack&amp;quot;,&amp;#xA;    &amp;quot;brand&amp;quot;: &amp;quot;CivicCarry&amp;quot;,&amp;#xA;    &amp;quot;category&amp;quot;: &amp;quot;Bags&amp;quot;,&amp;#xA;    &amp;quot;price&amp;quot;: 89,&amp;#xA;    &amp;quot;description&amp;quot;: &amp;quot;Twenty-liter commuter backpack with laptop sleeve, water bottle pockets, and weather-resistant fabric.&amp;quot;,&amp;#xA;    &amp;quot;attributes&amp;quot;: {&amp;#xA;      &amp;quot;color&amp;quot;: &amp;quot;Navy&amp;quot;,&amp;#xA;      &amp;quot;capacityLiters&amp;quot;: 20,&amp;#xA;      &amp;quot;use&amp;quot;: &amp;quot;Commuting&amp;quot;,&amp;#xA;      &amp;quot;returnWindowDays&amp;quot;: 45,&amp;#xA;      &amp;quot;warrantyMonths&amp;quot;: 24&amp;#xA;    }&amp;#xA;  },&amp;#xA;  {&amp;#xA;    &amp;quot;sku&amp;quot;: &amp;quot;FIT-WATCH-330&amp;quot;,&amp;#xA;    &amp;quot;name&amp;quot;: &amp;quot;PulseTrack Sport Watch&amp;quot;,&amp;#xA;    &amp;quot;brand&amp;quot;: &amp;quot;Northstar&amp;quot;,&amp;#xA;    &amp;quot;category&amp;quot;: &amp;quot;Electronics&amp;quot;,&amp;#xA;    &amp;quot;price&amp;quot;: 199,&amp;#xA;    &amp;quot;description&amp;quot;: &amp;quot;GPS sport watch with wrist heart-rate tracking, sleep insights, and five-day battery life.&amp;quot;,&amp;#xA;    &amp;quot;attributes&amp;quot;: {&amp;#xA;      &amp;quot;color&amp;quot;: &amp;quot;Black&amp;quot;,&amp;#xA;      &amp;quot;batteryDays&amp;quot;: 5,&amp;#xA;      &amp;quot;use&amp;quot;: &amp;quot;Fitness tracking&amp;quot;,&amp;#xA;      &amp;quot;returnWindowDays&amp;quot;: 14,&amp;#xA;      &amp;quot;warrantyMonths&amp;quot;: 12&amp;#xA;    }&amp;#xA;  },&amp;#xA;  {&amp;#xA;    &amp;quot;sku&amp;quot;: &amp;quot;YGA-MAT-014&amp;qu