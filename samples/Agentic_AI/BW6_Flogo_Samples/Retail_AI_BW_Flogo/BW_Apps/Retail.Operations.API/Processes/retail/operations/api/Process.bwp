                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TOP 25&#xa;  c.conversation_id,&#xa;  c.user_id,&#xa;  c.customer_id,&#xa;  c.store_id,&#xa;  c.title,&#xa;  COUNT(m.message_id) AS message_count&#xa;FROM retail_conversations c&#xa;LEFT JOIN retail_conversation_messages m&#xa;  ON m.conversation_id = c.conversation_id&#xa;GROUP BY&#xa;  c.conversation_id,&#xa;  c.user_id,&#xa;  c.customer_id,&#xa;  c.store_id,&#xa;  c.title,&#xa;  c.created_at,&#xa;  c.updated_at&#xa;ORDER BY c.updated_at DESC;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="conversation_id"
                                    dataType="1" typeName="uniqueidentifier"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="user_id"
                                    dataType="-9"
                                    status="OptionalElement" typeName="nvarchar"/>
                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="customer_id"
                                    dataType="-9"
                                    status="OptionalElement" typeName="nvarchar"/>
                                    <columnMetadata
                                    columnIndex="4"
                                    columnName="store_id"
                                    dataType="-9"
                                    status="OptionalElement" typeName="nvarchar"/>
                                    <columnMetadata
