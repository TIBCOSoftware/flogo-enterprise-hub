                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT&#xa;  approval_id,&#xa;  tool_name,&#xa;  arguments_json,&#xa;  summary,&#xa;  status,&#xa;  approved_by_json,&#xa;  result_json&#xa;FROM retail_approvals&#xa;WHERE approval_id = ?;&#xa;"
