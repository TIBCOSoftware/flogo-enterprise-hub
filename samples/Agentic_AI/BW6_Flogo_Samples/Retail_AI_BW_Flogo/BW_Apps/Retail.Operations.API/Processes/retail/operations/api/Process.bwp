                                tibex:xpdlId="fc3b613b-ae2e-49c2-aad1-3641c9f6aa24" variable="postOut-input">
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20260511170234PLT&quot; xmlns:tns17=&quot;http://tns.tibco.com/bw/json/1778544310015&quot; xmlns:tns5=&quot;http://tns.tibco.com/bw/json/1778544272499&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;GetPendingApproval&quot;/>&#xa;    &lt;xsl:param name=&quot;insert_retail_conversation_messages&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns17:PostApproveResponseElement>&#xa;            &lt;xsl:if test=&quot;$post.item/tns5:approvalId&quot;>&#xa;                &lt;tns17:approvalId>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns5:approvalId&quot;/>&#xa;                &lt;/tns17:approvalId>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$GetPendingApproval/Record[1]/tool_name&quot;>&#xa;                &lt;tns17:toolName>&#xa;                    &lt;xsl:value-of select=&quot;$GetPendingApproval/Record[1]/tool_name&quot;/>&#xa;                &lt;/tns17:toolName>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns17:approvedBy>&#xa;                &lt;xsl:if test=&quot;$post.item/tns5:userId&quot;>&#xa;                    &lt;tns17:userId>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns5:userId&quot;/>&#xa;                    &lt;/tns17:userId>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns17:approvedBy>&#xa;            &lt;tns17:persistence>&#xa;                &lt;tns17:provider>&#xa;                    &lt;xsl:value-of select=&quot;'sqlserver'&quot;/>&#xa;                &lt;/tns17:provider>&#xa;                &lt;xsl:if test=&quot;$post.item/tns5:approvalId&quot;>&#xa;                    &lt;tns17:approvalId>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns5:approvalId&quot;/>&#xa;                    &lt;/tns17:approvalId>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns17:persistence>&#xa;            &lt;tns17:conversation>&#xa;                &lt;tns17:provider>&#xa;                    &lt;xsl:value-of select=&quot;'sqlserver'&quot;/>&#xa;                &lt;/tns17:provider>&#xa;                &lt;xsl:if test=&quot;$post.item/tns5:conversationId&quot;>&#xa;                    &lt;tns17:conversationId>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns5:conversationId&quot;/>&#xa;                    &lt;/tns17:conversationId>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns17:messageCount>&#xa;                    &lt;xsl:value-of select=&quot;$insert_retail_conversation_messages/noOfUpdates&quot;/>&#xa;                &lt;/tns17:messageCount>&#xa;            &lt;/tns17:conversation>&#xa;        &lt;/tns17:PostApproveResponseElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20260511170234PLT" xmlns:tns17="http://tns.tibco.com/bw/json/1778544310015" xmlns:tns5="http://tns.tibco.com/bw/json/1778544272499" version="2.0"&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="GetPendingApproval"/&gt;
    &lt;xsl:param name="insert_retail_conversation_messages"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns:postResponse&gt;
            &lt;item&gt;
                &lt;tns17:PostApproveResponseElement&gt;
                    &lt;xsl:if test="$post/item/tns5:PostApproveRequestElement/tns5:approvalId"&gt;
                        &lt;tns17:approvalId&gt;
                            &lt;xsl:value-of select="$post/item/tns5:PostApproveRequestElement/tns5:approvalId"/&gt;
                        &lt;/tns17:approvalId&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$GetPendingApproval/Record[1]/tool_name"&gt;
                        &lt;tns17:toolName&gt;
                            &lt;xsl:value-of select="$GetPendingApproval/Record[1]/tool_name"/&gt;
                        &lt;/tns17:toolName&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns17:approvedBy&gt;
                        &lt;xsl:if test="$post/item/tns5:PostApproveRequestElement/tns5:userId"&gt;
                            &lt;tns17:userId&gt;
                                &lt;xsl:value-of select="$post/item/tns5:PostApproveRequestElement/tns5:userId"/&gt;
                            &lt;/tns17:userId&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns17:approvedBy&gt;
                    &lt;tns17:persistence&gt;
                        &lt;tns17:provider&gt;
                            &lt;xsl:value-of select="'sqlserver'"/&gt;
                        &lt;/tns17:provider&gt;
                        &lt;xsl:if test="$post/item/tns5:PostApproveRequestElement/tns5:approvalId"&gt;
                            &lt;tns17:approvalId&gt;
                                &lt;xsl:value-of select="$post/item/tns5:PostApproveRequestElement/tns5:approvalId"/&gt;
                            &lt;/tns17:approvalId&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns17:persistence&gt;
                    &lt;tns17:conversation&gt;
                        &lt;tns17:provider&gt;
                            &lt;xsl:value-of select="'sqlserver'"/&gt;
                        &lt;/tns17:provider&gt;
                        &lt;xsl:if test="$post/item/tns5:PostApproveRequestElement/tns5:conversationId"&gt;
                            &lt;tns17:conversationId&gt;
                                &lt;xsl:value-of select="$post/item/tns5:PostApproveRequestElement/tns5:conversationId"/&gt;
                            &lt;/tns17:conversationId&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns17:messageCount&gt;
                            &lt;xsl:value-of select="$insert_retail_conversation_messages/noOfUpdates"/&gt;
                        &lt;/tns17:messageCount&gt;
                    &lt;/tns17:conversation&gt;
                &lt;/tns17:PostApproveResponseElement&gt;
            &lt;/item&gt;
        &lt;/tns:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
