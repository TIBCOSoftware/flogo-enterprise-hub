                                tibex:xpdlId="8d22d608-a1a0-4e70-92e3-c0cbff6dccc8" variable="getOut2-input">
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20260511170234PLT&quot; xmlns:tns12=&quot;http://tns.tibco.com/bw/json/1778544440045&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;retail_conversations1&quot;/>&#xa;    &lt;xsl:param name=&quot;retail_conversation_messages&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:GetConversationDetailResponseElement>&#xa;            &lt;tns12:provider>&#xa;                &lt;xsl:value-of select=&quot;'sqlserver'&quot;/>&#xa;            &lt;/tns12:provider>&#xa;            &lt;xsl:for-each select=&quot;$retail_conversations1/Record[1]&quot;>&#xa;                &lt;tns12:conversation>&#xa;                    &lt;tns12:conversationId>&#xa;                        &lt;xsl:value-of select=&quot;conversation_id&quot;/>&#xa;                    &lt;/tns12:conversationId>&#xa;                    &lt;xsl:if test=&quot;user_id&quot;>&#xa;                        &lt;tns12:userId>&#xa;                            &lt;xsl:value-of select=&quot;user_id&quot;/>&#xa;                        &lt;/tns12:userId>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;customer_id&quot;>&#xa;                        &lt;tns12:customerId>&#xa;                            &lt;xsl:value-of select=&quot;customer_id&quot;/>&#xa;                        &lt;/tns12:customerId>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;store_id&quot;>&#xa;                        &lt;tns12:storeId>&#xa;                            &lt;xsl:value-of select=&quot;store_id&quot;/>&#xa;                        &lt;/tns12:storeId>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns12:title>&#xa;                        &lt;xsl:value-of select=&quot;title&quot;/>&#xa;                    &lt;/tns12:title>&#xa;                    &lt;xsl:if test=&quot;message_count&quot;>&#xa;                        &lt;tns12:messageCount>&#xa;                            &lt;xsl:value-of select=&quot;message_count&quot;/>&#xa;                        &lt;/tns12:messageCount>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns12:conversation>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$retail_conversation_messages/Record&quot;>&#xa;                &lt;tns12:messages>&#xa;                    &lt;tns12:messageId>&#xa;                        &lt;xsl:value-of select=&quot;message_id&quot;/>&#xa;                    &lt;/tns12:messageId>&#xa;                    &lt;tns12:conversationId>&#xa;                        &lt;xsl:value-of select=&quot;conversation_id&quot;/>&#xa;                    &lt;/tns12:conversationId>&#xa;                    &lt;tns12:role>&#xa;                        &lt;xsl:value-of select=&quot;role&quot;/>&#xa;                    &lt;/tns12:role>&#xa;                    &lt;tns12:content>&#xa;                        &lt;xsl:value-of select=&quot;content&quot;/>&#xa;                    &lt;/tns12:content>&#xa;                    &lt;xsl:if test=&quot;user_id&quot;>&#xa;                        &lt;tns12:userId>&#xa;                            &lt;xsl:value-of select=&quot;user_id&quot;/>&#xa;                        &lt;/tns12:userId>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns12:messages>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns12:GetConversationDetailResponseElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20260511170234PLT" xmlns:tns12="http://tns.tibco.com/bw/json/1778544440045" version="2.0"&gt;
    &lt;xsl:param name="retail_conversations1"/&gt;
    &lt;xsl:param name="retail_conversation_messages"/&gt;
    &lt;xsl:template name="getOut2-input" match="/"&gt;
        &lt;tns:getResponse2&gt;
            &lt;item&gt;
                &lt;tns12:GetConversationDetailResponseElement&gt;
                    &lt;tns12:provider&gt;
                        &lt;xsl:value-of select="'sqlserver'"/&gt;
                    &lt;/tns12:provider&gt;
                    &lt;xsl:for-each select="$retail_conversations1/Record[1]"&gt;
                        &lt;tns12:conversation&gt;
                            &lt;tns12:conversationId&gt;
                                &lt;xsl:value-of select="conversation_id"/&gt;
                            &lt;/tns12:conversationId&gt;
                            &lt;xsl:if test="user_id"&gt;
                                &lt;tns12:userId&gt;
                                    &lt;xsl:value-of select="user_id"/&gt;
                                &lt;/tns12:userId&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="customer_id"&gt;
                                &lt;tns12:customerId&gt;
                                    &lt;xsl:value-of select="customer_id"/&gt;
                                &lt;/tns12:customerId&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="store_id"&gt;
                                &lt;tns12:storeId&gt;
                                    &lt;xsl:value-of select="store_id"/&gt;
                                &lt;/tns12:storeId&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns12:title&gt;
                                &lt;xsl:value-of select="title"/&gt;
                            &lt;/tns12:title&gt;
                            &lt;xsl:if test="message_count"&gt;
                                &lt;tns12:messageCount&gt;
                                    &lt;xsl:value-of select="message_count"/&gt;
                                &lt;/tns12:messageCount&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns12:conversation&gt;
                    &lt;/xsl:for-each&gt;
