{
  "contrib": "",
  "data": {
    "description": "Entry flow: log event, run agent with MCP tools, return decision",
    "explicitReply": true,
    "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkxvZ0V2ZW50Ijp7IngiOjE1MSwieSI6NDN9LCJUcmlhZ2VBZ2VudCI6eyJ4IjozNDYsInkiOjM5fSwiQXVkaXRMb2ciOnsieCI6NTQ3LCJ5Ijo0MH0sIlJldHVybiI6eyJ4Ijo3NDksInkiOjQwfX0=",
    "links": [
      {
        "from": "StartActivity",
        "id": 1,
        "label": "StartActivity to LogEvent",
        "to": "LogEvent",
        "type": "label"
      },
      {
        "from": "LogEvent",
        "id": 2,
        "label": "LogEvent to TriageAgent",
