        "description": "Call mock ServiceNow to search incidents",
        "id": "CallSN",
        "name": "CallSN",
        "settings": {
          "retryOnError": {
            "count": 0,
            "interval": 0
          }
        }
      },
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/actreturn",
          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "data": {
                    "@conditional": [
                      {
                        "$activity[CallSN].statusCode == 200": "=coerce.toString($activity[CallSN].responseBody)"
                      }
                    ]
                  },
                  "error": {
                    "@conditional": [
                      {
                        "$activity[CallSN].statusCode != 200": "=coerce.toString($activity[CallSN].responseBody)"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "description": "Return tool response",
        "id": "Return",
        "name": "Return"
      }
