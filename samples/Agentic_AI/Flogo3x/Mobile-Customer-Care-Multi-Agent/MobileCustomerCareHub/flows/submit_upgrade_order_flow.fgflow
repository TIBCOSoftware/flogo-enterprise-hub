            },
            "toolParams": {
              "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"accountId\": {\"type\": \"string\"},\n    \"newPlan\": {\"type\": \"string\"},\n    \"effectiveDate\": {\"type\": \"string\"}\n  },\n  \"required\": [\"accountId\", \"newPlan\"]\n}",
              "type": "json",
              "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"accountId\": {\"type\": \"string\"},\n    \"newPlan\": {\"type\": \"string\"},\n    \"effectiveDate\": {\"type\": \"string\"}\n  },\n  \"required\": [\"accountId\", \"newPlan\"]\n}"
            }
          },
