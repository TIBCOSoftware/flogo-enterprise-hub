        },
        "settings": {
          "agentToolDescription": "Submits a confirmed upgrade order for a customer's selected plan or device. Only call this after the customer has explicitly confirmed their upgrade choice. Returns an order confirmation number, activation date, proration details, and next steps.",
          "agentToolName": "SubmitUpgradeOrder",
          "customConversationStoreOperation": "STORE",
          "customGuardrailType": "BOTH",
