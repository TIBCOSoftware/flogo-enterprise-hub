    "name": "get_eligible_upgrades_flow",
    "tasks": [
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/noop"
        },
        "description": "",
        "id": "StartActivity",
        "name": "StartActivity"
      },
      {
        "activity": {
          "input": {
            "Log Level": "INFO",
            "flowInfo": false,
            "logLevel": "",
            "message": "=string.concat(\"[GetEligibleUpgrades] accountId=\", coerce.toString($flow.toolParams.accountId), \" currentPlan=\", coerce.toString($flow.toolParams.currentPlan))"
          },
          "ref": "github.com/tibco/flogo-general/src/app/General/activity/log"
        },
        "description": "",
        "id": "LogUpgrades",
        "name": "LogUpgrades"
      },
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/actreturn",
          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "data": "{\"accountId\":\"ACC-10045\",\"currentPlan\":{\"name\":\"Unlimited Pro 5G\",\"monthlyRate\":89.99,\"contractEnd\":\"2026-07-31\"},\"upgradeEligible\":true,\"earlyUpgradeAvailable\":true,\"planUpgrades\":[{\"planName\":\"Unlimited Premium 5G+\",\"monthlyRate\":109.99,\"features\":[\"Unlimited 5G+ priority data (never throttled)\",\"4K streaming on all devices\",\"International calling to 50 countries\",\"Wi-Fi calling included\",\"500GB cloud backup\"],\"upgradeBonus\":\"$150 bill credit applied to first invoice\"},{\"planName\":\"Unlimited Elite 5G\",\"monthlyRate\":129.99,\"features\":[\"Everything in Premium 5G+\",\"Apple One or Google One bundle included\",\"International data roaming in 30 countries\",\"Hotspot 100GB/month at 5G speeds\"],\"upgradeBonus\":\"$200 bill credit + free Apple Watch SE\"}],\"deviceUpgradeEligible\":true,\"tradeinCreditAvailable\":\"Up to $400 for your iPhone 12\",\"message\":\"You are eligible for an early 5G+ upgrade. 2-year contract required for bonus credits.\"}",
                  "error": ""
                }
              }
            }
          }
        },
        "description": "Returns mock upgrade options.",
        "id": "ReturnUpgrades",
        "name": "ReturnUpgrades"
      }
    ],
    "triggerHandlers": [
      {
        "action": {
          "input": {
            "toolParams": "=$.toolParams"
          },
          "output": {
            "response": "=$.response"
          }
        },
        "description": "GetEligibleUpgrades tool flow for UpgradeAdvisorAgent. Returns eligible upgrade options for the account.",
        "schemas": {
          "output": {
            "customConversationStoreOpInput": {
              "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
              "type": "json",
              "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
            },
            "customGuardrailInput": {
              "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
              "type": "json",
