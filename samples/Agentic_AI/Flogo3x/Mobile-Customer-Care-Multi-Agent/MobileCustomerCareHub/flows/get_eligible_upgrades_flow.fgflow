              "type": "json",
              "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"accountId\": {\"type\": \"string\"},\n    \"currentPlan\": {\"type\": \"string\"}\n  },\n  \"required\": [\"accountId\"]\n}"
            }
          },
