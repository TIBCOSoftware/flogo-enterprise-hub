    "name": "apply_bill_credit_flow",
    "tasks": [
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/noop"
        },
        "description": "",
        "id": "StartActivity",
        "name": "StartActivity"
      },
      {
        "activity": {
          "input": {
            "Log Level": "INFO",
            "flowInfo": false,
            "logLevel": "",
            "message": "=string.concat(\"[ApplyBillCredit] accountId=\", coerce.toString($flow.toolParams.accountId), \" amount=$\", coerce.toString($flow.toolParams.creditAmount))"
          },
          "ref": "github.com/tibco/flogo-general/src/app/General/activity/log"
        },
        "description": "",
        "id": "LogCredit",
        "name": "LogCredit"
      },
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/actreturn",
          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "data": "{\"accountId\":\"ACC-10045\",\"creditApplied\":true,\"creditAmount\":12.00,\"creditReason\":\"International roaming charge dispute - goodwill credit\",\"newBalance\":97.98,\"confirmationNumber\":\"CRD-78234\",\"effectiveDate\":\"2026-04-03\",\"message\":\"Credit of $12.00 has been applied to your account. New balance due is $97.98 by 2026-04-15.\"}",
                  "error": ""
                }
              }
            }
          }
        },
        "description": "Returns mock credit confirmation.",
        "id": "ReturnCredit",
        "name": "ReturnCredit"
      }
    ],
    "triggerHandlers": [
      {
        "action": {
          "input": {
            "toolParams": "=$.toolParams"
