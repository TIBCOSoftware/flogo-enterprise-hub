    "name": "schedule_tech_visit_flow",
    "tasks": [
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/noop"
        },
        "description": "",
        "id": "StartActivity",
        "name": "StartActivity"
      },
      {
        "activity": {
          "input": {
            "Log Level": "INFO",
            "flowInfo": false,
            "logLevel": "",
            "message": "=string.concat(\"[ScheduleTechnicianVisit] accountId=\", coerce.toString($flow.toolParams.accountId), \" preferredDate=\", coerce.toString($flow.toolParams.preferredDate))"
          },
          "ref": "github.com/tibco/flogo-general/src/app/General/activity/log"
        },
        "description": "",
        "id": "LogVisit",
        "name": "LogVisit"
      },
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/actreturn",
          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "data": "{\"accountId\":\"ACC-10045\",\"ticketNumber\":\"TKT-2026-04-18943\",\"status\":\"Scheduled\",\"scheduledDate\":\"2026-04-08\",\"timeSlot\":\"10:00 AM - 12:00 PM\",\"technicianId\":\"TECH-0234\",\"technicianName\":\"Carlos Rivera\",\"issueDescription\":\"Intermittent LTE connectivity and SIM provisioning issue\",\"notes\":\"Technician will inspect SIM provisioning, run on-site network tests, and verify device settings. Please keep device on and accessible.\",\"confirmationSentTo\":\"sarah.johnson@email.com\",\"cancellationDeadline\":\"2026-04-07T18:00:00Z\",\"rescheduleUrl\":\"https://myaccount.Mobile.example.com/tech-visit/TKT-2026-04-18943\"}",
                  "error": ""
                }
              }
            }
          }
        },
        "description": "Returns mock technician booking confirmation.",
        "id": "ReturnVisit",
        "name": "ReturnVisit"
      }
    ],
