        "to": "LogMedGuide",
        "type": "label"
      },
      {
        "from": "LogMedGuide",
        "id": 2,
        "label": "LogMedGuide to ReturnMedication",
        "to": "ReturnMedication",
        "type": "label"
      }
    ],
    "metadata": {
      "fe_metadata": {
        "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"toolParams\":{\"type\":\"object\",\"properties\":{\"medicationName\":{\"type\":\"string\"},\"infoType\":{\"type\":\"string\"}}}}}",
        "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}}}"
      },
      "input": [
        {
