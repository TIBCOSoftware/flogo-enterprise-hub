            "value": "{\"medicationName\":{\"type\":\"string\"},\"infoType\":{\"type\":\"string\"}}"
          },
          "type": "object"
        }
      ],
      "output": [
        {
          "name": "response",
          "schema": {
            "type": "json",
            "value": "{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}"
          },
          "type": "object"
        }
      ]
