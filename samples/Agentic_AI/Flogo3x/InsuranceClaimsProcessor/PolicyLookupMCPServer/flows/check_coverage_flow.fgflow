        {
          "name": "arguments",
          "schema": {
            "type": "json",
            "value": "{\"policy_number\":{\"type\":\"string\",\"description\":\"The insurance policy number\"},\"claim_type\":{\"type\":\"string\",\"description\":\"Type of claim to check coverage for (e.g. collision, theft, medical, property_damage, liability, natural_disaster)\"}}"
          },
          "type": "object"
        },
        {
          "name": "httpHeaders",
          "schema": {
            "type": "json",
