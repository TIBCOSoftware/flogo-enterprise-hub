                "mapping": {
                  "data": "{\"supplier_capacity\":[{\"supplier_id\":\"S001\",\"supplier_name\":\"TechParts Inc.\",\"current_utilization_pct\":65,\"available_capacity\":\"High\",\"next_available_slot\":\"Immediate\",\"max_order_volume\":10000,\"notes\":\"Operating at normal capacity\"},{\"supplier_id\":\"S002\",\"supplier_name\":\"Pacific Components Ltd.\",\"current_utilization_pct\":90,\"available_capacity\":\"Low\",\"next_available_slot\":\"2025-04-20\",\"max_order_volume\":5000,\"notes\":\"High demand period, limited slots available\"},{\"supplier_id\":\"S003\",\"supplier_name\":\"EuroMech GmbH\",\"current_utilization_pct\":45,\"available_capacity\":\"High\",\"next_available_slot\":\"Immediate\",\"max_order_volume\":8000,\"notes\":\"Increased capacity after facility expansion\"},{\"supplier_id\":\"S004\",\"supplier_name\":\"QuickShip Supplies\",\"current_utilization_pct\":30,\"available_capacity\":\"Very High\",\"next_available_slot\":\"Immediate\",\"max_order_volume\":3000,\"notes\":\"Specializes in rush orders\"}]}",
