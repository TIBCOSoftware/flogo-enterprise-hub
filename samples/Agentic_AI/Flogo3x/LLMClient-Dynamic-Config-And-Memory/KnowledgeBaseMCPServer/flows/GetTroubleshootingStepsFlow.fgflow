        },
        "description": "NoOp Activity",
        "id": "StartActivity",
        "name": "StartActivity"
      },
      {
        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/actreturn",
          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "data": "{\"article_id\":\"KB-1001\",\"title\":\"WiFi Connection Troubleshooting Guide\",\"steps\":[{\"step\":1,\"action\":\"Open Settings \u003e Network \u0026 Internet \u003e WiFi and toggle WiFi OFF, wait 10 seconds, toggle back ON\"},{\"step\":2,\"action\":\"Forget the corporate network (CorpNet-5G) and reconnect using your Active Directory credentials\"},{\"step\":3,\"action\":\"Open Command Prompt as Administrator and run: netsh winsock reset \u0026\u0026 netsh int ip reset\"},{\"step\":4,\"action\":\"Restart the laptop and try connecting again\"},{\"step\":5,\"action\":\"If still failing, open Device Manager \u003e Network Adapters, right-click your WiFi adapter, select Update Driver\"},{\"step\":6,\"action\":\"Run the Network Diagnostics tool: Settings \u003e Network \u0026 Internet \u003e Advanced Network Settings \u003e Network Troubleshooter\"},{\"step\":7,\"action\":\"If none of the above work, contact IT Help Desk to create a support ticket for on-site investigation\"}],\"estimated_time_minutes\":15,\"difficulty\":\"Beginner\"}"
                }
              }
            }
          }
        },
        "description": "Simple Return Activity",
        "id": "Return",
        "name": "Return"
      }
    ],
    "triggerHandlers": [
