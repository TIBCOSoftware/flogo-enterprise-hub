  "data": {
    "description": "Process service request via LLMClient with 3 MCP servers.",
    "explicitReply": true,
    "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjMwLCJ5IjoxMDh9LCJQcm9jZXNzUmVxdWVzdCI6eyJ4IjoyMDAsInkiOjEwMH0sIlByb2Nlc3NBSUFnZW50Ijp7IngiOjQxOCwieSI6MTAzfSwiUmV0dXJuUmVzdWx0Ijp7IngiOjYyNiwieSI6MTA0fX0=",
    "links": [
      {
