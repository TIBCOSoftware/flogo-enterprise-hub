      {
        "activity": {
          "input": {
            "Log Level": "INFO",
            "flowInfo": false,
            "logLevel": "",
            "message": "=string.concat(\"Start... \",$flowctx[\"FlowName\"], \" with arguments \", coerce.toString($flow.arguments))"
