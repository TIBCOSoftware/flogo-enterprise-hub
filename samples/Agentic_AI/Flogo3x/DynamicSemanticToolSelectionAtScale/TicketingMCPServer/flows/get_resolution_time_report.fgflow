          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "data": "{\"period\":\"last_month\",\"total_resolved\":245,\"overall\":{\"median_hours\":8.5,\"average_hours\":12.3,\"p90_hours\":28,\"p95_hours\":42},\"by_priority\":{\"Critical\":{\"median\":2.1,\"average\":3.5},\"High\":{\"median\":6.2,\"average\":8.8},\"Medium\":{\"median\":12.5,\"average\":15.2},\"Low\":{\"median\":22.0,\"average\":28.5}},\"by_category\":{\"Hardware\":{\"median\":24.0},\"Software\":{\"median\":8.0},\"Network Access\":{\"median\":6.5},\"Account\":{\"median\":4.0}}}",
                  "error": ""
                }
              }
            }
          }
        },
        "description": "Simple Return Activity",
        "id": "Return",
        "name": "Return"
      }
