        "activity": {
          "ref": "github.com/project-flogo/contrib/activity/actreturn",
          "settings": {
            "mappings": {
              "response": {
                "mapping": {
                  "data": "{\"methods\":[{\"name\":\"authenticator_app\",\"status\":\"enabled\",\"recommended\":true,\"description\":\"TOTP-based authenticator apps like Google Authenticator or Authy\"},{\"name\":\"sms\",\"status\":\"enabled\",\"recommended\":false,\"description\":\"SMS-based one-time codes sent to registered phone number\"},{\"name\":\"hardware_key\",\"status\":\"enabled\",\"recommended\":true,\"description\":\"FIDO2/WebAuthn hardware security keys like YubiKey\"},{\"name\":\"email\",\"status\":\"disabled\",\"recommended\":false,\"description\":\"Email-based one-time codes\"}],\"organization_policy\":\"required\",\"grace_period_days\":7}",
                  "error": ""
                }
              }
            }
          }
        },
        "description": "Simple Return Activity",
        "id": "Return",
        "name": "Return"
      }
