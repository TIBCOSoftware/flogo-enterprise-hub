              "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"employee_id\": {\n      \"type\": \"string\",\n      \"description\": \"Employee ID to enable MFA for\"\n    },\n    \"method\": {\n      \"type\": \"string\",\n      \"description\": \"MFA method: authenticator_app, sms, hardware_key. Default: authenticator_app\"\n    }\n  },\n  \"required\": [\n    \"employee_id\"\n  ],\n  \"additionalProperties\": false\n}",
