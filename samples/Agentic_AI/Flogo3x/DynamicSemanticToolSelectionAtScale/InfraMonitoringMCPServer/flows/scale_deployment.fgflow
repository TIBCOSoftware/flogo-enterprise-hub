            "arguments": {
              "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"deployment_name\": {\n      \"type\": \"string\",\n      \"description\": \"Deployment name\"\n    },\n    \"namespace\": {\n      \"type\": \"string\",\n      \"description\": \"Kubernetes namespace\"\n    },\n    \"replicas\": {\n      \"type\": \"string\",\n      \"description\": \"Desired number of replicas\"\n    }\n  },\n  \"required\": [\n    \"deployment_name\",\n    \"namespace\",\n    \"replicas\"\n  ],\n  \"additionalProperties\": false\n}",
