            }
          }
        },
        "settings": {
          "destructiveToolHint": false,
          "handlerDescription": "Scale a Kubernetes deployment to a specified number of replicas. The scaling is performed gradually with health checks between each replica addition or removal.",
          "handlerName": "scale_deployment",
