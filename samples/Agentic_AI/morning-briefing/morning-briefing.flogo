  ],
  "name": "morning-briefing",
  "description": "Daily morning briefing that aggregates Slack messages, email, calendar events, and reminders, then calls Claude AI to produce a prioritized markdown report in three tiers: Needs Attention, Important Today, and Awareness.",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#rest_1",
      "name": "tibco-wi-rest",
      "description": "On-demand REST endpoint - GET /api/morning-briefing to trigger a briefing immediately",
      "settings": {
        "port": "=$property[\"App.Port\"]",
        "APISpecUpdate": false,
        "swagger": "",
        "swaggerVersion": "v2",
        "authenticationType": "None",
        "username": "",
        "password": "",
        "apiVersion": "1.0",
        "secureConnection": false,
        "serverKey": "",
        "caCertificate": ""
      },
      "id": "MorningBriefingRESTTrigger",
      "handlers": [
        {
          "description": "Three-phase morning briefing pipeline: Gather data from Slack, email, calendar and reminders, build Claude AI prompt, return prioritized markdown report",
          "settings": {
            "APISpecPath": "/api/morning-briefing",
            "Method": "GET",
            "reqType": "application/json",
            "Path": "/api/morning-briefing",
            "OutputValidation": false
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:MorningBriefingMain"
            },
            "output": {
              "code": "=$.code",
              "responseBody": "=$.responseBody"
            }
          },
          "reply": {
            "code": 200,
            "configureResponseCodes": false,
            "message": ""
          },
          "schemas": {
            "reply": {
              "responseBody": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"briefing\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{\"briefing\":{\"type\":\"string\"}}}"
              }
            },
            "output": {
              "headers": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Authorization\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Authorization\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
              }
            }
          },
          "name": "MorningBriefingMain"
        }
      ]
    },
    {
      "ref": "#timer",
      "name": "tibco-wi-timer",
      "description": "Automatic 7 AM daily timer - fires every morning and runs the briefing flow",
      "settings": {},
      "id": "MorningBriefingTimerTrigger",
      "handlers": [
        {
          "description": "Three-phase morning briefing pipeline: Gather data from Slack, email, calendar and reminders, build Claude AI prompt, return prioritized markdown report",
          "settings": {
            "Scheduler Options": "Cron",
            "Repeating": true,
            "Delayed Start": true,
            "Delayed Start Time": "23:59",
            "Time Interval": 1440,
            "Interval Unit": "Minute",
            "Cron Expression": "0 7 * * *"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:MorningBriefingMain"
            }
          },
          "name": "MorningBriefingMain"
        }
      ]
    }
  ],
