                  "dynamicRequestHeaders": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  }
                },
                "output": {
                  "headers": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false},\"Set-Cookie\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                    "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Set-Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildBriefingPrompt",
            "name": "BuildBriefingPrompt",
            "description": "Assemble the Anthropic API request body from all four data sources",
            "activity": {
              "ref": "#jsexec",
              "settings": {
                "script": "var nl = String.fromCharCode(10); var today = new Date().toISOString().split(\"T\")[0]; var slack = JSON.stringify(parameters.slackMessages || {}); var email = JSON.stringify(parameters.emails || {}); var cal = JSON.stringify(parameters.calendarEvents || {}); var rem = JSON.stringify(parameters.reminders || {}); result.userPrompt = \"Today: \" + today + nl + nl + \"SLACK MESSAGES (last 24h):\" + nl + slack + nl + nl + \"UNREAD EMAILS:\" + nl + email + nl + nl + \"TODAYS CALENDAR:\" + nl + cal + nl + nl + \"TODAYS REMINDERS:\" + nl + rem;"
              },
              "input": {
                "parameters": {
                  "mapping": {
                    "slackMessages": "=$activity[GetSlackMessages].responseBody",
                    "emails": "=$activity[GetEmails].responseBody",
                    "calendarEvents": "=$activity[GetCalendarEvents].responseBody",
                    "reminders": "=$activity[GetReminders].responseBody"
                  }
                }
              }
            }
          },
          {
            "id": "GenerateBriefing",
            "name": "GenerateBriefing",
            "description": "Call LLM to generate the morning briefing",
            "activity": {
              "ref": "#agentactivity",
              "settings": {
                "llmProviderConnection": "conn://5dea6b37-7fb7-4df0-91c8-ad657a5ec8d8",
                "model": "=$property[\"LLM_MODEL\"]",
                "reasoning": "",
                "temperature": 0.3,
                "enableGuardrails": false,
                "rateLimit": 1000,
                "tokenLimit": 4096,
                "redactSensitiveData": false,
                "responseType": "Text",
                "agentHandoffs": "",
                "mcpServers": [],
                "conversationStoreType": "None",
                "memoryMaxSize": 10,
                "systemPrompt": "You are a personal morning briefing assistant. Analyze the provided data and create a structured morning briefing formatted in Markdown. Use three priority tiers: Needs Attention (someone blocked on you, overdue tasks, urgent messages), Important Today (meetings needing prep, emails needing reply, key tasks), Awareness (FYI items). Keep each item to 1-2 lines. Omit empty sections entirely. Produce these sections in order: 1. Needs Attention 2. Important Today 3. Today Schedule (table: time | meeting | type) 4. Today Tasks (checklist, flag overdue) 5. Unread Emails 6. Slack Activity 7. Awareness"
              },
              "input": {
                "userPrompt": "=$activity[BuildBriefingPrompt].result.userPrompt",
                "conversationId": "\"morning-briefing\""
              }
            }
          },
          {
            "id": "LogBriefing",
            "name": "LogBriefing",
            "description": "Log the formatted morning briefing to the Flogo engine output",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=$activity[GenerateBriefing].response",
                "logLevel": ""
              }
            }
          },
          {
            "id": "ReturnBriefing",
            "name": "ReturnBriefing",
            "description": "Return the morning briefing as HTTP 200 JSON response",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": "=$activity[GenerateBriefing].response"
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [],
          "output": [
            {
              "name": "code",
              "type": "float64"
            },
            {
              "name": "responseBody",
              "type": "object"
            }
          ],
          "fe_metadata": {
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"number\"},\"responseBody\":{\"type\":\"object\",\"properties\":{}}}}"
          }
        },
        "explicitReply": true
      }
    }
  ],
