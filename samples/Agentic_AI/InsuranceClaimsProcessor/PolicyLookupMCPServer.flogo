{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/string"
  ],
  "name": "PolicyLookupMCPServer",
  "description": "Stateless MCP server exposing insurance policy lookup and coverage check tools.",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Stateless MCP server for insurance policy lookups. Each tool call is independent.",
      "settings": {
        "serverName": "PolicyLookupMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"FlogoMcpServer.PORT\"]",
        "statelessServer": true,
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": ""
      },
      "id": "PolicyLookupMCPServer",
      "handlers": [
        {
          "description": "Read-only policy details lookup.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "lookup_policy",
            "handlerDescription": "Retrieve full insurance policy details by policy number. Returns policy type, coverage limits, deductible, premium, policy holder information, effective dates, and current status. Read-only lookup — no state is modified.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:lookup_policy_flow"
            },
            "input": {
              "arguments": "=$.arguments",
              "httpHeaders": "=$.httpHeaders",
              "tokenInfo": "=$.tokenInfo"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"policy_number\": {\n      \"type\": \"string\",\n      \"description\": \"The insurance policy number (e.g. POL-2026-001234)\"\n    }\n  },\n  \"required\": [\"policy_number\"],\n  \"additionalProperties\": false\n}",
                "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"policy_number\": {\n      \"type\": \"string\",\n      \"description\": \"The insurance policy number (e.g. POL-2026-001234)\"\n    }\n  },\n  \"required\": [\"policy_number\"],\n  \"additionalProperties\": false\n}"
              },
              "httpHeaders": {
                "type": "json",
                "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"Authorization\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"Authorization\": {\n      \"type\": \"string\"\n    }\n  }\n}"
              },
              "tokenInfo": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": [\r\n        {\r\n          \"type\": \"string\"\r\n        }\r\n      ]\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": [\r\n        {\r\n          \"type\": \"string\"\r\n        }\r\n      ]\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    }\r\n  }\r\n}"
              }
            }
          },
          "name": "lookup_policy_flow"
        },
        {
          "description": "Read-only coverage check.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "check_coverage",
            "handlerDescription": "Check whether a specific claim type is covered under an insurance policy. Returns coverage status (COVERED/NOT_COVERED/PARTIALLY_COVERED), applicable coverage limit, deductible amount, co-pay percentage, and any exclusions or conditions. Read-only, closed-domain.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:check_coverage_flow"
            },
            "input": {
              "arguments": "=$.arguments",
              "httpHeaders": "=$.httpHeaders",
              "tokenInfo": "=$.tokenInfo"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"policy_number\": {\n      \"type\": \"string\",\n      \"description\": \"The insurance policy number\"\n    },\n    \"claim_type\": {\n      \"type\": \"string\",\n      \"description\": \"Type of claim to check coverage for (e.g. collision, theft, medical, property_damage, liability, natural_disaster)\"\n    }\n  },\n  \"required\": [\"policy_number\", \"claim_type\"],\n  \"additionalProperties\": false\n}",
                "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"policy_number\": {\n      \"type\": \"string\",\n      \"description\": \"The insurance policy number\"\n    },\n    \"claim_type\": {\n      \"type\": \"string\",\n      \"description\": \"Type of claim to check coverage for (e.g. collision, theft, medical, property_damage, liability, natural_disaster)\"\n    }\n  },\n  \"required\": [\"policy_number\", \"claim_type\"],\n  \"additionalProperties\": false\n}"
              },
              "httpHeaders": {
                "type": "json",
                "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"Authorization\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"Authorization\": {\n      \"type\": \"string\"\n    }\n  }\n}"
              },
              "tokenInfo": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": [\r\n        {\r\n          \"type\": \"string\"\r\n        }\r\n      ]\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": [\r\n        {\r\n          \"type\": \"string\"\r\n        }\r\n      ]\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    }\r\n  }\r\n}"
              }
            }
          },
          "name": "check_coverage_flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:lookup_policy_flow",
      "data": {
        "name": "lookup_policy_flow",
        "description": "Read-only policy details lookup.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Return",
            "type": "label",
            "label": "StartActivity to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Returns mock policy data.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "structuredContent": {
                    "mapping": {
                      "policyNumber": "=$flow.arguments.policy_number",
                      "policyType": "Comprehensive Auto",
                      "status": "ACTIVE",
                      "holderName": "Robert Chen",
                      "holderEmail": "robert.chen@email.com",
                      "effectiveDate": "2026-01-15",
                      "expirationDate": "2027-01-15",
                      "deductible": 1000,
                      "monthlyPremium": 185,
                      "collisionLimit": 50000,
                      "comprehensiveLimit": 50000,
                      "liabilityLimit": 100000,
                      "medicalLimit": 10000,
                      "vehicleMake": "Toyota",
                      "vehicleModel": "Camry",
                      "vehicleYear": 2024
                    }
                  },
                  "response": {
                    "@conditional": [
                      {
                        "$flow.arguments.policy_number == 'POL-2026-001234'": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"policyType\\\":\\\"Comprehensive Auto\\\",\\\"status\\\":\\\"ACTIVE\\\",\\\"holder\\\":{\\\"name\\\":\\\"James Morrison\\\",\\\"dateOfBirth\\\":\\\"1978-07-14\\\",\\\"address\\\":\\\"312 Maple Drive, Austin TX 78701\\\",\\\"phone\\\":\\\"512-555-0183\\\",\\\"email\\\":\\\"james.morrison@email.com\\\"},\\\"vehicle\\\":{\\\"make\\\":\\\"Honda\\\",\\\"model\\\":\\\"CR-V\\\",\\\"year\\\":2025,\\\"vin\\\":\\\"2HKRW2H59RH123456\\\"},\\\"effectiveDate\\\":\\\"2018-03-01\\\",\\\"expirationDate\\\":\\\"2027-03-01\\\",\\\"coverageLimits\\\":{\\\"collision\\\":50000,\\\"comprehensive\\\":50000,\\\"liability\\\":100000,\\\"medical\\\":10000,\\\"uninsured_motorist\\\":50000},\\\"deductible\\\":500,\\\"monthlyPremium\\\":165.00,\\\"claimHistory\\\":[{\\\"claimId\\\":\\\"CLM-2021-4421\\\",\\\"date\\\":\\\"2021-09-15\\\",\\\"type\\\":\\\"comprehensive\\\",\\\"amount\\\":1800,\\\"status\\\":\\\"SETTLED\\\"}],\\\"discounts\\\":[\\\"Safe driver\\\",\\\"Multi-policy\\\",\\\"Long-term customer\\\",\\\"Anti-theft device\\\"],\\\"customerSince\\\":\\\"2018-03-01\\\"}\")"
                        }
                      },
                      {
                        "$flow.arguments.policy_number == 'POL-2026-005678'": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"policyType\\\":\\\"Comprehensive Auto\\\",\\\"status\\\":\\\"ACTIVE\\\",\\\"holder\\\":{\\\"name\\\":\\\"Sarah Mitchell\\\",\\\"dateOfBirth\\\":\\\"1990-11-28\\\",\\\"address\\\":\\\"1847 Riverside Blvd, Denver CO 80202\\\",\\\"phone\\\":\\\"720-555-0264\\\",\\\"email\\\":\\\"sarah.mitchell@email.com\\\"},\\\"vehicle\\\":{\\\"make\\\":\\\"BMW\\\",\\\"model\\\":\\\"X5\\\",\\\"year\\\":2024,\\\"vin\\\":\\\"5UXCR6C09R9K78901\\\"},\\\"effectiveDate\\\":\\\"2024-01-10\\\",\\\"expirationDate\\\":\\\"2027-01-10\\\",\\\"coverageLimits\\\":{\\\"collision\\\":75000,\\\"comprehensive\\\":75000,\\\"liability\\\":100000,\\\"medical\\\":15000,\\\"uninsured_motorist\\\":50000},\\\"deductible\\\":1000,\\\"monthlyPremium\\\":310.00,\\\"claimHistory\\\":[{\\\"claimId\\\":\\\"CLM-2025-7712\\\",\\\"date\\\":\\\"2025-02-20\\\",\\\"type\\\":\\\"collision\\\",\\\"amount\\\":8200,\\\"status\\\":\\\"SETTLED\\\"},{\\\"claimId\\\":\\\"CLM-2025-9934\\\",\\\"date\\\":\\\"2025-11-05\\\",\\\"type\\\":\\\"comprehensive\\\",\\\"amount\\\":4100,\\\"status\\\":\\\"SETTLED\\\"}],\\\"discounts\\\":[\\\"Multi-vehicle\\\"],\\\"customerSince\\\":\\\"2024-01-10\\\",\\\"notes\\\":\\\"Coverage limits increased from 50000 to 75000 on 2025-10-01\\\"}\")"
                        }
                      },
                      {
                        "$flow.arguments.policy_number == 'POL-2026-009012'": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"policyType\\\":\\\"Comprehensive Auto\\\",\\\"status\\\":\\\"ACTIVE\\\",\\\"holder\\\":{\\\"name\\\":\\\"Marcus Webb\\\",\\\"dateOfBirth\\\":\\\"1995-04-03\\\",\\\"address\\\":\\\"9201 Ocean Avenue, Miami FL 33139\\\",\\\"phone\\\":\\\"305-555-0391\\\",\\\"email\\\":\\\"marcus.webb@email.com\\\"},\\\"vehicle\\\":{\\\"make\\\":\\\"Mercedes-Benz\\\",\\\"model\\\":\\\"GLE 450\\\",\\\"year\\\":2025,\\\"vin\\\":\\\"4JGFB4KB1RA567890\\\"},\\\"effectiveDate\\\":\\\"2025-08-15\\\",\\\"expirationDate\\\":\\\"2026-08-15\\\",\\\"coverageLimits\\\":{\\\"collision\\\":85000,\\\"comprehensive\\\":85000,\\\"liability\\\":100000,\\\"medical\\\":10000,\\\"uninsured_motorist\\\":50000},\\\"deductible\\\":1500,\\\"monthlyPremium\\\":425.00,\\\"claimHistory\\\":[{\\\"claimId\\\":\\\"CLM-2025-6601\\\",\\\"date\\\":\\\"2025-10-22\\\",\\\"type\\\":\\\"collision\\\",\\\"amount\\\":6800,\\\"status\\\":\\\"SETTLED\\\"},{\\\"claimId\\\":\\\"CLM-2025-7803\\\",\\\"date\\\":\\\"2025-12-14\\\",\\\"type\\\":\\\"comprehensive\\\",\\\"amount\\\":3200,\\\"status\\\":\\\"SETTLED\\\"},{\\\"claimId\\\":\\\"CLM-2026-1105\\\",\\\"date\\\":\\\"2026-02-08\\\",\\\"type\\\":\\\"collision\\\",\\\"amount\\\":9500,\\\"status\\\":\\\"SETTLED\\\"},{\\\"claimId\\\":\\\"CLM-2026-3307\\\",\\\"date\\\":\\\"2026-04-19\\\",\\\"type\\\":\\\"theft\\\",\\\"amount\\\":2100,\\\"status\\\":\\\"UNDER_REVIEW\\\"}],\\\"discounts\\\":[],\\\"customerSince\\\":\\\"2025-08-15\\\"}\")"
                        }
                      },
                      {
                        "$flow.arguments.policy_number == 'POL-2026-003456'": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"policyType\\\":\\\"Standard Auto\\\",\\\"status\\\":\\\"ACTIVE\\\",\\\"holder\\\":{\\\"name\\\":\\\"Elena Rodriguez\\\",\\\"dateOfBirth\\\":\\\"1982-06-19\\\",\\\"address\\\":\\\"5540 Cedar Lane, Chicago IL 60614\\\",\\\"phone\\\":\\\"312-555-0472\\\",\\\"email\\\":\\\"elena.rodriguez@email.com\\\"},\\\"vehicle\\\":{\\\"make\\\":\\\"Toyota\\\",\\\"model\\\":\\\"RAV4\\\",\\\"year\\\":2023,\\\"vin\\\":\\\"2T3P1RFV8PW234567\\\"},\\\"effectiveDate\\\":\\\"2021-06-01\\\",\\\"expirationDate\\\":\\\"2027-06-01\\\",\\\"coverageLimits\\\":{\\\"collision\\\":50000,\\\"comprehensive\\\":50000,\\\"liability\\\":100000,\\\"medical\\\":10000,\\\"uninsured_motorist\\\":25000},\\\"deductible\\\":750,\\\"monthlyPremium\\\":195.00,\\\"claimHistory\\\":[{\\\"claimId\\\":\\\"CLM-2023-2201\\\",\\\"date\\\":\\\"2023-11-30\\\",\\\"type\\\":\\\"collision\\\",\\\"amount\\\":4500,\\\"status\\\":\\\"SETTLED\\\"}],\\\"discounts\\\":[\\\"Safe driver\\\",\\\"Paperless billing\\\"],\\\"customerSince\\\":\\\"2021-06-01\\\"}\")"
                        }
                      },
                      {
                        "$flow.arguments.policy_number == 'POL-2026-007890'": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"policyType\\\":\\\"Standard Auto\\\",\\\"status\\\":\\\"EXPIRED\\\",\\\"holder\\\":{\\\"name\\\":\\\"David Park\\\",\\\"dateOfBirth\\\":\\\"1988-12-05\\\",\\\"address\\\":\\\"7723 Birch Street, Seattle WA 98101\\\",\\\"phone\\\":\\\"206-555-0538\\\",\\\"email\\\":\\\"david.park@email.com\\\"},\\\"vehicle\\\":{\\\"make\\\":\\\"Hyundai\\\",\\\"model\\\":\\\"Tucson\\\",\\\"year\\\":2022,\\\"vin\\\":\\\"KM8J3CA46NU345678\\\"},\\\"effectiveDate\\\":\\\"2025-04-01\\\",\\\"expirationDate\\\":\\\"2026-04-01\\\",\\\"coverageLimits\\\":{\\\"collision\\\":40000,\\\"comprehensive\\\":40000,\\\"liability\\\":50000,\\\"medical\\\":5000,\\\"uninsured_motorist\\\":25000},\\\"deductible\\\":1000,\\\"monthlyPremium\\\":155.00,\\\"claimHistory\\\":[],\\\"discounts\\\":[\\\"Paperless billing\\\"],\\\"customerSince\\\":\\\"2025-04-01\\\",\\\"notes\\\":\\\"Policy expired on 2026-04-01. Renewal notice sent but not actioned.\\\"}\")"
                        }
                      },
                      {
                        "$flow.arguments.policy_number != ''": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"status\\\":\\\"NOT_FOUND\\\",\\\"message\\\":\\\"No policy found with this policy number. Please verify the policy number and try again.\\\"}\")"
                        }
                      },
                      {
                        "@otherwise": {
                          "error": "policy_number is required"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIlJldHVybiI6eyJ4IjoyNDksInkiOjUwfX0=",
        "metadata": {
          "input": [
            {
              "name": "arguments",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"policy_number\":{\"type\":\"string\",\"description\":\"The insurance policy number (e.g. POL-2026-001234)\"}}"
              }
            },
            {
              "name": "httpHeaders",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Authorization\":{\"type\":\"string\"}}"
              }
            }
          ],
          "output": [
            {
              "name": "response",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"PolicyLookupMCPServer\",\"properties\":{\"arguments\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"policy_number\":{\"type\":\"string\",\"description\":\"The insurance policy number (e.g. POL-2026-001234)\"}},\"required\":[\"policy_number\"],\"additionalProperties\":false},\"httpHeaders\":{\"type\":\"object\",\"properties\":{\"Authorization\":{\"type\":\"string\"}}}}}",
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}},\"required\":[\"response\"]}"
          }
        }
      }
    },
    {
      "id": "flow:check_coverage_flow",
      "data": {
        "name": "check_coverage_flow",
        "description": "Read-only coverage check.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Return",
            "type": "label",
            "label": "StartActivity to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Returns mock coverage check.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "structuredContent": {
                    "mapping": {
                      "policyNumber": "=$flow.arguments.policy_number",
                      "claimType": "=$flow.arguments.claim_type",
                      "coverageStatus": "COVERED",
                      "coverageLimit": 50000,
                      "deductible": 1000,
                      "coPayPercentage": 20,
                      "priorAuthorization": false,
                      "estimatedProcessingDays": 10
                    }
                  },
                  "response": {
                    "@conditional": [
                      {
                        "$flow.arguments.policy_number == '' || $flow.arguments.claim_type == ''": {
                          "error": "Both policy_number and claim_type are required"
                        }
                      },
                      {
                        "$flow.arguments.policy_number == 'POL-2026-007890'": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"claimType\\\":\\\"\",$flow.arguments.claim_type,\"\\\",\\\"coverageStatus\\\":\\\"NOT_COVERED\\\",\\\"coverageLimit\\\":0,\\\"deductible\\\":0,\\\"coPayPercentage\\\":0,\\\"exclusions\\\":[\\\"Policy expired on 2026-04-01\\\"],\\\"conditions\\\":[\\\"Policy must be renewed before claims can be processed\\\"],\\\"priorAuthorization\\\":false,\\\"estimatedProcessingDays\\\":0,\\\"reason\\\":\\\"POLICY_EXPIRED\\\"}\")"
                        }
                      },
                      {
                        "$flow.arguments.claim_type == 'collision'": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"claimType\\\":\\\"\",$flow.arguments.claim_type,\"\\\",\\\"coverageStatus\\\":\\\"COVERED\\\",\\\"coverageLimit\\\":50000,\\\"deductible\\\":1000,\\\"coPayPercentage\\\":0,\\\"exclusions\\\":[\\\"Intentional damage\\\",\\\"Racing or speed contests\\\",\\\"Commercial use of vehicle\\\"],\\\"conditions\\\":[\\\"Police report required for claims over $5,000\\\",\\\"Photos of damage must be submitted within 72 hours\\\"],\\\"priorAuthorization\\\":false,\\\"estimatedProcessingDays\\\":10}\")"
                        }
                      },
                      {
                        "$flow.arguments.claim_type == 'theft'": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"claimType\\\":\\\"\",$flow.arguments.claim_type,\"\\\",\\\"coverageStatus\\\":\\\"COVERED\\\",\\\"coverageLimit\\\":50000,\\\"deductible\\\":1000,\\\"coPayPercentage\\\":0,\\\"exclusions\\\":[\\\"Items left in unlocked vehicle\\\",\\\"Keys left in ignition\\\"],\\\"conditions\\\":[\\\"Police report required within 24 hours\\\",\\\"Proof of ownership for claimed items\\\",\\\"Vehicle recovery period of 30 days before total loss payout\\\"],\\\"priorAuthorization\\\":false,\\\"estimatedProcessingDays\\\":21}\")"
                        }
                      },
                      {
                        "$flow.arguments.claim_type == 'medical'": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"claimType\\\":\\\"\",$flow.arguments.claim_type,\"\\\",\\\"coverageStatus\\\":\\\"PARTIALLY_COVERED\\\",\\\"coverageLimit\\\":10000,\\\"deductible\\\":500,\\\"coPayPercentage\\\":20,\\\"exclusions\\\":[\\\"Pre-existing conditions\\\",\\\"Cosmetic procedures\\\",\\\"Experimental treatments\\\"],\\\"conditions\\\":[\\\"Medical records required within 30 days\\\",\\\"Only in-network providers covered at full rate\\\",\\\"Maximum coverage per incident is $10,000\\\"],\\\"priorAuthorization\\\":true,\\\"estimatedProcessingDays\\\":21}\")"
                        }
                      },
                      {
                        "$flow.arguments.claim_type == 'liability'": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"claimType\\\":\\\"\",$flow.arguments.claim_type,\"\\\",\\\"coverageStatus\\\":\\\"COVERED\\\",\\\"coverageLimit\\\":100000,\\\"deductible\\\":0,\\\"coPayPercentage\\\":0,\\\"exclusions\\\":[\\\"Intentional acts\\\",\\\"Business use of personal vehicle\\\"],\\\"conditions\\\":[\\\"Third-party documentation required\\\",\\\"Legal representation may be provided by insurer\\\"],\\\"priorAuthorization\\\":false,\\\"estimatedProcessingDays\\\":30}\")"
                        }
                      },
                      {
                        "@otherwise": {
                          "data": "=string.concat(\"{\\\"policyNumber\\\":\\\"\",$flow.arguments.policy_number,\"\\\",\\\"claimType\\\":\\\"\",$flow.arguments.claim_type,\"\\\",\\\"coverageStatus\\\":\\\"NOT_COVERED\\\",\\\"coverageLimit\\\":0,\\\"deductible\\\":0,\\\"coPayPercentage\\\":0,\\\"exclusions\\\":[\\\"This claim type is not covered under the current policy\\\"],\\\"conditions\\\":[\\\"Contact your agent to discuss adding this coverage type\\\"],\\\"priorAuthorization\\\":false,\\\"estimatedProcessingDays\\\":0}\")"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ],
