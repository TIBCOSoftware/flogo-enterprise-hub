                      },
                      {
                        "$flow.toolParams.policyNumber == 'POL-2026-003456'": {
                          "data": "=string.concat(\"{\\\"riskScoreId\\\":\\\"RS-2026-20004\\\",\\\"claimantName\\\":\\\"\",$flow.toolParams.claimantName,\"\\\",\\\"policyNumber\\\":\\\"\",$flow.toolParams.policyNumber,\"\\\",\\\"compositeScore\\\":22,\\\"scoreBreakdown\\\":{\\\"claimFrequency\\\":{\\\"score\\\":12,\\\"weight\\\":0.25,\\\"details\\\":\\\"1 prior claim in 5 years, excellent history\\\"},\\\"amountAnomaly\\\":{\\\"score\\\":35,\\\"weight\\\":0.30,\\\"details\\\":\\\"$12,000 medical claim is slightly above average but within expected range for ER visit plus therapy\\\"},\\\"documentConsistency\\\":{\\\"score\\\":15,\\\"weight\\\":0.25,\\\"details\\\":\\\"Medical records, police report, and therapy receipts all consistent\\\"},\\\"behavioralPattern\\\":{\\\"score\\\":18,\\\"weight\\\":0.20,\\\"details\\\":\\\"No unusual patterns detected\\\"}},\\\"recommendation\\\":\\\"APPROVE\\\",\\\"confidence\\\":0.88,\\\"riskFactors\\\":[],\\\"mitigatingFactors\\\":[\\\"5-year customer with clean claims history\\\",\\\"Comprehensive medical documentation provided\\\",\\\"Police report confirms rear-end collision\\\"],\\\"timestamp\\\":\\\"2026-06-15T10:00:00Z\\\"}\")",
                          "error": ""
