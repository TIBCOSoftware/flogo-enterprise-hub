                          "data": "=string.concat(\"{\\\"riskScoreId\\\":\\\"RS-2026-20003\\\",\\\"claimantName\\\":\\\"\",$flow.toolParams.claimantName,\"\\\",\\\"policyNumber\\\":\\\"\",$flow.toolParams.policyNumber,\"\\\",\\\"compositeScore\\\":87,\\\"scoreBreakdown\\\":{\\\"claimFrequency\\\":{\\\"score\\\":95,\\\"weight\\\":0.25,\\\"details\\\":\\\"4 claims in 10 months is 5x the policy average — extremely high\\\"},\\\"amountAnomaly\\\":{\\\"score\\\":92,\\\"weight\\\":0.30,\\\"details\\\":\\\"$62,000 theft claim is 4.1x the regional average for this claim type\\\"},\\\"documentConsistency\\\":{\\\"score\\\":78,\\\"weight\\\":0.25,\\\"details\\\":\\\"No security footage available, no police report for prior theft claim\\\"},\\\"behavioralPattern\\\":{\\\"score\\\":88,\\\"weight\\\":0.20,\\\"details\\\":\\\"Claims filed at regular intervals consistent with staged-loss pattern\\\"}},\\\"recommendation\\\":\\\"DENY\\\",\\\"confidence\\\":0.89,\\\"riskFactors\\\":[\\\"Claim frequency 5x above average for new customers\\\",\\\"High-value theft with no supporting evidence\\\",\\\"Pattern of escalating claim amounts\\\",\\\"Staged-loss indicators detected\\\"],\\\"mitigatingFactors\\\":[],\\\"timestamp\\\":\\\"2026-06-15T10:00:00Z\\\"}\")",
                          "error": ""
