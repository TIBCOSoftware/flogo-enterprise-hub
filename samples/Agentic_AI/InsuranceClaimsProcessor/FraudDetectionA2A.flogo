                    "@conditional": [
                      {
                        "$flow.toolParams.policyNumber == 'POL-2026-001234'": {
                          "data": "=string.concat(\"{\\\"riskScoreId\\\":\\\"RS-2026-20001\\\",\\\"claimantName\\\":\\\"\",$flow.toolParams.claimantName,\"\\\",\\\"policyNumber\\\":\\\"\",$flow.toolParams.policyNumber,\"\\\",\\\"compositeScore\\\":15,\\\"scoreBreakdown\\\":{\\\"claimFrequency\\\":{\\\"score\\\":8,\\\"weight\\\":0.25,\\\"details\\\":\\\"1 claim in 5 years, well below average\\\"},\\\"amountAnomaly\\\":{\\\"score\\\":12,\\\"weight\\\":0.30,\\\"details\\\":\\\"Claim amount of $4,500 is within normal range for collision repairs\\\"},\\\"documentConsistency\\\":{\\\"score\\\":5,\\\"weight\\\":0.25,\\\"details\\\":\\\"All documents consistent, police report and witness statement on file\\\"},\\\"behavioralPattern\\\":{\\\"score\\\":10,\\\"weight\\\":0.20,\\\"details\\\":\\\"No unusual behavioral indicators detected\\\"}},\\\"recommendation\\\":\\\"APPROVE\\\",\\\"confidence\\\":0.92,\\\"riskFactors\\\":[],\\\"mitigatingFactors\\\":[\\\"8-year customer with excellent claims history\\\",\\\"Safe driver discount holder\\\",\\\"Third-party witness corroborates incident\\\"],\\\"timestamp\\\":\\\"2026-06-15T10:00:00Z\\\"}\")",
                          "error": ""
                        }
                      },
                      {
                        "$flow.toolParams.policyNumber == 'POL-2026-005678'": {
                          "data": "=string.concat(\"{\\\"riskScoreId\\\":\\\"RS-2026-20002\\\",\\\"claimantName\\\":\\\"\",$flow.toolParams.claimantName,\"\\\",\\\"policyNumber\\\":\\\"\",$flow.toolParams.policyNumber,\"\\\",\\\"compositeScore\\\":58,\\\"scoreBreakdown\\\":{\\\"claimFrequency\\\":{\\\"score\\\":52,\\\"weight\\\":0.25,\\\"details\\\":\\\"2 claims in 18 months is above average for policy age\\\"},\\\"amountAnomaly\\\":{\\\"score\\\":68,\\\"weight\\\":0.30,\\\"details\\\":\\\"Claim amount of $18,500 is 2.3x average for collision claims in this tier\\\"},\\\"documentConsistency\\\":{\\\"score\\\":42,\\\"weight\\\":0.25,\\\"details\\\":\\\"Police report filed but incident timeline has minor gaps\\\"},\\\"behavioralPattern\\\":{\\\"score\\\":65,\\\"weight\\\":0.20,\\\"details\\\":\\\"Coverage limits increased 60 days before filing this claim\\\"}},\\\"recommendation\\\":\\\"FLAG_FOR_REVIEW\\\",\\\"confidence\\\":0.76,\\\"riskFactors\\\":[\\\"Coverage increase shortly before claim submission\\\",\\\"Claim amount near independent adjuster threshold\\\",\\\"Above-average claim frequency for policy tenure\\\"],\\\"mitigatingFactors\\\":[\\\"3-year customer with no prior fraud flags\\\",\\\"Police report on file\\\"],\\\"timestamp\\\":\\\"2026-06-15T10:00:00Z\\\"}\")",
                          "error": ""
