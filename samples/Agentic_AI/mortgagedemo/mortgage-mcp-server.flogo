                "logLevel": ""
              }
            }
          },
          {
            "id": "QueryDebts",
            "name": "QueryDebts",
            "description": "SELECT all debt records for applicant from PostgreSQL",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://mortgage-pg-conn-001",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT debt_type, lender, outstanding_balance, monthly_payment, interest_rate, months_remaining FROM existing_debts WHERE applicant_id = ?applicantId ORDER BY monthly_payment DESC;",
                "manualmode": true,
                "Fields": [
                  {
                    "FieldName": "applicantId",
                    "Type": "VARCHAR",
                    "Selected": "true",
                    "Parameter": "true",
                    "isEditable": true,
