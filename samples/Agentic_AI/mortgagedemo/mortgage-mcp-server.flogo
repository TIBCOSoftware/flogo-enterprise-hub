                "flowInfo": false,
                "message": "=string.concat(\"ApproveMortgage: applicant=\", coerce.toString($flow.arguments.applicantId), \" amount=\", coerce.toString($flow.arguments.loanAmount), \" term=\", coerce.toString($flow.arguments.termYears), \"yr rate=\", coerce.toString($flow.arguments.interestRate), \"%\")",
                "logLevel": ""
              }
            }
          },
