  ],
  "resources": [
    {
      "id": "flow:GetApplicantProfileFlow",
      "data": {
        "name": "GetApplicantProfileFlow",
        "description": "Query applicant profile from PostgreSQL applicants table",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogStart",
            "type": "label",
            "label": "start"
          },
          {
            "id": 2,
            "from": "LogStart",
            "to": "QueryApplicant",
            "type": "label",
            "label": "query"
          },
          {
            "id": 3,
            "from": "QueryApplicant",
            "to": "LogResult",
            "type": "label",
            "label": "result"
          },
          {
            "id": 4,
            "from": "LogResult",
            "to": "Return",
            "type": "label",
            "label": "done"
          },
          {
            "id": 5,
            "from": "QueryApplicant",
            "to": "LogQueryError",
            "type": "error",
            "label": "query error"
          },
          {
            "id": 6,
            "from": "LogQueryError",
            "to": "ErrorReturn",
            "type": "label",
            "label": "exit"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogStart",
            "name": "LogStart",
            "description": "Log tool invocation",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"GetApplicantProfile called for: \", coerce.toString($flow.arguments))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "QueryApplicant",
            "name": "QueryApplicant",
            "description": "SELECT applicant record from PostgreSQL",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://mortgage-pg-conn-001",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT id, first_name, last_name, date_of_birth, email, phone, address, national_id, kyc_status, risk_band FROM applicants WHERE id = ?applicantId LIMIT 1;",
                "manualmode": true,
                "Fields": [
                  {
                    "FieldName": "applicantId",
                    "Type": "VARCHAR",
                    "Selected": "true",
                    "Parameter": "true",
                    "isEditable": true,
                    "Value": "false"
                  }
                ],
                "RuntimeQuery": "",
                "State": "38e76903-762f-484e-bded-ca9e16517726",
                "input": {
                  "mapping": {
                    "parameters": {
                      "applicantId": "=$flow.arguments.applicantId"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"applicantId\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"applicantId\":{\"type\":\"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"applicantId\":{\"type\":\"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"applicantId\":{\"type\":\"string\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "LogResult",
            "name": "LogResult",
            "description": "Log query result",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"Applicant found: \", coerce.toString($activity[QueryApplicant].Output.records))",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return applicant profile to MCP caller",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "=coerce.toString($activity[QueryApplicant].Output.records)",
                      "error": ""
                    }
                  }
                }
              }
            }
          },
          {
            "id": "LogQueryError",
            "name": "LogQueryError",
            "description": "Log PostgreSQL query error",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "ERROR",
                "flowInfo": true,
                "message": "=string.concat(\"GetApplicantProfile query failed: \", $error[QueryApplicant].message)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "ErrorReturn",
            "name": "ErrorReturn",
            "description": "Return error to MCP caller",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "",
                      "error": "=$error[QueryApplicant].message"
                    }
                  }
                }
              }
            }
