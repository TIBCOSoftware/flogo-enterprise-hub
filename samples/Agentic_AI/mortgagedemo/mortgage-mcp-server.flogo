                "Connection": "conn://mortgage-pg-conn-001",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO mortgage_decisions (applicant_id, decision, loan_amount, term_years, interest_rate, dti_ratio, decided_by, decided_at) VALUES (?applicantId, 'APPROVED', ?loanAmount, ?termYears, ?interestRate, ?dtiRatio, 'Claude-AI', NOW());",
                "manualmode": true,
                "Fields": [
                  {
                    "FieldName": "applicantId",
                    "Type": "VARCHAR",
                    "Selected": "true",
                    "Parameter": "true",
                    "isEditable": true,
                    "Value": "false"
                  },
                  {
                    "FieldName": "loanAmount",
                    "Type": "NUMERIC",
                    "Selected": "true",
                    "Parameter": "true",
                    "isEditable": true,
                    "Value": "false"
                  },
                  {
                    "FieldName": "termYears",
                    "Type": "INTEGER",
                    "Selected": "true",
                    "Parameter": "true",
                    "isEditable": true,
                    "Value": "false"
                  },
                  {
                    "FieldName": "interestRate",
                    "Type": "NUMERIC",
                    "Selected": "true",
                    "Parameter": "true",
                    "isEditable": true,
                    "Value": "false"
                  },
                  {
                    "FieldName": "dtiRatio",
                    "Type": "NUMERIC",
                    "Selected": "true",
                    "Parameter": "true",
                    "isEditable": true,
                    "Value": "false"
