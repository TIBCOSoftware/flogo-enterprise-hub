                "message": "Mock Employment Verification API called — returning EMPLOYED status for APP-001",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return hardcoded employment verification response",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "applicantId": "APP-001",
                    "employmentStatus": "EMPLOYED",
                    "employerName": "Meridian Technologies Ltd",
                    "jobTitle": "Senior Software Engineer",
                    "yearsEmployed": 5.5,
                    "annualIncome": 125000,
                    "monthlyIncome": 10416.67,
                    "incomeVerified": true,
                    "employmentType": "PERMANENT"
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MjAwfSwiTG9nUmVxdWVzdCI6eyJ4IjozNTAsInkiOjIwMH0sIlJldHVybiI6eyJ4Ijo2MDAsInkiOjIwMH19",
        "metadata": {
          "input": [{"name": "body", "type": "object"}],
          "output": [
            {"name": "code", "type": "integer"},
            {"name": "responseBody", "type": "object"}
          ],
          "fe_metadata": {}
