    {
      "id": "flow:CalculateDTIFlow",
      "data": {
        "name": "CalculateDTIFlow",
        "description": "Returns DTI calculation — monthly obligations $3,100 on income $10,417 = 29.8% DTI (AFFORDABLE)",
        "links": [
          {"id": 1, "from": "StartActivity", "to": "LogRequest", "type": "label", "label": "start"},
          {"id": 2, "from": "LogRequest", "to": "Return", "type": "label", "label": "return calculation"}
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point",
            "activity": {"ref": "#noop"}
          },
          {
            "id": "LogRequest",
            "name": "LogRequest",
            "description": "Log incoming DTI calculation request",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "Mock DTI Calculation API called — DTI 29.8% (AFFORDABLE, under 43% threshold)",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return DTI calculation result — 29.8% DTI is within acceptable limits",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "monthlyIncome": 10416.67,
                    "existingMonthlyDebts": 1250,
                    "proposedMortgagePayment": 1850,
                    "totalMonthlyObligations": 3100,
                    "dtiRatio": 0.298,
                    "dtiPercent": "29.8%",
                    "affordabilityFlag": "AFFORDABLE",
                    "maxAllowedDTI": 0.43,
                    "headroom": 1381.67
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MjAwfSwiTG9nUmVxdWVzdCI6eyJ4IjozNTAsInkiOjIwMH0sIlJldHVybiI6eyJ4Ijo2MDAsInkiOjIwMH19",
        "metadata": {
          "input": [{"name": "body", "type": "object"}],
          "output": [
            {"name": "code", "type": "integer"},
            {"name": "responseBody", "type": "object"}
          ],
