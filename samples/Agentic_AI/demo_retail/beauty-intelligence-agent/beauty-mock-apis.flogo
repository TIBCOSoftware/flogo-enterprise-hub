      "id": "flow:GetHealthFlow",
      "data": {
        "name": "GetHealthFlow",
        "description": "Health check endpoint returning service status UP",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "BuildHealthResponse",
            "type": "label",
            "label": "StartActivity to BuildHealthResponse"
          },
          {
            "id": 2,
            "from": "BuildHealthResponse",
            "to": "ReturnHealth",
            "type": "label",
            "label": "BuildHealthResponse to ReturnHealth"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "BuildHealthResponse",
            "name": "BuildHealthResponse",
            "description": "Build health check response",
            "activity": {
              "ref": "#jsexec",
              "settings": {
                "script": "function Execute(ctx) { return { result: { status: \"UP\", service: \"beauty-mock-apis\", version: \"1.0.0\", timestamp: new Date().toISOString() } }; }"
              },
              "input": {
                "parameters": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "ReturnHealth",
            "name": "ReturnHealth",
            "description": "Return health status with HTTP 200",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": "=$activity[BuildHealthResponse].result"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkJ1aWxkSGVhbHRoUmVzcG9uc2UiOnsieCI6MjUwLCJ5IjoxNTB9LCJSZXR1cm5IZWFsdGgiOnsieCI6NDUwLCJ5IjoyNTB9fQ==",
