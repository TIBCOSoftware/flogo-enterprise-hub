    {
      "id": "flow:PostMarketingFlow",
      "data": {
        "name": "PostMarketingFlow",
        "description": "Accepts a marketing sequence payload and returns a sequenceId confirming enqueue",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "BuildMarketingResponse",
            "type": "label",
            "label": "StartActivity to BuildMarketingResponse"
          },
          {
            "id": 2,
            "from": "BuildMarketingResponse",
            "to": "ReturnMarketing",
            "type": "label",
            "label": "BuildMarketingResponse to ReturnMarketing"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "BuildMarketingResponse",
            "name": "BuildMarketingResponse",
            "description": "Build marketing sequence confirmation response with generated sequenceId",
            "activity": {
              "ref": "#jsexec",
              "settings": {
                "script": "function Execute(ctx) { var chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\"; var seqId = \"SEQ-\"; for (var i = 0; i < 8; i++) { seqId += chars.charAt(Math.floor(Math.random() * chars.length)); } return { result: { sequence_id: seqId, status: \"QUEUED\", estimated_send_hours: 2, message: \"Marketing sequence successfully queued\", queued_at: new Date().toISOString() } }; }"
              },
              "input": {
                "parameters": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "ReturnMarketing",
            "name": "ReturnMarketing",
            "description": "Return marketing sequence confirmation with HTTP 201",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 201,
                  "data": "=$activity[BuildMarketingResponse].result"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkJ1aWxkTWFya2V0aW5nUmVzcG9uc2UiOnsieCI6MjUwLCJ5IjoxNTB9LCJSZXR1cm5NYXJrZXRpbmciOnsieCI6NDUwLCJ5IjoyNTB9fQ==",
        "metadata": {
          "input": [],
          "output": [],
          "fe_metadata": {}
        },
        "explicitReply": true
      }
    },
