  ],
  "resources": [
    {
      "id": "flow:GetCampaignsFlow",
      "data": {
        "name": "GetCampaignsFlow",
        "description": "Returns active GlowRewards promotional campaigns eligible for a member",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "BuildCampaignsResponse",
            "type": "label",
            "label": "StartActivity to BuildCampaignsResponse"
          },
          {
            "id": 2,
            "from": "BuildCampaignsResponse",
            "to": "ReturnCampaigns",
            "type": "label",
            "label": "BuildCampaignsResponse to ReturnCampaigns"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "BuildCampaignsResponse",
            "name": "BuildCampaignsResponse",
            "description": "Build hardcoded campaigns JSON for the requested memberId",
            "activity": {
              "ref": "#jsexec",
              "settings": {
                "script": "function Execute(ctx) { var memberId = ctx.memberId || \"unknown\"; var now = new Date(); var exp = new Date(now.getTime() + 14 * 86400000).toISOString().split(\"T\")[0]; return { result: { campaigns: [ { campaign_id: \"CAMP-GLOW-001\", offer_type: \"BONUS_POINTS\", description: \"Earn 3x points on all skincare this weekend\", bonus_points_multiplier: 3, eligible_brands: [\"Charlotte Tilbury\",\"Dr. Jart+\",\"Drunk Elephant\",\"La Roche-Posay\"], expiry: exp, member_eligible: true }, { campaign_id: \"CAMP-GLOW-002\", offer_type: \"PRODUCT_DISCOUNT\", description: \"20% off fragrance with any skincare purchase over $50\", discount_value: 20, eligible_brands: [\"Maison Margiela\",\"Valentino\",\"Yves Saint Laurent\"], expiry: exp, member_eligible: true }, { campaign_id: \"CAMP-GLOW-003\", offer_type: \"GWP\", description: \"Free 7-piece mini set with $75+ haircare purchase\", eligible_brands: [\"Olaplex\",\"Dyson\",\"K18\"], expiry: exp, member_eligible: true } ], member_id: memberId, fetched_at: now.toISOString() } }; }"
              },
              "input": {
                "parameters": {
                  "mapping": {
                    "memberId": "=$flow.memberId"
                  }
                }
              }
            }
          },
          {
            "id": "ReturnCampaigns",
            "name": "ReturnCampaigns",
            "description": "Return campaigns JSON to caller with HTTP 200",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": "=$activity[BuildCampaignsResponse].result"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkJ1aWxkQ2FtcGFpZ25zUmVzcG9uc2UiOnsieCI6MjUwLCJ5IjoxNTB9LCJSZXR1cm5DYW1wYWlnbnMiOnsieCI6NDUwLCJ5IjoyNTB9fQ==",
        "metadata": {
          "input": [
            {
              "name": "memberId",
              "type": "string"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:GetInventoryFlow",
      "data": {
        "name": "GetInventoryFlow",
        "description": "Returns stock levels and GWP promotions for a product SKU at a given store",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "BuildInventoryResponse",
            "type": "label",
            "label": "StartActivity to BuildInventoryResponse"
          },
          {
            "id": 2,
            "from": "BuildInventoryResponse",
            "to": "ReturnInventory",
            "type": "label",
            "label": "BuildInventoryResponse to ReturnInventory"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "BuildInventoryResponse",
            "name": "BuildInventoryResponse",
            "description": "Build hardcoded inventory JSON for the requested SKU and storeId",
            "activity": {
              "ref": "#jsexec",
              "settings": {
                "script": "function Execute(ctx) { var sku = ctx.sku || \"UNKNOWN\"; var storeId = ctx.storeId || \"0847\"; var stockMap = { \"CT-WONDERGLOW-01\": 12, \"OLP-007-100ML\": 0, \"DR-VITC-SERUM\": 8, \"CT-PILLOWTALK-L\": 24, \"DRP-MOISTURISER\": 5, \"FB-GLOSS-BOMB-210\": 18, \"CER-GENTLE-FACE\": 32, \"LA-ROCHE-SENSI\": 14, \"RB-SOFT-PINCH-14\": 9, \"DYS-AIRWRAP-V2\": 2 }; var qty = (stockMap[sku] !== undefined) ? stockMap[sku] : 7; return { result: { sku: sku, store_id: storeId, quantity_on_hand: qty, online_available: qty > 0, low_stock: qty > 0 && qty < 5, stockout: qty === 0, reorder_in_days: qty === 0 ? 3 : null, gwp_promotion: qty > 0 ? { promo_id: \"GWP-\" + sku.substring(0,6), description: \"Free deluxe sample with purchase\", threshold_spend: 45.00, gift_item: \"Brand Discovery Mini Set\" } : null, fetched_at: new Date().toISOString() } }; }"
              },
              "input": {
                "parameters": {
                  "mapping": {
                    "sku": "=$flow.sku",
                    "storeId": "=$flow.storeId"
                  }
                }
              }
            }
          },
          {
            "id": "ReturnInventory",
            "name": "ReturnInventory",
            "description": "Return inventory JSON to caller with HTTP 200",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": "=$activity[BuildInventoryResponse].result"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkJ1aWxkSW52ZW50b3J5UmVzcG9uc2UiOnsieCI6MjUwLCJ5IjoxNTB9LCJSZXR1cm5JbnZlbnRvcnkiOnsieCI6NDUwLCJ5IjoyNTB9fQ==",
        "metadata": {
          "input": [
            {
              "name": "sku",
              "type": "string"
            },
            {
              "name": "storeId",
              "type": "string"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"sku\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:GetStoreFlow",
      "data": {
        "name": "GetStoreFlow",
        "description": "Returns store details, hours, upcoming events, and beauty advisor availability",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "BuildStoreResponse",
            "type": "label",
            "label": "StartActivity to BuildStoreResponse"
          },
          {
            "id": 2,
            "from": "BuildStoreResponse",
            "to": "ReturnStore",
            "type": "label",
            "label": "BuildStoreResponse to ReturnStore"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "BuildStoreResponse",
            "name": "BuildStoreResponse",
            "description": "Build hardcoded store details JSON for the requested storeId",
            "activity": {
              "ref": "#jsexec",
              "settings": {
                "script": "function Execute(ctx) { var storeId = ctx.storeId || \"0847\"; var stores = { \"0847\": { name: \"BeautyCo Beverly Hills\", address: \"8500 Wilshire Blvd, Beverly Hills, CA 90211\", phone: \"310-555-0847\", hours: { mon_sat: \"10:00-21:00\", sun: \"11:00-19:00\" }, beauty_advisors_available: 3, upcoming_events: [ { event: \"Skincare Masterclass with Charlotte Tilbury\", date: new Date(Date.now() + 3*86400000).toISOString().split(\"T\")[0], spots_remaining: 8 }, { event: \"Fragrance Discovery Session\", date: new Date(Date.now() + 7*86400000).toISOString().split(\"T\")[0], spots_remaining: 12 } ], store_promotions: [\"In-store GWP on purchases over $50\",\"Double points Saturdays\"] }, \"1204\": { name: \"BeautyCo Santa Monica\", address: \"395 Santa Monica Place, Santa Monica, CA 90401\", phone: \"310-555-1204\", hours: { mon_sat: \"10:00-20:00\", sun: \"11:00-18:00\" }, beauty_advisors_available: 2, upcoming_events: [], store_promotions: [\"15% off first in-store visit\"] } }; var store = stores[storeId] || stores[\"0847\"]; store.store_id = storeId; store.fetched_at = new Date().toISOString(); return { result: store }; }"
              },
              "input": {
                "parameters": {
                  "mapping": {
                    "storeId": "=$flow.storeId"
                  }
                }
              }
            }
          },
          {
            "id": "ReturnStore",
            "name": "ReturnStore",
            "description": "Return store details JSON to caller with HTTP 200",
            "activity": {
