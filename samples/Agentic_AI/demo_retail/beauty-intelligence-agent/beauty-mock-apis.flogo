            "output": {
              "queryParams": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}},\"required\":[]}",
                "fe_metadata": "[{\"parameterName\":\"memberId\",\"type\":\"string\",\"repeating\":\"\",\"required\":\"\"}]"
