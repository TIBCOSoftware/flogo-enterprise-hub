  "name": "beauty-mock-apis",
  "description": "BeautyCo Demo 1 — REST mock API server providing hardcoded realistic retail responses for campaigns, inventory, store context, and marketing sequence endpoints. Backing service for beauty-intelligence-agent MCP server.",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#rest",
      "name": "tibco-wi-rest",
      "description": "REST trigger serving mock BeautyCo API endpoints on port 8091",
      "settings": {
        "port": 8091,
        "APISpecUpdate": false,
        "swagger": "",
        "swaggerVersion": "v2",
        "authenticationType": "None",
        "username": "",
        "password": "",
        "apiVersion": "1.0.0",
        "secureConnection": false,
