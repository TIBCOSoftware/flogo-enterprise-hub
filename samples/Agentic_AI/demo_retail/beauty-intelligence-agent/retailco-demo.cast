[7.9683, "o", "\u001b[90m  Querying server tool registry...\u001b[0m\r\n"]
[8.3688, "o", "\r\n"]
[8.3688, "o", "\u001b[96m  \u2713 12 tools registered on this MCP server\u001b[0m\r\n"]
[8.3688, "o", "\r\n"]
[8.3688, "o", "  \u001b[93m 1. \u001b[92mGetMemberProfile              \u001b[0m \u001b[90mFetch member demographics, tier, KYC status\u001b[0m\r\n"]
[8.3688, "o", "  \u001b[93m 2. \u001b[92mGetPurchaseHistory            \u001b[0m \u001b[90mLast 20 transactions by SKU, brand, category\u001b[0m\r\n"]
[8.3688, "o", "  \u001b[93m 3. \u001b[92mGetLoyaltyAccount             \u001b[0m \u001b[90mPoints balance, tier progress, next expiry\u001b[0m\r\n"]
[8.3688, "o", "  \u001b[93m 4. \u001b[92mGetBeautyProfile              \u001b[0m \u001b[90mSkin tone, concerns, hair, allergy flags\u001b[0m\r\n"]
[8.3688, "o", "  \u001b[93m 5. \u001b[92mGetActiveCampaigns            \u001b[0m \u001b[90mActive promos eligible for this member tier\u001b[0m\r\n"]
[8.3688, "o", "  \u001b[93m 6. \u001b[92mGetProductInventory           \u001b[0m \u001b[90mStock level + GWP promos per SKU and store\u001b[0m\r\n"]
[8.3689, "o", "  \u001b[93m 7. \u001b[92mGetStoreContext               \u001b[0m \u001b[90mStore hours, events, advisor availability\u001b[0m\r\n"]
[8.3689, "o", "  \u001b[93m 8. \u001b[92mGetRecentReturns              \u001b[0m \u001b[90mLast 6 months of returns with reasons\u001b[0m\r\n"]
[8.3689, "o", "  \u001b[93m 9. \u001b[92mUpsertConsultationRecord      \u001b[0m \u001b[90mWrite consultation + recommended SKUs to DB\u001b[0m\r\n"]
[8.3689, "o", "  \u001b[93m10. \u001b[92mCreateLoyaltyOffer            \u001b[0m \u001b[90mGenerate targeted offer (BONUS/BIRTHDAY/etc)\u001b[0m\r\n"]
[8.3689, "o", "  \u001b[93m11. \u001b[92mTriggerMarketingSequence      \u001b[0m \u001b[90mQueue post-visit email or push notification\u001b[0m\r\n"]
[8.3689, "o", "  \u001b[93m12. \u001b[92mLogAgentDecision              \u001b[0m \u001b[90mCompliance audit log with confidence score\u001b[0m\r\n"]
