                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"Header\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                  },
                  "body": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"description\":\"Payload to enqueue a post-visit marketing sequence for a member\",\"required\":[\"memberId\",\"sequenceType\"],\"properties\":{\"memberId\":{\"type\":\"string\",\"description\":\"GlowRewards member identifier\",\"example\":\"M-7724-ASHA\"},\"sequenceType\":{\"type\":\"string\",\"description\":\"Type of marketing sequence to trigger\",\"enum\":[\"REPLENISHMENT\",\"BIRTHDAY\",\"WIN_BACK\",\"POST_CONSULTATION\",\"LOYALTY_NUDGE\"],\"example\":\"REPLENISHMENT\"},\"productSkus\":{\"type\":\"array\",\"description\":\"SKUs to feature in the sequence (e.g. replenishment candidates)\",\"items\":{\"type\":\"string\"},\"example\":[\"OLP-007-100ML\",\"CT-WONDERGLOW-01\"]},\"delayHours\":{\"type\":\"integer\",\"description\":\"Hours to wait before sending the first message in the sequence\",\"example\":2,\"default\":2}}}",
                    "fe_metadata": "{\"type\":\"object\",\"description\":\"Payload to enqueue a post-visit marketing sequence for a member\",\"required\":[\"memberId\",\"sequenceType\"],\"properties\":{\"memberId\":{\"type\":\"string\",\"description\":\"GlowRewards member identifier\",\"example\":\"M-7724-ASHA\"},\"sequenceType\":{\"type\":\"string\",\"description\":\"Type of marketing sequence to trigger\",\"enum\":[\"REPLENISHMENT\",\"BIRTHDAY\",\"WIN_BACK\",\"POST_CONSULTATION\",\"LOYALTY_NUDGE\"],\"example\":\"REPLENISHMENT\"},\"productSkus\":{\"type\":\"array\",\"description\":\"SKUs to feature in the sequence (e.g. replenishment candidates)\",\"items\":{\"type\":\"string\"},\"example\":[\"OLP-007-100ML\",\"CT-WONDERGLOW-01\"]},\"delayHours\":{\"type\":\"integer\",\"description\":\"Hours to wait before sending the first message in the sequence\",\"example\":2,\"default\":2}}}"
                  }
                },
