    {
      "id": "flow:GetRecentReturnsFlow",
      "data": {
        "name": "GetRecentReturnsFlow",
        "description": "MCP Tool: Get last 6 months of product returns — SKU, brand, return reason, resolution",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "LogToolEntry",
            "type": "label",
            "label": "start"
          },
          {
            "id": 2,
            "from": "LogToolEntry",
            "to": "QueryReturns",
            "type": "label",
            "label": "query"
          },
          {
            "id": 3,
            "from": "QueryReturns",
            "to": "ReturnResult",
            "type": "label",
            "label": "return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp start",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "LogToolEntry",
            "name": "LogToolEntry",
            "description": "Log MCP tool invocation",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[MCP] GetRecentReturns memberId=\", $flow.arguments.memberId)",
                "logLevel": "INFO"
              }
            }
          },
          {
            "id": "QueryReturns",
            "name": "QueryReturns",
            "description": "SELECT returns from last 6 months",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://8cf3ee96-d6af-4394-9d67-cca990de6a39",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT id AS return_id, sku, brand, return_reason, resolution, returned_at FROM returns WHERE member_id = $1 AND returned_at >= NOW() - INTERVAL '6 months' ORDER BY returned_at DESC",
                "manualmode": true,
                "Fields": [
                  {
                    "FieldName": "member_id",
                    "Type": "VARCHAR",
                    "Selected": "true",
                    "Parameter": "true",
                    "isEditable": true
                  },
                  {
                    "FieldName": "return_id",
                    "Type": "INTEGER",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "sku",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "brand",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "return_reason",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "resolution",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  },
                  {
                    "FieldName": "returned_at",
                    "Type": "TIMESTAMP",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": true
                  }
                ],
                "RuntimeQuery": "",
                "State": "98bcaab9-87bd-486d-b058-92f7c77405d6",
                "input": {
                  "mapping": {
                    "parameters": {
                      "member_id": "=$flow.arguments.memberId"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"member_id\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"member_id\":{\"type\":\"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"member_id\":{\"type\":\"string\"},\"return_id\":{\"type\":\"integer\"},\"sku\":{\"type\":\"string\"},\"brand\":{\"type\":\"string\"},\"return_reason\":{\"type\":\"string\"},\"resolution\":{\"type\":\"string\"},\"returned_at\":{\"type\":\"string\",\"format\":\"time\"}}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"member_id\":{\"type\":\"string\"},\"return_id\":{\"type\":\"integer\"},\"sku\":{\"type\":\"string\"},\"brand\":{\"type\":\"string\"},\"return_reason\":{\"type\":\"string\"},\"resolution\":{\"type\":\"string\"},\"returned_at\":{\"type\":\"string\",\"format\":\"time\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnResult",
            "name": "ReturnResult",
            "description": "Return returns history to MCP caller",
            "activity": {
              "ref": "#actreturn"
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkxvZ1Rvb2xFbnRyeSI6eyJ4IjoyNTAsInkiOjE1MH0sIlF1ZXJ5UmV0dXJucyI6eyJ4Ijo0NTAsInkiOjI0OX0sIlJldHVyblJlc3VsdCI6eyJ4Ijo2NTAsInkiOjM1MH19",
        "metadata": {
