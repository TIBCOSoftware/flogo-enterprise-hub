tring\",\"description\":\"Event name\",\"example\":\"Skincare Masterclass with Charlotte Tilbury\"},\"date\":{\"type\":\"string\",\"format\":\"date\",\"description\":\"Event date (YYYY-MM-DD)\",\"example\":\"2026-05-15\"},\"spots_remaining\":{\"type\":\"integer\",\"description\":\"Number of registration spots still available\",\"example\":8}}},\"MarketingSequenceRequest\":{\"type\":\"object\",\"description\":\"Payload to enqueue a post-visit marketing sequence for a member\",\"required\":[\"memberId\",\"sequenceType\"],\"properties\":{\"memberId\":{\"type\":\"string\",\"description\":\"GlowRewards member identifier\",\"example\":\"M-7724-ASHA\"},\"sequenceType\":{\"type\":\"string\",\"description\":\"Type of marketing sequence to trigger\",\"enum\":[\"REPLENISHMENT\",\"BIRTHDAY\",\"WIN_BACK\",\"POST_CONSULTATION\",\"LOYALTY_NUDGE\"],\"example\":\"REPLENISHMENT\"},\"productSkus\":{\"type\":\"array\",\"description\":\"SKUs to feature in the sequence (e.g. replenishment candidates)\",\"items\":{\"type\":\"string\"},\"example\":[\"OLP-007-100ML\",\"CT-WONDERGLOW-01\"]},\"delayHours\":{\"type\":\"integer\",\"description\":\"Hours to wait before sending the first message in the sequence\",\"example\":2,\"default\":2}}},\"MarketingSequenceResponse\":{\"type\":\"object\",\"description\":\"Confirmation that a marketing sequence has been enqueued\",\"properties\":{\"sequence_id\":{\"type\":\"string\",\"description\":\"Unique identifier for the enqueued sequence (SEQ- prefix + 8 alphanumeric chars)\",\"example\":\"SEQ-AB12CD34\"},\"status\":{\"type\":\"string\",\"description\":\"Enqueue status\",\"enum\":[\"QUEUED\"],\"example\":\"QUEUED\"},\"estimated_send_hours\":{\"type\":\"integer\",\"description\":\"Estimated hours until the first message is sent\",\"example\":2},\"message\":{\"type\":\"string\",\"description\":\"Human-readable confirmation message\",\"example\":\"Marketing sequence successfully queued\"},\"queued_at\":{\"type\":\"string\",\"format\":\"date-time\",\"descr