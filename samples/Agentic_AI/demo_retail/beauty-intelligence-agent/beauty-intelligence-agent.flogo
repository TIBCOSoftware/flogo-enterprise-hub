{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-general/src/app/General/activity/rest",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/string",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "beauty-intelligence-agent",
  "description": "BeautyCo Demo 1 — 12-tool MCP Server exposing loyalty, purchase history, beauty profile, inventory, campaigns, store context, and CRM data to Claude AI for hyper-personalized beauty consultations. All enterprise data stays on-prem.",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "MCP Server trigger exposing 12 beauty retail tools to Claude AI on port 8036",
      "settings": {
        "serverName": "BeautyCo Intelligence Agent",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "8036",
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": ""
      },
      "id": "BeautyMCPServer",
      "handlers": [
        {
          "description": "MCP Tool: Retrieve full member profile — name, tier, preferred store, join date, KYC status",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetMemberProfile",
            "handlerDescription": "Retrieve full BeautyCo member profile: name, loyalty tier (Member/Platinum/Diamond), join date, preferred store, birth month, and KYC status"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:GetMemberProfileFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "memberId": "=$.arguments.memberId"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}"
              }
            }
          },
          "name": "GetMemberProfileFlow"
        },
        {
          "description": "MCP Tool: Retrieve last 20 purchase transactions for a member — SKU, brand, category, price, channel",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetPurchaseHistory",
            "handlerDescription": "Retrieve last 20 purchase transactions for a member including SKU, brand, category (SKINCARE/HAIRCARE/FRAGRANCE/MAKEUP), price, channel, and date. Use to identify brand loyalty and category preferences."
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:GetPurchaseHistoryFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "memberId": "=$.arguments.memberId"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}"
              }
            }
          },
          "name": "GetPurchaseHistoryFlow"
        },
        {
          "description": "MCP Tool: Get GlowRewards loyalty account — points balance, tier progress, next expiry date",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetLoyaltyAccount",
            "handlerDescription": "Get current GlowRewards loyalty balance: points available, points pending, tier progress to next tier, redemption history, and next expiry date"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:GetLoyaltyAccountFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "memberId": "=$.arguments.memberId"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}"
              }
            }
          },
          "name": "GetLoyaltyAccountFlow"
        },
        {
          "description": "MCP Tool: Get stored beauty profile — skin tone, skin concerns, hair texture, fragrance family, allergy flags",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetBeautyProfile",
            "handlerDescription": "Get member beauty profile: skin tone, skin concerns (acne/dryness/aging/sensitivity), hair texture, hair concerns, fragrance family preference, and allergy flags. Essential before making product recommendations."
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:GetBeautyProfileFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "memberId": "=$.arguments.memberId"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}"
              }
            }
          },
          "name": "GetBeautyProfileFlow"
        },
        {
          "description": "MCP Tool: List active promotional campaigns eligible for a member — offer type, discount, eligible brands",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetActiveCampaigns",
            "handlerDescription": "List currently active promotional campaigns and personalized offers eligible for this member based on their tier and purchase history. Returns campaign_id, offer_type, discount_value, eligible_brands, and expiry."
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:GetActiveCampaignsFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "memberId": "=$.arguments.memberId"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}"
              }
            }
          },
          "name": "GetActiveCampaignsFlow"
        },
        {
          "description": "MCP Tool: Check real-time inventory for a SKU at a store — stock level, online availability, GWP promotions",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetProductInventory",
            "handlerDescription": "Check real-time inventory for a product SKU at a given store. Returns in-stock quantity, online availability, low-stock flag, and any GWP (Gift With Purchase) promotions attached to that SKU."
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:GetProductInventoryFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "sku": "=$.arguments.sku",
                  "storeId": "=$.arguments.storeId"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"sku\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"sku\":{\"type\":\"string\"},\"storeId\":{\"type\":\"string\"}}}"
              }
            }
          },
          "name": "GetProductInventoryFlow"
        },
        {
          "description": "MCP Tool: Get store details — hours, upcoming events, beauty advisor availability, store promotions",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetStoreContext",
            "handlerDescription": "Get store details for a given storeId: address, store hours, upcoming in-store events, beauty advisor availability, and current store-level promotions"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:GetStoreContextFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "storeId": "=$.arguments.storeId"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"storeId\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"storeId\":{\"type\":\"string\"}}}"
              }
            }
          },
          "name": "GetStoreContextFlow"
        },
        {
          "description": "MCP Tool: Get last 6 months of product returns — SKU, brand, return reason, resolution",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "GetRecentReturns",
            "handlerDescription": "Get the member's last 6 months of product returns including SKU, brand, return reason, and resolution. Always call this before recommending products to avoid suggesting items already returned."
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:GetRecentReturnsFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "memberId": "=$.arguments.memberId"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"}}}"
              }
            }
          },
          "name": "GetRecentReturnsFlow"
        },
        {
          "description": "MCP Tool: Write or update a beauty consultation record with recommended SKUs, offer applied, and notes",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "UpsertConsultationRecord",
            "handlerDescription": "Write a beauty consultation record to the database. Call at the end of every consultation with the recommended products, offer applied, and summary notes. Inputs: memberId, recommendedSkus (comma-separated), offerApplied, consultationNotes, channelType (IN_STORE/APP/WEB)."
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:UpsertConsultationRecordFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "memberId": "=$.arguments.memberId",
                  "recommendedSkus": "=$.arguments.recommendedSkus",
                  "offerApplied": "=$.arguments.offerApplied",
                  "consultationNotes": "=$.arguments.consultationNotes",
                  "channelType": "=$.arguments.channelType"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"},\"recommendedSkus\":{\"type\":\"string\"},\"offerApplied\":{\"type\":\"string\"},\"consultationNotes\":{\"type\":\"string\"},\"channelType\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"},\"recommendedSkus\":{\"type\":\"string\"},\"offerApplied\":{\"type\":\"string\"},\"consultationNotes\":{\"type\":\"string\"},\"channelType\":{\"type\":\"string\"}}}"
              }
            }
          },
          "name": "UpsertConsultationRecordFlow"
        },
        {
          "description": "MCP Tool: Generate and persist a targeted loyalty offer — BONUS_POINTS, BIRTHDAY, TIER_CHALLENGE, or PRODUCT_DISCOUNT",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "CreateLoyaltyOffer",
            "handlerDescription": "Generate and persist a targeted loyalty offer for a member. Inputs: memberId, offerType (BONUS_POINTS/BIRTHDAY/TIER_CHALLENGE/PRODUCT_DISCOUNT), bonusPoints (integer), discountPercent (number), eligibleSkus (comma-separated SKUs). Returns offerId."
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:CreateLoyaltyOfferFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "memberId": "=$.arguments.memberId",
                  "offerType": "=$.arguments.offerType",
                  "bonusPoints": "=$.arguments.bonusPoints",
                  "discountPercent": "=$.arguments.discountPercent",
                  "eligibleSkus": "=$.arguments.eligibleSkus"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"},\"offerType\":{\"type\":\"string\"},\"bonusPoints\":{\"type\":\"integer\"},\"discountPercent\":{\"type\":\"number\"},\"eligibleSkus\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"},\"offerType\":{\"type\":\"string\"},\"bonusPoints\":{\"type\":\"integer\"},\"discountPercent\":{\"type\":\"number\"},\"eligibleSkus\":{\"type\":\"string\"}}}"
              }
            }
          },
          "name": "CreateLoyaltyOfferFlow"
        },
        {
          "description": "MCP Tool: Enqueue a post-consultation marketing sequence — RESTOCK_REMINDER, NEW_LAUNCH, or REPLENISHMENT",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "TriggerMarketingSequence",
            "handlerDescription": "Enqueue a post-consultation marketing sequence for the member. Inputs: memberId, sequenceType (RESTOCK_REMINDER/NEW_LAUNCH/REPLENISHMENT), productSkus (comma-separated), delayHours. Sends email or push notification after the delay."
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:TriggerMarketingSequenceFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "memberId": "=$.arguments.memberId",
                  "sequenceType": "=$.arguments.sequenceType",
                  "productSkus": "=$.arguments.productSkus",
                  "delayHours": "=$.arguments.delayHours"
                }
              }
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"},\"sequenceType\":{\"type\":\"string\"},\"productSkus\":{\"type\":\"string\"},\"delayHours\":{\"type\":\"integer\"}}}",
                "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"memberId\":{\"type\":\"string\"},\"sequenceType\":{\"type\":\"string\"},\"productSkus\":{\"type\":\"string\"},\"delayHours\":{\"type\":\"integer\"}}}"
              }
            }
          },
          "name": "TriggerMarketingSequenceFlow"
        },
        {
          "description": "MCP Tool: Audit log — record agent reasoning, tools used, outcome, and confidence score for compliance",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "LogAgentDecision",
            "handlerDescription": "Audit log: record the agent's final reasoning and recommended action for compliance and continuous improvement. Inputs: memberId, agentReasoning (full text), toolsUsed (comma-separated tool names), outcome, confidenceScore (0.0-1.0). Always call this last."
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:LogAgentDecisionFlow"
            },
            "input": {
              "arguments": {
                "mapping": {
                  "memberId": "=$.arguments.memberId",
