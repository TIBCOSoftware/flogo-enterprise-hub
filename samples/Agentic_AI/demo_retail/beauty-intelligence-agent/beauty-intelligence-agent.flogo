                    "fe_metadata": "{\"swagger\":\"2.0\",\"info\":{\"title\":\"BeautyCo Mock API\",\"description\":\"BeautyCo Demo 1 â Mock REST API backing the Beauty Intelligence Agent MCP server. Provides realistic hardcoded responses for campaigns, inventory, store context, marketing sequences, and health check endpoints. Runs on port 8091.\",\"version\":\"1.0.0\",\"contact\":{\"name\":\"BeautyCo Integration Team\"}},\"host\":\"localhost:8091\",\"basePath\":\"/\",\"schemes\":[\"http\"],\"consumes\":[\"application/json\"],\"produces\":[\"application/json\"],\"tags\":[{\"name\":\"Campaigns\",\"description\":\"GlowRewards promotional campaigns for loyalty members\"},{\"name\":\"Inventory\",\"description\":\"Real-time product stock levels and GWP promotions\"},{\"name\":\"Store\",\"description\":\"Store details, hours, events, and advisor availability\"},{\"name\":\"Marketing\",\"description\":\"Post-visit marketing sequence enqueueing\"},{\"name\":\"Health\",\"description\":\"Service health check\"}],\"paths\":{\"/campaigns\":{\"get\":{\"tags\":[\"Campaigns\"],\"summary\":\"Get active campaigns for a member\",\"description\":\"Returns active GlowRewards promotional campaigns eligible for the specified member. Includes bonus-points multipliers, product discounts, and gift-with-purchase offers.\",\"operationId\":\"getCampaigns\",\"parameters\":[{\"name\":\"memberId\",\"in\":\"query\",\"description\":\"GlowRewards member identifier (e.g. M-7724-ASHA)\",\"required\":false,\"type\":\"string\"}],\"responses\":{\"200\":{\"description\":\"Active campaigns for the member\",\"schema\":{\"type\":\"object\",\"description\":\"Active GlowRewards promotional campaigns for a loyalty member\",\"properties\":{\"campaigns\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"description\":\"A single promotional campaign eligible for the member\",\"properties\":{\"campaign_id\":{\"type\":\"string\",\"description\":\"Unique campaign identifier\",\"example\":\"CAMP-GLOW-001\"},\"offer_type\":{\"type\":\"string\",\"description\":\"Type of promotional offer\",\"enum\":[\"BONUS_POINTS\",\"PRODUCT_DISCOUNT\",\"GWP\"],\"example\":\"BONUS_POINTS\"},\"description\":{\"type\":\"string\",\"description\":\"Human-readable campaign description\",\"example\":\"Earn 3x points on all skincare this weekend\"},\"bonus_points_multiplier\":{\"type\":\"number\",\"description\":\"Points multiplier applied to qualifying purchases (BONUS_POINTS offers only)\",\"example\":3},\"discount_value\":{\"type\":\"number\",\"description\":\"Percentage discount applied (PRODUCT_DISCOUNT offers only)\",\"example\":20},\"eligible_brands\":{\"type\":\"array\",\"description\":\"List of brands qualifying for this campaign\",\"items\":{\"type\":\"string\"},\"example\":[\"Charlotte Tilbury\",\"Dr. Jart+\",\"Drunk Elephant\"]},\"expiry\":{\"type\":\"string\",\"format\":\"date\",\"description\":\"Campaign expiry date (YYYY-MM-DD)\",\"example\":\"2026-05-26\"},\"member_eligible\":{\"type\":\"boolean\",\"description\":\"Whether the queried member qualifies for this campaign\",\"example\":true}}}},\"member_id\":{\"type\":\"string\",\"description\":\"GlowRewards member identifier\",\"example\":\"M-7724-ASHA\"},\"fetched_at\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"ISO-8601 timestamp when the response was generated\"}}},\"examples\":{\"application/json\":{\"campaigns\":[{\"campaign_id\":\"CAMP-GLOW-001\",\"offer_type\":\"BONUS_POINTS\",\"description\":\"Earn 3x points on all skincare this weekend\",\"bonus_points_multiplier\":3,\"eligible_brands\":[\"Charlotte Tilbury\",\"Dr. Jart+\",\"Drunk Elephant\",\"La Roche-Posay\"],\"expiry\":\"2026-05-26\",\"member_eligible\":true},{\"campaign_id\":\"CAMP-GLOW-002\",\"offer_type\":\"PRODUCT_DISCOUNT\",\"description\":\"20% off fragrance with any skincare purchase over $50\",\"discount_value\":20,\"eligible_brands\":[\"Maison Margiela\",\"Valentino\",\"Yves Saint Laurent\"],\"expiry\":\"2026-05-26\",\"member_eligible\":true},{\"campaign_id\":\"CAMP-GLOW-003\",\"offer_type\":\"GWP\",\"description\":\"Free 7-piece mini set with $75+ haircare purchase\",\"eligible_brands\":[\"Olaplex\",\"Dyson\",\"K18\"],\"expiry\":\"2026-05-26\",\"member_eligible\":true}],\"member_id\":\"M-7724-ASHA\",\"fetched_at\":\"2026-05-12T10:30:00.000Z\"}}}}}},\"/inventory/{sku}\":{\"get\":{\"tags\":[\"Inventory\"],\"summary\":\"Get inventory for a SKU\",\"description\":\"Returns real-time stock levels, online availability, low-stock and stockout flags, reorder ETA, and any active gift-with-purchase promotion for a product SKU at a given store.\",\"operationId\":\"getInventory\",\"parameters\":[{\"name\":\"sku\",\"in\":\"path\",\"description\":\"Product SKU (e.g. OLP-007-100ML, CT-WONDERGLOW-01)\",\"required\":true,\"type\":\"string\"},{\"name\":\"storeId\",\"in\":\"query\",\"description\":\"Store identifier to check local stock (e.g. 0847, 1204)\",\"required\":false,\"type\":\"string\"}],\"responses\":{\"200\":{\"description\":\"Inventory details for the SKU\",\"schema\":{\"type\":\"object\",\"description\":\"Stock levels and GWP promotion for a product SKU at a store\",\"properties\":{\"sku\":{\"type\":\"string\",\"description\":\"Product SKU\",\"example\":\"OLP-007-100ML\"},\"store_id\":{\"type\":\"string\",\"description\":\"Store identifier\",\"example\":\"0847\"},\"quantity_on_hand\":{\"type\":\"integer\",\"description\":\"Number of units in stock at the specified store\",\"example\":12},\"online_available\":{\"type\":\"boolean\",\"description\":\"Whether the product is available for online purchase\",\"example\":true},\"low_stock\":{\"type\":\"boolean\",\"description\":\"True when quantity_on_hand is between 1 and 4 (inclusive)\",\"example\":false},\"stockout\":{\"type\":\"boolean\",\"description\":\"True when quantity_on_hand is 0\",\"example\":false},\"reorder_in_days\":{\"type\":\"integer\",\"description\":\"Estimated days until restock (non-null only when stockout is true)\",\"example\":3,\"x-nullable\":true},\"gwp_promotion\":{\"description\":\"Active gift-with-purchase promotion, or null if none / stockout\",\"x-nullable\":true,\"allOf\":[{\"type\":\"object\",\"description\":\"Gift-with-purchase promotion attached to a product\",\"properties\":{\"promo_id\":{\"type\":\"string\",\"description\":\"Unique promotion identifier\",\"example\":\"GWP-OLP-00\"},\"description\":{\"type\":\"string\",\"description\":\"Promotion description shown to the member\",\"example\":\"Free deluxe sample with purchase\"},\"threshold_spend\":{\"type\":\"number\",\"description\":\"Minimum spend in USD to qualify for the GWP\",\"example\":45},\"gift_item\":{\"type\":\"string\",\"description\":\"Name of the gift item\",\"example\":\"Brand Discovery Mini Set\"}}}]},\"fetched_at\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"ISO-8601 timestamp when the response was generated\"}}},\"examples\":{\"application/json\":{\"sku\":\"OLP-007-100ML\",\"store_id\":\"0847\",\"quantity_on_hand\":0,\"online_available\":false,\"low_stock\":false,\"stockout\":true,\"reorder_in_days\":3,\"gwp_promotion\":null,\"fetched_at\":\"2026-05-12T10:30:00.000Z\"}}}}}},\"/store/{storeId}\":{\"get\":{\"tags\":[\"Store\"],\"summary\":\"Get store context\",\"description\":\"Returns store details including address, phone, opening hours, number of available beauty advisors, upcoming in-store events, and active store promotions.\",\"operationId\":\"getStore\",\"parameters\":[{\"name\":\"storeId\",\"in\":\"path\",\"description\":\"Store identifier (e.g. 0847 for Beverly Hills, 1204 for Santa Monica)\",\"required\":true,\"type\":\"string\"}],\"responses\":{\"200\":{\"description\":\"Store context and availability\",\"schema\":{\"type\":\"object\",\"description\":\"Store details, operating hours, advisor availability, and upcoming events\",\"properties\":{\"store_id\":{\"type\":\"string\",\"description\":\"Store identifier\",\"example\":\"0847\"},\"name\":{\"type\":\"string\",\"description\":\"Store display name\",\"example\":\"BeautyCo Beverly Hills\"},\"address\":{\"type\":\"string\",\"description\":\"Full street address\",\"example\":\"8500 Wilshire Blvd, Beverly Hills, CA 90211\"},\"phone\":{\"type\":\"string\",\"description\":\"Store phone number\",\"example\":\"310-555-0847\"},\"hours\":{\"type\":\"object\",\"description\":\"Store opening hours by day group\",\"properties\":{\"mon_sat\":{\"type\":\"string\",\"description\":\"Opening hours Monday through Saturday (24-hour HH:MM-HH:MM format)\",\"example\":\"10:00-21:00\"},\"sun\":{\"type\":\"string\",\"description\":\"Opening hours Sunday (24-hour HH:MM-HH:MM format)\",\"example\":\"11:00-19:00\"}}},\"beauty_advisors_available\":{\"type\":\"integer\",\"description\":\"Number of beauty advisors currently on the floor\",\"example\":3},\"upcoming_events\":{\"type\":\"array\",\"description\":\"In-store events scheduled in the next 14 days\",\"items\":{\"type\":\"object\",\"description\":\"An upcoming in-store event\",\"properties\":{\"event\":{\"type\":\"string\",\"description\":\"Event name\",\"example\":\"Skincare Masterclass with Charlotte Tilbury\"},\"date\":{\"type\":\"string\",\"format\":\"date\",\"description\":\"Event date (YYYY-MM-DD)\",\"example\":\"2026-05-15\"},\"spots_remaining\":{\"type\":\"integer\",\"description\":\"Number of registration spots still available\",\"example\":8}}}},\"store_promotions\":{\"type\":\"array\",\"description\":\"Active in-store promotional offers\",\"items\":{\"type\":\"string\"},\"example\":[\"In-store GWP on purchases over $50\",\"Double points Saturdays\"]},\"fetched_at\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"ISO-8601 timestamp when the response was generated\"}}},\"examples\":{\"application/json\":{\"store_id\":\"0847\",\"name\":\"BeautyCo Beverly Hills\",\"address\":\"8500 Wilshire Blvd, Beverly Hills, CA 90211\",\"phone\":\"310-555-0847\",\"hours\":{\"mon_sat\":\"10:00-21:00\",\"sun\":\"11:00-19:00\"},\"beauty_advisors_available\":3,\"upcoming_events\":[{\"event\":\"Skincare Masterclass with Charlotte Tilbury\",\"date\":\"2026-05-15\",\"spots_remaining\":8},{\"event\":\"Fragrance Discovery Session\",\"date\":\"2026-05-19\",\"spots_remaining\":12}],\"store_promotions\":[\"In-store GWP on purchases over $50\",\"Double points Saturdays\"],\"fetched_at\":\"2026-05-12T10:30:00.000Z\"}}}}}},\"/marketing/sequence\":{\"post\":{\"tags\":[\"Marketing\"],\"summary\":\"Enqueue a post-visit marketing sequence\",\"description\":\"Accepts a marketing sequence payload and enqueues a personalised post-visit email or push notification sequence for the member. Returns a sequence ID confirming the enqueue.\",\"operationId\":\"postMarketingSequence\",\"parameters\":[{\"name\":\"body\",\"in\":\"body\",\"description\":\"Marketing sequence request payload\",\"required\":true,\"schema\":{\"type\":\"object\",\"description\":\"Payload to enqueue a post-visit marketing sequence for a member\",\"required\":[\"memberId\",\"sequenceType\"],\"properties\":{\"memberId\":{\"type\":\"string\",\"description\":\"GlowRewards member identifier\",\"example\":\"M-7724-ASHA\"},\"sequenceType\":{\"type\":\"string\",\"description\":\"Type of marketing sequence to trigger\",\"enum\":[\"REPLENISHMENT\",\"BIRTHDAY\",\"WIN_BACK\",\"POST_CONSULTATION\",\"LOYALTY_NUDGE\"],\"example\":\"REPLENISHMENT\"},\"productSkus\":{\"type\":\"array\",\"description\":\"SKUs to feature in the sequence (e.g. replenishment candidates)\",\"items\":{\"type\":\"string\"},\"example\":[\"OLP-007-100ML\",\"CT-WONDERGLOW-01\"]},\"delayHours\":{\"type\":\"integer\",\"description\":\"Hours to wait before sending the first message in the sequence\",\"example\":2,\"default\":2}}}}],\"responses\":{\"201\":{\"description\":\"Marketing sequence enqueued successfully\",\"schema\":{\"type\":\"object\",\"description\":\"Confirmation that a marketing sequence has been enqueued\",\"properties\":{\"sequence_id\":{\"type\":\"string\",\"description\":\"Unique identifier for the enqueued sequence (SEQ- prefix + 8 alphanumeric chars)\",\"example\":\"SEQ-AB12CD34\"},\"status\":{\"type\":\"string\",\"description\":\"Enqueue status\",\"enum\":[\"QUEUED\"],\"example\":\"QUEUED\"},\"estimated_send_hours\":{\"type\":\"integer\",\"description\":\"Estimated hours until the first message is sent\",\"example\":2},\"message\":{\"type\":\"string\",\"description\":\"Human-readable confirmation message\",\"example\":\"Marketing sequence successfully queued\"},\"queued_at\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"ISO-8601 timestamp when the sequence was enqueued\"}}},\"examples\":{\"application/json\":{\"sequence_id\":\"SEQ-AB12CD34\",\"status\":\"QUEUED\",\"estimated_send_hours\":2,\"message\":\"Marketing sequence successfully queued\",\"queued_at\":\"2026-05-12T10:30:00.000Z\"}}}}}},\"/health\":{\"get\":{\"tags\":[\"Health\"],\"summary\":\"Service health check\",\"description\":\"Returns the current health status of the mock API service. Used by the demo trigger script to verify the mock server is running before firing Claude prompts.\",\"operationId\":\"getHealth\",\"parameters\":[],\"responses\":{\"200\":{\"description\":\"Service is healthy\",\"schema\":{\"type\":\"object\",\"description\":\"Service health status\",\"properties\":{\"status\":{\"type\":\"string\",\"description\":\"Service status indicator\",\"enum\":[\"UP\",\"DOWN\"],\"example\":\"UP\"},\"service\":{\"type\":\"string\",\"description\":\"Service name\",\"example\":\"beauty-mock-apis\"},\"version\":{\"type\":\"string\",\"description\":\"Service version\",\"example\":\"1.0.0\"},\"timestamp\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"ISO-8601 timestamp of the health check response\"}}},\"examples\":{\"application/json\":{\"status\":\"UP\",\"service\":\"beauty-mock-apis\",\"version\":\"1.0.0\",\"timestamp\":\"2026-05-12T10:30:00.000Z\"}}}}}}},\"definitions\":{\"CampaignResponse\":{\"type\":\"object\",\"description\":\"Active GlowRewards promotional campaigns for a loyalty member\",\"properties\":{\"campaigns\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"description\":\"A single promotional campaign eligible for the member\",\"properties\":{\"campaign_id\":{\"type\":\"string\",\"description\":\"Unique campaign identifier\",\"example\":\"CAMP-GLOW-001\"},\"offer_type\":{\"type\":\"string\",\"description\":\"Type of promotional offer\",\"enum\":[\"BONUS_POINTS\",\"PRODUCT_DISCOUNT\",\"GWP\"],\"example\":\"BONUS_POINTS\"},\"description\":{\"type\":\"string\",\"description\":\"Human-readable campaign description\",\"example\":\"Earn 3x points on all skincare this weekend\"},\"bonus_points_multiplier\":{\"type\":\"number\",\"description\":\"Points multiplier applied to qualifying purchases (BONUS_POINTS offers only)\",\"example\":3},\"discount_value\":{\"type\":\"number\",\"description\":\"Percentage discount applied (PRODUCT_DISCOUNT offers only)\",\"example\":20},\"eligible_brands\":{\"type\":\"array\",\"description\":\"List of brands qualifying for this campaign\",\"items\":{\"type\":\"string\"},\"example\":[\"Charlotte Tilbury\",\"Dr. Jart+\",\"Drunk Elephant\"]},\"expiry\":{\"type\":\"string\",\"format\":\"date\",\"description\":\"Campaign expiry date (YYYY-MM-DD)\",\"example\":\"2026-05-26\"},\"member_eligible\":{\"type\":\"boolean\",\"description\":\"Whether the queried member qualifies for this campaign\",\"example\":true}}}},\"member_id\":{\"type\":\"string\",\"description\":\"GlowRewards member identifier\",\"example\":\"M-7724-ASHA\"},\"fetched_at\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"ISO-8601 timestamp when the response was generated\"}}},\"Campaign\":{\"type\":\"object\",\"description\":\"A single promotional campaign eligible for the member\",\"properties\":{\"campaign_id\":{\"type\":\"string\",\"description\":\"Unique campaign identifier\",\"example\":\"CAMP-GLOW-001\"},\"offer_type\":{\"type\":\"string\",\"description\":\"Type of promotional offer\",\"enum\":[\"BONUS_POINTS\",\"PRODUCT_DISCOUNT\",\"GWP\"],\"example\":\"BONUS_POINTS\"},\"description\":{\"type\":\"string\",\"description\":\"Human-readable campaign description\",\"example\":\"Earn 3x points on all skincare this weekend\"},\"bonus_points_multiplier\":{\"type\":\"number\",\"description\":\"Points multiplier applied to qualifying purchases (BONUS_POINTS offers only)\",\"example\":3},\"discount_value\":{\"type\":\"number\",\"description\":\"Percentage discount applied (PRODUCT_DISCOUNT offers only)\",\"example\":20},\"eligible_brands\":{\"type\":\"array\",\"description\":\"List of brands qualifying for this campaign\",\"items\":{\"type\":\"string\"},\"example\":[\"Charlotte Tilbury\",\"Dr. Jart+\",\"Drunk Elephant\"]},\"expiry\":{\"type\":\"string\",\"format\":\"date\",\"description\":\"Campaign expiry date (YYYY-MM-DD)\",\"example\":\"2026-05-26\"},\"member_eligible\":{\"type\":\"boolean\",\"description\":\"Whether the queried member qualifies for this campaign\",\"example\":true}}},\"InventoryResponse\":{\"type\":\"object\",\"description\":\"Stock levels and GWP promotion for a product SKU at a store\",\"properties\":{\"sku\":{\"type\":\"string\",\"description\":\"Product SKU\",\"example\":\"OLP-007-100ML\"},\"store_id\":{\"type\":\"string\",\"description\":\"Store identifier\",\"example\":\"0847\"},\"quantity_on_hand\":{\"type\":\"integer\",\"description\":\"Number of units in stock at the specified store\",\"example\":12},\"online_available\":{\"type\":\"boolean\",\"description\":\"Whether the product is available for online purchase\",\"example\":true},\"low_stock\":{\"type\":\"boolean\",\"description\":\"True when quantity_on_hand is between 1 and 4 (inclusive)\",\"example\":false},\"stockout\":{\"type\":\"boolean\",\"description\":\"True when quantity_on_hand is 0\",\"example\":false},\"reorder_in_days\":{\"type\":\"integer\",\"description\":\"Estimated days until restock (non-null only when stockout is true)\",\"example\":3,\"x-nullable\":true},\"gwp_promotion\":{\"description\":\"Active gift-with-purchase promotion, or null if none / stockout\",\"x-nullable\":true,\"allOf\":[{\"type\":\"object\",\"description\":\"Gift-with-purchase promotion attached to a product\",\"properties\":{\"promo_id\":{\"type\":\"string\",\"description\":\"Unique promotion identifier\",\"example\":\"GWP-OLP-00\"},\"description\":{\"type\":\"string\",\"description\":\"Promotion description shown to the member\",\"example\":\"Free deluxe sample with purchase\"},\"threshold_spend\":{\"type\":\"number\",\"description\":\"Minimum spend in USD to qualify for the GWP\",\"example\":45},\"gift_item\":{\"type\":\"string\",\"description\":\"Name of the gift item\",\"example\":\"Brand Discovery Mini Set\"}}}]},\"fetched_at\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"ISO-8601 timestamp when the response was generated\"}}},\"GWPPromotion\":{\"type\":\"object\",\"description\":\"Gift-with-purchase promotion attached to a product\",\"properties\":{\"promo_id\":{\"type\":\"string\",\"description\":\"Unique promotion identifier\",\"example\":\"GWP-OLP-00\"},\"description\":{\"type\":\"string\",\"description\":\"Promotion description shown to the member\",\"example\":\"Free deluxe sample with purchase\"},\"threshold_spend\":{\"type\":\"number\",\"description\":\"Minimum spend in USD to qualify for the GWP\",\"example\":45},\"gift_item\":{\"type\":\"string\",\"description\":\"Name of the gift item\",\"example\":\"Brand Discovery Mini Set\"}}},\"StoreResponse\":{\"type\":\"object\",\"description\":\"Store details, operating hours, advisor availability, and upcoming events\",\"properties\":{\"store_id\":{\"type\":\"string\",\"description\":\"Store identifier\",\"example\":\"0847\"},\"name\":{\"type\":\"string\",\"description\":\"Store display name\",\"example\":\"BeautyCo Beverly Hills\"},\"address\":{\"type\":\"string\",\"description\":\"Full street address\",\"example\":\"8500 Wilshire Blvd, Beverly Hills, CA 90211\"},\"phone\":{\"type\":\"string\",\"description\":\"Store phone number\",\"example\":\"310-555-0847\"},\"hours\":{\"type\":\"object\",\"description\":\"Store opening hours by day group\",\"properties\":{\"mon_sat\":{\"type\":\"string\",\"description\":\"Opening hours Monday through Saturday (24-hour HH:MM-HH:MM format)\",\"example\":\"10:00-21:00\"},\"sun\":{\"type\":\"string\",\"description\":\"Opening hours Sunday (24-hour HH:MM-HH:MM format)\",\"example\":\"11:00-19:00\"}}},\"beauty_advisors_available\":{\"type\":\"integer\",\"description\":\"Number of beauty advisors currently on the floor\",\"example\":3},\"upcoming_events\":{\"type\":\"array\",\"description\":\"In-store events scheduled in the next 14 days\",\"items\":{\"type\":\"object\",\"description\":\"An upcoming in-store event\",\"properties\":{\"event\":{\"type\":\"string\",\"description\":\"Event name\",\"example\":\"Skincare Masterclass with Charlotte Tilbury\"},\"date\":{\"type\":\"string\",\"format\":\"date\",\"description\":\"Event date (YYYY-MM-DD)\",\"example\":\"2026-05-15\"},\"spots_remaining\":{\"type\":\"integer\",\"description\":\"Number of registration spots still available\",\"example\":8}}}},\"store_promotions\":{\"type\":\"array\",\"description\":\"Active in-store promotional offers\",\"items\":{\"type\":\"string\"},\"example\":[\"In-store GWP on purchases over $50\",\"Double points Saturdays\"]},\"fetched_at\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"ISO-8601 timestamp when the response was generated\"}}},\"StoreHours\":{\"type\":\"object\",\"description\":\"Store opening hours by day group\",\"properties\":{\"mon_sat\":{\"type\":\"string\",\"description\":\"Opening hours Monday through Saturday (24-hour HH:MM-HH:MM format)\",\"example\":\"10:00-21:00\"},\"sun\":{\"type\":\"string\",\"description\":\"Opening hours Sunday (24-hour HH:MM-HH:MM format)\",\"example\":\"11:00-19:00\"}}},\"StoreEvent\":{\"type\":\"object\",\"description\":\"An upcoming in-store event\",\"properties\":{\"event\":{\"type\":\"string\",\"description\":\"Event name\",\"example\":\"Skincare Masterclass with Charlotte Tilbury\"},\"date\":{\"type\":\"string\",\"format\":\"date\",\"description\":\"Event date (YYYY-MM-DD)\",\"example\":\"2026-05-15\"},\"spots_remaining\":{\"type\":\"integer\",\"description\":\"Number of registration spots still available\",\"example\":8}}},\"MarketingSequenceRequest\":{\"type\":\"object\",\"description\":\"Payload to enqueue a post-visit marketing sequence for a member\",\"required\":[\"memberId\",\"sequenceType\"],\"properties\":{\"memberId\":{\"type\":\"string\",\"description\":\"GlowRewards member identifier\",\"example\":\"M-7724-ASHA\"},\"sequenceType\":{\"type\":\"string\",\"description\":\"Type of marketing sequence to trigger\",\"enum\":[\"REPLENISHMENT\",\"BIRTHDAY\",\"WIN_BACK\",\"POST_CONSULTATION\",\"LOYALTY_NUDGE\"],\"example\":\"REPLENISHMENT\"},\"productSkus\":{\"type\":\"array\",\"description\":\"SKUs to feature in the sequence (e.g. replenishment candidates)\",\"items\":{\"type\":\"string\"},\"example\":[\"OLP-007-100ML\",\"CT-WONDERGLOW-01\"]},\"delayHours\":{\"type\":\"integer\",\"description\":\"Hours to wait before sending the first message in the sequence\",\"example\":2,\"default\":2}}},\"MarketingSequenceResponse\":{\"type\":\"object\",\"description\":\"Confirmation that a marketing sequence has been enqueued\",\"properties\":{\"sequence_id\":{\"type\":\"string\",\"description\":\"Unique identifier for the enqueued sequence (SEQ- prefix + 8 alphanumeric chars)\",\"example\":\"SEQ-AB12CD34\"},\"status\":{\"type\":\"string\",\"description\":\"Enqueue status\",\"enum\":[\"QUEUED\"],\"example\":\"QUEUED\"},\"estimated_send_hours\":{\"type\":\"integer\",\"description\":\"Estimated hours until the first message is sent\",\"example\":2},\"message\":{\"type\":\"string\",\"description\":\"Human-readable confirmation message\",\"example\":\"Marketing sequence successfully queued\"},\"queued_at\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"ISO-8601 timestamp when the sequence was enqueued\"}}},\"HealthResponse\":{\"type\":\"object\",\"description\":\"Service health status\",\"properties\":{\"status\":{\"type\":\"string\",\"description\":\"Service status indicator\",\"enum\":[\"UP\",\"DOWN\"],\"example\":\"UP\"},\"service\":{\"type\":\"string\",\"description\":\"Service name\",\"example\":\"beauty-mock-apis\"},\"version\":{\"type\":\"string\",\"description\":\"Service version\",\"example\":\"1.0.0\"},\"timestamp\":{\"type\":\"string\",\"format\":\"date-time\",\"description\":\"ISO-8601 timestamp of the health check response\"}}}}}"
                  },
                  "headers": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Authorization\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}},\"required\":[]}",
                    "fe_metadata": "[{\"parameterName\":\"Accept\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Charset\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Accept-Encoding\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Authorization\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Type\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Content-Length\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Connection\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Cookie\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false},{\"parameterName\":\"Pragma\",\"type\":\"string\",\"repeating\":\"false\",\"required\":\"false\",\"visible\":false}]"
                  },
                  "dynamicRequestHeaders": {
                    "type": "json",
