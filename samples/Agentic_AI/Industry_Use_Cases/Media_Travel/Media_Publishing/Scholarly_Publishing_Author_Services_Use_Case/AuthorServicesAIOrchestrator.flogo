    },
    "19c8615a-29ea-427d-8477-b203d023da36": {
      "id": "19c8615a-29ea-427d-8477-b203d023da36",
      "name": "AuthorServicesMCPServer",
      "ref": "#mcpserverconfig",
      "isGlobal": false,
      "settings": {
        "name": "AuthorServicesMCPServer",
        "description": "Your mcpserverconfig Connector",
        "serverType": "http",
        "serverUrl": "http://localhost:9842/author-services-mcp",
        "httpTransportType": "streamable",
        "authType": "None",
        "authToken": "",
        "selectedTools": []
      }
    },
    "d2c84079-2911-4009-a532-5f07dd4d193f": {
      "id": "d2c84079-2911-4009-a532-5f07dd4d193f",
      "name": "journal_match_agentA2AServer",
      "ref": "#a2aserverconnection",
      "isGlobal": false,
      "settings": {
        "name": "journal_match_agentA2AServer",
        "description": "Your a2aserverconnection Connector",
        "serverUrl": "http://localhost:9843",
        "authType": "None",
        "authToken": ""
      }
    }
  },
  "contrib": "",
