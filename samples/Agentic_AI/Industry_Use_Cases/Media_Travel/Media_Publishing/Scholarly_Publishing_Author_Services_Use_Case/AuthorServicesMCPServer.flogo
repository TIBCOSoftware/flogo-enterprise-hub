                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"status\": {\"type\": \"string\"}, \"session_token\": {\"type\": \"string\"}, \"author_name\": {\"type\": \"string\"}, \"institution\": {\"type\": \"string\"}, \"expires_at\": {\"type\": \"string\"}}}}}}"
                  }
