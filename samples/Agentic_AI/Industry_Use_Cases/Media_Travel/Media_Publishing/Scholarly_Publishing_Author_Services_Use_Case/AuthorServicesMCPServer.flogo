    {
      "id": "flow:propose_transfer_flow",
      "data": {
        "name": "propose_transfer_flow",
        "description": "Step 1 of 2 for transferring a manuscript that received a transfer offer to another journal. The system checks every rule (ownership, transfer offer, editorial hold, target journal open to transfers, word limit) and prices the APC. Returns PROPOSED with an action_id and the quote, or NOT_PROPOSED with the reason. Nothing changes until confirm_transfer is called.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GuardedWrite",
            "name": "GuardedWrite",
            "description": "PostgreSQL Insert",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://18e54df6-fdff-40b3-abca-9b276a683793",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO pending_actions (action_type, author_id, manuscript_id, target_journal_code, apc_usd, coverage_pct, author_pays_usd) SELECT * FROM transfer_proposal_row(CAST(?w_tok AS text), CAST(?w_ms AS text), CAST(?w_jc AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_tok",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_ms",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_jc",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
