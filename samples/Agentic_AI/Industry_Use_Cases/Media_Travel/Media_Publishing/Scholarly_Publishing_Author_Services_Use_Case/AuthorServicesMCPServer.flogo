          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_cases_flow",
          "description": "List the verified author's open and past review cases with the assigned team, status (OPEN, APPROVED, REJECTED), requested amount, reply-by date and - once a person has decided - the approved amount and the message from the team (customer_message). Use it when the author asks about the status of a request.",
          "schemas": {
            "output": {
              "arguments": "schema://get_my_cases_Args"
