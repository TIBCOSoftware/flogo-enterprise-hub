                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"values\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"parameters\": {\"type\": \"object\", \"properties\": {\"w_tok\": {\"type\": \"string\"}, \"w_ms\": {\"type\": \"string\"}, \"w_jc\": {\"type\": \"string\"}, \"w_stmt\": {\"type\": \"string\"}, \"w_items\": {\"type\": \"string\"}, \"w_notes\": {\"type\": \"string\"}}}}}"
                  }
                },
                "output": {
