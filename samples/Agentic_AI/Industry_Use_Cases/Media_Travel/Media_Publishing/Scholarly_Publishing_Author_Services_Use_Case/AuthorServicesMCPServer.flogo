{
  "imports": [
    "con_postgresql github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection",
    "tr_mcpserver github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/flow",
    "act_default_noop github.com/project-flogo/contrib/activity/noop",
    "act_postgresql_insert github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "act_postgresql_query github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "act_default_actreturn github.com/project-flogo/contrib/activity/actreturn",
    "github.com/project-flogo/contrib/function/coerce"
  ],
  "name": "AuthorServicesMCPServer",
  "description": "Author Services MCP Server - scoped reads, guarded writes, submission checks and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "AuthorServicesMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/author-services-mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "AuthorServicesMCPServer",
      "name": "AuthorServicesMCPServer",
      "description": "Author Services MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_author",
            "handlerDescription": "Verify the author's identity with their ORCID iD and the 6-digit verification code sent to their registered email. Returns status VERIFIED with a session_token (valid 60 minutes) and the author's name, or NOT_VERIFIED. Call this before any other author tool. Never reveal or guess verification codes. Publisher staff use verify_reviewer instead.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_author_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_author_flow",
          "description": "Verify the author's identity with their ORCID iD and the 6-digit verification code sent to their registered email. Returns status VERIFIED with a session_token (valid 60 minutes) and the author's name, or NOT_VERIFIED. Call this before any other author tool. Never reveal or guess verification codes. Publisher staff use verify_reviewer instead.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_author_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_manuscripts",
            "handlerDescription": "List the verified author's own manuscripts (as corresponding author): id, title, journal, status and the status detail the author is allowed to see. Only this author's rows are returned.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_manuscripts_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_manuscripts_flow",
          "description": "List the verified author's own manuscripts (as corresponding author): id, title, journal, status and the status detail the author is allowed to see. Only this author's rows are returned.",
          "schemas": {
            "output": {
              "arguments": "schema://get_my_manuscripts_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_manuscript",
            "handlerDescription": "Get one of the verified author's manuscripts in detail: status, status detail, the editor's decision summary, article type, word count, keywords, abstract, the author's submission statements on file (declarations: data availability, ethics, funding, competing interests, author contributions) and, for an accepted manuscript, the APC still due and any waiver granted. Returns NOT_FOUND for any manuscript that does not belong to this author.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_manuscript_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_manuscript_flow",
          "description": "Get one of the verified author's manuscripts in detail: status, status detail, the editor's decision summary, article type, word count, keywords, abstract, the author's submission statements on file (declarations: data availability, ethics, funding, competing interests, author contributions) and, for an accepted manuscript, the APC still due and any waiver granted. Returns NOT_FOUND for any manuscript that does not belong to this author.",
          "schemas": {
            "output": {
              "arguments": "schema://get_manuscript_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_review_comments",
            "handlerDescription": "Get the editor's decision letter and the anonymous reviewer comments for one of the verified author's own manuscripts: one row per comment with comment_ref (E.1, R1.1, R2.3 ...), source (Editor, Reviewer 1, Reviewer 2 ...) and the comment text. Returns NO_COMMENTS when there are none and NOT_FOUND for a manuscript that is not this author's. Use it before asking review_summary_agent for a revision checklist.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_review_comments_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_review_comments_flow",
          "description": "Get the editor's decision letter and the anonymous reviewer comments for one of the verified author's own manuscripts: one row per comment with comment_ref (E.1, R1.1, R2.3 ...), source (Editor, Reviewer 1, Reviewer 2 ...) and the comment text. Returns NO_COMMENTS when there are none and NOT_FOUND for a manuscript that is not this author's. Use it before asking review_summary_agent for a revision checklist.",
          "schemas": {
            "output": {
              "arguments": "schema://get_review_comments_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "check_apc_coverage",
            "handlerDescription": "Quote the article processing charge (APC) for a journal and whether the author's institution's open-access agreement covers it. Returns apc_usd, coverage_pct, covered_usd, author_pays_usd and a coverage_note. All amounts are computed by the system - quote them exactly, never estimate.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:check_apc_coverage_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "check_apc_coverage_flow",
          "description": "Quote the article processing charge (APC) for a journal and whether the author's institution's open-access agreement covers it. Returns apc_usd, coverage_pct, covered_usd, author_pays_usd and a coverage_note. All amounts are computed by the system - quote them exactly, never estimate.",
          "schemas": {
            "output": {
              "arguments": "schema://check_apc_coverage_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "record_submission_check",
            "handlerDescription": "Record the submission statements check for moving a manuscript to a target journal. Pass the manuscript, the target journal code, any statement text the author added in this conversation (empty if none), the submission_check_agent's missing_items line and its full answer exactly as returned. The system validates the flagged items against the journal's policy, adds its own presence check, records the check and returns RECORDED with result COMPLETE or INCOMPLETE, the mandatory and recommended items that are missing and the policy's standard wording for each, or NOT_RECORDED with reason_code SESSION_INVALID, NOT_FOUND, ON_HOLD or JOURNAL_UNKNOWN. An INCOMPLETE check blocks the transfer (STATEMENTS_INCOMPLETE).",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:record_submission_check_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "record_submission_check_flow",
          "description": "Record the submission statements check for moving a manuscript to a target journal. Pass the manuscript, the target journal code, any statement text the author added in this conversation (empty if none), the submission_check_agent's missing_items line and its full answer exactly as returned. The system validates the flagged items against the journal's policy, adds its own presence check, records the check and returns RECORDED with result COMPLETE or INCOMPLETE, the mandatory and recommended items that are missing and the policy's standard wording for each, or NOT_RECORDED with reason_code SESSION_INVALID, NOT_FOUND, ON_HOLD or JOURNAL_UNKNOWN. An INCOMPLETE check blocks the transfer (STATEMENTS_INCOMPLETE).",
          "schemas": {
            "output": {
              "arguments": "schema://record_submission_check_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_transfer",
            "handlerDescription": "Step 1 of 2 for transferring a manuscript that received a transfer offer to another journal. The system checks every rule (ownership, transfer offer, editorial hold, target journal open to transfers, word limit, and the target journal's submission statements) and prices the APC. Returns PROPOSED with an action_id and the quote, or NOT_PROPOSED with the reason - CHECK_REQUIRED means the submission statements must be checked first (record_submission_check), STATEMENTS_INCOMPLETE means the last check found mandatory statements missing. Nothing changes until confirm_transfer is called.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_transfer_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_transfer_flow",
          "description": "Step 1 of 2 for transferring a manuscript that received a transfer offer to another journal. The system checks every rule (ownership, transfer offer, editorial hold, target journal open to transfers, word limit, and the target journal's submission statements) and prices the APC. Returns PROPOSED with an action_id and the quote, or NOT_PROPOSED with the reason - CHECK_REQUIRED means the submission statements must be checked first (record_submission_check), STATEMENTS_INCOMPLETE means the last check found mandatory statements missing. Nothing changes until confirm_transfer is called.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_transfer_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_transfer",
            "handlerDescription": "Step 2 of 2: execute a transfer the author has explicitly confirmed. Pass the action_id from propose_transfer. The system re-checks every rule and expires proposals after 15 minutes. Returns EXECUTED or NOT_EXECUTED with the reason. Only call after the author says yes to the exact quote.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:confirm_transfer_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "confirm_transfer_flow",
          "description": "Step 2 of 2: execute a transfer the author has explicitly confirmed. Pass the action_id from propose_transfer. The system re-checks every rule and expires proposals after 15 minutes. Returns EXECUTED or NOT_EXECUTED with the reason. Only call after the author says yes to the exact quote.",
          "schemas": {
            "output": {
              "arguments": "schema://confirm_transfer_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "open_review_case",
            "handlerDescription": "Hand a request that needs human judgment to the right team: APC_WAIVER (fee waiver or discount), DECISION_APPEAL (challenge an editorial decision or reviewer), AUTHORSHIP_CHANGE (add/remove/reorder authors), INTEGRITY_QUERY (ethics, data, image or plagiarism concerns), STATEMENTS_EXCEPTION (ask the editorial office to accept the submission statements as they are after an INCOMPLETE submission check; brief = submission_check_agent's full answer) or OTHER. The system routes it, works out what a person could approve (e.g. a waiver up to what the author pays) and returns CASE_OPENED with case_id, team, reply time and requested amount, ALREADY_OPEN when the same request is already with the team, or NOT_OPENED with the reason. A person decides; the assistant never decides these requests.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:open_review_case_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "open_review_case_flow",
          "description": "Hand a request that needs human judgment to the right team: APC_WAIVER (fee waiver or discount), DECISION_APPEAL (challenge an editorial decision or reviewer), AUTHORSHIP_CHANGE (add/remove/reorder authors), INTEGRITY_QUERY (ethics, data, image or plagiarism concerns), STATEMENTS_EXCEPTION (ask the editorial office to accept the submission statements as they are after an INCOMPLETE submission check; brief = submission_check_agent's full answer) or OTHER. The system routes it, works out what a person could approve (e.g. a waiver up to what the author pays) and returns CASE_OPENED with case_id, team, reply time and requested amount, ALREADY_OPEN when the same request is already with the team, or NOT_OPENED with the reason. A person decides; the assistant never decides these requests.",
          "schemas": {
            "output": {
              "arguments": "schema://open_review_case_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_cases",
            "handlerDescription": "List the verified author's open and past review cases with the assigned team, status (OPEN, APPROVED, REJECTED), requested amount, reply-by date and - once a person has decided - the approved amount and the message from the team (customer_message). Use it when the author asks about the status of a request.",
            "toolTitle": "",
