            "activity": {
              "input": {
                "Connection": "conn://8fa41334-5b98-4846-bd4e-e0bad90e1ec0",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO submission_checks (author_id, manuscript_id, journal_code, statements, agent_notes, agent_items, ignored_items, rule_items, mandatory_missing, recommended_missing, result) SELECT * FROM submission_check_row(CAST(?w_tok AS text), CAST(?w_ms AS text), CAST(?w_jc AS text), CAST(?w_stmt AS text), CAST(?w_items AS text), CAST(?w_notes AS text));",
                "manualmode": false,
                "Fields": [
