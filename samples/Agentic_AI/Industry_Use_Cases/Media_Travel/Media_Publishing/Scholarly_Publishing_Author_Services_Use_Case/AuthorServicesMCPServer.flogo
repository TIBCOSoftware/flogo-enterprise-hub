        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "decide_review_case",
            "handlerDescription": "Record the reviewer's decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved waiver in dollars (empty = the full amount the author pays; ignored for REJECT and for cases without an amount); internal_note is required (at least 5 characters, never shown to the author); customer_message is what the author will see. Approving runs the parked action (APC reduction, or accepting the submission statements so the transfer can go ahead) through the system's checks. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior reviewer), INVALID_DECISION or NOT_FOUND, or NOT_REVIEWER.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:decide_review_case_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "decide_review_case_flow",
          "description": "Record the reviewer's decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved waiver in dollars (empty = the full amount the author pays; ignored for REJECT and for cases without an amount); internal_note is required (at least 5 characters, never shown to the author); customer_message is what the author will see. Approving runs the parked action (APC reduction, or accepting the submission statements so the transfer can go ahead) through the system's checks. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior reviewer), INVALID_DECISION or NOT_FOUND, or NOT_REVIEWER.",
          "schemas": {
            "output": {
              "arguments": "schema://decide_review_case_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        }
      ]
    }
