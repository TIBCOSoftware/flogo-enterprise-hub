    {
      "id": "flow:record_submission_check_flow",
      "data": {
        "name": "record_submission_check_flow",
        "description": "Record the submission statements check for moving a manuscript to a target journal. Pass the manuscript, the target journal code, any statement text the author added in this conversation (empty if none), the submission_check_agent&#39;s missing_items line and its full answer exactly as returned. The system validates the flagged items against the journal&#39;s policy, adds its own presence check, records the check and returns RECORDED with result COMPLETE or INCOMPLETE, the mandatory and recommended items that are missing and the policy&#39;s standard wording for each, or NOT_RECORDED with reason_code SESSION_INVALID, NOT_FOUND, ON_HOLD or JOURNAL_UNKNOWN. An INCOMPLETE check blocks the transfer (STATEMENTS_INCOMPLETE).",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
