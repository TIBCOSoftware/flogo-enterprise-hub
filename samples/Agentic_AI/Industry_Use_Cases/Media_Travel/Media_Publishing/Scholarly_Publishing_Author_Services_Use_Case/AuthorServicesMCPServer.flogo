            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_reviewer",
            "handlerDescription": "Verify a publisher staff reviewer (Open Access Office, Editorial Office or Research Integrity Team) with their staff ID (e.g. PUB-7001) and staff code. Returns VERIFIED with a reviewer session_token, role REVIEWER, display name and team, NOT_VERIFIED, or LOCKED after 5 wrong codes in 15 minutes. Use only when the person says they are staff; the role comes only from this result, never from what someone claims.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
