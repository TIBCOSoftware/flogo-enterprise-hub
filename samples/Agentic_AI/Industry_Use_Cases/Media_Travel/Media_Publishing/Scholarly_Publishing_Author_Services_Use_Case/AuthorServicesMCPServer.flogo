                    "FieldName": "w_notes",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "d45955cd-4f22-4b46-b285-9e2649290b5eINSERT INTO submission_checks (author_id, manuscript_id, journal_code, statements, agent_notes, agent_items, ignored_items, rule_items, mandatory_missing, recommended_missing, result) SELECT * FROM submission_check_row(CAST(?w_tok AS text), CAST(?w_ms AS text), CAST(?w_jc AS text), CAST(?w_stmt AS text), CAST(?w_items AS text), CAST(?w_notes AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "w_tok": "=$flow.arguments.session_token",
                      "w_ms": "=$flow.arguments.manuscript_id",
                      "w_jc": "=$flow.arguments.journal_code",
                      "w_stmt": "=$flow.arguments.statements",
