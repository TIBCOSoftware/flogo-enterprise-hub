    {
      "id": "flow:get_my_manuscripts_flow",
      "data": {
        "name": "get_my_manuscripts_flow",
        "description": "List the verified author&#39;s own manuscripts (as corresponding author): id, title, journal, status and the status detail the author is allowed to see. Only this author&#39;s rows are returned.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadOutcome",
            "type": "label",
            "label": "StartActivity to ReadOutcome"
          },
          {
            "id": 2,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ReadOutcome",
            "name": "ReadOutcome",
            "description": "PostgreSQL Query",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://18e54df6-fdff-40b3-abca-9b276a683793",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT * FROM my_manuscripts(CAST(?tok AS text));",
                "manualmode": false,
                "fetchMetadata": false,
                "Fields": [
                  {
                    "FieldName": "tok",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "session_status",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "manuscript_id",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
