                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"r_orcid\": {\"type\": \"string\"}, \"r_code\": {\"type\": \"string\"}}}}}"
