    {
      "id": "flow:propose_transfer_flow",
      "data": {
        "name": "propose_transfer_flow",
        "description": "Step 1 of 2 for transferring a manuscript that received a transfer offer to another journal. The system checks every rule (ownership, transfer offer, editorial hold, target journal open to transfers, word limit, and the target journal&#39;s submission statements) and prices the APC. Returns PROPOSED with an action_id and the quote, or NOT_PROPOSED with the reason - CHECK_REQUIRED means the submission statements must be checked first (record_submission_check), STATEMENTS_INCOMPLETE means the last check found mandatory statements missing. Nothing changes until confirm_transfer is called.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
