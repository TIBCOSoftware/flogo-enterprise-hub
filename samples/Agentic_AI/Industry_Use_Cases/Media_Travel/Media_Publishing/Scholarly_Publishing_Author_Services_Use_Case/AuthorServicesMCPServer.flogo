{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "AuthorServicesMCPServer",
  "description": "Author Services MCP Server - scoped reads and guarded writes for verified authors",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Author Services MCP server",
      "settings": {
        "serverName": "AuthorServicesMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/author-services-mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "AuthorServicesMCPServer",
      "handlers": [
        {
          "description": "Verify the author&#39;s identity with their ORCID iD and the 6-digit verification code sent to their registered email. Returns status VERIFIED with a session_token (valid 60 minutes) and the author&#39;s name, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess verification codes.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_author",
            "handlerDescription": "Verify the author's identity with their ORCID iD and the 6-digit verification code sent to their registered email. Returns status VERIFIED with a session_token (valid 60 minutes) and the author's name, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess verification codes.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_author_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://verify_author_Args"
            }
          },
          "name": "verify_author_flow"
        },
        {
          "description": "List the verified author&#39;s own manuscripts (as corresponding author): id, title, journal, status and the status detail the author is allowed to see. Only this author&#39;s rows are returned.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_manuscripts",
            "handlerDescription": "List the verified author's own manuscripts (as corresponding author): id, title, journal, status and the status detail the author is allowed to see. Only this author's rows are returned.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_manuscripts_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_my_manuscripts_Args"
            }
          },
          "name": "get_my_manuscripts_flow"
        },
        {
          "description": "Get one of the verified author&#39;s manuscripts in detail: status, status detail, the editor&#39;s decision summary, article type, word count, keywords and abstract. Returns NOT_FOUND for any manuscript that does not belong to this author.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_manuscript",
            "handlerDescription": "Get one of the verified author's manuscripts in detail: status, status detail, the editor's decision summary, article type, word count, keywords and abstract. Returns NOT_FOUND for any manuscript that does not belong to this author.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_manuscript_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_manuscript_Args"
            }
          },
          "name": "get_manuscript_flow"
        },
        {
          "description": "Quote the article processing charge (APC) for a journal and whether the author&#39;s institution&#39;s open-access agreement covers it. Returns apc_usd, coverage_pct, covered_usd, author_pays_usd and a coverage_note. All amounts are computed by the system - quote them exactly, never estimate.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "check_apc_coverage",
            "handlerDescription": "Quote the article processing charge (APC) for a journal and whether the author's institution's open-access agreement covers it. Returns apc_usd, coverage_pct, covered_usd, author_pays_usd and a coverage_note. All amounts are computed by the system - quote them exactly, never estimate.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:check_apc_coverage_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://check_apc_coverage_Args"
            }
          },
          "name": "check_apc_coverage_flow"
        },
        {
          "description": "Step 1 of 2 for transferring a manuscript that received a transfer offer to another journal. The system checks every rule (ownership, transfer offer, editorial hold, target journal open to transfers, word limit) and prices the APC. Returns PROPOSED with an action_id and the quote, or NOT_PROPOSED with the reason. Nothing changes until confirm_transfer is called.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_transfer",
            "handlerDescription": "Step 1 of 2 for transferring a manuscript that received a transfer offer to another journal. The system checks every rule (ownership, transfer offer, editorial hold, target journal open to transfers, word limit) and prices the APC. Returns PROPOSED with an action_id and the quote, or NOT_PROPOSED with the reason. Nothing changes until confirm_transfer is called.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_transfer_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://propose_transfer_Args"
            }
          },
          "name": "propose_transfer_flow"
        },
        {
          "description": "Step 2 of 2: execute a transfer the author has explicitly confirmed. Pass the action_id from propose_transfer. The system re-checks every rule and expires proposals after 15 minutes. Returns EXECUTED or NOT_EXECUTED with the reason. Only call after the author says yes to the exact quote.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_transfer",
            "handlerDescription": "Step 2 of 2: execute a transfer the author has explicitly confirmed. Pass the action_id from propose_transfer. The system re-checks every rule and expires proposals after 15 minutes. Returns EXECUTED or NOT_EXECUTED with the reason. Only call after the author says yes to the exact quote.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:confirm_transfer_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://confirm_transfer_Args"
            }
          },
          "name": "confirm_transfer_flow"
        },
        {
          "description": "Hand a request that needs human judgment to the right team: APC_WAIVER (fee waiver or discount), DECISION_APPEAL (challenge an editorial decision or reviewer), AUTHORSHIP_CHANGE (add/remove/reorder authors), INTEGRITY_QUERY (ethics, data, image or plagiarism concerns) or OTHER. The system routes it and returns CASE_OPENED with case_id, team and reply time. The assistant never decides these requests.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "open_review_case",
            "handlerDescription": "Hand a request that needs human judgment to the right team: APC_WAIVER (fee waiver or discount), DECISION_APPEAL (challenge an editorial decision or reviewer), AUTHORSHIP_CHANGE (add/remove/reorder authors), INTEGRITY_QUERY (ethics, data, image or plagiarism concerns) or OTHER. The system routes it and returns CASE_OPENED with case_id, team and reply time. The assistant never decides these requests.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:open_review_case_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://open_review_case_Args"
            }
          },
          "name": "open_review_case_flow"
        },
        {
          "description": "List the verified author&#39;s open and past review cases with the assigned team and status.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_cases",
            "handlerDescription": "List the verified author's open and past review cases with the assigned team and status.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_cases_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_my_cases_Args"
            }
          },
          "name": "get_my_cases_flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:verify_author_flow",
      "data": {
        "name": "verify_author_flow",
        "description": "Verify the author&#39;s identity with their ORCID iD and the 6-digit verification code sent to their registered email. Returns status VERIFIED with a session_token (valid 60 minutes) and the author&#39;s name, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess verification codes.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GuardedWrite",
            "name": "GuardedWrite",
            "description": "PostgreSQL Insert",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://18e54df6-fdff-40b3-abca-9b276a683793",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO author_sessions (author_id) SELECT a.author_id FROM authors a WHERE a.orcid = trim(CAST(?w_orcid AS text)) AND a.verification_code = trim(CAST(?w_code AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_orcid",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_code",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "02aefc31-a0cb-4e31-8120-ba241e9d80a3INSERT INTO author_sessions (author_id) SELECT a.author_id FROM authors a WHERE a.orcid = trim(CAST(?w_orcid AS text)) AND a.verification_code = trim(CAST(?w_code AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "w_orcid": "=$flow.arguments.orcid",
                      "w_code": "=$flow.arguments.verification_code"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"values\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"parameters\": {\"type\": \"object\", \"properties\": {\"w_orcid\": {\"type\": \"string\"}, \"w_code\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"values\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"parameters\": {\"type\": \"object\", \"properties\": {\"w_orcid\": {\"type\": \"string\"}, \"w_code\": {\"type\": \"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReadOutcome",
            "name": "ReadOutcome",
            "description": "PostgreSQL Query",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://18e54df6-fdff-40b3-abca-9b276a683793",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT * FROM verify_result(CAST(?r_orcid AS text), CAST(?r_code AS text));",
