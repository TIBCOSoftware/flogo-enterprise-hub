{
  "imports": [
    "con_llmprovider github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "con_postgresql github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection",
    "tr_agent github.com/tibco/flogo-ai-agent/src/app/AgenticAI/trigger/agent",
    "github.com/project-flogo/flow",
    "act_default_noop github.com/project-flogo/contrib/activity/noop",
    "act_postgresql_query github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "act_default_actreturn github.com/project-flogo/contrib/activity/actreturn",
    "github.com/project-flogo/contrib/function/coerce"
  ],
  "name": "ParcelDeliveryAgents",
  "description": "Swiftbound Parcel Delivery governed A2A agent - delivery options (read-only)",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "llmProviderConnection": "conn://ea683e57-3332-4739-a38b-7b02b80c2e67",
        "agentName": "delivery_options_agent",
        "agentDescription": "Recommends delivery slots and pickup points for a parcel that needs a new delivery arrangement, from its area/size/constraints and the recipient's preferences. Read-only: it searches available options and ranks them; it cannot reschedule or redirect anything.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"delivery_options_agent_PORT\"]",
        "agentUrl": "=$property[\"delivery_options_agent_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": "0",
        "enableGuardrails": "true",
        "rateLimit": "30",
        "tokenLimit": "6000",
        "redactSensitiveData": "true",
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": "20",
        "systemPrompt": "You recommend delivery options for a parcel that needs a new delivery arrangement. You are given the parcel's\nservice area, size, whether it needs a signature, whether it is high value, the earliest date a slot may be on, and the\nrecipient's free-text preferences. You are never given the recipient's identity.\n\n1. Call the search_delivery_options tool exactly once with area, parcel_size, needs_signature, high_value and after_date.\n2. From the returned options ONLY, rank up to 3 that best match the recipient's stated preferences (e.g. a particular day\n   or time of day, an evening slot, a locker versus a staffed shop, somewhere near a given place). If a preference rules\n   an option out, say so. Never include an option the tool did not return.\n3. For each pick give: its type (delivery slot or pickup point), its id, when or where it is, and one short sentence on\n   why it fits. If the tool returns no options, say clearly there is no available option for this parcel right now.\n\nNever invent slots, pickup points, times or locations. Do not reschedule or redirect - that is confirmed elsewhere.\nReply as a short numbered list."
      },
      "id": "delivery_options_agent",
      "name": "delivery_options_agent",
      "description": "Recommends delivery slots and pickup points for a parcel that needs a new delivery arrangement, from its area/size/constraints and the recipient's preferences. Read-only: it searches available options and ranks them; it cannot reschedule or redirect anything.",
      "ref": "#tr_agent",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "search_delivery_options",
            "agentToolDescription": "Search the feasible delivery options for a parcel in a given service area: available delivery slots and pickup points the parcel can actually use. Pass the service area, the parcel size (SMALL/MEDIUM/LARGE), whether a signature is required (true/false), whether it is high value (true/false) and the earliest date a slot may be on (ISO date or empty). Returns up to 12 options (slots and pickup points). Never pass any recipient-identifying information.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:delivery_options_agent_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "customConversationStoreOpOutput": {}
          },
          "name": "delivery_options_agent_flow",
          "description": "Search the feasible delivery options for a parcel in a given service area: available delivery slots and pickup points the parcel can actually use. Pass the service area, the parcel size (SMALL/MEDIUM/LARGE), whether a signature is required (true/false), whether it is high value (true/false) and the earliest date a slot may be on (ISO date or empty). Returns up to 12 options (slots and pickup points). Never pass any recipient-identifying information.",
          "schemas": {
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"area\": {\n      \"type\": \"string\",\n      \"description\": \"Service area the parcel is going to, e.g. NORTHSIDE\"\n    },\n    \"parcel_size\": {\n      \"type\": \"string\",\n      \"description\": \"SMALL, MEDIUM or LARGE\"\n    },\n    \"needs_signature\": {\n      \"type\": \"string\",\n      \"description\": \"true if the parcel requires a signature, else false\"\n    },\n    \"high_value\": {\n      \"type\": \"string\",\n      \"description\": \"true if the parcel is high value, else false\"\n    },\n    \"after_date\": {\n      \"type\": \"string\",\n      \"description\": \"Earliest date a slot may be on (ISO date), or empty\"\n    }\n  },\n  \"required\": [\n    \"area\",\n    \"parcel_size\"\n  ]\n}",
                "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"area\": {\n      \"type\": \"string\",\n      \"description\": \"Service area the parcel is going to, e.g. NORTHSIDE\"\n    },\n    \"parcel_size\": {\n      \"type\": \"string\",\n      \"description\": \"SMALL, MEDIUM or LARGE\"\n    },\n    \"needs_signature\": {\n      \"type\": \"string\",\n      \"description\": \"true if the parcel requires a signature, else false\"\n    },\n    \"high_value\": {\n      \"type\": \"string\",\n      \"description\": \"true if the parcel is high value, else false\"\n    },\n    \"after_date\": {\n      \"type\": \"string\",\n      \"description\": \"Earliest date a slot may be on (ISO date), or empty\"\n    }\n  },\n  \"required\": [\n    \"area\",\n    \"parcel_size\"\n  ]\n}"
              }
            },
            "reply": {
              "response": {
                "type": "json",
                "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"data\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"data\": {\n      \"type\": \"string\"\n    }\n  }\n}"
              }
            }
          }
        }
      ]
    }
  ],
  "resources": [
    {
