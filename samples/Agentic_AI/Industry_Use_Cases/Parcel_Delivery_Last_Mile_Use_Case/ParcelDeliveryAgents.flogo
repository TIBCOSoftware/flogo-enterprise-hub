          {
            "activity": {
              "input": {
                "Connection": "conn://ec436a96-123d-41e4-9741-d4b1ca3d0784",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT * FROM search_delivery_options(CAST(?area AS text), CAST(?size AS text), CAST(?sig AS text), CAST(?hv AS text), CAST(?aft AS text));",
                "manualmode": false,
