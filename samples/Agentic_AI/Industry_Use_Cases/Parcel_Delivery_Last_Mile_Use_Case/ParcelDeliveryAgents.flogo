                "RuntimeQuery": "",
                "State": "cc8df331-88d1-494b-ad67-9afc09c2fa9eSELECT * FROM search_delivery_options(CAST(?area AS text), CAST(?size AS text), CAST(?sig AS text), CAST(?hv AS text), CAST(?aft AS text));",
                "input": {
