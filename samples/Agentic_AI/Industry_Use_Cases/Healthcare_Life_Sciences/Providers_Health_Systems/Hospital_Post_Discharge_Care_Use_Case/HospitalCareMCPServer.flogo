    {
      "id": "flow:propose_followup_flow",
      "data": {
        "name": "propose_followup_flow",
        "description": "Step 1 of 2 to book a patient&#39;s follow-up visit. Pass the patient_id and a slot_id from get_followup_slots. The system checks that the discharge order asks for a follow-up, that the slot is open, of the right specialty and inside the follow-up window, and returns PROPOSED with a proposal_id and a summary (expires in 15 minutes), or BLOCKED with a reason_code and reason_text. Nothing is booked until confirm_action is called after the coordinator explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GuardedWrite",
            "name": "GuardedWrite",
            "description": "PostgreSQL Insert",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://50c80854-98f9-405a-83fb-13f2f425270f",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO pending_actions (coordinator_id, action_type, target_key, patient_id, slot_id, outcome, reason_code, reason_text, summary) SELECT * FROM propose_followup_fn(CAST(?w_tok AS text), CAST(?w_pid AS text), CAST(?w_slot AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_tok",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_pid",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_slot",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
