        },
        {
          "description": "Open one case from the reviewer&#39;s team queue: request, status, patient (first name + last initial), ward and bed, the coordinator&#39;s statement, the AI-prepared agent_brief (unverified), requested and maximum approvable days&#39; supply, the reviewer&#39;s own approval limit, the facts from Bellmont&#39;s records and the decision options. Another team&#39;s case or an unknown id returns NOT_FOUND.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_review_case",
            "handlerDescription": "Open one case from the reviewer's team queue: request, status, patient (first name + last initial), ward and bed, the coordinator's statement, the AI-prepared agent_brief (unverified), requested and maximum approvable days' supply, the reviewer's own approval limit, the facts from Bellmont's records and the decision options. Another team's case or an unknown id returns NOT_FOUND.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
