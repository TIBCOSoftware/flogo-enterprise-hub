                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_msg",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "7c0ac661-80e3-471b-837c-9ccbaf00ceb9INSERT INTO review_decisions (case_id, reviewer_id, decision, approved_amount, internal_note, customer_message) SELECT * FROM decide_case_row(CAST(?w_tok AS text), CAST(?w_cid AS text), CAST(?w_dec AS text), CAST(?w_amt AS text), CAST(?w_note AS text), CAST(?w_msg AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "w_tok": "=$flow.arguments.session_token",
                      "w_cid": "=$flow.arguments.case_id",
                      "w_dec": "=$flow.arguments.decision",
                      "w_amt": "=$flow.arguments.amount",
                      "w_note": "=$flow.arguments.internal_note",
                      "w_msg": "=$flow.arguments.customer_message"
                    }
                  }
                }
