                "RuntimeQuery": "",
                "State": "8d6daf64-4b23-4188-80b3-144b547c5695INSERT INTO service_cases (case_no, case_id, patient_id, ward_id, opened_by, request_type, summary, reference_id, requested_amount, parked_action, agent_brief, sla_due_at) SELECT * FROM open_case_row(CAST(?w_tok AS text), CAST(?w_type AS text), CAST(?w_pid AS text), CAST(?w_sum AS text), CAST(?w_ref AS text), CAST(?w_brief AS text));",
