            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_followup_slots_Args"
            }
          },
          "name": "get_followup_slots_flow"
        },
        {
          "description": "List a patient&#39;s pharmacy orders: order_id (e.g. RX-000101), medicine, days&#39; supply, pickup location, ready-by time, order status and whether it was released after a pharmacist review. Status NONE = no orders yet.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_pharmacy_orders",
            "handlerDescription": "List a patient's pharmacy orders: order_id (e.g. RX-000101), medicine, days' supply, pickup location, ready-by time, order status and whether it was released after a pharmacist review. Status NONE = no orders yet.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
