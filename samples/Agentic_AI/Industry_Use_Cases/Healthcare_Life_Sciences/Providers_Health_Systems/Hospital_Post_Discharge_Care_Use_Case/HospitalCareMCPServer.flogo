          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_patient_appointments_Args"
            }
          },
          "name": "get_patient_appointments_flow"
        },
        {
          "description": "List the clinic slots that are eligible for a patient&#39;s follow-up visit: only OPEN slots of the specialty the discharge order asks for, inside the follow-up window. Each row: slot_id, weekday, date, time, part_of_day, location, clinician, wheelchair_accessible and transport_available (hospital wheelchair transport). If the patient cannot be booked, status says why (NO_FOLLOWUP_REQUIRED, ALREADY_BOOKED, DISCHARGE_NOT_ORDERED, NOT_FOUND, NONE_AVAILABLE) with a reason_text.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_followup_slots",
            "handlerDescription": "List the clinic slots that are eligible for a patient's follow-up visit: only OPEN slots of the specialty the discharge order asks for, inside the follow-up window. Each row: slot_id, weekday, date, time, part_of_day, location, clinician, wheelchair_accessible and transport_available (hospital wheelchair transport). If the patient cannot be booked, status says why (NO_FOLLOWUP_REQUIRED, ALREADY_BOOKED, DISCHARGE_NOT_ORDERED, NOT_FOUND, NONE_AVAILABLE) with a reason_text.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
