                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"values\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}},\"parameters\":{\"type\":\"object\",\"properties\":{\"w_tok\":{\"type\":\"string\"},\"w_cid\":{\"type\":\"string\"},\"w_dec\":{\"type\":\"string\"},\"w_amt\":{\"type\":\"string\"},\"w_note\":{\"type\":\"string\"},\"w_msg\":{\"type\":\"string\"}}}}}",
