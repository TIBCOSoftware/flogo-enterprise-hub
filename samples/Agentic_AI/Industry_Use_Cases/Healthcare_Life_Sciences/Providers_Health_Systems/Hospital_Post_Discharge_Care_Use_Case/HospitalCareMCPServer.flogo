            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_discharge_summary_Args"
            }
          },
          "name": "get_discharge_summary_flow"
        },
        {
          "description": "List a patient&#39;s appointments and scheduled tests (for example an echocardiogram or a follow-up visit): type, specialty, date and time, weekday, location, clinician and status. Status NONE = nothing scheduled; NOT_FOUND = not a patient on your ward.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_patient_appointments",
            "handlerDescription": "List a patient's appointments and scheduled tests (for example an echocardiogram or a follow-up visit): type, specialty, date and time, weekday, location, clinician and status. Status NONE = nothing scheduled; NOT_FOUND = not a patient on your ward.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_patient_appointments_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
