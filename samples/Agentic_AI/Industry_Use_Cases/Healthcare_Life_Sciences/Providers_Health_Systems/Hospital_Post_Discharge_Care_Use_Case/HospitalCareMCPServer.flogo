    "github.com/tibco/flogo-general/src/app/General/activity/sendmail",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "HospitalCareMCPServer",
  "description": "Bellmont Regional Medical Center post-discharge MCP Server - scoped reads, guarded writes and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Bellmont Regional Medical Center governed MCP server",
      "settings": {
        "serverName": "HospitalCareMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/hospitalcaremcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "HospitalCareMCPServer",
      "handlers": [
        {
          "description": "Verify a Bellmont discharge coordinator with their staff ID (BMC-4101, bmc4101 or 4101 all work) and their one-time code. Returns VERIFIED with a session_token (valid 60 minutes), their name and their ward, VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any coordinator tool. Never reveal, guess or hint at codes. Pharmacists, charge nurses and attendings reviewing cases use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_coordinator",
            "handlerDescription": "Verify a Bellmont discharge coordinator with their staff ID (BMC-4101, bmc4101 or 4101 all work) and their one-time code. Returns VERIFIED with a session_token (valid 60 minutes), their name and their ward, VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any coordinator tool. Never reveal, guess or hint at codes. Pharmacists, charge nurses and attendings reviewing cases use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_coordinator_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://verify_coordinator_Args"
            }
          },
          "name": "verify_coordinator_flow"
        },
        {
          "description": "List the discharges on the verified coordinator&#39;s ward: patient MRN and name, bed, discharge_status (DISCHARGED = has left, ORDERED = discharge order signed but still on the unit, PENDING = no discharge order yet), planned date, time left, the follow-up the order asks for and whether it is booked, how many discharge medicines there are, how many are ordered and how many wait for a pharmacist, and the bed status. Only this ward&#39;s patients are returned.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_ward_discharges",
            "handlerDescription": "List the discharges on the verified coordinator's ward: patient MRN and name, bed, discharge_status (DISCHARGED = has left, ORDERED = discharge order signed but still on the unit, PENDING = no discharge order yet), planned date, time left, the follow-up the order asks for and whether it is booked, how many discharge medicines there are, how many are ordered and how many wait for a pharmacist, and the bed status. Only this ward's patients are returned.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_ward_discharges_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_ward_discharges_Args"
            }
          },
          "name": "get_ward_discharges_flow"
        },
        {
          "description": "Get one patient&#39;s discharge summary on the coordinator&#39;s ward: one row per discharge medicine with the patient, bed, service, attending, discharge_status, follow-up required / specialty / window, isolation, and for each medicine its code, name, high_alert flag, the prescribed instructions (quote them exactly; never change or add to them), days&#39; supply and order_status. A patient on another ward returns NOT_FOUND.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_discharge_summary",
            "handlerDescription": "Get one patient's discharge summary on the coordinator's ward: one row per discharge medicine with the patient, bed, service, attending, discharge_status, follow-up required / specialty / window, isolation, and for each medicine its code, name, high_alert flag, the prescribed instructions (quote them exactly; never change or add to them), days' supply and order_status. A patient on another ward returns NOT_FOUND.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
