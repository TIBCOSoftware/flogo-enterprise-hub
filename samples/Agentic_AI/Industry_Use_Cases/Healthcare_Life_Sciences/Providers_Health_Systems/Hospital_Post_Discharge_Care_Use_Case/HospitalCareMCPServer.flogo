          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_my_cases_Args"
            }
          },
          "name": "get_my_cases_flow"
        },
        {
          "description": "Email a patient on the coordinator&#39;s ward their discharge plan: booked appointments, medicines with pickup and ready times, and medicines still with the pharmacist. The system writes the email from what was actually arranged and sends it only when something has been arranged for that patient (send_status SEND_OK); otherwise NOT_SENT with reason_code NOTHING_TO_SEND, NOT_FOUND or SESSION_INVALID. Quote any reason_text to the person as written; never change an outcome.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "email_patient_summary",
            "handlerDescription": "Email a patient on the coordinator's ward their discharge plan: booked appointments, medicines with pickup and ready times, and medicines still with the pharmacist. The system writes the email from what was actually arranged and sends it only when something has been arranged for that patient (send_status SEND_OK); otherwise NOT_SENT with reason_code NOTHING_TO_SEND, NOT_FOUND or SESSION_INVALID. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
