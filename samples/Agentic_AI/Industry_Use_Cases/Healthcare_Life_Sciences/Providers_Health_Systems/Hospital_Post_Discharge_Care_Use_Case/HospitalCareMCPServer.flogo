            },
            "output": {
              "arguments": "schema://get_pharmacy_orders_Args"
            }
          },
          "name": "get_pharmacy_orders_flow"
        },
        {
          "description": "List the beds on the coordinator&#39;s ward: bed_id (e.g. 4A-10), bed status (OCCUPIED, AVAILABLE, CLEANING_REQUESTED, CLEANING_IN_PROGRESS), the patient in it and their discharge status, and the estimated ready time when housekeeping has it.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_ward_beds",
            "handlerDescription": "List the beds on the coordinator's ward: bed_id (e.g. 4A-10), bed status (OCCUPIED, AVAILABLE, CLEANING_REQUESTED, CLEANING_IN_PROGRESS), the patient in it and their discharge status, and the estimated ready time when housekeeping has it.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
