              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_review_case_Args"
            }
          },
          "name": "get_review_case_flow"
        },
        {
          "description": "Record the reviewer&#39;s decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved days&#39; supply (high-alert medicine cases; empty = the full prescribed supply; ignored for REJECT and for cases without a supply); internal_note is required (at least 5 characters, never shown to the coordinator); customer_message is what the coordinator will see. Approving runs the parked action (dispense the medicine, or send the bed to housekeeping) through the system&#39;s checks. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior pharmacist) or NOT_FOUND, or NOT_REVIEWER. Quote any reason_text to the person as written; never change an outcome.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "decide_review_case",
            "handlerDescription": "Record the reviewer's decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved days' supply (high-alert medicine cases; empty = the full prescribed supply; ignored for REJECT and for cases without a supply); internal_note is required (at least 5 characters, never shown to the coordinator); customer_message is what the coordinator will see. Approving runs the parked action (dispense the medicine, or send the bed to housekeeping) through the system's checks. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior pharmacist) or NOT_FOUND, or NOT_REVIEWER. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
