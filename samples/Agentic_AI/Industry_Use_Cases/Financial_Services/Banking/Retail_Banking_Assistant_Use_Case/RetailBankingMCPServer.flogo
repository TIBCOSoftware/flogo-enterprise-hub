            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://email_my_confirmation_Args"
            }
          },
          "name": "email_my_confirmation_flow"
        },
        {
          "description": "List the verified customer&#39;s saved payees: payee_id, name, bank, masked account, payee_type (PERSON, BUSINESS, INVESTMENT_PLATFORM, CRYPTO_EXCHANGE), date added, date last paid and is_new_payee (never paid and added in the last 30 days). Payments go only to these payees; new payees are added in the Kestrel app.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_payees",
            "handlerDescription": "List the verified customer's saved payees: payee_id, name, bank, masked account, payee_type (PERSON, BUSINESS, INVESTMENT_PLATFORM, CRYPTO_EXCHANGE), date added, date last paid and is_new_payee (never paid and added in the last 30 days). Payments go only to these payees; new payees are added in the Kestrel app.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
