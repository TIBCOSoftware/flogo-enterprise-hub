          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://propose_payment_Args"
            }
          },
          "name": "propose_payment_flow"
        },
        {
          "description": "Step 2 of 2: send a payment the customer has explicitly confirmed. Pass the payment_id from propose_payment and acknowledge_warning YES only when the proposal was PROPOSED_WITH_WARNING and the customer said they read the warning and still want to go ahead (otherwise NO). The system re-checks every rule; proposals expire after 15 minutes. Returns SENT with the payment details, or NOT_SENT with reason_code NO_SUCH_PAYMENT, HELD_FOR_REVIEW, CANCELLED, EXPIRED, WARNING_NOT_ACKNOWLEDGED, ALREADY_SENT, SESSION_INVALID or a rule&#39;s code. Only call after the customer says yes to the exact proposal.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_payment",
            "handlerDescription": "Step 2 of 2: send a payment the customer has explicitly confirmed. Pass the payment_id from propose_payment and acknowledge_warning YES only when the proposal was PROPOSED_WITH_WARNING and the customer said they read the warning and still want to go ahead (otherwise NO). The system re-checks every rule; proposals expire after 15 minutes. Returns SENT with the payment details, or NOT_SENT with reason_code NO_SUCH_PAYMENT, HELD_FOR_REVIEW, CANCELLED, EXPIRED, WARNING_NOT_ACKNOWLEDGED, ALREADY_SENT, SESSION_INVALID or a rule's code. Only call after the customer says yes to the exact proposal.",
            "toolTitle": "",
