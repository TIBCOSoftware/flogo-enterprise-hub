{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-general/src/app/General/activity/sendmail",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "RetailBankingMCPServer",
  "description": "Kestrel Bank Retail Banking Assistant MCP Server - scoped reads, guarded writes, scam-protected payments and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Kestrel Bank Retail Banking governed MCP server",
      "settings": {
        "serverName": "RetailBanking",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/retail-banking-mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "RetailBankingMCPServer",
      "handlers": [
        {
          "description": "Verify the customer&#39;s identity with their Kestrel Bank customer id (e.g. CUST-2026-00101) and the 6-digit passcode from their Kestrel app. Returns VERIFIED with a session_token (valid 30 minutes) and their name, NOT_VERIFIED when the id and passcode do not match, or LOCKED after 5 failed attempts in 15 minutes (no token is issued while locked, even with the right passcode; offer account recovery only). Call this before any other customer tool. Never reveal, hint at or guess passcodes. Kestrel staff use verify_reviewer instead.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_customer",
            "handlerDescription": "Verify the customer's identity with their Kestrel Bank customer id (e.g. CUST-2026-00101) and the 6-digit passcode from their Kestrel app. Returns VERIFIED with a session_token (valid 30 minutes) and their name, NOT_VERIFIED when the id and passcode do not match, or LOCKED after 5 failed attempts in 15 minutes (no token is issued while locked, even with the right passcode; offer account recovery only). Call this before any other customer tool. Never reveal, hint at or guess passcodes. Kestrel staff use verify_reviewer instead.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_customer_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://verify_customer_Args"
            }
          },
          "name": "verify_customer_flow"
        },
        {
          "description": "List the verified customer&#39;s own accounts: account id, masked number, type (CHECKING, SAVINGS, CREDIT), balance, available balance, currency and status. Only this customer&#39;s accounts are returned. Quote figures exactly as returned; never compute or estimate balances.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_accounts",
            "handlerDescription": "List the verified customer's own accounts: account id, masked number, type (CHECKING, SAVINGS, CREDIT), balance, available balance, currency and status. Only this customer's accounts are returned. Quote figures exactly as returned; never compute or estimate balances.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_accounts_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_my_accounts_Args"
            }
          },
          "name": "get_my_accounts_flow"
        },
        {
          "description": "List the verified customer&#39;s own transactions, newest first, at most 25. Pass an empty search for everything in the last 120 days, or a search term to filter: part of the statement descriptor or merchant text (e.g. QUICKPAY, LUXEJET), a category, an amount (e.g. 249.99) or a transaction id. Each row has transaction_id, date, descriptor, amount, DEBIT/CREDIT, POSTED/PENDING and any open dispute id. Returns NO_MATCH when nothing matches. Use the transaction_id from here for propose_dispute; never invent one.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_transactions",
            "handlerDescription": "List the verified customer's own transactions, newest first, at most 25. Pass an empty search for everything in the last 120 days, or a search term to filter: part of the statement descriptor or merchant text (e.g. QUICKPAY, LUXEJET), a category, an amount (e.g. 249.99) or a transaction id. Each row has transaction_id, date, descriptor, amount, DEBIT/CREDIT, POSTED/PENDING and any open dispute id. Returns NO_MATCH when nothing matches. Use the transaction_id from here for propose_dispute; never invent one.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_transactions_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_my_transactions_Args"
            }
          },
          "name": "get_my_transactions_flow"
        },
        {
          "description": "List the verified customer&#39;s own cards: card_id, last 4 digits, DEBIT/CREDIT, network, status (ACTIVE, BLOCKED, EXPIRED), expiry, credit limit and, for a blocked card, the replacement&#39;s expected delivery date. Only this customer&#39;s cards are returned.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_cards",
            "handlerDescription": "List the verified customer's own cards: card_id, last 4 digits, DEBIT/CREDIT, network, status (ACTIVE, BLOCKED, EXPIRED), expiry, credit limit and, for a blocked card, the replacement's expected delivery date. Only this customer's cards are returned.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
