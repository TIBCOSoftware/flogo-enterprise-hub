            "output": {
              "arguments": "schema://get_my_payees_Args"
            }
          },
          "name": "get_my_payees_flow"
        },
        {
          "description": "Step 1 of 2 for paying a saved payee from the customer&#39;s own checking or savings account. Pass the from-account (account_id), the payee (payee_id), the amount in dollars, the customer&#39;s own words about the payment, and the scam_signal_agent&#39;s indicators, narrative_score and full answer exactly as it returned them. The system checks the rules, combines the agent&#39;s signals with its own checks and returns PROPOSED (ask for an explicit yes), PROPOSED_WITH_WARNING (read warning_text word for word first), HELD_FOR_REVIEW (nothing sent; a fraud specialist reviews it - give the case_id and reply date), or NOT_PROPOSED with reason_code ACCOUNT_NOT_FOUND, PAYEE_NOT_FOUND, BAD_AMOUNT, INSUFFICIENT_FUNDS, OVER_DAILY_LIMIT or SESSION_INVALID. Nothing is sent until confirm_payment.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_payment",
            "handlerDescription": "Step 1 of 2 for paying a saved payee from the customer's own checking or savings account. Pass the from-account (account_id), the payee (payee_id), the amount in dollars, the customer's own words about the payment, and the scam_signal_agent's indicators, narrative_score and full answer exactly as it returned them. The system checks the rules, combines the agent's signals with its own checks and returns PROPOSED (ask for an explicit yes), PROPOSED_WITH_WARNING (read warning_text word for word first), HELD_FOR_REVIEW (nothing sent; a fraud specialist reviews it - give the case_id and reply date), or NOT_PROPOSED with reason_code ACCOUNT_NOT_FOUND, PAYEE_NOT_FOUND, BAD_AMOUNT, INSUFFICIENT_FUNDS, OVER_DAILY_LIMIT or SESSION_INVALID. Nothing is sent until confirm_payment.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_payment_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
