    {
      "id": "flow:email_my_confirmation_flow",
      "data": {
        "name": "email_my_confirmation_flow",
        "description": "Email the confirmation for a dispute (DSP-...), card block (BLK-...), decided case (CASE-...) or sent payment (PAY-...) of this customer. Pass the reference from confirm_dispute, confirm_card_block, confirm_payment or get_my_cases. The system sends the email only when that reference belongs to this session&#39;s customer (and a case only once a person has decided it); otherwise it returns NOT_SENT with reason_code NO_SUCH_REFERENCE or SESSION_INVALID.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "SendMail",
            "type": "expression",
            "label": "send_status is SEND",
            "value": "$activity[ReadOutcome].Output.records[0].send_status == \"SEND\""
          },
          {
            "id": 4,
            "from": "SendMail",
            "to": "Return",
            "type": "label",
            "label": "SendMail to Return"
          },
          {
            "id": 5,
            "from": "ReadOutcome",
            "to": "ReturnNotSent",
            "type": "exprOtherwise",
            "label": "otherwise (NOT_SENT)"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GuardedWrite",
            "name": "GuardedWrite",
            "description": "PostgreSQL Insert",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://f2bd43ec-5125-4313-bc15-b0cf123b6171",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO email_log (customer_id, reference_id, subject) SELECT * FROM email_log_row(CAST(?w_tok AS text), CAST(?w_ref AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_tok",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
