                "State": "116b52bd-7191-4b2c-8297-df3458a4dd1fINSERT INTO payment_requests (customer_id, account_id, payee_id, amount, customer_story, agent_notes, narrative_indicators, ignored_indicators, narrative_score, signals, risk_points, risk_band, status, warning_required) SELECT * FROM payment_request_row(CAST(?w_tok AS text), CAST(?w_acct AS text), CAST(?w_payee AS text), CAST(?w_amt AS text), CAST(?w_story AS text), CAST(?w_ind AS text), CAST(?w_score AS text), CAST(?w_notes AS text));",
