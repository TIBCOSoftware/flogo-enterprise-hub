          "name": "get_review_case_flow"
        },
        {
          "description": "Record the reviewer&#39;s decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved amount in dollars (empty = the full eligible amount; ignored for REJECT); internal_note is required (at least 5 characters, never shown to the customer); customer_message is what the customer will see. Approving runs the parked action (fee refund, loan payment deferral or release of a held payment) through the system&#39;s checks; rejecting a held payment cancels it. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior reviewer), INVALID_DECISION or NOT_FOUND, or NOT_REVIEWER.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "decide_review_case",
            "handlerDescription": "Record the reviewer's decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved amount in dollars (empty = the full eligible amount; ignored for REJECT); internal_note is required (at least 5 characters, never shown to the customer); customer_message is what the customer will see. Approving runs the parked action (fee refund, loan payment deferral or release of a held payment) through the system's checks; rejecting a held payment cancels it. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior reviewer), INVALID_DECISION or NOT_FOUND, or NOT_REVIEWER.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
