            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ReadOutcome",
            "name": "ReadOutcome",
            "description": "PostgreSQL Query",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://f2bd43ec-5125-4313-bc15-b0cf123b6171",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT * FROM my_accounts(CAST(?tok AS text));",
                "manualmode": false,
                "fetchMetadata": false,
                "Fields": [
