    {
      "id": "flow:propose_dispute_flow",
      "data": {
        "name": "propose_dispute_flow",
        "description": "Step 1 of 2 for disputing a card or account charge. Give the transaction_id (from get_my_transactions), the reason_code (UNRECOGNISED, FRAUD, DUPLICATE, NOT_RECEIVED, NOT_AS_DESCRIBED, CANCELLED_RECURRING or WRONG_AMOUNT) and the customer&#39;s own words. The system checks eligibility and computes the quote: returns PROPOSED with action_id, amount, merchant, provisional_credit, fraud_review and est_decision_date, or NOT_PROPOSED with reason_code NOT_YOUR_TRANSACTION, NOT_A_DEBIT, PENDING_NOT_POSTED, OUTSIDE_WINDOW (older than 120 days), ALREADY_DISPUTED, BAD_REASON, NOT_DUPLICATE or SESSION_INVALID. Read the amount, provisional credit and decision date back exactly as returned; never compute or promise them yourself. Nothing is filed until confirm_dispute.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
