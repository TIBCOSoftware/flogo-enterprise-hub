        },
        {
          "description": "Email the confirmation for a dispute (DSP-...), card block (BLK-...), decided case (CASE-...) or sent payment (PAY-...) of this customer. Pass the reference from confirm_dispute, confirm_card_block, confirm_payment or get_my_cases. The system sends the email only when that reference belongs to this session&#39;s customer (and a case only once a person has decided it); otherwise it returns NOT_SENT with reason_code NO_SUCH_REFERENCE or SESSION_INVALID.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "email_my_confirmation",
            "handlerDescription": "Email the confirmation for a dispute (DSP-...), card block (BLK-...), decided case (CASE-...) or sent payment (PAY-...) of this customer. Pass the reference from confirm_dispute, confirm_card_block, confirm_payment or get_my_cases. The system sends the email only when that reference belongs to this session's customer (and a case only once a person has decided it); otherwise it returns NOT_SENT with reason_code NO_SUCH_REFERENCE or SESSION_INVALID.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
