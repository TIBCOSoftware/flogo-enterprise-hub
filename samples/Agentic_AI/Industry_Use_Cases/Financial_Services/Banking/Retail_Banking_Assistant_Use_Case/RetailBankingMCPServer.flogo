                  }
                ],
                "RuntimeQuery": "",
                "State": "5b72e48e-b1de-4723-8cc3-ccb7f8f8e43cINSERT INTO email_log (customer_id, reference_id, subject) SELECT * FROM email_log_row(CAST(?w_tok AS text), CAST(?w_ref AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "w_tok": "=$flow.arguments.session_token",
