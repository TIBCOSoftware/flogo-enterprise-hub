                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"r_sub\":{\"type\":\"string\"},\"r_ref\":{\"type\":\"string\"}}}}}"
