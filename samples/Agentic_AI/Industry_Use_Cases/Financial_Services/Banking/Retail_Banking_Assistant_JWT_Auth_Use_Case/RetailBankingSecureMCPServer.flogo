    {
      "id": "flow:email_my_confirmation_flow",
      "data": {
        "name": "email_my_confirmation_flow",
        "description": "Email the confirmation for a dispute (DSP-...), card block (BLK-...), decided case (CASE-...) or sent payment (PAY-...) of this customer. Pass the reference from confirm_dispute, confirm_card_block, confirm_payment or get_my_cases. The system sends the email only when that reference belongs to the signed-in customer (and a case only once a person has decided it); otherwise it returns NOT_SENT with reason_code NO_SUCH_REFERENCE or UNKNOWN_CALLER.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "SendMail",
            "type": "expression",
            "label": "send_status is SEND",
            "value": "$activity[ReadOutcome].Output.records[0].send_status == \"SEND\""
          },
          {
            "id": 4,
            "from": "SendMail",
            "to": "Return",
            "type": "label",
            "label": "SendMail to Return"
          },
          {
            "id": 5,
            "from": "ReadOutcome",
            "to": "ReturnNotSent",
            "type": "exprOtherwise",
            "label": "otherwise (NOT_SENT)"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GuardedWrite",
            "name": "GuardedWrite",
            "description": "PostgreSQL Insert",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://f2bd43ec-5125-4313-bc15-b0cf123b6171",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO email_log (customer_id, reference_id, subject) SELECT * FROM email_log_row(CAST(?w_sub AS text), CAST(?w_ref AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_sub",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_ref",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "d4782588-56b8-4b04-b546-f45b1fb91afcINSERT INTO email_log (customer_id, reference_id, subject) SELECT * FROM email_log_row(CAST(?w_sub AS text), CAST(?w_ref AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "w_sub": "=$flow.tokenInfo.sub",
                      "w_ref": "=$flow.arguments.reference_id"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"values\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}},\"parameters\":{\"type\":\"object\",\"properties\":{\"w_sub\":{\"type\":\"string\"},\"w_ref\":{\"type\":\"string\"}}}}}",
