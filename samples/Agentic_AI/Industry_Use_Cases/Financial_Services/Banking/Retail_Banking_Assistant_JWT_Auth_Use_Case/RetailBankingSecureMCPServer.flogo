                "value": "{\"request_type\":{\"type\":\"string\",\"description\":\"FEE_REFUND | LOAN_HARDSHIP | CREDIT_LIMIT_INCREASE | COMPLAINT | PERSONAL_DETAILS_CHANGE | ACCOUNT_CLOSURE | BEREAVEMENT | FRAUD_REVIEW | OTHER\"},\"customer_statement\":{\"type\":\"string\",\"description\":\"The customer's request in their own words\"},\"brief\":{\"type\":\"string\",\"description\":\"A neutral summary for the team (facts only, no recommendation); for LOAN_HARDSHIP the hardship intake brief\"},\"reference_id\":{\"type\":\"string\",\"description\":\"FEE_REFUND: the fee's transaction_id; LOAN_HARDSHIP: the loan_id; otherwise empty\"}}"
              }
            },
