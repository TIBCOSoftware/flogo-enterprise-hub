                "Query": "INSERT INTO pending_actions (action_type, customer_id, transaction_id, reason_code, customer_statement, amount, provisional_credit, fraud_review) SELECT * FROM dispute_proposal_row(CAST(?w_sub AS text), CAST(?w_txn AS text), CAST(?w_rsn AS text), CAST(?w_stmt AS text));",
                "manualmode": false,
