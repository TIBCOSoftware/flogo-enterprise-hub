    {
      "id": "flow:get_my_transactions_flow",
      "data": {
        "name": "get_my_transactions_flow",
        "description": "List the signed-in customer&#39;s own transactions, newest first, at most 25. Pass an empty search for everything in the last 120 days, or a search term to filter: part of the statement descriptor or merchant text (e.g. QUICKPAY, LUXEJET), a category, an amount (e.g. 249.99) or a transaction id. Each row has transaction_id, date, descriptor, amount, DEBIT/CREDIT, POSTED/PENDING and any open dispute id. Returns NO_MATCH when nothing matches. Use the transaction_id from here for propose_dispute; never invent one.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadOutcome",
            "type": "label",
            "label": "StartActivity to ReadOutcome"
          },
          {
            "id": 2,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ReadOutcome",
            "name": "ReadOutcome",
            "description": "PostgreSQL Query",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://f2bd43ec-5125-4313-bc15-b0cf123b6171",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT * FROM my_transactions(CAST(?sub AS text), CAST(?q AS text));",
                "manualmode": false,
                "fetchMetadata": false,
                "Fields": [
                  {
                    "FieldName": "sub",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "q",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "caller_status",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
