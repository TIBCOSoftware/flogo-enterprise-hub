    {
      "id": "flow:confirm_dispute_flow",
      "data": {
        "name": "confirm_dispute_flow",
        "description": "Step 2 of 2: file the dispute the customer has explicitly confirmed. Pass the action_id from propose_dispute. The system re-checks every rule; proposals expire after 15 minutes. Returns FILED with dispute_id (DSP-2026-NNNN), the provisional credit posted (if any), whether Fraud Operations opened a review case, and the decision date; or NOT_FILED with reason_code NO_SUCH_PROPOSAL, EXPIRED, ALREADY_EXECUTED, UNKNOWN_CALLER or a rule&#39;s code. Only call after the customer says yes to the exact proposal.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GuardedWrite",
            "name": "GuardedWrite",
            "description": "PostgreSQL Insert",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://f2bd43ec-5125-4313-bc15-b0cf123b6171",
