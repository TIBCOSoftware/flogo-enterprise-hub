                "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n      }\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"iss\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"sub\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"aud\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n        }\r\n    },\r\n    \"name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"email\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"given_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"family_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"preferred_username\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n      }\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"iss\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"sub\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"aud\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n        }\r\n    },\r\n    \"name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"email\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"given_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"family_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"preferred_username\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            }
          },
          "name": "get_review_case_flow"
        },
        {
          "description": "Record the reviewer&#39;s decision on a case in their team queue, in two steps. decision is APPROVE or REJECT; amount is the approved amount in dollars (empty = the full eligible amount; ignored for REJECT); internal_note is required (at least 5 characters, never shown to the customer); customer_message is what the customer will see. A valid first call records NOTHING and returns CONFIRM_REQUIRED with the decision, amount and customer_message to read back: ask the reviewer to confirm, and only after they do, call it again with the same decision and amount (within 15 minutes). That call runs the parked action (fee refund, loan payment deferral or release of a held payment) through the system&#39;s checks; rejecting a held payment cancels it. Returns CONFIRM_REQUIRED, APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior reviewer), ACTION_NOT_EXECUTABLE (the approved action cannot run now, e.g. the balance no longer covers a held payment or it would go over the daily limit; the case stays open), INVALID_DECISION or NOT_FOUND, or NOT_REVIEWER (the signed-in user is not an active staff reviewer).",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "decide_review_case",
            "handlerDescription": "Record the reviewer's decision on a case in their team queue, in two steps. decision is APPROVE or REJECT; amount is the approved amount in dollars (empty = the full eligible amount; ignored for REJECT); internal_note is required (at least 5 characters, never shown to the customer); customer_message is what the customer will see. A valid first call records NOTHING and returns CONFIRM_REQUIRED with the decision, amount and customer_message to read back: ask the reviewer to confirm, and only after they do, call it again with the same decision and amount (within 15 minutes). That call runs the parked action (fee refund, loan payment deferral or release of a held payment) through the system's checks; rejecting a held payment cancels it. Returns CONFIRM_REQUIRED, APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior reviewer), ACTION_NOT_EXECUTABLE (the approved action cannot run now, e.g. the balance no longer covers a held payment or it would go over the daily limit; the case stays open), INVALID_DECISION or NOT_FOUND, or NOT_REVIEWER (the signed-in user is not an active staff reviewer).",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": "reviews:decide"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:decide_review_case_flow"
            },
            "input": {
              "arguments": "=$.arguments",
              "tokenInfo": "=$.tokenInfo"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://decide_review_case_Args",
              "tokenInfo": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n      }\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"iss\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"sub\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"aud\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n        }\r\n    },\r\n    \"name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"email\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"given_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"family_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"preferred_username\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n      }\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"iss\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"sub\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"aud\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n        }\r\n    },\r\n    \"name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"email\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"given_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"family_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"preferred_username\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
