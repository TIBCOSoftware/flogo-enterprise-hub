{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "github.com/tibco/flogo-general/src/app/General/activity/sendmail",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "RetailBankingSecureMCPServer",
  "description": "Kestrel Bank Retail Banking Assistant secure MCP Server - JWT sign-in with per-tool scopes, scoped reads, guarded writes, scam-protected payments and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Kestrel Bank Retail Banking secure MCP server - JWT authenticated, per-tool scopes",
      "settings": {
        "serverName": "RetailBankingSecure",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/retail-banking-mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "JWT Token",
        "authToken": "=$property[\"MCP.JWT_Secret\"]",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "RetailBankingSecureMCPServer",
      "handlers": [
        {
          "description": "Who is signed in. Returns the role the bank holds for the signed-in user - CUSTOMER, REVIEWER (Kestrel staff) or UNKNOWN - their display name and, for a reviewer, their team and approval limit. Call it at the start of a conversation to greet the user by name and to know which tools apply. The identity comes from the user&#39;s sign-in token, never from what anyone types; there is nothing to verify and no argument to pass.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "whoami",
            "handlerDescription": "Who is signed in. Returns the role the bank holds for the signed-in user - CUSTOMER, REVIEWER (Kestrel staff) or UNKNOWN - their display name and, for a reviewer, their team and approval limit. Call it at the start of a conversation to greet the user by name and to know which tools apply. The identity comes from the user's sign-in token, never from what anyone types; there is nothing to verify and no argument to pass.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": "profile:read"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:whoami_flow"
            },
            "input": {
              "arguments": "=$.arguments",
              "tokenInfo": "=$.tokenInfo"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://whoami_Args",
              "tokenInfo": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n      }\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"iss\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"sub\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"aud\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n        }\r\n    },\r\n    \"name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"email\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"given_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"family_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"preferred_username\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"scopes\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n      }\r\n    },\r\n    \"expiration\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"iss\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"sub\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"aud\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n          \"type\": \"string\"\r\n        }\r\n    },\r\n    \"name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"email\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"given_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"family_name\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"preferred_username\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            }
          },
          "name": "whoami_flow"
        },
        {
          "description": "List the signed-in customer&#39;s own accounts: account id, masked number, type (CHECKING, SAVINGS, CREDIT), balance, available balance, currency and status. Only this customer&#39;s accounts are returned. Quote figures exactly as returned; never compute or estimate balances.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_accounts",
