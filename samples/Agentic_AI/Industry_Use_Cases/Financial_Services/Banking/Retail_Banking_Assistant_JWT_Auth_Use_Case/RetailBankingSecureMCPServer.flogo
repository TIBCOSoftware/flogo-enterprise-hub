    {
      "id": "flow:decide_review_case_flow",
      "data": {
        "name": "decide_review_case_flow",
        "description": "Record the reviewer&#39;s decision on a case in their team queue, in two steps. decision is APPROVE or REJECT; amount is the approved amount in dollars (empty = the full eligible amount; ignored for REJECT); internal_note is required (at least 5 characters, never shown to the customer); customer_message is what the customer will see. A valid first call records NOTHING and returns CONFIRM_REQUIRED with the decision, amount and customer_message to read back: ask the reviewer to confirm, and only after they do, call it again with the same decision and amount (within 15 minutes). That call runs the parked action (fee refund, loan payment deferral or release of a held payment) through the system&#39;s checks; rejecting a held payment cancels it. Returns CONFIRM_REQUIRED, APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior reviewer), ACTION_NOT_EXECUTABLE (the approved action cannot run now, e.g. the balance no longer covers a held payment or it would go over the daily limit; the case stays open), INVALID_DECISION or NOT_FOUND, or NOT_REVIEWER (the signed-in user is not an active staff reviewer).",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GuardedWrite",
            "name": "GuardedWrite",
            "description": "PostgreSQL Insert",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://f2bd43ec-5125-4313-bc15-b0cf123b6171",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO review_decisions (case_id, reviewer_id, decision, approved_amount, internal_note, customer_message) SELECT * FROM decide_case_row(CAST(?w_sub AS text), CAST(?w_cid AS text), CAST(?w_dec AS text), CAST(?w_amt AS text), CAST(?w_note AS text), CAST(?w_msg AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_sub",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
