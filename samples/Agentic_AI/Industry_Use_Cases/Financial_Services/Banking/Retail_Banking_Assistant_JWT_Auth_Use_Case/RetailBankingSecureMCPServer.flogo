            "input": "{\"type\": \"object\", \"title\": \"RetailBankingSecureMCPServer\", \"properties\": {\"arguments\": {\"type\": \"object\", \"properties\": {\"request_type\": {\"type\": \"string\", \"description\": \"FEE_REFUND | LOAN_HARDSHIP | CREDIT_LIMIT_INCREASE | COMPLAINT | PERSONAL_DETAILS_CHANGE | ACCOUNT_CLOSURE | BEREAVEMENT | FRAUD_REVIEW | OTHER\"}, \"customer_statement\": {\"type\": \"string\", \"description\": \"The customer's request in their own words\"}, \"brief\": {\"type\": \"string\", \"description\": \"A neutral summary for the team (facts only, no recommendation); for LOAN_HARDSHIP the hardship intake brief\"}, \"reference_id\": {\"type\": \"string\", \"description\": \"FEE_REFUND: the fee's transaction_id; LOAN_HARDSHIP: the loan_id; otherwise empty\"}}, \"required\": [\"request_type\", \"customer_statement\", \"brief\", \"reference_id\"]}, \"tokenInfo\": {\"type\": \"object\", \"properties\": {\"scopes\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"expiration\": {\"type\": \"number\"}, \"iss\": {\"type\": \"string\"}, \"sub\": {\"type\": \"string\"}, \"aud\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"name\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}}}}}",
