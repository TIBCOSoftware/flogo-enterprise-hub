    {
      "id": "flow:email_my_confirmation_flow",
      "data": {
        "name": "email_my_confirmation_flow",
        "description": "Email the confirmation for an investigation (INV-...), review case (CASE-...), posted cash application (CAP-...) or a payment submitted through the assistant (PMT-... from confirm_payment) of this client. The system sends the email only when that reference belongs to this session&#39;s client; otherwise it returns NOT_SENT with reason_code NO_SUCH_REFERENCE or SESSION_INVALID. Call only when the client asks.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "SendMail",
            "type": "expression",
            "label": "send_status is SEND",
            "value": "$activity[ReadOutcome].Output.records[0].send_status == \"SEND\""
          },
          {
            "id": 4,
            "from": "SendMail",
            "to": "Return",
            "type": "label",
            "label": "SendMail to Return"
          },
          {
            "id": 5,
            "from": "ReadOutcome",
            "to": "ReturnNotSent",
            "type": "exprOtherwise",
            "label": "otherwise (NOT_SENT)"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
