    {
      "id": "flow:confirm_payment_flow",
      "data": {
        "name": "confirm_payment_flow",
        "description": "Step 2 of 2: submit a payment the client has explicitly confirmed. Pass the request_id from propose_payment and acknowledge_warning YES only when the proposal was PROPOSED_WITH_WARNING and the client said they checked the payee and still want to go ahead (otherwise NO). The system re-checks every rule; proposals expire after 15 minutes. Returns SENT with the new payment_ref and value date, or NOT_SENT with reason_code NO_SUCH_REQUEST, HELD_FOR_REVIEW, CANCELLED, EXPIRED, WARNING_NOT_ACKNOWLEDGED, ALREADY_SENT, SESSION_INVALID or a rule&#39;s code. Only call after the client says yes to the exact proposal.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
