    {
      "id": "flow:propose_payment_flow",
      "data": {
        "name": "propose_payment_flow",
        "description": "Step 1 of 2 for a new payment to a beneficiary account. Pass the from-account (its currency such as USD, its last 4 digits or its account_id), the beneficiary account, the name the client gave, the amount, the client&#39;s own words about the payment, and payee_name_match_agent&#39;s verdict, reasons and full answer exactly as it returned them. The system checks the rules, combines the agent&#39;s verdict with its own name check and returns PROPOSED (ask for an explicit yes), PROPOSED_WITH_WARNING (read warning_text word for word first), HELD_FOR_REVIEW (nothing sent; Payment Operations verifies the payee - give the case_id and reply date), or NOT_PROPOSED with reason_code ACCOUNT_NOT_FOUND, BENEFICIARY_NOT_FOUND, NAME_REQUIRED, CURRENCY_MISMATCH, BAD_AMOUNT, OVER_CHANNEL_LIMIT or SESSION_INVALID. Nothing is sent until confirm_payment.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Connection": "conn://57668758-6dc9-4302-aba7-2948cabdee19",
