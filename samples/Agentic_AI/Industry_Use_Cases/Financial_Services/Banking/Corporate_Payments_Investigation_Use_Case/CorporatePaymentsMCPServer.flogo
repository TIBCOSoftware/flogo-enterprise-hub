            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_cases_flow",
          "description": "List the verified client's investigations (INV-) and review cases (CASE-) with type, status (OPEN, APPROVED or REJECTED for review cases), the related payment, the assigned team, the expected response or reply date and - once a person has decided - the approved amount and the customer_message from the team. Use it when the client asks about the status of a trace, a recall, a held payment, a deduction or a fee waiver.",
          "schemas": {
