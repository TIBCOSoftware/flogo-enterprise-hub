            "input": "{\"type\": \"object\", \"title\": \"CorporatePaymentsMCPServer\", \"properties\": {\"arguments\": {\"type\": \"object\", \"properties\": {\"session_token\": {\"type\": \"string\", \"description\": \"Session token returned by verify_client. Required; never invent a session token. If a tool answers SESSION_INVALID, ask the client to verify again.\"}, \"from_account\": {\"type\": \"string\", \"description\": \"The client's account to pay from: currency (USD), last 4 digits or account_id\"}, \"beneficiary_account\": {\"type\": \"string\", \"description\": \"The beneficiary account number from check_payee_account\"}, \"typed_name\": {\"type\": \"string\", \"description\": \"The beneficiary name the client gave\"}, \"amount\": {\"type\": \"string\", \"description\": \"Amount in the account currency, e.g. 185000.00\"}, \"purpose\": {\"type\": \"string\", \"description\": \"The client's own words about what the payment is for\"}, \"name_verdict\": {\"type\": \"string\", \"description\": \"The verdict from payee_name_match_agent, exactly as returned: MATCH, CLOSE_MATCH or NO_MATCH\"}, \"name_reasons\": {\"type\": \"string\", \"description\": \"The reasons line from payee_name_match_agent, exactly as returned\"}, \"agent_notes\": {\"type\": \"string\", \"description\": \"payee_name_match_agent's full answer, unchanged\"}}, \"required\": [\"session_token\", \"from_account\", \"beneficiary_account\", \"typed_name\", \"amount\", \"purpose\", \"name_verdict\", \"name_reasons\", \"agent_notes\"]}}}",
            "output": "{\"type\": \"object\", \"title\": \"Inputs\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}, \"required\": [\"response\"]}"
          }
        }
