    "propose_payment_Args": {
      "type": "json",
      "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"session_token\": {\n      \"type\": \"string\",\n      \"description\": \"Session token returned by verify_client. Required; never invent a session token. If a tool answers SESSION_INVALID, ask the client to verify again.\"\n    },\n    \"from_account\": {\n      \"type\": \"string\",\n      \"description\": \"The client's account to pay from: currency (USD), last 4 digits or account_id\"\n    },\n    \"beneficiary_account\": {\n      \"type\": \"string\",\n      \"description\": \"The beneficiary account number from check_payee_account\"\n    },\n    \"typed_name\": {\n      \"type\": \"string\",\n      \"description\": \"The beneficiary name the client gave\"\n    },\n    \"amount\": {\n      \"type\": \"string\",\n      \"description\": \"Amount in the account currency, e.g. 185000.00\"\n    },\n    \"purpose\": {\n      \"type\": \"string\",\n      \"description\": \"The client's own words about what the payment is for\"\n    },\n    \"name_verdict\": {\n      \"type\": \"string\",\n      \"description\": \"The verdict from payee_name_match_agent, exactly as returned: MATCH, CLOSE_MATCH or NO_MATCH\"\n    },\n    \"name_reasons\": {\n      \"type\": \"string\",\n      \"description\": \"The reasons line from payee_name_match_agent, exactly as returned\"\n    },\n    \"agent_notes\": {\n      \"type\": \"string\",\n      \"description\": \"payee_name_match_agent's full answer, unchanged\"\n    }\n  },\n  \"required\": [\n    \"session_token\",\n    \"from_account\",\n    \"beneficiary_account\",\n    \"typed_name\",\n    \"amount\",\n    \"purpose\",\n    \"name_verdict\",\n    \"name_reasons\",\n    \"agent_notes\"\n  ]\n}",
      "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"session_token\": {\n      \"type\": \"string\",\n      \"description\": \"Session token returned by verify_client. Required; never invent a session token. If a tool answers SESSION_INVALID, ask the client to verify again.\"\n    },\n    \"from_account\": {\n      \"type\": \"string\",\n      \"description\": \"The client's account to pay from: currency (USD), last 4 digits or account_id\"\n    },\n    \"beneficiary_account\": {\n      \"type\": \"string\",\n      \"description\": \"The beneficiary account number from check_payee_account\"\n    },\n    \"typed_name\": {\n      \"type\": \"string\",\n      \"description\": \"The beneficiary name the client gave\"\n    },\n    \"amount\": {\n      \"type\": \"string\",\n      \"description\": \"Amount in the account currency, e.g. 185000.00\"\n    },\n    \"purpose\": {\n      \"type\": \"string\",\n      \"description\": \"The client's own words about what the payment is for\"\n    },\n    \"name_verdict\": {\n      \"type\": \"string\",\n      \"description\": \"The verdict from payee_name_match_agent, exactly as returned: MATCH, CLOSE_MATCH or NO_MATCH\"\n    },\n    \"name_reasons\": {\n      \"type\": \"string\",\n      \"description\": \"The reasons line from payee_name_match_agent, exactly as returned\"\n    },\n    \"agent_notes\": {\n      \"type\": \"string\",\n      \"description\": \"payee_name_match_agent's full answer, unchanged\"\n    }\n  },\n  \"required\": [\n    \"session_token\",\n    \"from_account\",\n    \"beneficiary_account\",\n    \"typed_name\",\n    \"amount\",\n    \"purpose\",\n    \"name_verdict\",\n    \"name_reasons\",\n    \"agent_notes\"\n  ]\n}"
