    {
      "id": "flow:propose_cash_application_flow",
      "data": {
        "name": "propose_cash_application_flow",
        "description": "Step 1 of 2 for applying an incoming payment to the client&#39;s open invoices. Pass the incoming payment_ref (from get_my_payments), the remittance or short-pay note in the client&#39;s words, and the remittance_match_agent&#39;s invoices line, deductions line and confidence exactly as it returned them, plus its full answer as agent_notes. The system checks the invoices are this client&#39;s open invoices, keeps only known deduction reasons, works out the early-pay discount the terms allow and what is disputed, and returns PROPOSED with the breakdown (read it back exactly) or NOT_PROPOSED with reason_code NOT_YOUR_PAYMENT, NOT_INCOMING, FUNDS_NOT_RECEIVED, ALREADY_APPLIED, NO_INVOICES, INVOICE_NOT_OPEN, LOW_CONFIDENCE, OVERPAYMENT, DEDUCTIONS_EXCEED_SHORT_PAY or SESSION_INVALID. Nothing is posted until confirm_cash_application.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
