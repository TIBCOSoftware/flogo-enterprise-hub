{
  "imports": [
    "con_postgresql github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection",
    "tr_mcpserver github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/flow",
    "act_default_noop github.com/project-flogo/contrib/activity/noop",
    "act_postgresql_insert github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "act_postgresql_query github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "act_default_actreturn github.com/project-flogo/contrib/activity/actreturn",
    "github.com/project-flogo/contrib/function/coerce",
    "act_general_sendmail github.com/tibco/flogo-general/src/app/General/activity/sendmail"
  ],
  "name": "CorporatePaymentsMCPServer",
  "description": "Aurelia Global Bank Corporate Payments MCP Server - scoped reads, guarded writes, cash application, payee checks and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "CorporatePayments",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/corporate-payments-mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "CorporatePaymentsMCPServer",
      "name": "CorporatePaymentsMCPServer",
      "description": "Aurelia Global Bank Corporate Payments governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_client",
            "handlerDescription": "Verify the client's identity with their Aurelia Global Bank client id (e.g. CLI-2026-00101) and the 6-digit passcode from their corporate portal. Returns VERIFIED with a session_token (valid 30 minutes) and their legal name, NOT_VERIFIED when the id and passcode do not match, or LOCKED after 5 failed attempts in 15 minutes (no token is issued while locked, even with the right passcode; offer recovery only). Call this before any other client tool. Never reveal, hint at or guess passcodes. Aurelia staff use verify_reviewer instead.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_client_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_client_flow",
          "description": "Verify the client's identity with their Aurelia Global Bank client id (e.g. CLI-2026-00101) and the 6-digit passcode from their corporate portal. Returns VERIFIED with a session_token (valid 30 minutes) and their legal name, NOT_VERIFIED when the id and passcode do not match, or LOCKED after 5 failed attempts in 15 minutes (no token is issued while locked, even with the right passcode; offer recovery only). Call this before any other client tool. Never reveal, hint at or guess passcodes. Aurelia staff use verify_reviewer instead.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_client_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_payments",
            "handlerDescription": "List the verified client's own payments, newest first, at most 25. Pass an empty search for everything in the last 90 days, or a search term to filter back 18 months: part of the payment reference, the beneficiary name or bank BIC, or an amount (e.g. 48500). Each row has payment_ref, direction (OUTGOING/INCOMING), rail, amount, currency, fx_rate, fees, beneficiary, status and any return reason code, value date, created-at and any open investigation id. Returns NO_MATCH when nothing matches. Use the payment_ref from here for the other tools; never invent one.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_payments_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_payments_flow",
          "description": "List the verified client's own payments, newest first, at most 25. Pass an empty search for everything in the last 90 days, or a search term to filter back 18 months: part of the payment reference, the beneficiary name or bank BIC, or an amount (e.g. 48500). Each row has payment_ref, direction (OUTGOING/INCOMING), rail, amount, currency, fx_rate, fees, beneficiary, status and any return reason code, value date, created-at and any open investigation id. Returns NO_MATCH when nothing matches. Use the payment_ref from here for the other tools; never invent one.",
          "schemas": {
            "output": {
              "arguments": "schema://get_my_payments_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_payment_status",
            "handlerDescription": "Get the full status of one payment on the verified client's own accounts: direction, rail, amount, currency, fx rate, fees, beneficiary and bank, status (INITIATED, IN_TRANSIT, COMPLETED, RETURNED, HELD, RECALL_REQUESTED, RECALLED) and - when RETURNED - the return reason code decoded into plain language. Returns NOT_YOUR_PAYMENT for a payment that is absent or belongs to another client. Quote amounts, fees and the decoded reason exactly as returned.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_payment_status_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_payment_status_flow",
          "description": "Get the full status of one payment on the verified client's own accounts: direction, rail, amount, currency, fx rate, fees, beneficiary and bank, status (INITIATED, IN_TRANSIT, COMPLETED, RETURNED, HELD, RECALL_REQUESTED, RECALLED) and - when RETURNED - the return reason code decoded into plain language. Returns NOT_YOUR_PAYMENT for a payment that is absent or belongs to another client. Quote amounts, fees and the decoded reason exactly as returned.",
          "schemas": {
            "output": {
              "arguments": "schema://get_payment_status_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_payment_timeline",
            "handlerDescription": "Show the GPI-style event timeline of one payment on the verified client's own accounts: each step with its time, the acting bank and what happened (initiated, debited, forwarded to the agent bank, in transit, returned, completed...). Returns NOT_YOUR_PAYMENT for a payment that is not this client's.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_payment_timeline_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_payment_timeline_flow",
          "description": "Show the GPI-style event timeline of one payment on the verified client's own accounts: each step with its time, the acting bank and what happened (initiated, debited, forwarded to the agent bank, in transit, returned, completed...). Returns NOT_YOUR_PAYMENT for a payment that is not this client's.",
          "schemas": {
            "output": {
              "arguments": "schema://get_payment_timeline_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "check_delivery_estimate",
            "handlerDescription": "Assess whether one payment on the verified client's own accounts will settle on time. The system computes it deterministically from the rail/currency cutoff rules and business days - it is never estimated by you. Returns the outcome ON_TRACK, PAST_CUTOFF (submitted after today's cutoff, so it processes the next business day), DELAYED (past the expected settlement date and still not completed) or SETTLED, with the expected settlement date, or NOT_YOUR_PAYMENT. Quote the outcome and date verbatim; never compute a delivery estimate yourself.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:check_delivery_estimate_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "check_delivery_estimate_flow",
          "description": "Assess whether one payment on the verified client's own accounts will settle on time. The system computes it deterministically from the rail/currency cutoff rules and business days - it is never estimated by you. Returns the outcome ON_TRACK, PAST_CUTOFF (submitted after today's cutoff, so it processes the next business day), DELAYED (past the expected settlement date and still not completed) or SETTLED, with the expected settlement date, or NOT_YOUR_PAYMENT. Quote the outcome and date verbatim; never compute a delivery estimate yourself.",
          "schemas": {
            "output": {
              "arguments": "schema://check_delivery_estimate_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_trace",
            "handlerDescription": "Step 1 of 2 for raising a trace / investigation on a delayed or missing payment. Give the payment_ref (from get_my_payments), a return/reason code (use lookup_reason_code, or MS03 if none was given) and the client's own words. The system checks every rule and returns PROPOSED with an action_id, the amount, beneficiary, decoded reason and estimated response date, or NOT_PROPOSED with reason_code NOT_YOUR_PAYMENT, NOT_TRACEABLE (submitted less than 2 hours ago, or still INITIATED), ALREADY_UNDER_INVESTIGATION, BAD_REASON or SESSION_INVALID. Read the amount, beneficiary, decoded reason and response date back exactly as returned. Nothing is opened until confirm_trace is called after the client's explicit yes.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_trace_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_trace_flow",
          "description": "Step 1 of 2 for raising a trace / investigation on a delayed or missing payment. Give the payment_ref (from get_my_payments), a return/reason code (use lookup_reason_code, or MS03 if none was given) and the client's own words. The system checks every rule and returns PROPOSED with an action_id, the amount, beneficiary, decoded reason and estimated response date, or NOT_PROPOSED with reason_code NOT_YOUR_PAYMENT, NOT_TRACEABLE (submitted less than 2 hours ago, or still INITIATED), ALREADY_UNDER_INVESTIGATION, BAD_REASON or SESSION_INVALID. Read the amount, beneficiary, decoded reason and response date back exactly as returned. Nothing is opened until confirm_trace is called after the client's explicit yes.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_trace_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_trace",
            "handlerDescription": "Step 2 of 2: open the trace the client has explicitly confirmed. Pass the action_id from propose_trace. The system re-checks every rule; proposals expire after 15 minutes. Returns OPENED with the investigation_id (INV-2026-NNNN) and the estimated response date, or NOT_EXECUTED with reason_code NO_SUCH_PROPOSAL, EXPIRED, ALREADY_EXECUTED, SESSION_INVALID or a rule's code. Only call after the client says yes to the exact proposal; never call it without a fresh action_id.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:confirm_trace_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "confirm_trace_flow",
          "description": "Step 2 of 2: open the trace the client has explicitly confirmed. Pass the action_id from propose_trace. The system re-checks every rule; proposals expire after 15 minutes. Returns OPENED with the investigation_id (INV-2026-NNNN) and the estimated response date, or NOT_EXECUTED with reason_code NO_SUCH_PROPOSAL, EXPIRED, ALREADY_EXECUTED, SESSION_INVALID or a rule's code. Only call after the client says yes to the exact proposal; never call it without a fresh action_id.",
          "schemas": {
            "output": {
              "arguments": "schema://confirm_trace_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_recall",
            "handlerDescription": "Step 1 of 2 for requesting a recall / return of a payment (for example sent to the wrong beneficiary). Give the payment_ref, a return/reason code (e.g. BE01 for a wrong beneficiary) and the client's own words. The system checks every rule and returns PROPOSED with an action_id, the amount, beneficiary and decoded reason, or NOT_PROPOSED with reason_code NOT_YOUR_PAYMENT, NOT_RECALLABLE (incoming payment, already returned/recalled, or completed more than 5 business days ago), ALREADY_RECALL_REQUESTED, BAD_REASON or SESSION_INVALID. Make clear to the client that a recall is a REQUEST a person at Payment Operations decides: it is not guaranteed and does NOT reverse the funds automatically. Nothing is submitted until confirm_recall is called after the client's explicit yes.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_recall_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_recall_flow",
          "description": "Step 1 of 2 for requesting a recall / return of a payment (for example sent to the wrong beneficiary). Give the payment_ref, a return/reason code (e.g. BE01 for a wrong beneficiary) and the client's own words. The system checks every rule and returns PROPOSED with an action_id, the amount, beneficiary and decoded reason, or NOT_PROPOSED with reason_code NOT_YOUR_PAYMENT, NOT_RECALLABLE (incoming payment, already returned/recalled, or completed more than 5 business days ago), ALREADY_RECALL_REQUESTED, BAD_REASON or SESSION_INVALID. Make clear to the client that a recall is a REQUEST a person at Payment Operations decides: it is not guaranteed and does NOT reverse the funds automatically. Nothing is submitted until confirm_recall is called after the client's explicit yes.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_recall_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_recall",
            "handlerDescription": "Step 2 of 2: submit the recall the client has explicitly confirmed. Pass the action_id from propose_recall. The system re-checks every rule; proposals expire after 15 minutes. Returns SUBMITTED with the review case_id (CASE-NNNNN) and the assigned team (Payment Operations) - the payment is set to RECALL_REQUESTED and a person decides the recall; funds are not auto-reversed. Otherwise returns NOT_EXECUTED with reason_code NO_SUCH_PROPOSAL, EXPIRED, ALREADY_EXECUTED, SESSION_INVALID or a rule's code. Only call after the client says yes to the exact proposal; state that a person will decide and the funds are not reversed automatically.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:confirm_recall_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "confirm_recall_flow",
          "description": "Step 2 of 2: submit the recall the client has explicitly confirmed. Pass the action_id from propose_recall. The system re-checks every rule; proposals expire after 15 minutes. Returns SUBMITTED with the review case_id (CASE-NNNNN) and the assigned team (Payment Operations) - the payment is set to RECALL_REQUESTED and a person decides the recall; funds are not auto-reversed. Otherwise returns NOT_EXECUTED with reason_code NO_SUCH_PROPOSAL, EXPIRED, ALREADY_EXECUTED, SESSION_INVALID or a rule's code. Only call after the client says yes to the exact proposal; state that a person will decide and the funds are not reversed automatically.",
          "schemas": {
            "output": {
              "arguments": "schema://confirm_recall_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "open_review_case",
            "handlerDescription": "Hand a request that a person must own to the right team: PAYMENT_REPAIR (fix beneficiary details and re-send), FEE_WAIVER (waive or refund a fee on a payment; reference_id = that payment_ref), COMPENSATION, FRAUD (suspected fraud), SANCTIONS_QUERY (a payment held for sanctions screening) or OTHER. A recall is not opened here - use propose_recall. The system routes it, works out what a person could approve (for a fee waiver: refund that fee) and returns CASE_OPENED with case_id (CASE-NNNNN), the assigned team, reply time and requested amount, ALREADY_OPEN when the same request is already with the team, or NOT_OPENED with BAD_TYPE, BAD_REFERENCE or SESSION_INVALID. Supply a neutral brief: facts only, no recommendation. A person decides; the assistant never decides, approves, promises or predicts the outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:open_review_case_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "open_review_case_flow",
          "description": "Hand a request that a person must own to the right team: PAYMENT_REPAIR (fix beneficiary details and re-send), FEE_WAIVER (waive or refund a fee on a payment; reference_id = that payment_ref), COMPENSATION, FRAUD (suspected fraud), SANCTIONS_QUERY (a payment held for sanctions screening) or OTHER. A recall is not opened here - use propose_recall. The system routes it, works out what a person could approve (for a fee waiver: refund that fee) and returns CASE_OPENED with case_id (CASE-NNNNN), the assigned team, reply time and requested amount, ALREADY_OPEN when the same request is already with the team, or NOT_OPENED with BAD_TYPE, BAD_REFERENCE or SESSION_INVALID. Supply a neutral brief: facts only, no recommendation. A person decides; the assistant never decides, approves, promises or predicts the outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://open_review_case_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_cases",
            "handlerDescription": "List the verified client's investigations (INV-) and review cases (CASE-) with type, status (OPEN, APPROVED or REJECTED for review cases), the related payment, the assigned team, the expected response or reply date and - once a person has decided - the approved amount and the customer_message from the team. Use it when the client asks about the status of a trace, a recall, a held payment, a deduction or a fee waiver.",
            "toolTitle": "",
