        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_cash_application",
            "handlerDescription": "Step 1 of 2 for applying an incoming payment to the client's open invoices. Pass the incoming payment_ref (from get_my_payments), the remittance or short-pay note in the client's words, and the remittance_match_agent's invoices line, deductions line and confidence exactly as it returned them, plus its full answer as agent_notes. The system checks the invoices are this client's open invoices, keeps only known deduction reasons, works out the early-pay discount the terms allow and what is disputed, and returns PROPOSED with the breakdown (read it back exactly) or NOT_PROPOSED with reason_code NOT_YOUR_PAYMENT, NOT_INCOMING, FUNDS_NOT_RECEIVED, ALREADY_APPLIED, NO_INVOICES, INVOICE_NOT_OPEN, LOW_CONFIDENCE, OVERPAYMENT, DEDUCTIONS_EXCEED_SHORT_PAY or SESSION_INVALID. Nothing is posted until confirm_cash_application.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
