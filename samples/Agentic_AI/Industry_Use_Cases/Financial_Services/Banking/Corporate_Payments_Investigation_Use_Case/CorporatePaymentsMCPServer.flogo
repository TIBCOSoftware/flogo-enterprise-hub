        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "email_my_confirmation",
            "handlerDescription": "Email the confirmation for an investigation (INV-...), review case (CASE-...), posted cash application (CAP-...) or a payment submitted through the assistant (PMT-... from confirm_payment) of this client. The system sends the email only when that reference belongs to this session's client; otherwise it returns NOT_SENT with reason_code NO_SUCH_REFERENCE or SESSION_INVALID. Call only when the client asks.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:email_my_confirmation_flow"
            }
          },
          "reply": {
            "response": {
