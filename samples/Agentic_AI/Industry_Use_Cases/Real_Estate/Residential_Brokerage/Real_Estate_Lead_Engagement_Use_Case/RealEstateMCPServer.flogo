    {
      "id": "flow:get_review_case_flow",
      "data": {
        "name": "get_review_case_flow",
        "description": "Open one case from the reviewer&#39;s team queue: request, status, priority, customer, the lead&#39;s statement, the AI-prepared agent_brief (unverified), what is requested, the amount_unit and allowed_range (list-price changes), the reviewer&#39;s own approval limit, facts from Brightpath&#39;s records and the decision options. Another team&#39;s case or an unknown id returns NOT_FOUND.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadOutcome",
            "type": "label",
