          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_showing_availability_flow",
          "description": "List open 1-hour showing slots for one Active listing: on a date (YYYY-MM-DD) or, with an empty date, the next 3 days (up to 12 slots). Each row gives slot (YYYY-MM-DD HH:MM - pass it to propose_showing) and a friendly slot_label. Status NO_SLOTS, LISTING_NOT_ACTIVE, NOT_FOUND or INVALID_DATE explain why there is nothing. This is information; propose_showing re-checks everything.",
          "schemas": {
