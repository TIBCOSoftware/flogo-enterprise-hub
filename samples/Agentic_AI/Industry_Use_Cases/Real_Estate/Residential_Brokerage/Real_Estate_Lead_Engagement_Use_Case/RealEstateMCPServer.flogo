            "structuredContent": {}
          },
          "name": "request_agent_follow_up_flow",
          "description": "Ask the verified lead's Brightpath agent to contact them. Pass the lead's own message, and intent, timeline, pre_approved and motivation from lead_intent_agent, plus the agent's full answer as agent_brief. The system decides how soon the agent reaches out and returns FOLLOW_UP_REQUESTED with the follow-up id (FUP-...), the agent and the contact-by time, EXISTING when a follow-up is already open (nothing added), or MESSAGE_REQUIRED. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
