    {
      "id": "flow:email_confirmation_flow",
      "data": {
        "name": "email_confirmation_flow",
        "description": "Email the lead a confirmation of something already done for them: a booked showing (APT-... from confirm_showing), a follow-up request (FUP-...) or a decided request (BPR-CASE-...). The system prepares the email only when that reference belongs to this lead and is done (send_status SEND_OK); otherwise NOT_SENT with reason_code NOT_FOUND or SESSION_INVALID. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
