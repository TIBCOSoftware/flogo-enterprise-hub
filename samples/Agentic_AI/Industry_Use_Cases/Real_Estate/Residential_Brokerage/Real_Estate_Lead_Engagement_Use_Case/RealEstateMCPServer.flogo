              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_showing",
            "handlerDescription": "Step 1 of 2 to book a showing for the verified lead. Pass the listing and the start time as YYYY-MM-DD HH:MM (24-hour; showings start on the hour between 09:00 and 18:00). The system checks the lead's stage, that the listing is Active, that the time is in the future with 2 hours' notice and within 30 days, the lead's upcoming-showing limit and that neither the lead nor the listing is already booked then, and returns PROPOSED with a proposal_id and summary (expires in 15 minutes) or BLOCKED with a reason_code and reason_text. Nothing is booked until confirm_showing is called after the lead explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_showing_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_showing_flow",
          "description": "Step 1 of 2 to book a showing for the verified lead. Pass the listing and the start time as YYYY-MM-DD HH:MM (24-hour; showings start on the hour between 09:00 and 18:00). The system checks the lead's stage, that the listing is Active, that the time is in the future with 2 hours' notice and within 30 days, the lead's upcoming-showing limit and that neither the lead nor the listing is already booked then, and returns PROPOSED with a proposal_id and summary (expires in 15 minutes) or BLOCKED with a reason_code and reason_text. Nothing is booked until confirm_showing is called after the lead explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_showing_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_showing",
            "handlerDescription": "Step 2 of 2: book a showing the lead has explicitly confirmed. Pass the proposal_id from propose_showing. The system re-checks every rule and returns EXECUTED with the appointment_id (APT-...), time, address, agent and the lead's journey_stage, or BLOCKED / EXPIRED (after 15 minutes) / NOT_FOUND / ALREADY_DONE with the reason. Only call after the lead says yes to the exact proposal. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:confirm_showing_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "confirm_showing_flow",
          "description": "Step 2 of 2: book a showing the lead has explicitly confirmed. Pass the proposal_id from propose_showing. The system re-checks every rule and returns EXECUTED with the appointment_id (APT-...), time, address, agent and the lead's journey_stage, or BLOCKED / EXPIRED (after 15 minutes) / NOT_FOUND / ALREADY_DONE with the reason. Only call after the lead says yes to the exact proposal. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://confirm_showing_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "request_agent_follow_up",
            "handlerDescription": "Ask the verified lead's Brightpath agent to contact them. Pass the lead's own message, and intent, timeline, pre_approved and motivation from lead_intent_agent, plus the agent's full answer as agent_brief. The system decides how soon the agent reaches out and returns FOLLOW_UP_REQUESTED with the follow-up id (FUP-...), the agent and the contact-by time, EXISTING when a follow-up is already open (nothing added), or MESSAGE_REQUIRED. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
