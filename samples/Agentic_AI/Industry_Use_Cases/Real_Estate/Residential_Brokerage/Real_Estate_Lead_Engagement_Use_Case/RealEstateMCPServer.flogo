{
  "imports": [
    "con_postgresql github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection",
    "tr_mcpserver github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/flow",
    "act_default_noop github.com/project-flogo/contrib/activity/noop",
    "act_postgresql_insert github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "act_postgresql_query github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "act_default_actreturn github.com/project-flogo/contrib/activity/actreturn",
    "github.com/project-flogo/contrib/function/coerce",
    "act_general_sendmail github.com/tibco/flogo-general/src/app/General/activity/sendmail"
  ],
  "name": "RealEstateMCPServer",
  "description": "Brightpath Realty lead engagement MCP Server - scoped reads, guarded writes and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "RealEstateMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/realestatemcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "RealEstateMCPServer",
      "name": "RealEstateMCPServer",
      "description": "Brightpath Realty governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_lead",
            "handlerDescription": "Verify a Brightpath Realty buyer or seller lead with the e-mail address they registered with and the one-time code e-mailed to them. Returns VERIFIED with a session_token (valid 60 minutes), the lead's first name and today's date (use it to turn 'Saturday' into a date), VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any lead tool. Never reveal, guess or hint at codes. Brightpath staff use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_lead_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_lead_flow",
          "description": "Verify a Brightpath Realty buyer or seller lead with the e-mail address they registered with and the one-time code e-mailed to them. Returns VERIFIED with a session_token (valid 60 minutes), the lead's first name and today's date (use it to turn 'Saturday' into a date), VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any lead tool. Never reveal, guess or hint at codes. Brightpath staff use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_lead_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_profile",
            "handlerDescription": "Get the verified lead's profile: name, buyer/seller, journey stage, budget, preferred area, minimum bedrooms and bathrooms, property type, timeline, financing (pre-approval on file or not), assigned agent, their own listings (sellers), number of upcoming showings, any open follow-up request and today's date. Only this lead's data is returned.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_profile_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_profile_flow",
          "description": "Get the verified lead's profile: name, buyer/seller, journey stage, budget, preferred area, minimum bedrooms and bathrooms, property type, timeline, financing (pre-approval on file or not), assigned agent, their own listings (sellers), number of upcoming showings, any open follow-up request and today's date. Only this lead's data is returned.",
          "schemas": {
            "output": {
              "arguments": "schema://get_my_profile_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "search_listings",
            "handlerDescription": "Search Brightpath's Active and Pending listings in the Larkspur Valley metro. Every filter is applied by the system: area (Cedar Hollow, Willow Bend, Larkspur Downtown, Northgate, or empty for all), min_price and max_price in dollars, min_bedrooms, property_type (single family, townhouse, condo) and keywords (every word must appear in the listing; leave keywords empty for fuzzy wishes like 'walkable' - send those to listing_match_agent with the rows instead). Returns up to 12 rows: listing_id, address, area, price, bedrooms, bathrooms, sqft, property_type, year_built, HOA, listing_status (Active or Pending), days on market, features and description. Status NO_MATCH = nothing found; loosen a filter. Use empty strings for filters the person did not give.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:search_listings_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "search_listings_flow",
          "description": "Search Brightpath's Active and Pending listings in the Larkspur Valley metro. Every filter is applied by the system: area (Cedar Hollow, Willow Bend, Larkspur Downtown, Northgate, or empty for all), min_price and max_price in dollars, min_bedrooms, property_type (single family, townhouse, condo) and keywords (every word must appear in the listing; leave keywords empty for fuzzy wishes like 'walkable' - send those to listing_match_agent with the rows instead). Returns up to 12 rows: listing_id, address, area, price, bedrooms, bathrooms, sqft, property_type, year_built, HOA, listing_status (Active or Pending), days on market, features and description. Status NO_MATCH = nothing found; loosen a filter. Use empty strings for filters the person did not give.",
          "schemas": {
            "output": {
              "arguments": "schema://search_listings_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_listing_details",
            "handlerDescription": "Get one listing: address, area, price, bedrooms, bathrooms, sqft, lot, type, year built, HOA, status, list date and days on market, price per sqft, the area median price, features, description, listing agent, price history, the next open showing slots and whether it is the lead's own listing. NOT_FOUND = no such listing. Facts only - the listings never describe schools, safety or who lives nearby.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
