        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "open_service_case",
            "handlerDescription": "Hand a request that needs a person to the right Brightpath team. request_type is offer_request (offers, price or negotiation questions; reference_id = the listing, amount = the offer idea in dollars if given), list_price_change (a seller changing the price of their own listing; reference_id = their listing, amount = the new list price), stage_change (an accepted offer or a closing; reference_id = Under Contract or Closed), fair_housing_review (a question about schools, safety, crime, who lives in an area or 'family-friendly' areas; reference_id = the category from fair_housing_agent, agent_brief = its full answer) or advice_referral (legal or mortgage questions; reference_id = the topic). summary is a neutral 1-3 sentence summary in the lead's own words. Leave fields empty when they do not apply. The system routes it and returns OPENED with case_id, team and reply time, EXISTING, or BLOCKED / INVALID_TYPE with a reason. The assistant never decides, promises or predicts the outcome. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:open_service_case_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "open_service_case_flow",
          "description": "Hand a request that needs a person to the right Brightpath team. request_type is offer_request (offers, price or negotiation questions; reference_id = the listing, amount = the offer idea in dollars if given), list_price_change (a seller changing the price of their own listing; reference_id = their listing, amount = the new list price), stage_change (an accepted offer or a closing; reference_id = Under Contract or Closed), fair_housing_review (a question about schools, safety, crime, who lives in an area or 'family-friendly' areas; reference_id = the category from fair_housing_agent, agent_brief = its full answer) or advice_referral (legal or mortgage questions; reference_id = the topic). summary is a neutral 1-3 sentence summary in the lead's own words. Leave fields empty when they do not apply. The system routes it and returns OPENED with case_id, team and reply time, EXISTING, or BLOCKED / INVALID_TYPE with a reason. The assistant never decides, promises or predicts the outcome. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://open_service_case_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "email_confirmation",
            "handlerDescription": "Email the lead a confirmation of something already done for them: a booked showing (APT-... from confirm_showing), a follow-up request (FUP-...) or a decided request (BPR-CASE-...). The system prepares the email only when that reference belongs to this lead and is done (send_status SEND_OK); otherwise NOT_SENT with reason_code NOT_FOUND or SESSION_INVALID. Quote any reason_text to the person as written; never change an outcome.",
