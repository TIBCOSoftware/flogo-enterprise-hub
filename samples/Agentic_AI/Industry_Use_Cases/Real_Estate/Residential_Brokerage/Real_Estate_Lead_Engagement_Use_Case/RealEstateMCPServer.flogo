    {
      "id": "flow:propose_showing_flow",
      "data": {
        "name": "propose_showing_flow",
        "description": "Step 1 of 2 to book a showing for the verified lead. Pass the listing and the start time as YYYY-MM-DD HH:MM (24-hour; showings start on the hour between 09:00 and 18:00). The system checks the lead&#39;s stage, that the listing is Active, that the time is in the future with 2 hours&#39; notice and within 30 days, the lead&#39;s upcoming-showing limit and that neither the lead nor the listing is already booked then, and returns PROPOSED with a proposal_id and summary (expires in 15 minutes) or BLOCKED with a reason_code and reason_text. Nothing is booked until confirm_showing is called after the lead explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
