                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"option_type\": {\"type\": \"string\"}, \"option_id\": {\"type\": \"string\"}, \"title\": {\"type\": \"string\"}, \"detail\": {\"type\": \"string\"}, \"when_available\": {\"type\": \"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"option_type\": {\"type\": \"string\"}, \"option_id\": {\"type\": \"string\"}, \"title\": {\"type\": \"string\"}, \"detail\": {\"type\": \"string\"}, \"when_available\": {\"type\": \"string\"}}}}}}"
