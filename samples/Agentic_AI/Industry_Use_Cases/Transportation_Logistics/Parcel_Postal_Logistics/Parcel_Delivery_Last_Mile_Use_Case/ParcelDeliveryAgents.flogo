                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"area\": {\"type\": \"string\"}, \"size\": {\"type\": \"string\"}, \"sig\": {\"type\": \"string\"}, \"hv\": {\"type\": \"string\"}, \"aft\": {\"type\": \"string\"}}}}}"
