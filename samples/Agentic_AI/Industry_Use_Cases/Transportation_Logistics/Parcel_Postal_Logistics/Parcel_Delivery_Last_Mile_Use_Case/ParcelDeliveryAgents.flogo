                  },
                  {
                    "FieldName": "when_available",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "ace62498-e79d-4af5-b2b7-7ed2906ad166SELECT * FROM search_delivery_options(CAST(?area AS text), CAST(?size AS text), CAST(?sig AS text), CAST(?hv AS text), CAST(?aft AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "area": "=$flow.toolParams.area",
                      "size": "=$flow.toolParams.parcel_size",
                      "sig": "=$flow.toolParams.needs_signature",
