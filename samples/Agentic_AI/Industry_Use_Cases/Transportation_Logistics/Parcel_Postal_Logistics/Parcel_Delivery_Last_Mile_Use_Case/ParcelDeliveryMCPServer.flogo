                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO pending_actions (action_type, parcel_id, slot_id) SELECT * FROM reschedule_proposal_row(CAST(?w_tok AS text), CAST(?w_trk AS text), CAST(?w_slot AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_tok",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
