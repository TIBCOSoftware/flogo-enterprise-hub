        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "email_confirmation",
            "handlerDescription": "Email the recipient the confirmation for a reschedule or redirect they have already executed. Pass the action_id from confirm_reschedule or confirm_redirect. The system sends the email only when that change belongs to this session and has been executed; otherwise it returns NOT_SENT with the reason. Call only after a successful change.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
