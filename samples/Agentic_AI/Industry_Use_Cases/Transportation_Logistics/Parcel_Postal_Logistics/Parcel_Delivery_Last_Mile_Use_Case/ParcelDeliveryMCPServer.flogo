            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_cases_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_cases_flow",
          "description": "List the verified recipient's open and past cases and claims: case id, claim id, request type, parcel, assigned team, status (OPEN, APPROVED, REJECTED), the amount under review, and - once a person has decided - the approved amount, any compensation paid and the customer_message from the team. Use it when the recipient asks about the status of a claim or request.",
          "schemas": {
            "output": {
              "arguments": "schema://get_my_cases_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "open_damage_claim",
            "handlerDescription": "Open a compensation claim for one of the verified recipient's own parcels that arrived damaged (DAMAGED), arrived with items missing (MISSING_CONTENTS) or never arrived (LOST). Pass the tracking number, the damage_claim_agent's claim_type, packaging_condition and likely_cause exactly as it returned them, the amount the recipient is claiming (empty = the declared value), the recipient's own words and the agent's full answer. The system checks the rules (ownership, delivery status, claim window, one open claim per parcel), caps the claimable amount at the declared value and Swiftbound's coverage limit, and returns CLAIM_OPENED with claim_id, case_id, team, reply date, the amount under review, why it was capped and the evidence to send; ALREADY_OPEN; or NOT_OPENED with reason_code NOT_FOUND, BAD_CLAIM_TYPE, NOT_DELIVERED_YET, DELIVERED_NOT_LOST, NOT_YET_LOST, RETURNED_TO_SENDER, CLAIM_WINDOW_CLOSED, BAD_AMOUNT or SESSION_INVALID. A person decides the claim and any compensation; never promise an amount.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:open_damage_claim_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "open_damage_claim_flow",
          "description": "Open a compensation claim for one of the verified recipient's own parcels that arrived damaged (DAMAGED), arrived with items missing (MISSING_CONTENTS) or never arrived (LOST). Pass the tracking number, the damage_claim_agent's claim_type, packaging_condition and likely_cause exactly as it returned them, the amount the recipient is claiming (empty = the declared value), the recipient's own words and the agent's full answer. The system checks the rules (ownership, delivery status, claim window, one open claim per parcel), caps the claimable amount at the declared value and Swiftbound's coverage limit, and returns CLAIM_OPENED with claim_id, case_id, team, reply date, the amount under review, why it was capped and the evidence to send; ALREADY_OPEN; or NOT_OPENED with reason_code NOT_FOUND, BAD_CLAIM_TYPE, NOT_DELIVERED_YET, DELIVERED_NOT_LOST, NOT_YET_LOST, RETURNED_TO_SENDER, CLAIM_WINDOW_CLOSED, BAD_AMOUNT or SESSION_INVALID. A person decides the claim and any compensation; never promise an amount.",
          "schemas": {
            "output": {
              "arguments": "schema://open_damage_claim_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_delivery_instructions",
            "handlerDescription": "Step 1 of 2 to save delivery instructions (safe place, access-code flag, hazards) for one of the verified recipient's own upcoming parcels. Pass the tracking number, the delivery_instructions_agent's safe_place, access_code_present, hazards and risk_flags exactly as it returned them, the recipient's own words and the agent's full answer. The system checks the safe place against Swiftbound's list, scans for risky instructions, applies the signature and high-value rules, masks any access code and returns PROPOSED with an action_id and the driver note, or NOT_PROPOSED with reason_code RISKY_INSTRUCTION, SAFE_PLACE_UNKNOWN, SIGNATURE_REQUIRED, HIGH_VALUE_SAFE_PLACE, ALREADY_DELIVERED, REDIRECTED_TO_PICKUP, NOT_FOUND or SESSION_INVALID. Nothing is saved until confirm_delivery_instructions.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_delivery_instructions_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_delivery_instructions_flow",
          "description": "Step 1 of 2 to save delivery instructions (safe place, access-code flag, hazards) for one of the verified recipient's own upcoming parcels. Pass the tracking number, the delivery_instructions_agent's safe_place, access_code_present, hazards and risk_flags exactly as it returned them, the recipient's own words and the agent's full answer. The system checks the safe place against Swiftbound's list, scans for risky instructions, applies the signature and high-value rules, masks any access code and returns PROPOSED with an action_id and the driver note, or NOT_PROPOSED with reason_code RISKY_INSTRUCTION, SAFE_PLACE_UNKNOWN, SIGNATURE_REQUIRED, HIGH_VALUE_SAFE_PLACE, ALREADY_DELIVERED, REDIRECTED_TO_PICKUP, NOT_FOUND or SESSION_INVALID. Nothing is saved until confirm_delivery_instructions.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_delivery_instructions_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_delivery_instructions",
            "handlerDescription": "Step 2 of 2: save delivery instructions the recipient has explicitly confirmed. Pass the action_id from propose_delivery_instructions. The system re-checks every rule; proposals expire after 15 minutes. Returns EXECUTED with the saved safe place, hazards and driver note (access codes are never stored), or NOT_EXECUTED with the reason. Only call after the recipient says yes to the exact proposal.",
            "toolTitle": "",
            "readOnlyToolHint": false,
