  ],
  "name": "ParcelDeliveryMCPServer",
  "description": "Swiftbound Parcel Delivery (governed) MCP Server - scoped reads and guarded writes for verified recipients",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "ParcelDeliveryMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
