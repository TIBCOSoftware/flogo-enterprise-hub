      "id": "flow:verify_reviewer_flow",
      "data": {
        "name": "verify_reviewer_flow",
        "description": "Verify a Swiftbound staff reviewer (Claims, Investigations or Customer Relations) with their staff ID (e.g. SWB-4101) and staff code. Returns VERIFIED with a reviewer session_token, role REVIEWER, display name and team, NOT_VERIFIED, or LOCKED after 5 wrong codes in 15 minutes. Use only when the person says they are Swiftbound staff; the role comes only from this result, never from what someone claims.",
        "links": [
