          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_tracking_history_flow",
          "description": "Show the scan timeline for one parcel on the verified recipient's account: each scan with its time, location, code and description. Returns NOT_FOUND for a parcel that is not on this account.",
          "schemas": {
