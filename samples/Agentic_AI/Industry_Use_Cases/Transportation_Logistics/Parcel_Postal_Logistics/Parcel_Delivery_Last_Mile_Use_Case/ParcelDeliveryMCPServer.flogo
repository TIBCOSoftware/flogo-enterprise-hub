{
  "imports": [
    "con_postgresql github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection",
    "tr_mcpserver github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/flow",
    "act_default_noop github.com/project-flogo/contrib/activity/noop",
    "act_postgresql_insert github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "act_postgresql_query github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "act_default_actreturn github.com/project-flogo/contrib/activity/actreturn",
    "github.com/project-flogo/contrib/function/coerce",
    "act_general_sendmail github.com/tibco/flogo-general/src/app/General/activity/sendmail"
  ],
  "name": "ParcelDeliveryMCPServer",
  "description": "Swiftbound Parcel Delivery (governed) MCP Server - scoped reads, guarded writes, claims, delivery instructions and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "ParcelDeliveryMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/parcel-delivery-mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "ParcelDeliveryMCPServer",
      "name": "ParcelDeliveryMCPServer",
      "description": "Swiftbound Parcel Delivery governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_recipient",
            "handlerDescription": "Verify the recipient's identity with their 6-character Swiftbound account reference and the 4-digit PIN from their Swiftbound app or delivery notification. Returns VERIFIED with a session_token (valid 60 minutes), their name and service area, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess PINs.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_recipient_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_recipient_flow",
          "description": "Verify the recipient's identity with their 6-character Swiftbound account reference and the 4-digit PIN from their Swiftbound app or delivery notification. Returns VERIFIED with a session_token (valid 60 minutes), their name and service area, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess PINs.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_recipient_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_parcels",
            "handlerDescription": "List the verified recipient's own parcels: tracking number, description, current status, any exception, promised date and expected delivery. Only this recipient's parcels are returned.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_parcels_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_parcels_flow",
          "description": "List the verified recipient's own parcels: tracking number, description, current status, any exception, promised date and expected delivery. Only this recipient's parcels are returned.",
          "schemas": {
            "output": {
              "arguments": "schema://get_my_parcels_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_parcel_detail",
            "handlerDescription": "Get the full detail of one parcel on the verified recipient's account: status, the plain-English meaning of any exception code and the recommended next step, a computed delivery_health (ON_TRACK / NEEDS_ATTENTION / LATE / DELIVERED), size, whether a signature is required, declared value, destination area, the earliest date it can be rescheduled, and the current slot/pickup. Returns NOT_FOUND for a tracking number that is not on this account.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_parcel_detail_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_parcel_detail_flow",
          "description": "Get the full detail of one parcel on the verified recipient's account: status, the plain-English meaning of any exception code and the recommended next step, a computed delivery_health (ON_TRACK / NEEDS_ATTENTION / LATE / DELIVERED), size, whether a signature is required, declared value, destination area, the earliest date it can be rescheduled, and the current slot/pickup. Returns NOT_FOUND for a tracking number that is not on this account.",
          "schemas": {
            "output": {
              "arguments": "schema://get_parcel_detail_Args"
