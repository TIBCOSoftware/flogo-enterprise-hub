      "id": "ParcelDeliveryMCPServer",
      "name": "ParcelDeliveryMCPServer",
      "description": "Swiftbound Parcel Delivery governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_recipient",
            "handlerDescription": "Verify the recipient's identity with their 6-character Swiftbound account reference and the 4-digit PIN from their Swiftbound app or delivery notification. Returns VERIFIED with a session_token (valid 60 minutes), their name and service area, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess PINs.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_recipient_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_recipient_flow",
