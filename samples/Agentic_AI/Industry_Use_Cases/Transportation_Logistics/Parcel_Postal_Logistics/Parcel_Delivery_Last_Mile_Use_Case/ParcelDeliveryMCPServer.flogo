    {
      "id": "flow:email_confirmation_flow",
      "data": {
        "name": "email_confirmation_flow",
        "description": "Email the recipient a confirmation of something already done for them: a reschedule or redirect they executed, delivery instructions they saved (pass the action_id), or a case a person has decided (pass the case id SC-...). The system sends the email only when that action or case belongs to this session and is executed or decided; otherwise it returns NOT_SENT with the reason. Call only when the recipient asks.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "SendMail",
            "type": "expression",
            "label": "send_status is SEND_OK",
            "value": "$activity[ReadOutcome].Output.records[0].send_status == \"SEND_OK\""
          },
          {
            "id": 4,
            "from": "SendMail",
            "to": "Return",
            "type": "label",
            "label": "SendMail to Return"
          },
          {
            "id": 5,
            "from": "ReadOutcome",
            "to": "ReturnNotSent",
            "type": "exprOtherwise",
            "label": "otherwise (NOT_SENT)"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
