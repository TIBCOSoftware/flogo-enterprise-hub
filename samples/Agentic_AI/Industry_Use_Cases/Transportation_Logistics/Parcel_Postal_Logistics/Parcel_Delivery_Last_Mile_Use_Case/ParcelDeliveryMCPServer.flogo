        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_reschedule",
            "handlerDescription": "Step 1 of 2 to reschedule a parcel onto a new delivery slot. Give the parcel's tracking number and the chosen slot_id (from the delivery-options agent or get_parcel_detail). The system checks every rule (ownership, the parcel is still reschedulable, the slot is in the parcel's area, not in the past, and has capacity) and returns PROPOSED with an action_id and the slot date/window, or NOT_PROPOSED with the reason. Nothing changes until confirm_reschedule is called.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_reschedule_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_reschedule_flow",
          "description": "Step 1 of 2 to reschedule a parcel onto a new delivery slot. Give the parcel's tracking number and the chosen slot_id (from the delivery-options agent or get_parcel_detail). The system checks every rule (ownership, the parcel is still reschedulable, the slot is in the parcel's area, not in the past, and has capacity) and returns PROPOSED with an action_id and the slot date/window, or NOT_PROPOSED with the reason. Nothing changes until confirm_reschedule is called.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_reschedule_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_reschedule",
            "handlerDescription": "Step 2 of 2: execute a reschedule the recipient has explicitly confirmed. Pass the action_id from propose_reschedule. The system re-checks every rule and expires proposals after 15 minutes. Returns EXECUTED (with the new slot) or NOT_EXECUTED with the reason. Only call after the recipient says yes to the exact proposal.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:confirm_reschedule_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "confirm_reschedule_flow",
          "description": "Step 2 of 2: execute a reschedule the recipient has explicitly confirmed. Pass the action_id from propose_reschedule. The system re-checks every rule and expires proposals after 15 minutes. Returns EXECUTED (with the new slot) or NOT_EXECUTED with the reason. Only call after the recipient says yes to the exact proposal.",
          "schemas": {
            "output": {
              "arguments": "schema://confirm_reschedule_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_redirect",
            "handlerDescription": "Step 1 of 2 to redirect a parcel to a pickup point (locker or staffed shop). Give the tracking number and the chosen pickup_id. The system checks every rule (ownership, the parcel is still redirectable, the pickup point serves the parcel's area and fits its size, and - for unattended lockers - that the parcel is not signature-required and not over the value limit) and returns PROPOSED with an action_id, or NOT_PROPOSED with the reason. Nothing changes until confirm_redirect is called.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_redirect_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_redirect_flow",
          "description": "Step 1 of 2 to redirect a parcel to a pickup point (locker or staffed shop). Give the tracking number and the chosen pickup_id. The system checks every rule (ownership, the parcel is still redirectable, the pickup point serves the parcel's area and fits its size, and - for unattended lockers - that the parcel is not signature-required and not over the value limit) and returns PROPOSED with an action_id, or NOT_PROPOSED with the reason. Nothing changes until confirm_redirect is called.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_redirect_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
