                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO recipient_sessions (recipient_id) SELECT recipient_id FROM verify_and_record(CAST(?w_ref AS text), CAST(?w_pin AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_ref",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
