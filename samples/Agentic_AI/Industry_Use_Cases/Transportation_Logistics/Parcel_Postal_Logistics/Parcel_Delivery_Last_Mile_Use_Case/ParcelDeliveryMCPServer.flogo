        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "open_service_case",
            "handlerDescription": "Hand a request that needs a human to the right team: LOST_PARCEL (a parcel that never arrived), DAMAGED_PARCEL (arrived damaged), MISSING_ITEMS (contents missing from the parcel), WRONG_DELIVERY (delivered to the wrong place/person), DELIVERY_COMPLAINT (a complaint about the service) or OTHER. The system routes it and returns CASE_OPENED with case_id, team and reply time. The assistant never decides, promises or predicts compensation or outcomes.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
