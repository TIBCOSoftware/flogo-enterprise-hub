  "resources": [
    {
      "id": "flow:verify_recipient_flow",
      "data": {
        "name": "verify_recipient_flow",
        "description": "Verify the recipient&#39;s identity with their 6-character Swiftbound account reference and the 4-digit PIN from their Swiftbound app or delivery notification. Returns VERIFIED with a session_token (valid 60 minutes), their name and service area, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess PINs.",
