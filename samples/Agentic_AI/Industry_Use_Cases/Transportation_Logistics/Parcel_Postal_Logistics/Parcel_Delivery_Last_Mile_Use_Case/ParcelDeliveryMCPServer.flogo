            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "email_confirmation_flow",
          "description": "Email the recipient a confirmation of something already done for them: a reschedule or redirect they executed, delivery instructions they saved (pass the action_id), or a case a person has decided (pass the case id SC-...). The system sends the email only when that action or case belongs to this session and is executed or decided; otherwise it returns NOT_SENT with the reason. Call only when the recipient asks.",
          "schemas": {
            "output": {
              "arguments": "schema://email_confirmation_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "open_service_case",
            "handlerDescription": "Hand a request that needs a human to the right team (for compensation claims on a damaged, lost or incomplete parcel use open_damage_claim instead): LOST_PARCEL (a parcel that never arrived), DAMAGED_PARCEL (arrived damaged), MISSING_ITEMS (contents missing from the parcel), WRONG_DELIVERY (delivered to the wrong place/person), DELIVERY_COMPLAINT (a complaint about the service) or OTHER. The system routes it and returns CASE_OPENED with case_id, team and reply time. The assistant never decides, promises or predicts compensation or outcomes.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:open_service_case_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "open_service_case_flow",
          "description": "Hand a request that needs a human to the right team (for compensation claims on a damaged, lost or incomplete parcel use open_damage_claim instead): LOST_PARCEL (a parcel that never arrived), DAMAGED_PARCEL (arrived damaged), MISSING_ITEMS (contents missing from the parcel), WRONG_DELIVERY (delivered to the wrong place/person), DELIVERY_COMPLAINT (a complaint about the service) or OTHER. The system routes it and returns CASE_OPENED with case_id, team and reply time. The assistant never decides, promises or predicts compensation or outcomes.",
          "schemas": {
            "output": {
              "arguments": "schema://open_service_case_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_cases",
            "handlerDescription": "List the verified recipient's open and past cases and claims: case id, claim id, request type, parcel, assigned team, status (OPEN, APPROVED, REJECTED), the amount under review, and - once a person has decided - the approved amount, any compensation paid and the customer_message from the team. Use it when the recipient asks about the status of a claim or request.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
