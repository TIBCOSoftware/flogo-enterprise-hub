          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "confirm_redirect_flow",
          "description": "Step 2 of 2: execute a redirect the recipient has explicitly confirmed. Pass the action_id from propose_redirect. The system re-checks every rule and expires proposals after 15 minutes. Returns EXECUTED (with the pickup point) or NOT_EXECUTED with the reason. Only call after the recipient says yes to the exact proposal.",
          "schemas": {
            "output": {
              "arguments": "schema://confirm_redirect_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "email_confirmation",
            "handlerDescription": "Email the recipient a confirmation of something already done for them: a reschedule or redirect they executed, delivery instructions they saved (pass the action_id), or a case a person has decided (pass the case id SC-...). The system sends the email only when that action or case belongs to this session and is executed or decided; otherwise it returns NOT_SENT with the reason. Call only when the recipient asks.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
