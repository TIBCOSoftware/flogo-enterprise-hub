                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"org\": {\"type\": \"string\"}, \"dst\": {\"type\": \"string\"}, \"aft\": {\"type\": \"string\"}, \"cab\": {\"type\": \"string\"}}}}}"
