                "State": "37b20446-a8f9-401c-aff1-6d00e25561f6INSERT INTO review_decisions (case_id, reviewer_id, decision, approved_amount, internal_note, customer_message) SELECT * FROM decide_case_row(CAST(?w_tok AS text), CAST(?w_cid AS text), CAST(?w_dec AS text), CAST(?w_amt AS text), CAST(?w_note AS text), CAST(?w_msg AS text));",
