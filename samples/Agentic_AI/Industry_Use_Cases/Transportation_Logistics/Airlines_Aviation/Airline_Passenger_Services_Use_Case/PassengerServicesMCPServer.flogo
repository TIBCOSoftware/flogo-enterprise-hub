          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_cases_flow",
          "description": "List the verified traveller's open and past cases with the assigned team, status (OPEN, APPROVED, REJECTED), requested amount, reply-by date and - once a person has decided - the approved amount and the message from the team (customer_message). Use it when the traveller asks about the status of a request.",
          "schemas": {
            "output": {
              "arguments": "schema://get_my_cases_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "record_baggage_claim",
            "handlerDescription": "Record a delayed, lost, damaged or pilfered bag for a flight on the verified traveller's booking that has arrived. Pass the flight, the traveller's own description, the interim expenses they ask for (dollars, or empty) and baggage_claim_agent's full answer exactly as returned. The system validates the agent's claim type, bag-type and colour codes, contents and missing report fields against Meridian's tables (a bag is LOST only 5+ days after arrival), records the claim and opens a Baggage Services case. Returns RECORDED with claim_id, case_id, team, reply-by date, the missing report fields and what to send, ALREADY_RECORDED, or NOT_RECORDED with reason_code SESSION_INVALID, NOT_FOUND, NOT_ARRIVED, DESCRIPTION_MISSING or CLAIM_TYPE_UNKNOWN. Interim expenses are decided by a person.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:record_baggage_claim_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "record_baggage_claim_flow",
          "description": "Record a delayed, lost, damaged or pilfered bag for a flight on the verified traveller's booking that has arrived. Pass the flight, the traveller's own description, the interim expenses they ask for (dollars, or empty) and baggage_claim_agent's full answer exactly as returned. The system validates the agent's claim type, bag-type and colour codes, contents and missing report fields against Meridian's tables (a bag is LOST only 5+ days after arrival), records the claim and opens a Baggage Services case. Returns RECORDED with claim_id, case_id, team, reply-by date, the missing report fields and what to send, ALREADY_RECORDED, or NOT_RECORDED with reason_code SESSION_INVALID, NOT_FOUND, NOT_ARRIVED, DESCRIPTION_MISSING or CLAIM_TYPE_UNKNOWN. Interim expenses are decided by a person.",
          "schemas": {
            "output": {
              "arguments": "schema://record_baggage_claim_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "request_assistance",
            "handlerDescription": "Add special assistance to an upcoming flight on the verified traveller's booking. Pass the flight, the traveller's needs in their own words and special_assistance_agent's full answer exactly as returned. The system validates the agent's IATA SSR codes (only codes a traveller can request, one wheelchair code, a medical need adds MEDA), adds them to the traveller's own segment as PENDING_CONFIRMATION and opens an Accessibility Desk case. Returns REQUESTED with request_id, the codes and status, medical_clearance, case_id, team and reply-by date, ALREADY_REQUESTED, or NOT_RECORDED with reason_code SESSION_INVALID, NOT_FOUND, NOT_UPCOMING, NEEDS_MISSING or NO_VALID_CODES. A person on the Accessibility Desk confirms it.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:request_assistance_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "request_assistance_flow",
          "description": "Add special assistance to an upcoming flight on the verified traveller's booking. Pass the flight, the traveller's needs in their own words and special_assistance_agent's full answer exactly as returned. The system validates the agent's IATA SSR codes (only codes a traveller can request, one wheelchair code, a medical need adds MEDA), adds them to the traveller's own segment as PENDING_CONFIRMATION and opens an Accessibility Desk case. Returns REQUESTED with request_id, the codes and status, medical_clearance, case_id, team and reply-by date, ALREADY_REQUESTED, or NOT_RECORDED with reason_code SESSION_INVALID, NOT_FOUND, NOT_UPCOMING, NEEDS_MISSING or NO_VALID_CODES. A person on the Accessibility Desk confirms it.",
          "schemas": {
            "output": {
              "arguments": "schema://request_assistance_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_reviewer",
            "handlerDescription": "Verify a Meridian staff reviewer (Baggage Services, Accessibility Desk, Customer Care, Customer Relations or Ticketing) with their staff ID (e.g. MER-7001) and staff code. Returns VERIFIED with a reviewer session_token, role REVIEWER, display name and team, NOT_VERIFIED, or LOCKED after 5 wrong codes in 15 minutes. Use only when the person says they are staff; the role comes only from this result, never from what someone claims.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
