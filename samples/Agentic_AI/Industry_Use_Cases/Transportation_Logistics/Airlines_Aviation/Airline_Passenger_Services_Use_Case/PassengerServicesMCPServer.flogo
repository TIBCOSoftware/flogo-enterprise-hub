            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_flight_status",
            "handlerDescription": "Get the live status of one flight that is on the verified traveller's own itinerary: scheduled vs estimated times, status, delay minutes and reason, and gate. Returns NOT_ON_ITINERARY for a flight that is not on their booking.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
