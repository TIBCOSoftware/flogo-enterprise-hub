  ],
  "name": "PassengerServicesMCPServer",
  "description": "Meridian Passenger Services (governed) MCP Server - scoped reads, guarded writes, baggage claims, assistance requests and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "PassengerServicesMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/passenger-services-gov-mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "PassengerServicesMCPServer",
      "name": "PassengerServicesMCPServer",
      "description": "Meridian Passenger Services governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_traveller",
            "handlerDescription": "Verify the traveller's identity with their 6-character PNR (booking reference) and the 4-digit PIN from their Meridian app or booking email. Returns VERIFIED with a session_token (valid 60 minutes), their name and loyalty tier, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess PINs.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_traveller_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_traveller_flow",
          "description": "Verify the traveller's identity with their 6-character PNR (booking reference) and the 4-digit PIN from their Meridian app or booking email. Returns VERIFIED with a session_token (valid 60 minutes), their name and loyalty tier, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess PINs.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_traveller_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_itinerary",
            "handlerDescription": "List the verified traveller's own itinerary: each leg with flight number, route, scheduled and estimated times, live flight status, delay, gate, seat, cabin and any special assistance on the leg (code + status). Only this booking's legs are returned.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
