        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "check_connection_risk",
            "handlerDescription": "Assess whether the verified traveller will make each connection on their booking. The system computes it from the live inbound arrival vs the next departure and the minimum connection time, and returns SAFE, AT_RISK or MISSED per connection, plus the earliest_rebook_departure a replacement flight must leave after. This is computed - never estimate connection risk yourself.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:check_connection_risk_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "check_connection_risk_flow",
          "description": "Assess whether the verified traveller will make each connection on their booking. The system computes it from the live inbound arrival vs the next departure and the minimum connection time, and returns SAFE, AT_RISK or MISSED per connection, plus the earliest_rebook_departure a replacement flight must leave after. This is computed - never estimate connection risk yourself.",
          "schemas": {
            "output": {
              "arguments": "schema://check_connection_risk_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_rebook",
            "handlerDescription": "Step 1 of 2 for rebooking a disrupted leg. Give the leg's current flight and the chosen new flight. The system checks every rule (ownership, the leg is changeable, same route, target not cancelled, seats available, and that it departs after the inbound arrival plus the minimum connection) and returns PROPOSED with an action_id, new seat and times, or NOT_PROPOSED with the reason. Nothing changes until confirm_rebook is called.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_rebook_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_rebook_flow",
          "description": "Step 1 of 2 for rebooking a disrupted leg. Give the leg's current flight and the chosen new flight. The system checks every rule (ownership, the leg is changeable, same route, target not cancelled, seats available, and that it departs after the inbound arrival plus the minimum connection) and returns PROPOSED with an action_id, new seat and times, or NOT_PROPOSED with the reason. Nothing changes until confirm_rebook is called.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_rebook_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_rebook",
            "handlerDescription": "Step 2 of 2: execute a rebooking the traveller has explicitly confirmed. Pass the action_id from propose_rebook. The system re-checks every rule and expires proposals after 15 minutes. Returns EXECUTED (with the new flight, seat and times) or NOT_EXECUTED with the reason. Only call after the traveller says yes to the exact proposal.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:confirm_rebook_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "confirm_rebook_flow",
          "description": "Step 2 of 2: execute a rebooking the traveller has explicitly confirmed. Pass the action_id from propose_rebook. The system re-checks every rule and expires proposals after 15 minutes. Returns EXECUTED (with the new flight, seat and times) or NOT_EXECUTED with the reason. Only call after the traveller says yes to the exact proposal.",
          "schemas": {
            "output": {
              "arguments": "schema://confirm_rebook_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "email_my_confirmation",
            "handlerDescription": "Email the traveller the confirmation for a rebooking they have already executed (action_id ACT-... from confirm_rebook) or for one of their cases that a person has already decided (case id SC-... from get_my_cases). The system sends the email only when that reference belongs to this session and is executed / decided; otherwise it returns NOT_SENT with the reason.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:email_my_confirmation_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "email_my_confirmation_flow",
          "description": "Email the traveller the confirmation for a rebooking they have already executed (action_id ACT-... from confirm_rebook) or for one of their cases that a person has already decided (case id SC-... from get_my_cases). The system sends the email only when that reference belongs to this session and is executed / decided; otherwise it returns NOT_SENT with the reason.",
          "schemas": {
            "output": {
              "arguments": "schema://email_my_confirmation_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "open_service_case",
            "handlerDescription": "Hand a request that needs a human to the right team: COMPENSATION_CLAIM (delay/cancellation compensation), COMPLAINT (service complaint), NAME_CHANGE (change the name on a ticket) or OTHER - and BAGGAGE_CLAIM / SPECIAL_ASSISTANCE only when record_baggage_claim / request_assistance cannot be used. The system routes it, works out what a person could approve (for compensation: up to the disruption band's maximum, or less if the traveller asks for less) and returns CASE_OPENED with case_id, team, reply-by date and requested amount, ALREADY_OPEN when the same request is already with the team, or NOT_OPENED with the reason. A person decides; the assistant never decides these.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:open_service_case_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "open_service_case_flow",
          "description": "Hand a request that needs a human to the right team: COMPENSATION_CLAIM (delay/cancellation compensation), COMPLAINT (service complaint), NAME_CHANGE (change the name on a ticket) or OTHER - and BAGGAGE_CLAIM / SPECIAL_ASSISTANCE only when record_baggage_claim / request_assistance cannot be used. The system routes it, works out what a person could approve (for compensation: up to the disruption band's maximum, or less if the traveller asks for less) and returns CASE_OPENED with case_id, team, reply-by date and requested amount, ALREADY_OPEN when the same request is already with the team, or NOT_OPENED with the reason. A person decides; the assistant never decides these.",
          "schemas": {
            "output": {
              "arguments": "schema://open_service_case_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_cases",
            "handlerDescription": "List the verified traveller's open and past cases with the assigned team, status (OPEN, APPROVED, REJECTED), requested amount, reply-by date and - once a person has decided - the approved amount and the message from the team (customer_message). Use it when the traveller asks about the status of a request.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
