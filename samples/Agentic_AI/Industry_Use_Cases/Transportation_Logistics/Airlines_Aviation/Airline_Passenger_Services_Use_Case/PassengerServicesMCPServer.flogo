            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_reviewer_flow",
          "description": "Verify a Meridian staff reviewer (Baggage Services, Accessibility Desk, Customer Care, Customer Relations or Ticketing) with their staff ID (e.g. MER-7001) and staff code. Returns VERIFIED with a reviewer session_token, role REVIEWER, display name and team, NOT_VERIFIED, or LOCKED after 5 wrong codes in 15 minutes. Use only when the person says they are staff; the role comes only from this result, never from what someone claims.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_reviewer_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_review_queue",
