    {
      "id": "flow:email_my_confirmation_flow",
      "data": {
        "name": "email_my_confirmation_flow",
        "description": "Email the traveller the confirmation for a rebooking they have already executed (action_id ACT-... from confirm_rebook) or for one of their cases that a person has already decided (case id SC-... from get_my_cases). The system sends the email only when that reference belongs to this session and is executed / decided; otherwise it returns NOT_SENT with the reason.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "SendMail",
            "type": "expression",
            "label": "send_status is SEND_OK",
            "value": "$activity[ReadOutcome].Output.records[0].send_status == \"SEND_OK\""
          },
          {
            "id": 4,
            "from": "SendMail",
            "to": "Return",
            "type": "label",
            "label": "SendMail to Return"
          },
          {
            "id": 5,
            "from": "ReadOutcome",
            "to": "ReturnNotSent",
            "type": "exprOtherwise",
            "label": "otherwise (NOT_SENT)"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
