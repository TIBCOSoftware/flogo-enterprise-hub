            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "decide_review_case",
            "handlerDescription": "Record the reviewer's decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved payment in dollars (empty = the full requested amount; ignored for REJECT and for cases without an amount); internal_note is required (at least 5 characters, never shown to the traveller); customer_message is what the traveller will see. Approving runs the parked action (compensation or interim-expense payment, or confirming the assistance on the flight) through the system's checks. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior reviewer), INVALID_DECISION or NOT_FOUND, or NOT_REVIEWER.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
