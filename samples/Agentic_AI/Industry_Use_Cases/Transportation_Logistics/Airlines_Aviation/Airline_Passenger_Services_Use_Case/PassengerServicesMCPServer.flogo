    {
      "id": "flow:open_service_case_flow",
      "data": {
        "name": "open_service_case_flow",
        "description": "Hand a request that needs a human to the right team: COMPENSATION_CLAIM (delay/cancellation compensation), COMPLAINT (service complaint), NAME_CHANGE (change the name on a ticket) or OTHER - and BAGGAGE_CLAIM / SPECIAL_ASSISTANCE only when record_baggage_claim / request_assistance cannot be used. The system routes it, works out what a person could approve (for compensation: up to the disruption band&#39;s maximum, or less if the traveller asks for less) and returns CASE_OPENED with case_id, team, reply-by date and requested amount, ALREADY_OPEN when the same request is already with the team, or NOT_OPENED with the reason. A person decides; the assistant never decides these.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
