    {
      "id": "flow:open_service_case_flow",
      "data": {
        "name": "open_service_case_flow",
        "description": "Hand a request that needs a human to the right team: FEE_REFUND (refund of a fee such as overdraft), LOAN_HARDSHIP (payment difficulty, deferral), CREDIT_LIMIT_INCREASE, COMPLAINT, PERSONAL_DETAILS_CHANGE (address, phone, name), ACCOUNT_CLOSURE, BEREAVEMENT, FRAUD_REVIEW or OTHER. The system routes it and returns CASE_OPENED with case_id (CASE-NNNNN), team and reply time in business days, or NOT_OPENED with BAD_TYPE or SESSION_INVALID. The assistant never decides, approves, promises or predicts the outcome of these requests.",
        "links": [
          {
