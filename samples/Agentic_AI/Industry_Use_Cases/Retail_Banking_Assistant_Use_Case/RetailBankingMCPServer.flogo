            }
          },
          "name": "get_my_loans_flow"
        },
        {
          "description": "Find Kestrel Bank branches by city (or branch name, state or ZIP). Public information: no verification or session token needed. Pass an empty city to list all branches. Returns address, phone and opening hours, or NOT_FOUND.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "find_branch",
            "handlerDescription": "Find Kestrel Bank branches by city (or branch name, state or ZIP). Public information: no verification or session token needed. Pass an empty city to list all branches. Returns address, phone and opening hours, or NOT_FOUND.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
