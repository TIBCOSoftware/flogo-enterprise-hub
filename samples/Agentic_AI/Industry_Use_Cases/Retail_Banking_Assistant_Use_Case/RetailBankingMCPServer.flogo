            },
            "output": {
              "arguments": "schema://get_my_transactions_Args"
            }
          },
          "name": "get_my_transactions_flow"
        },
        {
          "description": "List the verified customer&#39;s own cards: card_id, last 4 digits, DEBIT/CREDIT, network, status (ACTIVE, BLOCKED, EXPIRED), expiry, credit limit and, for a blocked card, the replacement&#39;s expected delivery date. Only this customer&#39;s cards are returned.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
