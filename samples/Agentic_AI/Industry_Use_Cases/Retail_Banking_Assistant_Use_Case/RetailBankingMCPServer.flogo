  "resources": [
    {
      "id": "flow:verify_customer_flow",
      "data": {
        "name": "verify_customer_flow",
        "description": "Verify the customer&#39;s identity with their Kestrel Bank customer id (e.g. CUST-2026-00101) and the 6-digit passcode from their Kestrel app. Returns VERIFIED with a session_token (valid 30 minutes) and their name, NOT_VERIFIED when the id and passcode do not match, or LOCKED after 5 failed attempts in 15 minutes (no token is issued while locked, even with the right passcode; offer account recovery only). Call this before any other customer tool. Never reveal, hint at or guess passcodes.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
