            }
          },
          "name": "open_service_case_flow"
        },
        {
          "description": "List the verified customer&#39;s disputes (DSP-) and service cases (CASE-) with type, status, assigned team, amount, provisional credit and the expected decision or reply date.",
          "settings": {
            "handlerType": "Tool",
