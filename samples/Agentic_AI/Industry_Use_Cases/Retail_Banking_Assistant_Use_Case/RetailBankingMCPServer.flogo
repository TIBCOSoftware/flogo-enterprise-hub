    {
      "id": "flow:email_my_confirmation_flow",
      "data": {
        "name": "email_my_confirmation_flow",
        "description": "Email the confirmation for a dispute (DSP-...) or card block (BLK-...) of this customer. Pass the reference_id from confirm_dispute or confirm_card_block. The system sends the email only when that reference belongs to this session&#39;s customer; otherwise it returns NOT_SENT with reason_code NO_SUCH_REFERENCE or SESSION_INVALID. Call only after a successful filing or block.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadOutcome",
            "type": "label",
            "label": "StartActivity to ReadOutcome"
          },
          {
            "id": 2,
            "from": "ReadOutcome",
            "to": "SendMail",
            "type": "expression",
            "label": "send_status is SEND",
            "value": "$activity[ReadOutcome].Output.records[0].send_status == \"SEND\""
          },
          {
            "id": 3,
            "from": "SendMail",
            "to": "Return",
            "type": "label",
            "label": "SendMail to Return"
          },
          {
            "id": 4,
            "from": "ReadOutcome",
            "to": "ReturnNotSent",
            "type": "exprOtherwise",
            "label": "otherwise (NOT_SENT)"
          }
        ],
        "tasks": [
