{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/trigger/agent",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "AuthorServicesAgents",
  "description": "Author Services A2A agent - journal matching (read-only)",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "Recommends alternative journals for a manuscript from its title, abstract, keywords and word count. Read-only: it searches the journal catalogue and ranks candidates; it cannot transfer anything.",
      "settings": {
        "llmProviderConnection": "conn://5fa9cd3e-50a3-4dea-b9c8-a2fd204ddb0e",
        "agentName": "journal_match_agent",
        "agentDescription": "Recommends alternative journals for a manuscript from its title, abstract, keywords and word count. Read-only: it searches the journal catalogue and ranks candidates; it cannot transfer anything.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"journal_match_agent_PORT\"]",
        "agentUrl": "=$property[\"journal_match_agent_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": "0",
        "enableGuardrails": "true",
        "rateLimit": 25,
        "tokenLimit": 2048,
        "redactSensitiveData": "true",
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": "20",
        "systemPrompt": "You recommend journals for a manuscript that received a transfer offer. You are given the manuscript's\ntitle, abstract, keywords, article type, word count and current journal code. You are never given the author's identity.\n\n1. Extract 4-8 topic keywords and one broad subject area, then call the search_journals tool exactly once.\n   If it returns nothing useful, retry once with broader keywords.\n2. From the returned journals only, pick up to 3 that best fit the manuscript's topic and method.\n   Exclude the current journal. Exclude any journal whose word_limit is below the manuscript's word count\n   and say which ones you excluded for that reason.\n3. For each pick return: journal_code, title, one sentence on why the aims & scope fit, oa_model, apc_usd,\n   word_limit and median_days_to_first_decision, copied exactly from the tool result.\n\nNever invent journals, codes, fees or turnaround times. Do not state whether the author's institution covers\nthe fee - that is checked elsewhere. Reply as a short numbered list."
      },
      "id": "journal_match_agent",
      "handlers": [
        {
          "description": "Search active journals that accept transfers by topic. Pass comma-separated keywords taken from the manuscript&#39;s title, abstract and keywords, and optionally a broad subject area. Returns up to 8 journals with aims &amp; scope, OA model, APC, word limit and a relevance score.",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "search_journals",
            "agentToolDescription": "Search active journals that accept transfers by topic. Pass comma-separated keywords taken from the manuscript's title, abstract and keywords, and optionally a broad subject area. Returns up to 8 journals with aims & scope, OA model, APC, word limit and a relevance score.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:journal_match_agent_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"data\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"data\": {\n      \"type\": \"string\"\n    }\n  }\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"keywords\": {\n      \"type\": \"string\",\n      \"description\": \"Comma-separated topic keywords\"\n    },\n    \"subject_area\": {\n      \"type\": \"string\",\n      \"description\": \"Optional broad subject area, or empty\"\n    }\n  },\n  \"required\": [\n    \"keywords\"\n  ]\n}",
                "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"keywords\": {\n      \"type\": \"string\",\n      \"description\": \"Comma-separated topic keywords\"\n    },\n    \"subject_area\": {\n      \"type\": \"string\",\n      \"description\": \"Optional broad subject area, or empty\"\n    }\n  },\n  \"required\": [\n    \"keywords\"\n  ]\n}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "journal_match_agent_flow"
        }
      ]
    }
  ],
