                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"journal_code\": {\"type\": \"string\"}, \"title\": {\"type\": \"string\"}, \"subject_area\": {\"type\": \"string\"}, \"oa_model\": {\"type\": \"string\"}, \"apc_usd\": {\"type\": \"number\"}, \"word_limit\": {\"type\": \"number\"}, \"median_days_to_first_decision\": {\"type\": \"number\"}, \"aims_scope\": {\"type\": \"string\"}, \"relevance\": {\"type\": \"number\"}}}}}}"
                  }
