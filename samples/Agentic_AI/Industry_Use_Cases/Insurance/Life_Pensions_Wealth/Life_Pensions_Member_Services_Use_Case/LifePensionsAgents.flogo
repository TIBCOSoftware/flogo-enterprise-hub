            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "customConversationStoreOpOutput": {}
          },
          "name": "get_life_event_checklist_flow",
          "description": "Reads Harborline Life & Retirement's life-event checklist from the database: what is typically reviewed after each life event, the beneficiary relationship values, primary vs contingent beneficiaries and shares, ERISA spousal consent for 401(k) beneficiaries, and which team helps with what. Rows of section, term, meaning. Read-only reference data with no member data. Pass term \"\" for the whole guide.",
          "schemas": {
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"type\": \"object\", \"properties\": {\"term\": {\"type\": \"string\", \"description\": \"Optional lookup: one or more words separated by commas (for example a claim type, a life event, a denial reason or a section name), or an empty string for the whole guide. Never put member details here.\"}}, \"required\": [\"term\"]}",
                "fe_metadata": "{\"type\": \"object\", \"properties\": {\"term\": {\"type\": \"string\", \"description\": \"Optional lookup: one or more words separated by commas (for example a claim type, a life event, a denial reason or a section name), or an empty string for the whole guide. Never put member details here.\"}}, \"required\": [\"term\"]}"
              }
            },
            "reply": {
              "response": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"}}}"
