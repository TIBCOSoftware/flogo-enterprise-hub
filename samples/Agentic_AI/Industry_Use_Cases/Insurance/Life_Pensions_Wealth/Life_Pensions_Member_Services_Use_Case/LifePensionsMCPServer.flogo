    {
      "id": "flow:propose_contribution_change_flow",
      "data": {
        "name": "propose_contribution_change_flow",
        "description": "Step 1 of 2 to change the verified member&#39;s 401(k) payroll contribution rate. Pass the new rate as a whole percent of pay (e.g. 6). The system checks the plan maximum and the IRS annual limit and returns PROPOSED with a proposal_id, a summary and the effective payroll date (expires in 15 minutes), or BLOCKED with a reason_code and reason_text. Nothing changes until confirm_action is called after the member explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
