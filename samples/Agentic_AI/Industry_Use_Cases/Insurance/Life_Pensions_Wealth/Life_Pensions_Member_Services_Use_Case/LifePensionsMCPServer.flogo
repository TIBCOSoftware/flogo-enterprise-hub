  ],
  "name": "LifePensionsMCPServer",
  "description": "Harborline Life &amp; Retirement member services MCP Server - scoped reads, guarded writes and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "LifePensionsMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/lifepensionsmcpserver",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
