        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_contribution_change",
            "handlerDescription": "Step 1 of 2 to change the verified member's 401(k) payroll contribution rate. Pass the new rate as a whole percent of pay (e.g. 6). The system checks the plan maximum and the IRS annual limit and returns PROPOSED with a proposal_id, a summary and the effective payroll date (expires in 15 minutes), or BLOCKED with a reason_code and reason_text. Nothing changes until confirm_action is called after the member explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_contribution_change_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_contribution_change_flow",
          "description": "Step 1 of 2 to change the verified member's 401(k) payroll contribution rate. Pass the new rate as a whole percent of pay (e.g. 6). The system checks the plan maximum and the IRS annual limit and returns PROPOSED with a proposal_id, a summary and the effective payroll date (expires in 15 minutes), or BLOCKED with a reason_code and reason_text. Nothing changes until confirm_action is called after the member explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_contribution_change_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_fund_switch",
            "handlerDescription": "Step 1 of 2 to move money between funds inside one of the verified member's retirement accounts. Pass the account_id and from_fund_id from get_my_holdings, the to_fund_id from get_fund_catalog, and the amount in US dollars (e.g. 20000) or ALL for the whole holding. The system checks the holding and the lineup and returns PROPOSED with a proposal_id, summary and trade date (expires in 15 minutes), or BLOCKED with a reason. Nothing moves until confirm_action is called after the member explicitly says yes. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_fund_switch_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_fund_switch_flow",
          "description": "Step 1 of 2 to move money between funds inside one of the verified member's retirement accounts. Pass the account_id and from_fund_id from get_my_holdings, the to_fund_id from get_fund_catalog, and the amount in US dollars (e.g. 20000) or ALL for the whole holding. The system checks the holding and the lineup and returns PROPOSED with a proposal_id, summary and trade date (expires in 15 minutes), or BLOCKED with a reason. Nothing moves until confirm_action is called after the member explicitly says yes. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
