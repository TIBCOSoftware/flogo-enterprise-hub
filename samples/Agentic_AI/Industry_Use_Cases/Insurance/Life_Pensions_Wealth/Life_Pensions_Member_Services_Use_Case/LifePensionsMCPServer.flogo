        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "file_claim",
            "handlerDescription": "File a Critical Illness or Income Protection claim on one of the verified member's policies. Pass the policy_id from get_my_policies, the claim_type (CriticalIllness or IncomeProtection), the member's own description of what happened, and the documents_needed list from the claim intake step (or empty). The system checks that the policy is Active, that the claim type matches the policy and that no claim is already open on it, then returns FILED with claim_id, the claim-decision case_id, team and reply time, or BLOCKED with a reason. A claims examiner decides every claim - never promise or predict payment. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
