      },
      "id": "LifePensionsMCPServer",
      "name": "LifePensionsMCPServer",
      "description": "Harborline Life & Retirement governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_member",
            "handlerDescription": "Verify a Harborline plan member with their member ID (HLR-100101, hlr100101 or 100101 all work) and the one-time code texted to them. Returns VERIFIED with a session_token (valid 60 minutes) and their first name, VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any member tool. Never reveal, guess or hint at codes. Staff use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_member_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_member_flow",
          "description": "Verify a Harborline plan member with their member ID (HLR-100101, hlr100101 or 100101 all work) and the one-time code texted to them. Returns VERIFIED with a session_token (valid 60 minutes) and their first name, VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any member tool. Never reveal, guess or hint at codes. Staff use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_member_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
