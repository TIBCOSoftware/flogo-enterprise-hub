        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_action",
            "handlerDescription": "Step 2 of 2: execute a proposal the member has explicitly confirmed. Pass the proposal_id from propose_contribution_change or propose_fund_switch. The system re-checks every rule and returns EXECUTED with a reference (e.g. HLR-ACT-000101), or BLOCKED / EXPIRED (after 15 minutes) / NOT_FOUND / ALREADY_DONE with the reason. Only call after the member says yes to the exact proposal. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
