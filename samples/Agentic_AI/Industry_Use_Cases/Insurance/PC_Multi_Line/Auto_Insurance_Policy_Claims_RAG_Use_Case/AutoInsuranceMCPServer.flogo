    "github.com/TIBCOSoftware/flogo-enterprise-hub/extensions/openAI/activity/vectorSearch"
  ],
  "name": "AutoInsuranceMCPServer",
  "description": "Copperleaf Auto Insurance policy and claims MCP Server - scoped reads, guarded writes, RAG policy wording and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "AutoInsuranceMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/autoinsurancemcpserver",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "AutoInsuranceMCPServer",
      "name": "AutoInsuranceMCPServer",
      "description": "Copperleaf Auto Insurance governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_policyholder",
            "handlerDescription": "Verify a Copperleaf policyholder with their policy number (CAI-100101, cai100101, CAI 100101 or 100101 all work) and the one-time code texted to them. Returns VERIFIED with a session_token (valid 60 minutes), their first name, the verified policy number, product tier and today's date (YYYY-MM-DD), or VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any customer tool. Never reveal, guess or hint at codes. Staff use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_policyholder_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_policyholder_flow",
          "description": "Verify a Copperleaf policyholder with their policy number (CAI-100101, cai100101, CAI 100101 or 100101 all work) and the one-time code texted to them. Returns VERIFIED with a session_token (valid 60 minutes), their first name, the verified policy number, product tier and today's date (YYYY-MM-DD), or VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any customer tool. Never reveal, guess or hint at codes. Staff use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_policyholder_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_policy",
            "handlerDescription": "Get the verified customer's Copperleaf policies (the verified policy first, verified_policy = yes; older policies such as a cancelled one follow): product tier (Full Coverage, Liability + Comprehensive, Liability Only), policy_status (Active, Pending Renewal, Lapsed, Cancelled) with a status_note, effective and renewal dates, annual premium, payment frequency and installment, claims-free years, discount protection and a claims_free_discount explanation, and the insured vehicle (year, make, model, body type, license plate, VIN, value, usage). Also returns today (YYYY-MM-DD) - use it to turn 'today' / 'yesterday' / 'last Tuesday' into a date.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_policy_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_policy_flow",
          "description": "Get the verified customer's Copperleaf policies (the verified policy first, verified_policy = yes; older policies such as a cancelled one follow): product tier (Full Coverage, Liability + Comprehensive, Liability Only), policy_status (Active, Pending Renewal, Lapsed, Cancelled) with a status_note, effective and renewal dates, annual premium, payment frequency and installment, claims-free years, discount protection and a claims_free_discount explanation, and the insured vehicle (year, make, model, body type, license plate, VIN, value, usage). Also returns today (YYYY-MM-DD) - use it to turn 'today' / 'yesterday' / 'last Tuesday' into a date.",
          "schemas": {
            "output": {
              "arguments": "schema://get_my_policy_Args"
