            "input": "{\"type\": \"object\", \"title\": \"AutoInsuranceMCPServer\", \"properties\": {\"arguments\": {\"type\": \"object\", \"properties\": {\"session_token\": {\"type\": \"string\", \"description\": \"Customer session token returned by verify_policyholder. Required; never invent one. If a tool answers SESSION_INVALID, ask the customer to verify again.\"}, \"request_type\": {\"type\": \"string\", \"description\": \"settlement_dispute | liability_dispute | reinstatement | quote_or_plan_change | callback | complaint\"}, \"summary\": {\"type\": \"string\", \"description\": \"Neutral summary of the request in the customer's words: facts only\"}, \"reference_id\": {\"type\": \"string\", \"description\": \"Claim number (e.g. CLM-2026-0052) or policy number the request is about, or empty\"}}, \"required\": [\"session_token\", \"request_type\", \"summary\", \"reference_id\"]}}}",
            "output": "{\"type\": \"object\", \"title\": \"Inputs\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}, \"required\": [\"response\"]}"
          }
        }
      }
