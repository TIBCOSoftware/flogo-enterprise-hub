    {
      "id": "flow:get_review_queue_flow",
      "data": {
        "name": "get_review_queue_flow",
        "description": "List the verified reviewer&#39;s team queue: OPEN cases ordered by reply-due date, with case_id, request, customer (first name + last initial), claim number, opened date, age in days, reply-due date, sla_status (ON_TRACK, DUE_TODAY, OVERDUE), requested amount and eligible maximum. Status EMPTY = no open cases; NOT_REVIEWER = not a reviewer token.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadOutcome",
            "type": "label",
            "label": "StartActivity to ReadOutcome"
          },
