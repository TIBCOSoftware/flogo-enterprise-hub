        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_review_case",
            "handlerDescription": "Open one case from the reviewer's team queue: request, status, customer (first name + last initial, city/state), the claim facts from Copperleaf's records (claim number, type, incident date and hour, product tier, estimate, deductible, coverage limit, eligible maximum, prior claims in 24 months, policy age at the incident, repair shop), the customer's statement, the AI-prepared agent_brief (unverified: coverage finding, indicators, claim signals and band), the reviewer's own approval limit and the decision options. Another team's case or an unknown id returns NOT_FOUND.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
