                    "Value": false
                  },
                  {
                    "FieldName": "w_amt",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_desc",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_shop",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "d228f923-f44b-46f5-aa37-c23ee71ae11fINSERT INTO pending_claims (policyholder_id, policy_number, target_key, claim_type, incident_date, incident_hour, estimated_amount, description, repair_shop, outcome, reason_code, reason_text, coverage_that_pays, deductible, coverage_limit, discount_impact, summary, signal_points, review_signals) SELECT * FROM propose_claim_fn(CAST(?w_tok AS text), CAST(?w_type AS text), CAST(?w_date AS text), CAST(?w_time AS text), CAST(?w_amt AS text), CAST(?w_desc AS text), CAST(?w_shop AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "w_tok": "=$flow.arguments.session_token",
                      "w_type": "=$flow.arguments.claim_type",
                      "w_date": "=$flow.arguments.incident_date",
                      "w_time": "=$flow.arguments.incident_time",
                      "w_amt": "=$flow.arguments.estimated_amount",
