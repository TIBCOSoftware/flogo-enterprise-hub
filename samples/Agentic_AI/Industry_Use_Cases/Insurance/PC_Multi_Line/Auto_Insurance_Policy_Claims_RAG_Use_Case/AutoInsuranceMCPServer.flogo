            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_payments_flow",
          "description": "List the verified customer's 12 most recent premium payments: policy, due date, amount in USD, payment_status (Paid, Due, Failed, Scheduled), paid date, method and a note.",
          "schemas": {
            "output": {
              "arguments": "schema://get_my_payments_Args"
