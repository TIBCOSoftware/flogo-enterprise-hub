    {
      "id": "flow:open_service_case_flow",
      "data": {
        "name": "open_service_case_flow",
        "description": "Hand a request that needs a person to the right team. request_type is settlement_dispute or liability_dispute (reference_id = the customer&#39;s claim number), reinstatement (lapsed policy), quote_or_plan_change (quotes, adding or changing coverage), callback or complaint (reference_id = a claim or policy number if relevant, else empty). summary is a neutral 1-3 sentence summary in the customer&#39;s words. New claims are never opened here (use propose_claim). The system routes it and returns OPENED with case_id, team and reply time, EXISTING, NOT_FOUND or INVALID_TYPE with a reason. Never decide, promise or predict the outcome. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
