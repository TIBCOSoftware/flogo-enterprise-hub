            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_coverages",
            "handlerDescription": "List the coverages on the verified policy: coverage name, included (yes/no - 'no' means it is not on this policy), limit amount and basis, and deductible in USD. Collision pays collision damage; Comprehensive pays theft, weather (flood, hail, wind), vandalism, animal strikes and glass when there is no Full Glass coverage. These are the facts; for what the policy wording says (exclusions, definitions, conditions) use search_policy_wording.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_coverages_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_coverages_flow",
          "description": "List the coverages on the verified policy: coverage name, included (yes/no - 'no' means it is not on this policy), limit amount and basis, and deductible in USD. Collision pays collision damage; Comprehensive pays theft, weather (flood, hail, wind), vandalism, animal strikes and glass when there is no Full Glass coverage. These are the facts; for what the policy wording says (exclusions, definitions, conditions) use search_policy_wording.",
          "schemas": {
            "output": {
              "arguments": "schema://get_my_coverages_Args"
