        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "search_policy_wording",
            "handlerDescription": "Search Copperleaf's policy wording documents (Full Coverage wording, Liability & Comprehensive wording, Endorsements & Add-ons, Claims Procedure Guide) for what the policy says: what is covered or excluded, definitions, conditions, deductibles rules, the claims-free discount and how to make a claim. Write a short natural-language query and include the customer's product tier in the query (e.g. 'Full Coverage: is flood damage from driving into standing water covered?'). Returns the most relevant passages with document names and scores. Use the passages to answer and name the document; never invent wording, and never use it for the customer's own numbers or status (use the get_my_* tools for facts).",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:search_policy_wording_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "search_policy_wording_flow",
          "description": "Search Copperleaf's policy wording documents (Full Coverage wording, Liability & Comprehensive wording, Endorsements & Add-ons, Claims Procedure Guide) for what the policy says: what is covered or excluded, definitions, conditions, deductibles rules, the claims-free discount and how to make a claim. Write a short natural-language query and include the customer's product tier in the query (e.g. 'Full Coverage: is flood damage from driving into standing water covered?'). Returns the most relevant passages with document names and scores. Use the passages to answer and name the document; never invent wording, and never use it for the customer's own numbers or status (use the get_my_* tools for facts).",
          "schemas": {
            "output": {
              "arguments": "schema://search_policy_wording_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_claim",
            "handlerDescription": "Step 1 of the claim filing (first notice of loss) on the verified policy. Pass the structured fields from the claim intake: claim_type (Collision, Glass, Theft, Weather, Vandalism or Animal), incident_date (YYYY-MM-DD, today or yesterday), incident_time (HH:MM 24-hour, or empty if unknown), estimated_amount in US dollars, the customer's own description and the repair shop (or empty). The system checks the policy is in force, the type, the date is in the policy period, the coverage is on the policy, the amount and duplicates, and returns PROPOSED with a proposal_id, the coverage that pays, the deductible, the claims-free discount impact and a customer-safe summary (expires in 15 minutes), or BLOCKED with a reason_code and reason_text. review_signals is INTERNAL: pass it only to the fraud_signal_agent, never show or read it to the customer. Nothing is filed until confirm_claim is called after the customer explicitly says yes to this summary. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_claim_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_claim_flow",
          "description": "Step 1 of the claim filing (first notice of loss) on the verified policy. Pass the structured fields from the claim intake: claim_type (Collision, Glass, Theft, Weather, Vandalism or Animal), incident_date (YYYY-MM-DD, today or yesterday), incident_time (HH:MM 24-hour, or empty if unknown), estimated_amount in US dollars, the customer's own description and the repair shop (or empty). The system checks the policy is in force, the type, the date is in the policy period, the coverage is on the policy, the amount and duplicates, and returns PROPOSED with a proposal_id, the coverage that pays, the deductible, the claims-free discount impact and a customer-safe summary (expires in 15 minutes), or BLOCKED with a reason_code and reason_text. review_signals is INTERNAL: pass it only to the fraud_signal_agent, never show or read it to the customer. Nothing is filed until confirm_claim is called after the customer explicitly says yes to this summary. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_claim_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "record_claim_assessment",
            "handlerDescription": "Step 2 of the claim filing: save the AI assessments for a PROPOSED claim. Pass the proposal_id from propose_claim and the coverage_interpreter_agent and fraud_signal_agent outputs UNCHANGED: coverage_finding (COVERED, EXCLUDED or UNCLEAR) and coverage_note (clause + document) from the coverage agent; narrative_risk_score (0-100) and risk_indicators from the claim-signal agent. The system combines them with its own checks when the claim is confirmed; nothing is decided or filed here. Returns RECORDED (with the next step) or NOT_FOUND / EXPIRED / ALREADY_DONE. Never tell the customer about scores or indicators. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:record_claim_assessment_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "record_claim_assessment_flow",
          "description": "Step 2 of the claim filing: save the AI assessments for a PROPOSED claim. Pass the proposal_id from propose_claim and the coverage_interpreter_agent and fraud_signal_agent outputs UNCHANGED: coverage_finding (COVERED, EXCLUDED or UNCLEAR) and coverage_note (clause + document) from the coverage agent; narrative_risk_score (0-100) and risk_indicators from the claim-signal agent. The system combines them with its own checks when the claim is confirmed; nothing is decided or filed here. Returns RECORDED (with the next step) or NOT_FOUND / EXPIRED / ALREADY_DONE. Never tell the customer about scores or indicators. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://record_claim_assessment_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_claim",
            "handlerDescription": "Step 3: file a claim the customer has explicitly confirmed. Pass the proposal_id from propose_claim. The system re-checks every rule, files the claim with a claim number (e.g. CLM-2026-0101) and decides the handling: STANDARD (an adjuster contacts the customer within 2 business days) or REVIEW (a claims specialist reviews it under a case reference and replies within the stated business days). Returns FILED with claim_no, claim_status, case_id, reply_text, deductible and discount_impact, or NOT_FOUND / ALREADY_DONE / EXPIRED (after 15 minutes) / BLOCKED with the reason. Read reply_text to the customer; never promise payment. Only call after the customer says yes to the exact summary. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:confirm_claim_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "confirm_claim_flow",
          "description": "Step 3: file a claim the customer has explicitly confirmed. Pass the proposal_id from propose_claim. The system re-checks every rule, files the claim with a claim number (e.g. CLM-2026-0101) and decides the handling: STANDARD (an adjuster contacts the customer within 2 business days) or REVIEW (a claims specialist reviews it under a case reference and replies within the stated business days). Returns FILED with claim_no, claim_status, case_id, reply_text, deductible and discount_impact, or NOT_FOUND / ALREADY_DONE / EXPIRED (after 15 minutes) / BLOCKED with the reason. Read reply_text to the customer; never promise payment. Only call after the customer says yes to the exact summary. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://confirm_claim_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "open_service_case",
            "handlerDescription": "Hand a request that needs a person to the right team. request_type is settlement_dispute or liability_dispute (reference_id = the customer's claim number), reinstatement (lapsed policy), quote_or_plan_change (quotes, adding or changing coverage), callback or complaint (reference_id = a claim or policy number if relevant, else empty). summary is a neutral 1-3 sentence summary in the customer's words. New claims are never opened here (use propose_claim). The system routes it and returns OPENED with case_id, team and reply time, EXISTING, NOT_FOUND or INVALID_TYPE with a reason. Never decide, promise or predict the outcome. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:open_service_case_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "open_service_case_flow",
          "description": "Hand a request that needs a person to the right team. request_type is settlement_dispute or liability_dispute (reference_id = the customer's claim number), reinstatement (lapsed policy), quote_or_plan_change (quotes, adding or changing coverage), callback or complaint (reference_id = a claim or policy number if relevant, else empty). summary is a neutral 1-3 sentence summary in the customer's words. New claims are never opened here (use propose_claim). The system routes it and returns OPENED with case_id, team and reply time, EXISTING, NOT_FOUND or INVALID_TYPE with a reason. Never decide, promise or predict the outcome. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://open_service_case_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "email_confirmation",
            "handlerDescription": "Email the customer a confirmation of something already done on their account: a claim they filed in chat (CLM-... from confirm_claim) or a decided request (CAI-CASE-...). The system prepares the email only when that reference belongs to this customer (send_status SEND_OK); otherwise NOT_SENT with reason_code NOT_FOUND or SESSION_INVALID. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
