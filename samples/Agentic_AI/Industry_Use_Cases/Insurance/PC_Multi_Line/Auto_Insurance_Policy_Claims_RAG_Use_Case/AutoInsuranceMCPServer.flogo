            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Connection": "conn://886d7374-6135-4a9d-8d2c-09b386e79146",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT * FROM review_queue(CAST(?tok AS text));",
                "manualmode": false,
