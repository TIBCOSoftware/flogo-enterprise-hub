    {
      "id": "flow:get_my_policy_flow",
      "data": {
        "name": "get_my_policy_flow",
        "description": "Get the verified customer&#39;s Copperleaf policies (the verified policy first, verified_policy = yes; older policies such as a cancelled one follow): product tier (Full Coverage, Liability + Comprehensive, Liability Only), policy_status (Active, Pending Renewal, Lapsed, Cancelled) with a status_note, effective and renewal dates, annual premium, payment frequency and installment, claims-free years, discount protection and a claims_free_discount explanation, and the insured vehicle (year, make, model, body type, license plate, VIN, value, usage). Also returns today (YYYY-MM-DD) - use it to turn &#39;today&#39; / &#39;yesterday&#39; / &#39;last Tuesday&#39; into a date.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadOutcome",
