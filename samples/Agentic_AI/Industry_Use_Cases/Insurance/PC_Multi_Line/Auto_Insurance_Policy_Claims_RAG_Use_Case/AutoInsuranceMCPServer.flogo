            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_review_case_flow",
          "description": "Open one case from the reviewer's team queue: request, status, customer (first name + last initial, city/state), the claim facts from Copperleaf's records (claim number, type, incident date and hour, product tier, estimate, deductible, coverage limit, eligible maximum, prior claims in 24 months, policy age at the incident, repair shop), the customer's statement, the AI-prepared agent_brief (unverified: coverage finding, indicators, claim signals and band), the reviewer's own approval limit and the decision options. Another team's case or an unknown id returns NOT_FOUND.",
          "schemas": {
            "output": {
              "arguments": "schema://get_review_case_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "decide_review_case",
            "handlerDescription": "Record the reviewer's decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved claim payment in dollars (APPROVE on a claim case; empty = the full eligible amount; ignored for REJECT); internal_note is required (at least 5 characters, never shown to the customer); customer_message is what the customer will see. Approving a claim case posts the claim payment through the system's checks (and releases any payment hold); rejecting denies the claim. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_FOUND, NOT_YOUR_TEAM, ALREADY_DECIDED, INVALID_DECISION, NOTE_REQUIRED, AMOUNT_INVALID or OVER_AUTHORITY (case stays open for a senior reviewer), or NOT_REVIEWER. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:decide_review_case_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "decide_review_case_flow",
          "description": "Record the reviewer's decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved claim payment in dollars (APPROVE on a claim case; empty = the full eligible amount; ignored for REJECT); internal_note is required (at least 5 characters, never shown to the customer); customer_message is what the customer will see. Approving a claim case posts the claim payment through the system's checks (and releases any payment hold); rejecting denies the claim. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_FOUND, NOT_YOUR_TEAM, ALREADY_DECIDED, INVALID_DECISION, NOTE_REQUIRED, AMOUNT_INVALID or OVER_AUTHORITY (case stays open for a senior reviewer), or NOT_REVIEWER. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://decide_review_case_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        }
      ]
    }
