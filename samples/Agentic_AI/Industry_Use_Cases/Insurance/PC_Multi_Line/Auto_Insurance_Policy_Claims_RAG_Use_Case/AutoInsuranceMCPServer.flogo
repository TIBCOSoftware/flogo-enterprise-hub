    {
      "id": "flow:propose_claim_flow",
      "data": {
        "name": "propose_claim_flow",
        "description": "Step 1 of the claim filing (first notice of loss) on the verified policy. Pass the structured fields from the claim intake: claim_type (Collision, Glass, Theft, Weather, Vandalism or Animal), incident_date (YYYY-MM-DD, today or yesterday), incident_time (HH:MM 24-hour, or empty if unknown), estimated_amount in US dollars, the customer&#39;s own description and the repair shop (or empty). The system checks the policy is in force, the type, the date is in the policy period, the coverage is on the policy, the amount and duplicates, and returns PROPOSED with a proposal_id, the coverage that pays, the deductible, the claims-free discount impact and a customer-safe summary (expires in 15 minutes), or BLOCKED with a reason_code and reason_text. review_signals is INTERNAL: pass it only to the fraud_signal_agent, never show or read it to the customer. Nothing is filed until confirm_claim is called after the customer explicitly says yes to this summary. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
