            "input": "{\"type\": \"object\", \"title\": \"AutoInsuranceMCPServer\", \"properties\": {\"arguments\": {\"type\": \"object\", \"properties\": {\"session_token\": {\"type\": \"string\", \"description\": \"Customer session token returned by verify_policyholder. Required; never invent one. If a tool answers SESSION_INVALID, ask the customer to verify again.\"}, \"proposal_id\": {\"type\": \"string\", \"description\": \"proposal_id from propose_claim, e.g. CAI-PRP-1A2B3C4D\"}, \"coverage_finding\": {\"type\": \"string\", \"description\": \"coverage_interpreter_agent coverage_finding: COVERED | EXCLUDED | UNCLEAR\"}, \"coverage_note\": {\"type\": \"string\", \"description\": \"coverage_interpreter_agent clause and rationale, unchanged\"}, \"narrative_risk_score\": {\"type\": \"string\", \"description\": \"fraud_signal_agent narrative_risk_score, an integer 0-100, unchanged\"}, \"risk_indicators\": {\"type\": \"string\", \"description\": \"fraud_signal_agent indicators, unchanged (semicolon-separated)\"}}, \"required\": [\"session_token\", \"proposal_id\", \"coverage_finding\", \"coverage_note\", \"narrative_risk_score\", \"risk_indicators\"]}}}",
            "output": "{\"type\": \"object\", \"title\": \"Inputs\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}, \"required\": [\"response\"]}"
          }
        }
      }
    },
    {
      "id": "flow:confirm_claim_flow",
      "data": {
        "name": "confirm_claim_flow",
        "description": "Step 3: file a claim the customer has explicitly confirmed. Pass the proposal_id from propose_claim. The system re-checks every rule, files the claim with a claim number (e.g. CLM-2026-0101) and decides the handling: STANDARD (an adjuster contacts the customer within 2 business days) or REVIEW (a claims specialist reviews it under a case reference and replies within the stated business days). Returns FILED with claim_no, claim_status, case_id, reply_text, deductible and discount_impact, or NOT_FOUND / ALREADY_DONE / EXPIRED (after 15 minutes) / BLOCKED with the reason. Read reply_text to the customer; never promise payment. Only call after the customer says yes to the exact summary. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
