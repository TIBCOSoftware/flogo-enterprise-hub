            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_cases",
            "handlerDescription": "List the verified customer's requests that a person decides (claim reviews, settlement or fault reviews, reinstatement, quotes, callbacks, complaints): case_id, request, what it is about, team, case_status (OPEN, APPROVED, REJECTED), opened and reply-due dates, outcome amount, decided date and the customer_message from the team once decided. Use it when the customer asks about the status of a claim review or request.",
            "toolTitle": "",
