    {
      "id": "flow:decide_review_case_flow",
      "data": {
        "name": "decide_review_case_flow",
        "description": "Record the reviewer&#39;s decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved claim payment in dollars (APPROVE on a claim case; empty = the full eligible amount; ignored for REJECT); internal_note is required (at least 5 characters, never shown to the customer); customer_message is what the customer will see. Approving a claim case posts the claim payment through the system&#39;s checks (and releases any payment hold); rejecting denies the claim. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_FOUND, NOT_YOUR_TEAM, ALREADY_DECIDED, INVALID_DECISION, NOTE_REQUIRED, AMOUNT_INVALID or OVER_AUTHORITY (case stays open for a senior reviewer), or NOT_REVIEWER. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
