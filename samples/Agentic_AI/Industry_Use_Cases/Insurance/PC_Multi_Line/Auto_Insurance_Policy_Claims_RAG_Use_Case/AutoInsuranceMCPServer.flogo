          {
            "activity": {
              "input": {
                "Connection": "conn://886d7374-6135-4a9d-8d2c-09b386e79146",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO pending_claims (policyholder_id, policy_number, target_key, claim_type, incident_date, incident_hour, estimated_amount, description, repair_shop, outcome, reason_code, reason_text, coverage_that_pays, deductible, coverage_limit, discount_impact, summary, signal_points, review_signals) SELECT * FROM propose_claim_fn(CAST(?w_tok AS text), CAST(?w_type AS text), CAST(?w_date AS text), CAST(?w_time AS text), CAST(?w_amt AS text), CAST(?w_desc AS text), CAST(?w_shop AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_tok",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
