          {
            "id": "RecordIndex",
            "name": "RecordIndex",
            "description": "This activity inserts records into a PostgreSQL database",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://1bdafcdb-682c-497c-93ad-cc21254b64cf",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO document_index (vector_store_id, store_name, files_ingested) SELECT * FROM record_vector_store(CAST(?w_vs AS text), CAST(?w_name AS text), CAST(?w_files AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_vs",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_name",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_files",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "bffdee2a-0d82-444a-804f-e16e2e5bd588INSERT INTO document_index (vector_store_id, store_name, files_ingested) SELECT * FROM record_vector_store(CAST(?w_vs AS text), CAST(?w_name AS text), CAST(?w_files AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "w_vs": "=$activity[CreateVectorStore].id",
                      "w_name": "=$activity[CreateVectorStore].name",
                      "w_files": "4"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"values\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"parameters\": {\"type\": \"object\", \"properties\": {\"w_vs\": {\"type\": \"string\"}, \"w_name\": {\"type\": \"string\"}, \"w_files\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"values\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"parameters\": {\"type\": \"object\", \"properties\": {\"w_vs\": {\"type\": \"string\"}, \"w_name\": {\"type\": \"string\"}, \"w_files\": {\"type\": \"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
