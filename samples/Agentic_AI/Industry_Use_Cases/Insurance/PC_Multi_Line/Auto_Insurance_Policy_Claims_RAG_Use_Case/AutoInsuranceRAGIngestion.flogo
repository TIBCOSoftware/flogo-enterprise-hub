            },
            "activity": {
              "ref": "#vectorStoreCreate",
              "settings": {
                "endPointURL": "=$property[\"OPENAI_API_ENDPOINT_URL\"]",
                "apiKey": "=$property[\"OPENAI_API_KEY\"]"
              },
              "input": {
                "name": "CopperleafAutoPolicyKB",
                "description": "Copperleaf Auto Insurance policy wording knowledge base",
                "expiresAfterDays": 0,
                "maxChunkSizeTokens": 800,
                "chunkOverlapTokens": 400,
                "timeoutSeconds": 120,
                "fileIds": {
