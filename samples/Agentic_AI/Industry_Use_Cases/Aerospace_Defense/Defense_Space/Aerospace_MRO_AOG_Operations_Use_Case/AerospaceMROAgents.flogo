          {
            "activity": {
              "input": {
                "Connection": "conn://876184e2-e113-4f9a-9157-a854dadf8f15",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT * FROM ref_ata_chapters(CAST(?lookup AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "lookup",
