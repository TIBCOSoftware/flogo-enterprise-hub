    {
      "id": "flow:open_service_case_flow",
      "data": {
        "name": "open_service_case_flow",
        "description": "Hand a request that a person must decide to the right team. request_type is return_to_service (return-to-service sign-off, including closing an AOG), ad_compliance (airworthiness directive compliance), mel_deferral (deferring an item under the MEL), grounding_change (grounding or ungrounding an aircraft) or reliability_review (a repeat defect; agent_brief = the repeat-defect agent&#39;s flag). summary is a neutral 1-3 sentence summary in the controller&#39;s own words. The system routes it and returns OPENED with case_id, team and reply time, EXISTING, or BLOCKED / INVALID_TYPE with a reason. The assistant never signs off, defers, grounds or releases an aircraft and never promises or predicts the outcome. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
