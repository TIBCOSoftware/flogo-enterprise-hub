    "act_postgresql_query github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "act_default_actreturn github.com/project-flogo/contrib/activity/actreturn",
    "github.com/project-flogo/contrib/function/coerce",
    "act_general_sendmail github.com/tibco/flogo-general/src/app/General/activity/sendmail"
  ],
  "name": "AerospaceMROMCPServer",
  "description": "Northvale Aero Services MRO AOG operations MCP Server - scoped reads, guarded writes and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "AerospaceMROMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/aerospacemromcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "AerospaceMROMCPServer",
      "name": "AerospaceMROMCPServer",
      "description": "Northvale Aero Services governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_controller",
            "handlerDescription": "Verify a Northvale MRO controller with their staff ID (NVA-2101, nva2101 or 2101 all work) and their one-time code. Returns VERIFIED with a session_token (valid 60 minutes), their name, their base and their per-order part spend limit, VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any controller tool. Never reveal, guess or hint at codes. Maintenance managers and Quality & Airworthiness inspectors reviewing cases use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_controller_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_controller_flow",
          "description": "Verify a Northvale MRO controller with their staff ID (NVA-2101, nva2101 or 2101 all work) and their one-time code. Returns VERIFIED with a session_token (valid 60 minutes), their name, their base and their per-order part spend limit, VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any controller tool. Never reveal, guess or hint at codes. Maintenance managers and Quality & Airworthiness inspectors reviewing cases use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_controller_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
