        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "decide_review_case",
            "handlerDescription": "Record the reviewer's decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved NUMBER OF UNITS for a part spend approval (empty = everything requested; ignored for REJECT and for cases without a quantity); internal_note is required (at least 5 characters, never shown to the controller); customer_message is what the controller will see. Approving runs the parked action (place the part order, or record the return to service) through the system's checks. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior manager), NOT_READY or NOT_FOUND, or NOT_REVIEWER. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
