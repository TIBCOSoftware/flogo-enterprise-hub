    {
      "id": "flow:email_ops_summary_flow",
      "data": {
        "name": "email_ops_summary_flow",
        "description": "Email the maintenance-control mailbox an ops summary for one aircraft at your base: its status and AOG, part orders with delivery dates, technicians dispatched and its cases. The system writes the email from what was actually recorded and sends it only when something has been done on that aircraft (send_status SEND_OK); otherwise NOT_SENT with reason_code NOTHING_TO_SEND, NOT_FOUND or SESSION_INVALID. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "SendMail",
            "type": "expression",
            "label": "send_status is SEND_OK",
            "value": "$activity[ReadOutcome].Output.records[0].send_status == \"SEND_OK\""
          },
          {
            "id": 4,
            "from": "SendMail",
            "to": "Return",
            "type": "label",
            "label": "SendMail to Return"
          },
          {
            "id": 5,
            "from": "ReadOutcome",
            "to": "ReturnNotSent",
            "type": "exprOtherwise",
            "label": "otherwise (NOT_SENT)"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
