    {
      "id": "flow:propose_part_order_flow",
      "data": {
        "name": "propose_part_order_flow",
        "description": "Step 1 of 2 to order or expedite a part for a work order at your base. Pass the wo_number, a part_number from get_parts, a quantity (1-10) and priority ROUTINE or EXPEDITE. The system checks that the work order is open at your base, the part fits that aircraft type and is not already on order, works out the total and the delivery date from the lead time, and returns PROPOSED with a proposal_id, total_usd, needs_manager_approval and a summary (expires in 15 minutes), or BLOCKED with a reason_code and reason_text. needs_manager_approval = yes means the spend is above the controller&#39;s per-order limit: confirming sends it to a maintenance manager instead of ordering. Nothing happens until confirm_action is called after the controller explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
