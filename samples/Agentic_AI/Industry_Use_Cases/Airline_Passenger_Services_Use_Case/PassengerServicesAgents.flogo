{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/trigger/agent",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/flogo-ai-agent/src/app/AgenticAI/connector/llmprovider",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "PassengerServicesAgents",
  "description": "Meridian Passenger Services governed A2A agent - rebooking options (read-only)",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#agent",
      "name": "flogo-agenticai-agent",
      "description": "Recommends replacement flights for a disrupted leg from the route, an earliest-departure cutoff and the traveller's preferences. Read-only: it searches available flights and ranks them; it cannot rebook anything.",
      "settings": {
        "llmProviderConnection": "conn://4c043606-7840-4593-9a84-a219f2002111",
        "agentName": "rebooking_options_agent",
        "agentDescription": "Recommends replacement flights for a disrupted leg from the route, an earliest-departure cutoff and the traveller's preferences. Read-only: it searches available flights and ranks them; it cannot rebook anything.",
        "agentType": "A2A Server",
        "agentPort": "=$property[\"rebooking_options_agent_PORT\"]",
        "agentUrl": "=$property[\"rebooking_options_agent_URL\"]",
        "agentAuthMode": "None",
        "agentToken": "",
        "model": "=$property[\"LLM_Model\"]",
        "reasoning": "",
        "temperature": "0",
        "enableGuardrails": "true",
        "rateLimit": "30",
        "tokenLimit": "6000",
        "redactSensitiveData": "true",
        "remoteAgents": [],
        "mcpServers": [],
        "conversationStoreType": "Memory",
        "memoryMaxSize": "20",
        "systemPrompt": "You recommend replacement flights for a traveller whose connection is at risk or missed. You are given the\nroute (origin and destination airport codes), the earliest_departure a replacement must leave after, the preferred\ncabin, and the traveller's free-text preferences. You are never given the traveller's identity.\n\n1. Call the search_alternatives tool exactly once with origin, destination, earliest_departure and cabin.\n2. From the returned flights ONLY, rank up to 3 that best match the traveller's stated preferences (e.g. arrive\n   before a certain time, prefer a cabin, avoid a late-night/red-eye arrival, shortest trip). If a preference rules a\n   flight out, say so. Never include a flight the tool did not return.\n3. For each pick give: flight_number, departure time, arrival time, seats_available, cabin and one short sentence on\n   why it fits. If the tool returns no flights, say clearly there is no same-day alternative on this route.\n\nNever invent flights, times or seats. Do not rebook - that is confirmed elsewhere. Reply as a short numbered list."
      },
      "id": "rebooking_options_agent",
      "handlers": [
        {
          "description": "Search available replacement flights for a route after a given earliest departure time. Pass the origin and destination airport codes, the earliest_rebook_departure (ISO timestamp the flight must leave after) and the preferred cabin. Returns up to 8 flights with times, seats and aircraft. Never pass any passenger-identifying information.",
          "settings": {
            "handlerType": "Tool",
            "agentToolName": "search_alternatives",
            "agentToolDescription": "Search available replacement flights for a route after a given earliest departure time. Pass the origin and destination airport codes, the earliest_rebook_departure (ISO timestamp the flight must leave after) and the preferred cabin. Returns up to 8 flights with times, seats and aircraft. Never pass any passenger-identifying information.",
            "agentSkillTags": "",
            "agentSkillExamples": "",
            "customGuardrailType": "BOTH",
            "customConversationStoreOperation": "STORE"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:rebooking_options_agent_flow"
            },
            "input": {
              "toolParams": "=$.toolParams"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"data\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"data\": {\n      \"type\": \"string\"\n    }\n  }\n}"
              },
              "customConversationStoreOpOutput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"success\": {\r\n      \"type\": \"boolean\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"success\"\r\n  ]\r\n}"
              }
            },
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"origin\": {\n      \"type\": \"string\",\n      \"description\": \"Origin airport IATA code, e.g. ATL\"\n    },\n    \"destination\": {\n      \"type\": \"string\",\n      \"description\": \"Destination airport IATA code, e.g. MIA\"\n    },\n    \"earliest_departure\": {\n      \"type\": \"string\",\n      \"description\": \"ISO timestamp the replacement flight must depart after\"\n    },\n    \"cabin\": {\n      \"type\": \"string\",\n      \"description\": \"Preferred cabin: Economy or Business (or empty)\"\n    }\n  },\n  \"required\": [\n    \"origin\",\n    \"destination\",\n    \"earliest_departure\"\n  ]\n}",
                "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"origin\": {\n      \"type\": \"string\",\n      \"description\": \"Origin airport IATA code, e.g. ATL\"\n    },\n    \"destination\": {\n      \"type\": \"string\",\n      \"description\": \"Destination airport IATA code, e.g. MIA\"\n    },\n    \"earliest_departure\": {\n      \"type\": \"string\",\n      \"description\": \"ISO timestamp the replacement flight must depart after\"\n    },\n    \"cabin\": {\n      \"type\": \"string\",\n      \"description\": \"Preferred cabin: Economy or Business (or empty)\"\n    }\n  },\n  \"required\": [\n    \"origin\",\n    \"destination\",\n    \"earliest_departure\"\n  ]\n}"
              },
              "customGuardrailInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"isRequest\": {\r\n      \"type\": \"boolean\"\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"data\",\"isRequest\"\r\n ]\r\n}"
              },
              "customConversationStoreOpInput": {
                "type": "json",
                "value": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}",
                "fe_metadata": "{\r\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"conversationId\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"message\": {\r\n      \"type\": \"object\",\r\n      \"properties\": {\r\n        \"role\": {\r\n          \"type\": \"string\",\r\n          \"enum\":[\"user\", \"assistant\", \"system\", \"tool\"]\r\n        },\r\n        \"content\": {\r\n          \"type\": \"string\"\r\n        },\r\n        \"metadata\": {\r\n          \"type\": \"object\"\r\n        }\r\n      },\r\n      \"required\": [\r\n        \"role\",\r\n        \"content\",\r\n        \"metadata\"\r\n      ]\r\n    }\r\n  },\r\n  \"required\": [\r\n    \"conversationId\",\r\n    \"message\"\r\n  ]\r\n}"
              }
            }
          },
          "name": "rebooking_options_agent_flow"
        }
      ]
    }
  ],
