          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_my_cases_Args"
            }
          },
          "name": "get_my_cases_flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:verify_traveller_flow",
      "data": {
        "name": "verify_traveller_flow",
        "description": "Verify the traveller&#39;s identity with their 6-character PNR (booking reference) and the 4-digit PIN from their Meridian app or booking email. Returns VERIFIED with a session_token (valid 60 minutes), their name and loyalty tier, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess PINs.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GuardedWrite",
            "name": "GuardedWrite",
            "description": "PostgreSQL Insert",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://70c516c8-5e4b-4b42-92ee-126dcceae187",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO traveler_sessions (booking_id) SELECT booking_id FROM verify_and_record(CAST(?w_pnr AS text), CAST(?w_pin AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_pnr",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_pin",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "04da00d9-b6ec-4621-865d-6e9708eeb9e1INSERT INTO traveler_sessions (booking_id) SELECT booking_id FROM verify_and_record(CAST(?w_pnr AS text), CAST(?w_pin AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "w_pnr": "=$flow.arguments.pnr",
                      "w_pin": "=$flow.arguments.pin"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"values\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}},\"parameters\":{\"type\":\"object\",\"properties\":{\"w_pnr\":{\"type\":\"string\"},\"w_pin\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"values\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}},\"parameters\":{\"type\":\"object\",\"properties\":{\"w_pnr\":{\"type\":\"string\"},\"w_pin\":{\"type\":\"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReadOutcome",
            "name": "ReadOutcome",
            "description": "PostgreSQL Query",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://70c516c8-5e4b-4b42-92ee-126dcceae187",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT * FROM verify_result(CAST(?r_pnr AS text), CAST(?r_pin AS text));",
                "manualmode": false,
                "fetchMetadata": false,
                "Fields": [
                  {
                    "FieldName": "r_pnr",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
