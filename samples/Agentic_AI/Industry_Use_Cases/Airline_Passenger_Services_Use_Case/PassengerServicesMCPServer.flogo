                "Schema": "public",
                "Query": "INSERT INTO rebookings (action_id, segment_id, from_flight, to_flight, new_seat) SELECT * FROM rebook_confirmation_row(CAST(?w_tok AS text), CAST(?w_act AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_tok",
