    {
      "id": "flow:propose_rebook_flow",
      "data": {
        "name": "propose_rebook_flow",
        "description": "Step 1 of 2 for rebooking a disrupted leg. Give the leg&#39;s current flight and the chosen new flight. The system checks every rule (ownership, the leg is changeable, same route, target not cancelled, seats available, and that it departs after the inbound arrival plus the minimum connection) and returns PROPOSED with an action_id, new seat and times, or NOT_PROPOSED with the reason. Nothing changes until confirm_rebook is called.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
