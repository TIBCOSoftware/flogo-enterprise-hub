                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "passenger_name",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
