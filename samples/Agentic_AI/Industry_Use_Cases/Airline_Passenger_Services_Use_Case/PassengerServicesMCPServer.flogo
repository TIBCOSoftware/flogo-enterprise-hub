{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "github.com/project-flogo/contrib/activity/actreturn",
    "github.com/tibco/flogo-general/src/app/General/activity/sendmail",
    "github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/contrib/function/coerce",
    "github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection"
  ],
  "name": "PassengerServicesMCPServer",
  "description": "Meridian Passenger Services (governed) MCP Server - scoped reads and guarded writes for verified travellers",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Meridian Passenger Services governed MCP server",
      "settings": {
        "serverName": "PassengerServicesMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/passenger-services-gov-mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "PassengerServicesMCPServer",
      "handlers": [
        {
          "description": "Verify the traveller&#39;s identity with their 6-character PNR (booking reference) and the 4-digit PIN from their Meridian app or booking email. Returns VERIFIED with a session_token (valid 60 minutes), their name and loyalty tier, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess PINs.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_traveller",
            "handlerDescription": "Verify the traveller's identity with their 6-character PNR (booking reference) and the 4-digit PIN from their Meridian app or booking email. Returns VERIFIED with a session_token (valid 60 minutes), their name and loyalty tier, or NOT_VERIFIED. Call this before any other tool. Never reveal or guess PINs.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_traveller_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://verify_traveller_Args"
            }
          },
          "name": "verify_traveller_flow"
        },
        {
          "description": "List the verified traveller&#39;s own itinerary: each leg with flight number, route, scheduled and estimated times, live flight status, delay, gate, seat and cabin. Only this booking&#39;s legs are returned.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_itinerary",
            "handlerDescription": "List the verified traveller's own itinerary: each leg with flight number, route, scheduled and estimated times, live flight status, delay, gate, seat and cabin. Only this booking's legs are returned.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_itinerary_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_my_itinerary_Args"
            }
          },
          "name": "get_my_itinerary_flow"
        },
        {
          "description": "Get the live status of one flight that is on the verified traveller&#39;s own itinerary: scheduled vs estimated times, status, delay minutes and reason, and gate. Returns NOT_ON_ITINERARY for a flight that is not on their booking.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_flight_status",
            "handlerDescription": "Get the live status of one flight that is on the verified traveller's own itinerary: scheduled vs estimated times, status, delay minutes and reason, and gate. Returns NOT_ON_ITINERARY for a flight that is not on their booking.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_flight_status_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_flight_status_Args"
            }
          },
          "name": "get_flight_status_flow"
        },
        {
          "description": "Show the verified traveller&#39;s loyalty standing: frequent-flyer number, tier and miles balance.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_loyalty",
            "handlerDescription": "Show the verified traveller's loyalty standing: frequent-flyer number, tier and miles balance.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_loyalty_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://get_my_loyalty_Args"
            }
          },
          "name": "get_my_loyalty_flow"
        },
        {
          "description": "Assess whether the verified traveller will make each connection on their booking. The system computes it from the live inbound arrival vs the next departure and the minimum connection time, and returns SAFE, AT_RISK or MISSED per connection, plus the earliest_rebook_departure a replacement flight must leave after. This is computed - never estimate connection risk yourself.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "check_connection_risk",
            "handlerDescription": "Assess whether the verified traveller will make each connection on their booking. The system computes it from the live inbound arrival vs the next departure and the minimum connection time, and returns SAFE, AT_RISK or MISSED per connection, plus the earliest_rebook_departure a replacement flight must leave after. This is computed - never estimate connection risk yourself.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:check_connection_risk_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://check_connection_risk_Args"
            }
          },
          "name": "check_connection_risk_flow"
        },
        {
          "description": "Step 1 of 2 for rebooking a disrupted leg. Give the leg&#39;s current flight and the chosen new flight. The system checks every rule (ownership, the leg is changeable, same route, target not cancelled, seats available, and that it departs after the inbound arrival plus the minimum connection) and returns PROPOSED with an action_id, new seat and times, or NOT_PROPOSED with the reason. Nothing changes until confirm_rebook is called.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_rebook",
            "handlerDescription": "Step 1 of 2 for rebooking a disrupted leg. Give the leg's current flight and the chosen new flight. The system checks every rule (ownership, the leg is changeable, same route, target not cancelled, seats available, and that it departs after the inbound arrival plus the minimum connection) and returns PROPOSED with an action_id, new seat and times, or NOT_PROPOSED with the reason. Nothing changes until confirm_rebook is called.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_rebook_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://propose_rebook_Args"
            }
          },
          "name": "propose_rebook_flow"
        },
        {
          "description": "Step 2 of 2: execute a rebooking the traveller has explicitly confirmed. Pass the action_id from propose_rebook. The system re-checks every rule and expires proposals after 15 minutes. Returns EXECUTED (with the new flight, seat and times) or NOT_EXECUTED with the reason. Only call after the traveller says yes to the exact proposal.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_rebook",
            "handlerDescription": "Step 2 of 2: execute a rebooking the traveller has explicitly confirmed. Pass the action_id from propose_rebook. The system re-checks every rule and expires proposals after 15 minutes. Returns EXECUTED (with the new flight, seat and times) or NOT_EXECUTED with the reason. Only call after the traveller says yes to the exact proposal.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:confirm_rebook_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://confirm_rebook_Args"
            }
          },
          "name": "confirm_rebook_flow"
        },
        {
          "description": "Email the traveller the confirmation for a rebooking they have already executed. Pass the action_id from confirm_rebook. The system sends the email only when that rebooking belongs to this session and has been executed; otherwise it returns NOT_SENT with the reason. Call only after a successful rebooking.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "email_my_confirmation",
            "handlerDescription": "Email the traveller the confirmation for a rebooking they have already executed. Pass the action_id from confirm_rebook. The system sends the email only when that rebooking belongs to this session and has been executed; otherwise it returns NOT_SENT with the reason. Call only after a successful rebooking.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:email_my_confirmation_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://email_my_confirmation_Args"
            }
          },
          "name": "email_my_confirmation_flow"
        },
        {
          "description": "Hand a request that needs a human to the right team: COMPENSATION_CLAIM (delay/cancellation compensation or a refund), BAGGAGE_CLAIM (lost, delayed or damaged bags), SPECIAL_ASSISTANCE (mobility, medical or unaccompanied-minor help), COMPLAINT (service complaint), NAME_CHANGE (change the name on a ticket) or OTHER. The system routes it and returns CASE_OPENED with case_id, team and reply time. The assistant never decides, promises or predicts these.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "open_service_case",
            "handlerDescription": "Hand a request that needs a human to the right team: COMPENSATION_CLAIM (delay/cancellation compensation or a refund), BAGGAGE_CLAIM (lost, delayed or damaged bags), SPECIAL_ASSISTANCE (mobility, medical or unaccompanied-minor help), COMPLAINT (service complaint), NAME_CHANGE (change the name on a ticket) or OTHER. The system routes it and returns CASE_OPENED with case_id, team and reply time. The assistant never decides, promises or predicts these.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:open_service_case_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": "schema://ToolResponse"
            },
            "output": {
              "arguments": "schema://open_service_case_Args"
            }
          },
          "name": "open_service_case_flow"
        },
        {
          "description": "List the verified traveller&#39;s open and past service cases with the assigned team and status.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_cases",
            "handlerDescription": "List the verified traveller's open and past service cases with the assigned team and status.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_cases_flow"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
