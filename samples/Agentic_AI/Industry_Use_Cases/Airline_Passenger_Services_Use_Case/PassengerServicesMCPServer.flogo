          {
            "id": "Return",
            "name": "Return",
            "description": "Simple Return",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": {
                    "mapping": {
                      "data": "=coerce.toString($activity[ReadOutcome].Output)"
                    }
                  }
                }
              }
            }
