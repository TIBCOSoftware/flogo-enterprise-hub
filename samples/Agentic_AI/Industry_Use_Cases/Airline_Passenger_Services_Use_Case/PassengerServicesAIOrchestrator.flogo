      }
    },
    "0d5ca2ba-26c5-4673-8e66-54c885bff8ca": {
      "id": "0d5ca2ba-26c5-4673-8e66-54c885bff8ca",
      "name": "PassengerServicesMCPServer",
      "ref": "#mcpserverconfig",
      "isGlobal": false,
      "settings": {
        "name": "PassengerServicesMCPServer",
        "description": "Your mcpserverconfig Connector",
        "serverType": "http",
