    }
  ],
  "connections": {
    "c6acb966-4d1c-4a5d-b1b9-ab0cb481132a": {
      "id": "c6acb966-4d1c-4a5d-b1b9-ab0cb481132a",
      "name": "OpenAIConn",
      "ref": "#llmprovider",
      "isGlobal": false,
      "settings": {
        "name": "OpenAIConn",
        "description": "Your llmprovider Connector",
        "llmProvider": "=$property[\"AgenticAI.OpenAIConn.LLM_Provider\"]",
        "anthropicProvider": "Default",
        "apiKey": "=$property[\"AgenticAI.OpenAIConn.API_Key\"]",
