    {
      "id": "flow:confirm_action_flow",
      "data": {
        "name": "confirm_action_flow",
        "description": "Step 2 of 2: execute a proposal the customer has explicitly confirmed. Pass the proposal_id from propose_action. The system re-checks every rule and returns EXECUTED with a reference (e.g. TW-ACT-000101), or BLOCKED / EXPIRED (proposals expire after 15 minutes) / NOT_FOUND / ALREADY_DONE with the reason. Only call after the customer says yes to the exact proposal. Quote any reason_text to the customer as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Connection": "conn://cd62ecb5-7c22-4463-8912-c4ba1dce7e2d",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO account_events (event_id, reference, proposal_id, customer_id, action_type, target, price, effective_date, summary) SELECT * FROM confirm_action_fn(CAST(?w_tok AS text), CAST(?w_pid AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_tok",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_pid",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
