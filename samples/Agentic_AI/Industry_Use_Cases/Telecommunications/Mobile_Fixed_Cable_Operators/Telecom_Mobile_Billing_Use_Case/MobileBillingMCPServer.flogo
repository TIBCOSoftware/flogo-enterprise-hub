            }
          },
          "name": "email_action_confirmation_flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:verify_customer_flow",
      "data": {
        "name": "verify_customer_flow",
        "description": "Verify the customer with their Tidewell mobile number (2125550101, 212-555-0101, (212) 555-0101 or +1 212 555 0101 all work) and the one-time code sent to that number. Returns VERIFIED with a session_token (valid 30 minutes) and their first name, or VERIFY_FAILED. Call this before any other tool. Never reveal, guess or hint at codes. Quote any reason_text to the customer as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GuardedWrite",
            "name": "GuardedWrite",
            "description": "PostgreSQL Insert",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://51e6e597-f86a-4135-bb7e-df0597038724",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO customer_sessions (customer_id) SELECT customer_id FROM verify_customer_fn(CAST(?w_mob AS text), CAST(?w_otp AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_mob",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
