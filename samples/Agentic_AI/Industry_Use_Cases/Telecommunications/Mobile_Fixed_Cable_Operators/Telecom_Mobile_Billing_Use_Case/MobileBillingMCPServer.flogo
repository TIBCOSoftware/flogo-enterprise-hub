    {
      "id": "flow:email_action_confirmation_flow",
      "data": {
        "name": "email_action_confirmation_flow",
        "description": "Email the confirmation of an action the customer has already completed, or the outcome of one of their cases that a person has decided. Pass the reference from confirm_action (e.g. TW-ACT-000101) or a decided case_id from get_my_cases (e.g. TW-CASE-000044). The system prepares the email only when that reference is an executed action or a decided case on this customer&#39;s account (send_status SEND_OK); otherwise it returns NOT_SENT with reason_code NOT_FOUND or SESSION_INVALID. Quote any reason_text to the customer as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "SendMail",
            "type": "expression",
            "label": "send_status is SEND_OK",
            "value": "$activity[ReadOutcome].Output.records[0].send_status == \"SEND_OK\""
          },
          {
            "id": 4,
            "from": "SendMail",
            "to": "Return",
            "type": "label",
            "label": "SendMail to Return"
          },
          {
            "id": 5,
            "from": "ReadOutcome",
            "to": "ReturnNotSent",
            "type": "exprOtherwise",
            "label": "otherwise (NOT_SENT)"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
