            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_eligible_plans",
            "handlerDescription": "List every other Tidewell plan for the verified customer (data allowance, monthly price in USD, device installment, roaming included) with change_type (UPGRADE / DOWNGRADE), the date it would take effect, the monthly price difference, allowed (yes/no) and, when not allowed, the reason_code and reason_text. Only plans with allowed = yes can be proposed. Quote any reason_text to the customer as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
