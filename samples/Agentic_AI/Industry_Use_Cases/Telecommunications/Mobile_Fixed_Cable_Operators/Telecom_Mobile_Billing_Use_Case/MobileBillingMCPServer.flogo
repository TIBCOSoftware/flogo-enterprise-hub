      "handlers": [
        {
          "description": "Verify the customer with their Tidewell mobile number (2125550101, 212-555-0101, (212) 555-0101 or +1 212 555 0101 all work) and the one-time code sent to that number. Returns VERIFIED with a session_token (valid 30 minutes) and their first name, or VERIFY_FAILED. Call this before any other tool. Never reveal, guess or hint at codes. Quote any reason_text to the customer as written; never change an outcome.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_customer",
            "handlerDescription": "Verify the customer with their Tidewell mobile number (2125550101, 212-555-0101, (212) 555-0101 or +1 212 555 0101 all work) and the one-time code sent to that number. Returns VERIFIED with a session_token (valid 30 minutes) and their first name, or VERIFY_FAILED. Call this before any other tool. Never reveal, guess or hint at codes. Quote any reason_text to the customer as written; never change an outcome.",
