    {
      "id": "flow:decide_review_case_flow",
      "data": {
        "name": "decide_review_case_flow",
        "description": "Record the reviewer&#39;s decision on a case in their team queue - only after the reviewer explicitly confirmed the restated decision. decision is APPROVE or REJECT; amount is the approved credit in dollars (empty = the full eligible amount; ignored for REJECT and for cases without an amount); internal_note is required (at least 5 characters, never shown to the customer); customer_message is what the customer will see. Approving runs the parked action (bill credit, SIM-swap reversal or premium content block) through the system&#39;s checks; rejecting executes nothing. Returns APPROVED / REJECTED with executed_action, or BLOCKED with reason_code NOT_YOUR_TEAM, ALREADY_DECIDED, NOTE_REQUIRED, AMOUNT_INVALID, OVER_AUTHORITY (case stays open for a senior reviewer), INVALID_DECISION or NOT_FOUND, or NOT_REVIEWER.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Connection": "conn://cd62ecb5-7c22-4463-8912-c4ba1dce7e2d",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO review_decisions (case_id, reviewer_id, decision, approved_amount, internal_note, customer_message) SELECT * FROM decide_case_row(CAST(?w_tok AS text), CAST(?w_cid AS text), CAST(?w_dec AS text), CAST(?w_amt AS text), CAST(?w_note AS text), CAST(?w_msg AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_tok",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_cid",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_dec",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_amt",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_note",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_msg",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "33602cd7-2f17-4265-ad54-5f910b77a307INSERT INTO review_decisions (case_id, reviewer_id, decision, approved_amount, internal_note, customer_message) SELECT * FROM decide_case_row(CAST(?w_tok AS text), CAST(?w_cid AS text), CAST(?w_dec AS text), CAST(?w_amt AS text), CAST(?w_note AS text), CAST(?w_msg AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "w_tok": "=$flow.arguments.session_token",
                      "w_cid": "=$flow.arguments.case_id",
                      "w_dec": "=$flow.arguments.decision",
                      "w_amt": "=$flow.arguments.amount",
                      "w_note": "=$flow.arguments.internal_note",
                      "w_msg": "=$flow.arguments.customer_message"
                    }
                  }
                }
              },
              "ref": "#act_postgresql_insert",
              "settings": {},
              "schemas": {
                "input": {
