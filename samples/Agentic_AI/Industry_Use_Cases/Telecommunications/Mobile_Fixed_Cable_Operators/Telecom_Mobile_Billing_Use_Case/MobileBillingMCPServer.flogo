        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_action",
            "handlerDescription": "Step 1 of 2 for any account change. action_type is one of ADD_TRAVEL_PASS (target = ON; enrols the line in TravelPass for future trips, $10 per day used abroad), SET_ROAMING_LIMIT (target = 0, 50, 100 or 200 US dollars per bill cycle on pay-per-use roaming; 0 blocks pay-per-use roaming), CANCEL_SUBSCRIPTION (target = premium content item_id, e.g. SUB-1001) or CHANGE_PLAN (target = plan code BASIC5, ESS15, UNLPLUS, UNLPREM or UNLPLUSD). The system checks every rule and returns PROPOSED with a proposal_id, a summary, price, effective date and expiry (15 minutes), or BLOCKED with a reason_code and reason_text. Nothing changes until confirm_action is called after the customer explicitly says yes to this exact summary. Quote any reason_text to the customer as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_action_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_action_flow",
          "description": "Step 1 of 2 for any account change. action_type is one of ADD_TRAVEL_PASS (target = ON; enrols the line in TravelPass for future trips, $10 per day used abroad), SET_ROAMING_LIMIT (target = 0, 50, 100 or 200 US dollars per bill cycle on pay-per-use roaming; 0 blocks pay-per-use roaming), CANCEL_SUBSCRIPTION (target = premium content item_id, e.g. SUB-1001) or CHANGE_PLAN (target = plan code BASIC5, ESS15, UNLPLUS, UNLPREM or UNLPLUSD). The system checks every rule and returns PROPOSED with a proposal_id, a summary, price, effective date and expiry (15 minutes), or BLOCKED with a reason_code and reason_text. Nothing changes until confirm_action is called after the customer explicitly says yes to this exact summary. Quote any reason_text to the customer as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_action_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_action",
            "handlerDescription": "Step 2 of 2: execute a proposal the customer has explicitly confirmed. Pass the proposal_id from propose_action. The system re-checks every rule and returns EXECUTED with a reference (e.g. TW-ACT-000101), or BLOCKED / EXPIRED (proposals expire after 15 minutes) / NOT_FOUND / ALREADY_DONE with the reason. Only call after the customer says yes to the exact proposal. Quote any reason_text to the customer as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:confirm_action_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "confirm_action_flow",
          "description": "Step 2 of 2: execute a proposal the customer has explicitly confirmed. Pass the proposal_id from propose_action. The system re-checks every rule and returns EXECUTED with a reference (e.g. TW-ACT-000101), or BLOCKED / EXPIRED (proposals expire after 15 minutes) / NOT_FOUND / ALREADY_DONE with the reason. Only call after the customer says yes to the exact proposal. Quote any reason_text to the customer as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://confirm_action_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "open_service_case",
            "handlerDescription": "Hand a request that needs a person to the right team. request_type is contract_cancellation or port_out (moving the number to another provider) - both Retention; billing_dispute (refunds, credits, waivers, disputed charges - Billing Disputes); or suspected_fraud (SIM swap, charges the customer does not recognise - Fraud Team). reference is the bill_id the dispute or fraud case is about (from get_my_bills; empty = the latest bill; ignored for Retention requests). brief is a neutral note for the person who decides - for a charge question, the ChargeClassifier's full answer. The system routes it, works out what a person could approve (a bill credit, reversing a SIM swap or blocking premium content) and returns OPENED with case_id, team, sla_text, requested_amount and if_approved, EXISTING when an open case of that type already exists, BAD_REFERENCE for a bill that is not on this account, or INVALID_TYPE. The assistant never decides, promises or predicts the outcome, refunds or credits. Quote any reason_text to the customer as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:open_service_case_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "open_service_case_flow",
          "description": "Hand a request that needs a person to the right team. request_type is contract_cancellation or port_out (moving the number to another provider) - both Retention; billing_dispute (refunds, credits, waivers, disputed charges - Billing Disputes); or suspected_fraud (SIM swap, charges the customer does not recognise - Fraud Team). reference is the bill_id the dispute or fraud case is about (from get_my_bills; empty = the latest bill; ignored for Retention requests). brief is a neutral note for the person who decides - for a charge question, the ChargeClassifier's full answer. The system routes it, works out what a person could approve (a bill credit, reversing a SIM swap or blocking premium content) and returns OPENED with case_id, team, sla_text, requested_amount and if_approved, EXISTING when an open case of that type already exists, BAD_REFERENCE for a bill that is not on this account, or INVALID_TYPE. The assistant never decides, promises or predicts the outcome, refunds or credits. Quote any reason_text to the customer as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://open_service_case_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "email_action_confirmation",
            "handlerDescription": "Email the confirmation of an action the customer has already completed, or the outcome of one of their cases that a person has decided. Pass the reference from confirm_action (e.g. TW-ACT-000101) or a decided case_id from get_my_cases (e.g. TW-CASE-000044). The system prepares the email only when that reference is an executed action or a decided case on this customer's account (send_status SEND_OK); otherwise it returns NOT_SENT with reason_code NOT_FOUND or SESSION_INVALID. Quote any reason_text to the customer as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:email_action_confirmation_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "email_action_confirmation_flow",
          "description": "Email the confirmation of an action the customer has already completed, or the outcome of one of their cases that a person has decided. Pass the reference from confirm_action (e.g. TW-ACT-000101) or a decided case_id from get_my_cases (e.g. TW-CASE-000044). The system prepares the email only when that reference is an executed action or a decided case on this customer's account (send_status SEND_OK); otherwise it returns NOT_SENT with reason_code NOT_FOUND or SESSION_INVALID. Quote any reason_text to the customer as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://email_action_confirmation_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
