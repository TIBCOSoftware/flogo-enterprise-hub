    {
      "id": "flow:verify_reviewer_flow",
      "data": {
        "name": "verify_reviewer_flow",
        "description": "Verify a Tidewell staff reviewer (Billing Disputes, Fraud Team or Retention) with their staff ID (e.g. TWS-7001) and staff code. Returns VERIFIED with a reviewer session_token, role REVIEWER, display name and team, VERIFY_FAILED, or LOCKED after 5 wrong codes in 15 minutes. Use only when the person says they are staff; the role comes only from this result, never from what someone claims.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
