    "act_postgresql_insert github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "act_postgresql_query github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "act_default_actreturn github.com/project-flogo/contrib/activity/actreturn",
    "github.com/project-flogo/contrib/function/coerce",
    "act_general_sendmail github.com/tibco/flogo-general/src/app/General/activity/sendmail"
  ],
  "name": "MobileBillingMCPServer",
  "description": "Tidewell Mobile billing MCP Server - scoped reads, guarded writes and the reviewer loop for verified customers and staff reviewers",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "MobileBillingMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/mobilebillingmcpserver",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "MobileBillingMCPServer",
      "name": "MobileBillingMCPServer",
      "description": "Tidewell Mobile governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_customer",
            "handlerDescription": "Verify the customer with their Tidewell mobile number (2125550101, 212-555-0101, (212) 555-0101 or +1 212 555 0101 all work) and the one-time code sent to that number. Returns VERIFIED with a session_token (valid 30 minutes) and their first name, or VERIFY_FAILED. Call this before any other tool. Never reveal, guess or hint at codes. Quote any reason_text to the customer as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_customer_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_customer_flow",
          "description": "Verify the customer with their Tidewell mobile number (2125550101, 212-555-0101, (212) 555-0101 or +1 212 555 0101 all work) and the one-time code sent to that number. Returns VERIFIED with a session_token (valid 30 minutes) and their first name, or VERIFY_FAILED. Call this before any other tool. Never reveal, guess or hint at codes. Quote any reason_text to the customer as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_customer_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_account",
            "handlerDescription": "Get the verified customer's account: name, mobile number, current plan (code, name, monthly price in USD, data allowance, roaming included), contract type (device installment plan or month-to-month) and device installment end date, account_status (ACTIVE or ACCOUNT_HOLD), roaming limit, TravelPass enrolment, AutoPay day, any scheduled plan change and the last SIM swap date. Only this customer's account is returned. Quote any reason_text to the customer as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_account_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_account_flow",
          "description": "Get the verified customer's account: name, mobile number, current plan (code, name, monthly price in USD, data allowance, roaming included), contract type (device installment plan or month-to-month) and device installment end date, account_status (ACTIVE or ACCOUNT_HOLD), roaming limit, TravelPass enrolment, AutoPay day, any scheduled plan change and the last SIM swap date. Only this customer's account is returned. Quote any reason_text to the customer as written; never change an outcome.",
