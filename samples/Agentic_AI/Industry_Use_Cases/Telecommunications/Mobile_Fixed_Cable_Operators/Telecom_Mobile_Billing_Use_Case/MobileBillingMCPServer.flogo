    {
      "id": "flow:open_service_case_flow",
      "data": {
        "name": "open_service_case_flow",
        "description": "Hand a request that needs a person to the right team. request_type is contract_cancellation or port_out (moving the number to another provider) - both Retention; billing_dispute (refunds, credits, waivers, disputed charges - Billing Disputes); or suspected_fraud (SIM swap, charges the customer does not recognise - Fraud Team). The system routes it and returns OPENED with case_id, team and sla_text, EXISTING when an open case of that type already exists, or INVALID_TYPE. The assistant never decides, promises or predicts the outcome, refunds or credits. Quote any reason_text to the customer as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
