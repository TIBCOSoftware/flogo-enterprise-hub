                "cc_recipients": "",
                "bcc_recipients": "",
                "reply_to": "=$property[\"Email_Username\"]",
                "subject": "=$activity[ReadOutcome].Output.records[0].subject",
                "message": "=$activity[ReadOutcome].Output.records[0].body"
              }
