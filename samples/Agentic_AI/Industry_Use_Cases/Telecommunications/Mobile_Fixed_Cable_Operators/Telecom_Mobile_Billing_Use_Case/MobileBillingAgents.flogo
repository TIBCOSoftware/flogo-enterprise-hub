            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Connection": "conn://cf637aa8-88b7-414d-9522-45dab0716202",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT * FROM ref_plan_guide(CAST(?lookup AS text));",
