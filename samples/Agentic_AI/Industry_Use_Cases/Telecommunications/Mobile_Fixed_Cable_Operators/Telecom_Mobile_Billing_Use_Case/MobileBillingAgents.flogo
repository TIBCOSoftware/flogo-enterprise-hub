                  "response": {
                    "mapping": {
                      "data": "Tidewell Mobile bill-comparison glossary (US dollars). Columns: previous_amount = the amount on the previous bill; latest_amount = the amount on the latest bill; delta = the change between them as computed by Tidewell Mobile's systems (positive = higher now); previous_total / latest_total = the two bill totals. Categories: plan = the monthly plan price; roaming = pay-per-use roaming data and calls abroad, or TravelPass days; premium_content = recurring premium content subscriptions billed to the phone bill; voice_sms = calls and texts charged outside the plan; taxes_fees = taxes, surcharges and fees; other = anything else, such as late fees or one-time charges."
                    }
                  }
                }
              }
            },
            "id": "Return",
            "name": "Return",
            "description": "Simple Return"
          }
        ],
