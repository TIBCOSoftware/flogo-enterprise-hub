    }
  ],
  "connections": {
    "2cd0c69d-76a9-4f07-8400-9cbee1012b54": {
      "settings": {
        "name": "OpenAIConn",
        "description": "Your llmprovider Connector",
        "llmProvider": "=$property[\"AgenticAI.OpenAIConn.LLM_Provider\"]",
        "anthropicProvider": "Default",
        "apiKey": "=$property[\"AgenticAI.OpenAIConn.API_Key\"]",
        "llmProviderUrl": "=$property[\"AgenticAI.OpenAIConn.LLM_Base_URL\"]",
        "azureDeployment": "",
        "azureRegion": "",
        "azureResourceName": "",
        "azureApiVersion": ""
      },
      "id": "2cd0c69d-76a9-4f07-8400-9cbee1012b54",
