            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "customConversationStoreOpOutput": {}
          },
          "name": "get_rate_plan_glossary_flow",
          "description": "Reads Ridgeline Power & Light's rate plan guide from the utility database: every rate plan with its prices and what it needs, the on-peak window, the plan-comparison columns, the reason codes, the eligibility notes and how common habits move a time-of-use bill. Rows of section, term, meaning. Read-only reference data with no customer data. Pass term \"\" for the whole guide.",
          "schemas": {
            "output": {
              "toolParams": {
                "type": "json",
                "value": "{\"type\": \"object\", \"properties\": {\"term\": {\"type\": \"string\", \"description\": \"Optional lookup: one or more words separated by commas (for example a bill category, a phrase from your input, or a section name), or an empty string for the whole guide. Never put customer details here.\"}}, \"required\": [\"term\"]}",
                "fe_metadata": "{\"type\": \"object\", \"properties\": {\"term\": {\"type\": \"string\", \"description\": \"Optional lookup: one or more words separated by commas (for example a bill category, a phrase from your input, or a section name), or an empty string for the whole guide. Never put customer details here.\"}}, \"required\": [\"term\"]}"
              }
            },
            "reply": {
              "response": {
                "type": "json",
                "value": "{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"}}}",
                "fe_metadata": "{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"}}}"
              }
            }
          }
        }
      ]
    }
  ],
