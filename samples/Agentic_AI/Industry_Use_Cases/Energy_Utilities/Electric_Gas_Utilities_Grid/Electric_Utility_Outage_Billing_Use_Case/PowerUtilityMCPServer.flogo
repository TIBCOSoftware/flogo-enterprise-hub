      },
      "id": "PowerUtilityMCPServer",
      "name": "PowerUtilityMCPServer",
      "description": "Ridgeline Power & Light governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_customer",
            "handlerDescription": "Verify a Ridgeline Power & Light customer with their account number (RPL-100101, RPL 100101 or 100101 all work) and the one-time code texted to them. Returns VERIFIED with a session_token (valid 30 minutes) and their first name, VERIFY_FAILED, or VERIFY_LOCKED after too many attempts. Call this before any other customer tool. Never reveal, guess or hint at codes. Quote any reason_text to the user as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_customer_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_customer_flow",
          "description": "Verify a Ridgeline Power & Light customer with their account number (RPL-100101, RPL 100101 or 100101 all work) and the one-time code texted to them. Returns VERIFIED with a session_token (valid 30 minutes) and their first name, VERIFY_FAILED, or VERIFY_LOCKED after too many attempts. Call this before any other customer tool. Never reveal, guess or hint at codes. Quote any reason_text to the user as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_customer_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_account",
            "handlerDescription": "Get the verified customer's account: name, account number, service address and service area, meter type (SMART or ANALOG), connection status (CONNECTED, DISCONNECTED or RECONNECT_PENDING), rate plan, any scheduled plan change, balance due, past-due amount and days past due, AutoPay, solar on file and medical-baseline protection. Only this customer's account is returned. Quote any reason_text to the user as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
