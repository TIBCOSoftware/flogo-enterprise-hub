    {
      "id": "flow:email_confirmation_flow",
      "data": {
        "name": "email_confirmation_flow",
        "description": "Email a confirmation of something already completed. Pass the reference: an executed action (RPL-ACT-...), an appointment (APPT-...), a reconnect order (SO-...) or a decided case (RPL-CASE-...). Works with a customer token for their own items, or a staff token for a decided case in their team. The system prepares the email only for such a reference (send_status SEND_OK); otherwise it returns NOT_SENT with reason_code NOT_FOUND or SESSION_INVALID. Quote any reason_text to the user as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "SendMail",
            "type": "expression",
            "label": "send_status is SEND_OK",
            "value": "$activity[ReadOutcome].Output.records[0].send_status == \"SEND_OK\""
          },
          {
            "id": 4,
            "from": "SendMail",
            "to": "Return",
            "type": "label",
            "label": "SendMail to Return"
          },
          {
            "id": 5,
            "from": "ReadOutcome",
            "to": "ReturnNotSent",
            "type": "exprOtherwise",
            "label": "otherwise (NOT_SENT)"
          }
        ],
