        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_bill_comparison",
            "handlerDescription": "Compare the verified customer's latest bill with the previous one by category (base_charge, energy, power_cost_rider, credits, taxes_fees, other): previous amount, latest amount and delta, plus both totals and the facts behind them - latest read type (ACTUAL or ESTIMATED), latest and previous kWh, kWh in the same month last year and the % change, and cooling degree days this year vs last year (higher = hotter). All numbers are computed by the system - use them exactly; never compute your own.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
