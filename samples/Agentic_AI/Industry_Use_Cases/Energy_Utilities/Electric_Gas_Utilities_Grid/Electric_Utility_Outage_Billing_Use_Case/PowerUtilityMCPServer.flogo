            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_action",
            "handlerDescription": "Step 1 of 2 for REPORT_OUTAGE (target = NO_POWER, PARTIAL_POWER or FLICKERING) or CHANGE_RATE_PLAN (target = plan code STANDARD, TOU, EV or SOLAR). The system checks every rule and returns PROPOSED with a proposal_id, a summary (for an outage it says whether the report links to a known outage in the area or opens a new crew ticket), price (estimated monthly cost for a plan), effective date and expiry (15 minutes), or BLOCKED with a reason_code and reason_text. Nothing changes until confirm_action is called after the customer explicitly says yes to this exact summary. Quote any reason_text to the user as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_action_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_action_flow",
          "description": "Step 1 of 2 for REPORT_OUTAGE (target = NO_POWER, PARTIAL_POWER or FLICKERING) or CHANGE_RATE_PLAN (target = plan code STANDARD, TOU, EV or SOLAR). The system checks every rule and returns PROPOSED with a proposal_id, a summary (for an outage it says whether the report links to a known outage in the area or opens a new crew ticket), price (estimated monthly cost for a plan), effective date and expiry (15 minutes), or BLOCKED with a reason_code and reason_text. Nothing changes until confirm_action is called after the customer explicitly says yes to this exact summary. Quote any reason_text to the user as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_action_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_action",
            "handlerDescription": "Step 2 of 2: execute a proposal the customer has explicitly confirmed. Pass the proposal_id from propose_action. The system re-checks every rule and returns EXECUTED with a reference (e.g. RPL-ACT-000101) and, for an outage, the ticket id, whether it is LINKED to a known outage and the estimated restoration; or BLOCKED / EXPIRED / NOT_FOUND / ALREADY_DONE with the reason. Only call after the customer says yes to the exact proposal. Quote any reason_text to the user as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
