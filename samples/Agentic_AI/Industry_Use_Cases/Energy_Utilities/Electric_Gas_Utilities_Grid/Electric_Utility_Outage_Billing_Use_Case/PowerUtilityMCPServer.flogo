          "name": "book_appointment_flow",
          "description": "Book a technician appointment for the verified customer: appointment_type METER_UPGRADE (analog meters only) or METER_INSPECTION, in a slot_id from get_appointment_slots. The system checks the slot (exists, from tomorrow, spots left), the meter type and that no appointment of that type is already booked, and returns BOOKED with an appointment_id (e.g. APPT-000101) or BLOCKED with the reason. Book only the slot the customer chose. Quote any reason_text to the user as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://book_appointment_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
