    "act_postgresql_query github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "act_default_actreturn github.com/project-flogo/contrib/activity/actreturn",
    "github.com/project-flogo/contrib/function/coerce",
    "act_general_sendmail github.com/tibco/flogo-general/src/app/General/activity/sendmail"
  ],
  "name": "PowerUtilityMCPServer",
  "description": "Ridgeline Power &amp; Light outage &amp; billing MCP Server - scoped reads, guarded writes and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "PowerUtilityMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/powerutilitymcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
