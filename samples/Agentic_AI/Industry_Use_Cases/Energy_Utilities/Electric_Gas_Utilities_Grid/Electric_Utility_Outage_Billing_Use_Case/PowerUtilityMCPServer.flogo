        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "request_reconnect",
            "handlerDescription": "Ask to reconnect the verified customer's disconnected power service. The system reconnects only when the service is disconnected, the past-due balance is cleared and no reconnection is already scheduled: it returns RECONNECT_SCHEDULED with an order_id (e.g. SO-000101) and the time power will be back, or BLOCKED with reason_code (PAST_DUE with amount_due, NOT_DISCONNECTED, ALREADY_REQUESTED). Nobody can override a PAST_DUE block in this chat. Quote any reason_text to the user as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
