    {
      "id": "flow:propose_action_flow",
      "data": {
        "name": "propose_action_flow",
        "description": "Step 1 of 2 for REPORT_OUTAGE (target = NO_POWER, PARTIAL_POWER or FLICKERING) or CHANGE_RATE_PLAN (target = plan code STANDARD, TOU, EV or SOLAR). The system checks every rule and returns PROPOSED with a proposal_id, a summary (for an outage it says whether the report links to a known outage in the area or opens a new crew ticket), price (estimated monthly cost for a plan), effective date and expiry (15 minutes), or BLOCKED with a reason_code and reason_text. Nothing changes until confirm_action is called after the customer explicitly says yes to this exact summary. Quote any reason_text to the user as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
