        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_plan_options",
            "handlerDescription": "List every Ridgeline rate plan (STANDARD, TOU, EV, SOLAR) for the verified customer with its rates, what it needs (smart meter, solar), the system's estimated monthly base + energy cost on THIS customer's last 3 bills, the current plan's estimate, the estimated monthly savings (positive = cheaper than now), whether it is the current plan, eligible yes/no with reason_code/reason_text, and the effective date. Quote the estimates exactly; never compute savings yourself. Only eligible plans can be proposed. Quote any reason_text to the user as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
