      "id": "flow:get_review_queue_flow",
      "data": {
        "name": "get_review_queue_flow",
        "description": "List the verified reviewer&#39;s team queue: OPEN cases ordered by reply deadline, with case_id, request, masked account, customer first name, age in hours, deadline, past_sla and requested amount. Returns NOT_REVIEWER for a missing, expired or customer token, QUEUE_EMPTY when there is nothing to review.",
