    {
      "id": "flow:decide_review_case_flow",
      "data": {
        "name": "decide_review_case_flow",
        "description": "Record a reviewer&#39;s decision after they explicitly confirmed it. decision = APPROVE or REJECT; amount = the approved dollar amount for a bill credit or payment arrangement (empty = the requested amount or the eligible maximum; ignored for REJECT); internal_note = the reviewer&#39;s reason (at least 5 characters, never shown to the customer); customer_message = what the customer will see. The system checks role, team, status, amount and the reviewer&#39;s approval limit; on success the case is APPROVED or REJECTED and an approval executes the parked action (bill credit, payment arrangement, protection flag). Returns DECIDED with what was executed, or BLOCKED with reason_code (NOT_YOUR_TEAM, NOT_FOUND, ALREADY_DECIDED, NOTE_REQUIRED, INVALID_DECISION, AMOUNT_INVALID, OVER_AUTHORITY - the case stays open for a senior reviewer), or NOT_REVIEWER. Quote any reason_text to the user as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
