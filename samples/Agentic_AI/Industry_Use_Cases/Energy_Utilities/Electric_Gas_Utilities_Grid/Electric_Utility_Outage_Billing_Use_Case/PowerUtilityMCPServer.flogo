    {
      "id": "flow:request_reconnect_flow",
      "data": {
        "name": "request_reconnect_flow",
        "description": "Ask to reconnect the verified customer&#39;s disconnected power service. The system reconnects only when the service is disconnected, the past-due balance is cleared and no reconnection is already scheduled: it returns RECONNECT_SCHEDULED with an order_id (e.g. SO-000101) and the time power will be back, or BLOCKED with reason_code (PAST_DUE with amount_due, NOT_DISCONNECTED, ALREADY_REQUESTED). Nobody can override a PAST_DUE block in this chat. Quote any reason_text to the user as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
