    {
      "id": "flow:open_service_case_flow",
      "data": {
        "name": "open_service_case_flow",
        "description": "Hand a request that a person must decide to the right team. request_type is shut_in (shut-in or emergency shutdown of an asset), safety_signal (gas odor, H2S, a spill, fire or an injury reported directly - a field note with safety language is routed by log_field_note instead), threshold_change (changing a sensor threshold) or alert_closure (closing the asset&#39;s open alert). summary is a neutral 1-3 sentence summary in the operator&#39;s own words; agent_brief is an agent&#39;s output if relevant, else empty. The system routes it and returns OPENED with case_id, team and reply time, EXISTING, or BLOCKED / INVALID_TYPE with a reason. The assistant never shuts in, restarts or clears anything itself and never promises or predicts the outcome. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
