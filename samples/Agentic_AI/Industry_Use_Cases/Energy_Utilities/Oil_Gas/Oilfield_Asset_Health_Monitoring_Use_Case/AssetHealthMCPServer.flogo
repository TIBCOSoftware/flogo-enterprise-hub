          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "log_field_note",
            "handlerDescription": "Log a technician's field note for an asset in your region together with field_note_triage_agent's reading of it. Pass the note text exactly as written and the agent's failure_mode, urgency (LOW, MEDIUM, HIGH, IMMEDIATE), safety_language (yes or no) and a one-line summary (likely parts and the safety phrase, if any). The system checks the agent's output, reconciles it with the sensor classification and returns the next step: SAFETY_CASE (safety language - an HSE case was opened or joined; no work order from this note), WORK_ORDER_ELIGIBLE (a work order can be proposed) or MONITOR (sensors normal, or the asset already has work), with agreement (AGREE, DIFFERENT, NO_SENSOR_ANOMALY, AGENT_MODE_INVALID), case_id and reason_text. NOT_FOUND = asset not in your region. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:log_field_note_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "log_field_note_flow",
          "description": "Log a technician's field note for an asset in your region together with field_note_triage_agent's reading of it. Pass the note text exactly as written and the agent's failure_mode, urgency (LOW, MEDIUM, HIGH, IMMEDIATE), safety_language (yes or no) and a one-line summary (likely parts and the safety phrase, if any). The system checks the agent's output, reconciles it with the sensor classification and returns the next step: SAFETY_CASE (safety language - an HSE case was opened or joined; no work order from this note), WORK_ORDER_ELIGIBLE (a work order can be proposed) or MONITOR (sensors normal, or the asset already has work), with agreement (AGREE, DIFFERENT, NO_SENSOR_ANOMALY, AGENT_MODE_INVALID), case_id and reason_text. NOT_FOUND = asset not in your region. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://log_field_note_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_work_order",
            "handlerDescription": "Step 1 of 2 to create a corrective work order for an asset in your region. Pass the asset_id, a failure_mode from get_failure_modes (empty = the sensor classification's mode) and a short note (the symptom, a similar past fix). The system checks that the asset is not in MAINTENANCE or SHUT_IN, has no open work order and is WARNING or CRITICAL, sets the priority, crew, scheduled date and estimate from Mesa Ridge's tables, and returns PROPOSED with a proposal_id, estimate_usd, needs_supervisor_approval and a summary (expires in 15 minutes), or BLOCKED with reason_code ASSET_IN_MAINTENANCE, ASSET_SHUT_IN, OPEN_WO_EXISTS, HEALTH_NORMAL, FAILURE_MODE_INVALID or NOT_FOUND and a reason_text. needs_supervisor_approval = yes means the estimate is above the operator's limit: confirming sends it to Production Engineering instead of creating it. Nothing happens until confirm_action is called after the operator explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_work_order_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_work_order_flow",
          "description": "Step 1 of 2 to create a corrective work order for an asset in your region. Pass the asset_id, a failure_mode from get_failure_modes (empty = the sensor classification's mode) and a short note (the symptom, a similar past fix). The system checks that the asset is not in MAINTENANCE or SHUT_IN, has no open work order and is WARNING or CRITICAL, sets the priority, crew, scheduled date and estimate from Mesa Ridge's tables, and returns PROPOSED with a proposal_id, estimate_usd, needs_supervisor_approval and a summary (expires in 15 minutes), or BLOCKED with reason_code ASSET_IN_MAINTENANCE, ASSET_SHUT_IN, OPEN_WO_EXISTS, HEALTH_NORMAL, FAILURE_MODE_INVALID or NOT_FOUND and a reason_text. needs_supervisor_approval = yes means the estimate is above the operator's limit: confirming sends it to Production Engineering instead of creating it. Nothing happens until confirm_action is called after the operator explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_work_order_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_action",
            "handlerDescription": "Step 2 of 2: carry out a work order the operator has explicitly confirmed. Pass the proposal_id from propose_work_order. The system re-checks every rule and returns EXECUTED with the work_order number (e.g. MRE-WO-1101), SUPERVISOR_APPROVAL with a case_id (estimate above the operator's limit: nothing is created until a Production Engineering supervisor approves), or BLOCKED / EXPIRED (after 15 minutes) / NOT_FOUND / ALREADY_DONE with the reason. Only call after the operator says yes to the exact proposal. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:confirm_action_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "confirm_action_flow",
          "description": "Step 2 of 2: carry out a work order the operator has explicitly confirmed. Pass the proposal_id from propose_work_order. The system re-checks every rule and returns EXECUTED with the work_order number (e.g. MRE-WO-1101), SUPERVISOR_APPROVAL with a case_id (estimate above the operator's limit: nothing is created until a Production Engineering supervisor approves), or BLOCKED / EXPIRED (after 15 minutes) / NOT_FOUND / ALREADY_DONE with the reason. Only call after the operator says yes to the exact proposal. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://confirm_action_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "log_alert",
            "handlerDescription": "Log an alert for an asset in your region. The severity, failure mode and message come from the sensor classification, not from you. Returns LOGGED with the alert_id, ALREADY_LOGGED_TODAY (one alert per asset per day - the existing alert is shown), HEALTH_NORMAL (no alert for a NORMAL asset) or NOT_FOUND. Closing an alert is a Production Engineering decision (open_service_case alert_closure). Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
