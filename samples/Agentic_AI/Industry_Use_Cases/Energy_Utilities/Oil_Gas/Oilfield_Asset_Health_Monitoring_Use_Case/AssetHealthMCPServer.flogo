    "log_field_note_Args": {
      "type": "json",
      "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"session_token\": {\n      \"type\": \"string\",\n      \"description\": \"Operator session token returned by verify_operator. Required; never invent one. If a tool answers SESSION_INVALID, ask the operator to verify again.\"\n    },\n    \"asset_id\": {\n      \"type\": \"string\",\n      \"description\": \"Asset id in your region, e.g. PUMP-PB-W47 (the short well/station tag W47 also works)\"\n    },\n    \"note_text\": {\n      \"type\": \"string\",\n      \"description\": \"The technician's note exactly as written\"\n    },\n    \"failure_mode\": {\n      \"type\": \"string\",\n      \"description\": \"The triage agent's failure mode, e.g. bearing_wear, or empty\"\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"description\": \"The triage agent's urgency: LOW, MEDIUM, HIGH or IMMEDIATE\"\n    },\n    \"safety_language\": {\n      \"type\": \"string\",\n      \"description\": \"yes if the triage agent found safety language, else no\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"The triage agent's one-line summary: likely parts and the safety phrase, if any\"\n    }\n  },\n  \"required\": [\n    \"session_token\",\n    \"asset_id\",\n    \"note_text\",\n    \"failure_mode\",\n    \"urgency\",\n    \"safety_language\",\n    \"summary\"\n  ]\n}",
