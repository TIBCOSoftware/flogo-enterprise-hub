    {
      "id": "flow:get_review_case_flow",
      "data": {
        "name": "get_review_case_flow",
        "description": "Open one case from the reviewer&#39;s team queue: request, status, asset and region, the operator&#39;s statement, the AI-prepared agent_brief (unverified), requested budget, maximum approvable budget, the reviewer&#39;s own budget authority, the facts from Mesa Ridge&#39;s records (sensor health, work orders, alerts, field notes) and the decision options. Another team&#39;s case or an unknown id returns NOT_FOUND.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadOutcome",
            "type": "label",
            "label": "StartActivity to ReadOutcome"
          },
          {
            "id": 2,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
