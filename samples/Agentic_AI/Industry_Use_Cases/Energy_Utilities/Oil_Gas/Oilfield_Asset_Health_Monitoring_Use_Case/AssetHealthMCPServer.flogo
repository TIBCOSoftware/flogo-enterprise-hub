        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_region_handover",
            "handlerDescription": "Get the region's shift-handover snapshot: open cases (by request type) with their reply-due time, assets in WARNING or CRITICAL with the anomalies, open work orders, open alerts, field notes from the last 12 hours and decisions from the last 24 hours. Equipment data only (no people's names, no case ids) - it can be passed to shift_handover_agent as is.",
            "toolTitle": "",
