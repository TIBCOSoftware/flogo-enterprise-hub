            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_failure_modes_flow",
          "description": "List the failure modes that apply to one asset's type, with label, recommended action, typical parts, repair estimate and downtime, the asset's current health line, and whether each mode matches the sensor classification. Pass these rows (without anything about people) to field_note_triage_agent: it must pick the failure mode and parts from this list only.",
          "schemas": {
            "output": {
              "arguments": "schema://get_failure_modes_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_failure_history",
            "handlerDescription": "Get Mesa Ridge's reliability library for the asset's type: closed work orders across all basins from the last 2 years with wo_number, past asset, basin, closed date, failure mode, the symptom as written, the fix applied, parts used and downtime. Equipment data only (no people) - pass the rows to similar_failure_agent as they are.",
