            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_alerts",
            "handlerDescription": "List alerts in the operator's region (open or acknowledged, plus the last 30 days): alert_id, asset, severity (WARNING, CRITICAL), failure mode, message, status (OPEN, ACKNOWLEDGED, CLOSED), when and by whom (monitoring system or control room). asset_id = ALL (or empty) or one asset.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
