              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_work_orders_flow",
          "description": "List work orders in the operator's region: open ones first, then those closed in the last 90 days. wo_number, asset, type (CORRECTIVE, PREVENTIVE, SAFETY_INSPECTION), failure mode, symptom, priority, status (OPEN, SCHEDULED, IN_PROGRESS, CLOSED), crew, scheduled date, estimate, approved budget and whether a supervisor approved it. asset_id = ALL (or empty) for the whole region, or one asset; NOT_FOUND = asset not in your region; NONE = no work orders.",
          "schemas": {
            "output": {
