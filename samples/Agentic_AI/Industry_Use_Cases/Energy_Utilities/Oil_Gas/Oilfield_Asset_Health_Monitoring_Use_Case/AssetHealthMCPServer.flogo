    {
      "id": "flow:log_field_note_flow",
      "data": {
        "name": "log_field_note_flow",
        "description": "Log a technician&#39;s field note for an asset in your region together with field_note_triage_agent&#39;s reading of it. Pass the note text exactly as written and the agent&#39;s failure_mode, urgency (LOW, MEDIUM, HIGH, IMMEDIATE), safety_language (yes or no) and a one-line summary (likely parts and the safety phrase, if any). The system checks the agent&#39;s output, reconciles it with the sensor classification and returns the next step: SAFETY_CASE (safety language - an HSE case was opened or joined; no work order from this note), WORK_ORDER_ELIGIBLE (a work order can be proposed) or MONITOR (sensors normal, or the asset already has work), with agreement (AGREE, DIFFERENT, NO_SENSOR_ANOMALY, AGENT_MODE_INVALID), case_id and reason_text. NOT_FOUND = asset not in your region. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Connection": "conn://86ed625a-8a23-4e40-848c-8a8863b3ce1b",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO field_notes (note_id, asset_id, operator_id, note_text, agent_failure_mode, agent_urgency, agent_safety, agent_summary, health_status, sql_failure_mode, agreement, safety_source, safety_phrase, reconciled_action, case_id, new_case) SELECT * FROM field_note_row(CAST(?w_tok AS text), CAST(?w_aid AS text), CAST(?w_note AS text), CAST(?w_mode AS text), CAST(?w_urg AS text), CAST(?w_safe AS text), CAST(?w_sum AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_tok",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_aid",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_note",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_mode",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_urg",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_safe",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_sum",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "0c8b97ba-19c9-4c5e-9b33-0d7cd7a088f4INSERT INTO field_notes (note_id, asset_id, operator_id, note_text, agent_failure_mode, agent_urgency, agent_safety, agent_summary, health_status, sql_failure_mode, agreement, safety_source, safety_phrase, reconciled_action, case_id, new_case) SELECT * FROM field_note_row(CAST(?w_tok AS text), CAST(?w_aid AS text), CAST(?w_note AS text), CAST(?w_mode AS text), CAST(?w_urg AS text), CAST(?w_safe AS text), CAST(?w_sum AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "w_tok": "=$flow.arguments.session_token",
                      "w_aid": "=$flow.arguments.asset_id",
                      "w_note": "=$flow.arguments.note_text",
                      "w_mode": "=$flow.arguments.failure_mode",
                      "w_urg": "=$flow.arguments.urgency",
                      "w_safe": "=$flow.arguments.safety_language",
                      "w_sum": "=$flow.arguments.summary"
                    }
                  }
