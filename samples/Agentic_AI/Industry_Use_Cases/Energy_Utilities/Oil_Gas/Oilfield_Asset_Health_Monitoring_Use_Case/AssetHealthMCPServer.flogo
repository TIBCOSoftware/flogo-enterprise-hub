{
  "imports": [
    "con_postgresql github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection",
    "tr_mcpserver github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/flow",
    "act_default_noop github.com/project-flogo/contrib/activity/noop",
    "act_postgresql_insert github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "act_postgresql_query github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "act_default_actreturn github.com/project-flogo/contrib/activity/actreturn",
    "github.com/project-flogo/contrib/function/coerce",
    "act_general_sendmail github.com/tibco/flogo-general/src/app/General/activity/sendmail"
  ],
  "name": "AssetHealthMCPServer",
  "description": "Mesa Ridge Energy oilfield asset health MCP Server - deterministic health, scoped reads, guarded writes and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "AssetHealthMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/assethealthmcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "AssetHealthMCPServer",
      "name": "AssetHealthMCPServer",
      "description": "Mesa Ridge Energy governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_operator",
            "handlerDescription": "Verify a Mesa Ridge control-room operator with their staff ID (MRE-4101, mre4101 or 4101 all work) and their one-time code. Returns VERIFIED with a session_token (valid 60 minutes), their name, their region and their work-order limit, VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any operator tool. Never reveal, guess or hint at codes. Production Engineering supervisors and HSE reviewers use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_operator_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_operator_flow",
          "description": "Verify a Mesa Ridge control-room operator with their staff ID (MRE-4101, mre4101 or 4101 all work) and their one-time code. Returns VERIFIED with a session_token (valid 60 minutes), their name, their region and their work-order limit, VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any operator tool. Never reveal, guess or hint at codes. Production Engineering supervisors and HSE reviewers use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_operator_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_region_assets",
            "handlerDescription": "List the assets in the verified operator's region with their health computed by Mesa Ridge's rules: asset id, type, description, asset status (OPERATIONAL, MAINTENANCE, SHUT_IN), health_status (CRITICAL, WARNING, NORMAL), worst sensor, likely failure mode, confidence, days to failure, open work order, open alerts and the latest reading time. Worst health first. Never classify an asset yourself - quote these values.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_region_assets_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_region_assets_flow",
          "description": "List the assets in the verified operator's region with their health computed by Mesa Ridge's rules: asset id, type, description, asset status (OPERATIONAL, MAINTENANCE, SHUT_IN), health_status (CRITICAL, WARNING, NORMAL), worst sensor, likely failure mode, confidence, days to failure, open work order, open alerts and the latest reading time. Worst health first. Never classify an asset yourself - quote these values.",
          "schemas": {
            "output": {
              "arguments": "schema://get_region_assets_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_asset_health",
            "handlerDescription": "Get one asset's health as computed by the deterministic classifier: health_status, worst sensor, number of anomalous sensors, failure mode and label, confidence, days to failure, the anomalies with their thresholds, the recommended action and repair estimate, the latest reading (vibration g RMS, temperature F, pressure psi, flow bbl/h, power kW), any open work order and work_order_allowed (yes, or no with the reason). An asset in another region returns NOT_FOUND. Quote these values; never re-classify.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_asset_health_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_asset_health_flow",
          "description": "Get one asset's health as computed by the deterministic classifier: health_status, worst sensor, number of anomalous sensors, failure mode and label, confidence, days to failure, the anomalies with their thresholds, the recommended action and repair estimate, the latest reading (vibration g RMS, temperature F, pressure psi, flow bbl/h, power kW), any open work order and work_order_allowed (yes, or no with the reason). An asset in another region returns NOT_FOUND. Quote these values; never re-classify.",
          "schemas": {
            "output": {
              "arguments": "schema://get_asset_health_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
