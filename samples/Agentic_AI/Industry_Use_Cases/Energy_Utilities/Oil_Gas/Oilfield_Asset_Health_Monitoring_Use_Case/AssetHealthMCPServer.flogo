        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_failure_modes",
            "handlerDescription": "List the failure modes that apply to one asset's type, with label, recommended action, typical parts, repair estimate and downtime, the asset's current health line, and whether each mode matches the sensor classification. Pass these rows (without anything about people) to field_note_triage_agent: it must pick the failure mode and parts from this list only.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
