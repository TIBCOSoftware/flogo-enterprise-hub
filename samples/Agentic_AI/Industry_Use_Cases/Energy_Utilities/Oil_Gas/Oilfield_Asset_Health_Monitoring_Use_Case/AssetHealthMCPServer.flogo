            "activity": {
              "input": {
                "Connection": "conn://86ed625a-8a23-4e40-848c-8a8863b3ce1b",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO service_cases (case_no, case_id, site_id, asset_id, opened_by, request_type, summary, reference_id, requested_amount, parked_action, agent_brief, sla_due_at) SELECT * FROM open_case_row(CAST(?w_tok AS text), CAST(?w_type AS text), CAST(?w_aid AS text), CAST(?w_sum AS text), CAST(?w_brief AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_tok",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_type",
