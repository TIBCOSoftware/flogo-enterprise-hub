            "input": "{\"type\": \"object\", \"title\": \"SemiOrdersMCPServer\", \"properties\": {\"arguments\": {\"type\": \"object\", \"properties\": {\"session_token\": {\"type\": \"string\", \"description\": \"Buyer session token returned by verify_buyer. Required; never invent one. If a tool answers SESSION_INVALID, ask the buyer to verify again.\"}, \"order_number\": {\"type\": \"string\", \"description\": \"Order number from get_my_orders, e.g. SO-2026-0011\"}, \"part_number\": {\"type\": \"string\", \"description\": \"Arcwell part number, e.g. AW-MF-4012\"}, \"quantity\": {\"type\": \"string\", \"description\": \"Number of pieces to return, e.g. 40\"}, \"failure_description\": {\"type\": \"string\", \"description\": \"The buyer's own words about what went wrong: facts only\"}, \"defect_type\": {\"type\": \"string\", \"description\": \"From rma_triage_agent: ELECTRICAL_FAILURE | PARAMETRIC_DRIFT | MECHANICAL_DAMAGE | SOLDERABILITY | WRONG_PART | OTHER\"}, \"safety_relevant\": {\"type\": \"string\", \"description\": \"From rma_triage_agent: YES or NO\"}, \"triage_brief\": {\"type\": \"string\", \"description\": \"rma_triage_agent's full answer, for the quality engineer (or empty)\"}}, \"required\": [\"session_token\", \"order_number\", \"part_number\", \"quantity\", \"failure_description\", \"defect_type\", \"safety_relevant\", \"triage_brief\"]}}}",
            "output": "{\"type\": \"object\", \"title\": \"Inputs\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}, \"required\": [\"response\"]}"
          }
        }
      }
