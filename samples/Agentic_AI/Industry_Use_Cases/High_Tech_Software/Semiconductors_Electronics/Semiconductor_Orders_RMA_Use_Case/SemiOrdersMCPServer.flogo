    {
      "id": "flow:open_service_case_flow",
      "data": {
        "name": "open_service_case_flow",
        "description": "Hand a request that needs a person to the right Arcwell team. request_type is last_time_buy (reference_id = the proposal_id of the LARGE_LAST_TIME_BUY propose_order result), factory_expedite (reference_id = the line_ref, requested_date = the date the buyer needs, YYYY-MM-DD), credit_review (amount = the credit limit asked for in dollars, or empty to ask only for a credit-hold release), or special_pricing (price match or special price; reference_id = the part number if known). summary is a neutral 1-3 sentence summary in the buyer&#39;s own words. Leave fields empty when they do not apply. The system routes it and returns OPENED with case_id, team and reply time, EXISTING, or BLOCKED / INVALID_TYPE with a reason. RMAs are not opened here (use propose_rma). The assistant never decides, promises or predicts the outcome. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Connection": "conn://5e45024e-3107-41d7-9b45-e0960ceb2451",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO service_cases (case_no, case_id, account_id, buyer_id, request_type, summary, reference_id, part_number, quantity, unit_price, po_number, line_id, requested_date, requested_amount, parked_action, sla_due_at) SELECT * FROM open_case_row(CAST(?w_tok AS text), CAST(?w_type AS text), CAST(?w_sum AS text), CAST(?w_ref AS text), CAST(?w_date AS text), CAST(?w_amt AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "w_tok",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "w_type",
