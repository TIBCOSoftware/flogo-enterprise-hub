        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_order",
            "handlerDescription": "Step 1 of 2 to place an order for the verified buyer's account. Pass the part number, the quantity in pieces and the buyer's PO number. The system prices it from the price-break table and checks the part, lifecycle and last-time-buy date, MOQ, stock, credit hold and credit limit, then returns PROPOSED with a proposal_id, a priced summary and the ship date (expires in 15 minutes), or BLOCKED with a reason_code and reason_text. A BLOCKED LARGE_LAST_TIME_BUY also returns a proposal_id: that is the reference_id for open_service_case last_time_buy. Nothing is ordered until confirm_action is called after the buyer explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_order_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_order_flow",
          "description": "Step 1 of 2 to place an order for the verified buyer's account. Pass the part number, the quantity in pieces and the buyer's PO number. The system prices it from the price-break table and checks the part, lifecycle and last-time-buy date, MOQ, stock, credit hold and credit limit, then returns PROPOSED with a proposal_id, a priced summary and the ship date (expires in 15 minutes), or BLOCKED with a reason_code and reason_text. A BLOCKED LARGE_LAST_TIME_BUY also returns a proposal_id: that is the reference_id for open_service_case last_time_buy. Nothing is ordered until confirm_action is called after the buyer explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_order_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "propose_rma",
            "handlerDescription": "Step 1 of 2 to open a return (RMA) for parts that failed or arrived wrong. Pass the order number and part number from get_my_orders, the quantity to return, the buyer's own description of the problem, and the defect_type, safety_relevant (YES/NO) and the full answer (triage_brief) from rma_triage_agent. The system checks the line is the buyer's, shipped, inside the warranty and that the quantity is not more than shipped minus earlier returns, then returns PROPOSED with a proposal_id and summary (expires in 15 minutes) or BLOCKED with a reason. Nothing is opened until confirm_action is called after the buyer explicitly says yes. Quality Engineering decides every RMA - never promise a credit. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:propose_rma_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "propose_rma_flow",
          "description": "Step 1 of 2 to open a return (RMA) for parts that failed or arrived wrong. Pass the order number and part number from get_my_orders, the quantity to return, the buyer's own description of the problem, and the defect_type, safety_relevant (YES/NO) and the full answer (triage_brief) from rma_triage_agent. The system checks the line is the buyer's, shipped, inside the warranty and that the quantity is not more than shipped minus earlier returns, then returns PROPOSED with a proposal_id and summary (expires in 15 minutes) or BLOCKED with a reason. Nothing is opened until confirm_action is called after the buyer explicitly says yes. Quality Engineering decides every RMA - never promise a credit. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://propose_rma_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "confirm_action",
            "handlerDescription": "Step 2 of 2: execute a proposal the buyer has explicitly confirmed. Pass the proposal_id from propose_order or propose_rma. The system re-checks every rule and returns EXECUTED with a reference (the new order number SO-... or RMA number RMA-...; for an RMA also the Quality Engineering case_id, team and reply date), or BLOCKED / EXPIRED (after 15 minutes) / NOT_FOUND / ALREADY_DONE with the reason. Only call after the buyer says yes to the exact proposal. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
