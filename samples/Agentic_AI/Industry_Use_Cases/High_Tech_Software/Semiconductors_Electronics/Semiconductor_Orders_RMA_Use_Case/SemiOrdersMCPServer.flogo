        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_orders",
            "handlerDescription": "List the verified buyer's orders, one row per line: order number (e.g. SO-2026-0014), PO number, order date, line_ref (e.g. SO-2026-0014/2 - use it for request_expedite), part, description, quantity, unit price, extended price, requested and promised dates, line_status (OPEN, PARTIALLY_SHIPPED, SHIPPED), shipped quantity and date, and the warranty end date for shipped lines.",
