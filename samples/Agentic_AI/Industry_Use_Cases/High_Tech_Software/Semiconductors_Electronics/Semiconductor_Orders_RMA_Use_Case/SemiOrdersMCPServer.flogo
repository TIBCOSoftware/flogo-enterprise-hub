    {
      "id": "flow:confirm_action_flow",
      "data": {
        "name": "confirm_action_flow",
        "description": "Step 2 of 2: execute a proposal the buyer has explicitly confirmed. Pass the proposal_id from propose_order or propose_rma. The system re-checks every rule and returns EXECUTED with a reference (the new order number SO-... or RMA number RMA-...; for an RMA also the Quality Engineering case_id, team and reply date), or BLOCKED / EXPIRED (after 15 minutes) / NOT_FOUND / ALREADY_DONE with the reason. Only call after the buyer says yes to the exact proposal. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
