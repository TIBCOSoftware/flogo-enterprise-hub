{
  "imports": [
    "con_postgresql github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection",
    "tr_mcpserver github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/flow",
    "act_default_noop github.com/project-flogo/contrib/activity/noop",
    "act_postgresql_insert github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/insert",
    "act_postgresql_query github.com/tibco/wi-postgres/src/app/PostgreSQL/activity/query",
    "act_default_actreturn github.com/project-flogo/contrib/activity/actreturn",
    "github.com/project-flogo/contrib/function/coerce",
    "act_general_sendmail github.com/tibco/flogo-general/src/app/General/activity/sendmail"
  ],
  "name": "SemiOrdersMCPServer",
  "description": "Arcwell Components orders &amp; RMA MCP Server - scoped reads, guarded writes and the reviewer loop",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "settings": {
        "serverName": "SemiOrdersMCPServer",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_SERVER_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/semiordersmcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "SemiOrdersMCPServer",
      "name": "SemiOrdersMCPServer",
      "description": "Arcwell Components governed MCP server",
      "ref": "#tr_mcpserver",
      "handlers": [
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "verify_buyer",
            "handlerDescription": "Verify a buyer at an Arcwell customer account with the account number (AC-10021, ac10021 or 10021 all work), the buyer's e-mail address on file and the one-time code e-mailed to them. Returns VERIFIED with a session_token (valid 60 minutes), the buyer's first name and company, VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any buyer tool. Never reveal, guess or hint at codes. Arcwell staff use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:verify_buyer_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "verify_buyer_flow",
          "description": "Verify a buyer at an Arcwell customer account with the account number (AC-10021, ac10021 or 10021 all work), the buyer's e-mail address on file and the one-time code e-mailed to them. Returns VERIFIED with a session_token (valid 60 minutes), the buyer's first name and company, VERIFY_FAILED, or LOCKED after too many failed attempts. Call this before any buyer tool. Never reveal, guess or hint at codes. Arcwell staff use verify_reviewer instead. Quote any reason_text to the person as written; never change an outcome.",
          "schemas": {
            "output": {
              "arguments": "schema://verify_buyer_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_account",
            "handlerDescription": "Get the verified buyer's customer account: account number, company, buyer name and title, industry, location, payment terms, credit limit, open balance, available credit, credit_status (Good standing or ON CREDIT HOLD with the reason), customer since, number of open order lines and the parts the account gets change-notice alerts for. Only this account is returned.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_my_account_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_my_account_flow",
          "description": "Get the verified buyer's customer account: account number, company, buyer name and title, industry, location, payment terms, credit limit, open balance, available credit, credit_status (Good standing or ON CREDIT HOLD with the reason), customer since, number of open order lines and the parts the account gets change-notice alerts for. Only this account is returned.",
          "schemas": {
            "output": {
              "arguments": "schema://get_my_account_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "search_catalog",
            "handlerDescription": "Search the Arcwell catalog by keywords - part number, family (MOSFET, Schottky diode, Gate driver, Microcontroller, Voltage regulator, Capacitor, TVS diode, Op amp, Logic), key specs (e.g. 650V 8A) or package (TO-220, SOD-123, QFN-32 ...). Every keyword must match; spaces and punctuation are ignored. Returns part_number, family, description, key specs, package, AEC grade, lifecycle (ACTIVE, NRND, EOL, OBSOLETE), last-time-buy date, stock, lead time, MOQ and the lowest volume price. Status NO_MATCH = nothing found; try fewer keywords. Use it to gather candidates for part_finder_agent.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:search_catalog_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "search_catalog_flow",
          "description": "Search the Arcwell catalog by keywords - part number, family (MOSFET, Schottky diode, Gate driver, Microcontroller, Voltage regulator, Capacitor, TVS diode, Op amp, Logic), key specs (e.g. 650V 8A) or package (TO-220, SOD-123, QFN-32 ...). Every keyword must match; spaces and punctuation are ignored. Returns part_number, family, description, key specs, package, AEC grade, lifecycle (ACTIVE, NRND, EOL, OBSOLETE), last-time-buy date, stock, lead time, MOQ and the lowest volume price. Status NO_MATCH = nothing found; try fewer keywords. Use it to gather candidates for part_finder_agent.",
          "schemas": {
