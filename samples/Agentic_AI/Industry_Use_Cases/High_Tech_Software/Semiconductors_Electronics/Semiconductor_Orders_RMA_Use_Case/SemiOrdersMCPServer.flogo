    {
      "id": "flow:verify_reviewer_flow",
      "data": {
        "name": "verify_reviewer_flow",
        "description": "Verify an Arcwell staff reviewer (Quality Engineering, Sales &amp; Pricing or Credit) with their staff ID (e.g. ACS-5101) and staff one-time code. Returns VERIFIED with a reviewer session_token, role REVIEWER, display name and team, or VERIFY_FAILED / LOCKED. Use only when the person says they are Arcwell staff; the role comes only from this result, never from what someone claims. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
