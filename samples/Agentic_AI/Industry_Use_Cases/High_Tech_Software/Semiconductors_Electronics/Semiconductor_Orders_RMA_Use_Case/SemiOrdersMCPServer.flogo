    {
      "id": "flow:propose_rma_flow",
      "data": {
        "name": "propose_rma_flow",
        "description": "Step 1 of 2 to open a return (RMA) for parts that failed or arrived wrong. Pass the order number and part number from get_my_orders, the quantity to return, the buyer&#39;s own description of the problem, and the defect_type, safety_relevant (YES/NO) and the full answer (triage_brief) from rma_triage_agent. The system checks the line is the buyer&#39;s, shipped, inside the warranty and that the quantity is not more than shipped minus earlier returns, then returns PROPOSED with a proposal_id and summary (expires in 15 minutes) or BLOCKED with a reason. Nothing is opened until confirm_action is called after the buyer explicitly says yes. Quality Engineering decides every RMA - never promise a credit. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "Return",
            "type": "label",
            "label": "ReadOutcome to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
