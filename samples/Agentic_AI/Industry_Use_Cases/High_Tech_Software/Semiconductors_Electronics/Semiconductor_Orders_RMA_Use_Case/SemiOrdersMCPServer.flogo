        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_my_cases",
            "handlerDescription": "List the verified buyer's account's requests that a person decides: case_id, request, what it is about, team, case_status (OPEN, APPROVED, REJECTED), opened and reply-due dates, what was requested, the outcome, the decision date and the customer_message from the team once decided. Use it when the buyer asks about the status of a request, a credit review or an RMA decision.",
            "toolTitle": "",
