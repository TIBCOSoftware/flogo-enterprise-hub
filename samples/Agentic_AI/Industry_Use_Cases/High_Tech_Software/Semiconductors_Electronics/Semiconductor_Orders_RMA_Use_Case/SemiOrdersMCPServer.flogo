    {
      "id": "flow:email_confirmation_flow",
      "data": {
        "name": "email_confirmation_flow",
        "description": "Email the buyer a confirmation of something already done for their account: an order (SO-... reference from confirm_action), a return (RMA-...), an expedite (EXP-...), or a decided request (ARC-CASE-...). The system prepares the email only when that reference belongs to this account and is done (send_status SEND_OK); otherwise NOT_SENT with reason_code NOT_FOUND or SESSION_INVALID. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
          {
            "id": 2,
            "from": "GuardedWrite",
            "to": "ReadOutcome",
            "type": "label",
            "label": "GuardedWrite to ReadOutcome"
          },
          {
            "id": 3,
            "from": "ReadOutcome",
            "to": "SendMail",
            "type": "expression",
            "label": "send_status is SEND_OK",
            "value": "$activity[ReadOutcome].Output.records[0].send_status == \"SEND_OK\""
          },
          {
            "id": 4,
            "from": "SendMail",
            "to": "Return",
            "type": "label",
            "label": "SendMail to Return"
          },
          {
            "id": 5,
            "from": "ReadOutcome",
            "to": "ReturnNotSent",
            "type": "exprOtherwise",
            "label": "otherwise (NOT_SENT)"
          }
        ],
