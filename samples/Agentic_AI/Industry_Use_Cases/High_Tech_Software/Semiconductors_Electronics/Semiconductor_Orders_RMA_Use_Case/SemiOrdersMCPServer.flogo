        {
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "get_price_and_stock",
            "handlerDescription": "Get the price and availability of a part for a quantity: the unit price from the price-break table, the tier applied, the extended price, the next price break, MOQ and whether the quantity meets it, stock and whether it covers the quantity, the ship date if ordered today, lead time, next receipt, lifecycle and a note. All numbers come from Arcwell's system - quote them exactly and never compute a price yourself. This is information; propose_order re-checks everything.",
            "toolTitle": "",
            "readOnlyToolHint": true,
            "destructiveToolHint": false,
            "idempotentToolHint": true,
            "openWorldToolHint": false,
            "scope": ""
          },
          "action": {
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            },
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:get_price_and_stock_flow"
            }
          },
          "reply": {
            "response": {
              "type": "json",
              "value": "{}",
              "fe_metadata": "{}"
            },
            "outputSchema": "",
            "structuredContent": {}
          },
          "name": "get_price_and_stock_flow",
          "description": "Get the price and availability of a part for a quantity: the unit price from the price-break table, the tier applied, the extended price, the next price break, MOQ and whether the quantity meets it, stock and whether it covers the quantity, the ship date if ordered today, lead time, next receipt, lifecycle and a note. All numbers come from Arcwell's system - quote them exactly and never compute a price yourself. This is information; propose_order re-checks everything.",
          "schemas": {
            "output": {
              "arguments": "schema://get_price_and_stock_Args"
            },
            "reply": {
              "response": "schema://ToolResponse"
            }
          }
        },
