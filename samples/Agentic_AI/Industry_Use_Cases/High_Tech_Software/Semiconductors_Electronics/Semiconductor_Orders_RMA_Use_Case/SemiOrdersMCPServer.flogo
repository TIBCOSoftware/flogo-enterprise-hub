    {
      "id": "flow:propose_order_flow",
      "data": {
        "name": "propose_order_flow",
        "description": "Step 1 of 2 to place an order for the verified buyer&#39;s account. Pass the part number, the quantity in pieces and the buyer&#39;s PO number. The system prices it from the price-break table and checks the part, lifecycle and last-time-buy date, MOQ, stock, credit hold and credit limit, then returns PROPOSED with a proposal_id, a priced summary and the ship date (expires in 15 minutes), or BLOCKED with a reason_code and reason_text. A BLOCKED LARGE_LAST_TIME_BUY also returns a proposal_id: that is the reference_id for open_service_case last_time_buy. Nothing is ordered until confirm_action is called after the buyer explicitly says yes to this exact summary. Quote any reason_text to the person as written; never change an outcome.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
