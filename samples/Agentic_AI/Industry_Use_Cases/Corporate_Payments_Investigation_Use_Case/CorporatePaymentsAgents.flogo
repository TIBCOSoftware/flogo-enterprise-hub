                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "ad6dc45d-79c2-4f20-9530-39ccf70dc7ecSELECT * FROM lookup_reason_code(CAST(?code AS text));",
                "input": {
                  "mapping": {
                    "parameters": {
                      "code": "=$flow.toolParams.code"
                    }
                  }
                },
                "fetchMetadata": false
              },
              "ref": "#act_postgresql_query",
              "settings": {},
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"code\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"code\": {\"type\": \"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"match_status\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}, \"rail\": {\"type\": \"string\"}, \"plain_language\": {\"type\": \"string\"}, \"category\": {\"type\": \"string\"}, \"typical_action\": {\"type\": \"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"match_status\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}, \"rail\": {\"type\": \"string\"}, \"plain_language\": {\"type\": \"string\"}, \"category\": {\"type\": \"string\"}, \"typical_action\": {\"type\": \"string\"}}}}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "LookupReasonCode",
            "name": "LookupReasonCode",
            "description": "PostgreSQL Query"
          },
          {
            "activity": {
              "input": {
                "mappings": []
              },
              "ref": "#act_default_actreturn",
              "settings": {
