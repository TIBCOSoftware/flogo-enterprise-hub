        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#act_default_noop"
            }
          },
          {
            "activity": {
              "input": {
                "Connection": "conn://37cdadd8-4767-477b-8316-8010559720e9",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT * FROM lookup_reason_code(CAST(?code AS text));",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "code",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": false
                  },
                  {
                    "FieldName": "match_status",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "code",
                    "Type": "VARCHAR",
                    "Selected": true,
