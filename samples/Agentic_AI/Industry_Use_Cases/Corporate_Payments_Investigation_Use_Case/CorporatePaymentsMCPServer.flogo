{
  "imports": [
    "con_postgresql github.com/tibco/wi-postgres/src/app/PostgreSQL/connector/connection",
    "tr_mcpserver github.com/tibco/flogo-mcp/src/app/MCP/trigger/mcpserver",
    "github.com/project-flogo/flow",
