    {
      "id": "flow:check_delivery_estimate_flow",
      "data": {
        "name": "check_delivery_estimate_flow",
        "description": "Assess whether one payment on the verified client&#39;s own accounts will settle on time. The system computes it deterministically from the rail/currency cutoff rules and business days - it is never estimated by you. Returns the outcome ON_TRACK, PAST_CUTOFF (submitted after today&#39;s cutoff, so it processes the next business day), DELAYED (past the expected settlement date and still not completed) or SETTLED, with the expected settlement date, or NOT_YOUR_PAYMENT. Quote the outcome and date verbatim; never compute a delivery estimate yourself.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadOutcome",
            "type": "label",
            "label": "StartActivity to ReadOutcome"
          },
