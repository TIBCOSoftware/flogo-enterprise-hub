    {
      "id": "flow:get_my_payments_flow",
      "data": {
        "name": "get_my_payments_flow",
        "description": "List the verified client&#39;s own payments, newest first, at most 25. Pass an empty search for everything in the last 90 days, or a search term to filter back 18 months: part of the payment reference, the beneficiary name or bank BIC, or an amount (e.g. 48500). Each row has payment_ref, direction (OUTGOING/INCOMING), rail, amount, currency, fx_rate, fees, beneficiary, status and any return reason code, value date, created-at and any open investigation id. Returns NO_MATCH when nothing matches. Use the payment_ref from here for the other tools; never invent one.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadOutcome",
