  "resources": [
    {
      "id": "flow:verify_client_flow",
      "data": {
        "name": "verify_client_flow",
        "description": "Verify the client&#39;s identity with their Aurelia Global Bank client id (e.g. CLI-2026-00101) and the 6-digit passcode from their corporate portal. Returns VERIFIED with a session_token (valid 30 minutes) and their legal name, NOT_VERIFIED when the id and passcode do not match, or LOCKED after 5 failed attempts in 15 minutes (no token is issued while locked, even with the right passcode; offer recovery only). Call this before any other client tool. Never reveal, hint at or guess passcodes.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GuardedWrite",
            "type": "label",
            "label": "StartActivity to GuardedWrite"
          },
