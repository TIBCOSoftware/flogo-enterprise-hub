{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/mmussett/flogo-enterprise-hub/extensions/XSLT/src/activity/transform",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/tibco/flogo-general/src/app/General/trigger/timer"
  ],
  "name": "xslt-transform",
  "description": "",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#timer",
      "name": "tibco-wi-timer",
      "description": "Simple Timer trigger",
      "settings": {},
      "id": "TimerTrigger",
      "handlers": [
        {
          "description": "",
          "settings": {
            "Scheduler Options": "Timer",
            "Start Time": "",
            "Repeating": true,
            "Delayed Start": false,
            "Time Interval": 10,
            "Interval Unit": "Second",
            "Cron Expression": "CRON_TZ=Europe/London * * * * *"
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:New_flow"
            }
          },
          "name": "New_flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:New_flow",
      "data": {
        "name": "New_flow",
        "description": "",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "transform",
            "type": "label",
            "label": "StartActivity to transform"
          },
          {
            "id": 2,
            "from": "transform",
            "to": "LogMessage",
            "type": "label",
            "label": "transform to LogMessage"
          },
          {
            "id": 3,
            "from": "transform",
            "to": "LogMessage1",
            "type": "error",
            "label": "transform to LogMessage1"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "transform",
            "name": "transform",
            "description": "",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#transform",
              "input": {
                "xmlDocument": "=$property[\"xmlDocument\"]",
                "xsltStylesheet": "=$property[\"xsltDocument\"]"
              }
            }
          },
          {
            "id": "LogMessage",
            "name": "LogMessage",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=$activity[transform].outputString",
                "logLevel": ""
              }
            }
          },
          {
            "id": "LogMessage1",
            "name": "LogMessage1",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "ERROR",
                "flowInfo": false,
                "message": "=$error[transform].message",
                "logLevel": ""
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjMzLCJ5IjoxNDF9LCJ0cmFuc2Zvcm0iOnsieCI6MjI4LCJ5IjoxMzN9LCJMb2dNZXNzYWdlIjp7IngiOjQ5MCwieSI6MTMzfSwiTG9nTWVzc2FnZTEiOnsieCI6NTAyLCJ5IjozMjV9fQ==",
        "metadata": {
          "input": [],
          "output": [],
          "fe_metadata": {}
        }
      }
    }
  ],
  "properties": [
    {
      "name": "xsltDocument",
      "type": "string",
      "value": "<xsl:stylesheet version=\\\"2.0\\\" xmlns:xsl=\\\"http://www.w3.org/1999/XSL/Transform\\\" xmlns:xs=\\\"http://www.w3.org/1999/XSL/Transform\\\"><xsl:template match=\\\"/fruits\\\"><apples-and-friends><xsl:for-each select=\\\"*\\\"><xsl:choose><xsl:when test=\\\"name() = 'pair'\\\"><apple-like-fruit/></xsl:when><xsl:otherwise><xsl:copy-of select=\\\".\\\"/></xsl:otherwise></xsl:choose></xsl:for-each></apples-and-friends></xsl:template></xsl:stylesheet>"
    },
    {
      "name": "xmlDocument",
      "type": "string",
      "value": "<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?><fruits><apple>Granny Smith</apple><pair>Bosc</pair><banana>Cavendish</banana><pair>Anjou</pair><orange>Navel</orange><pair>Bartlett</pair><grape>Concord</grape></fruits>"
    }
  ],
  "connections": {},
  "contrib": "",
  "metadata": {
    "endpoints": [],
    "flogoVersion": "2.25.9"
  }
}