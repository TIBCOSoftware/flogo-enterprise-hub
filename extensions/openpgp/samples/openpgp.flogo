{
  "imports": [
    "github.com/project-flogo/flow",
    "github.com/project-flogo/contrib/activity/noop",
    "github.com/mmussett/extensions/openpgp/activity/encrypt",
    "github.com/tibco/flogo-general/src/app/General/activity/log",
    "github.com/mmussett/extensions/openpgp/activity/decrypt",
    "github.com/tibco/flogo-general/src/app/General/trigger/startuphook",
    "github.com/project-flogo/contrib/function/string"
  ],
  "name": "openpgp",
  "description": "",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#startuphook",
      "name": "tibco-appstartup",
      "description": "This trigger allows you to execute flows before other triggers in the application are started. This is useful in initializing application specific tasks.",
      "settings": {},
      "id": "AppStartupTrigger",
      "handlers": [
        {
          "description": "",
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:New_flow"
            }
          },
          "name": "New_flow"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:New_flow",
      "data": {
        "name": "New_flow",
        "description": "",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Encrypt",
            "type": "label",
            "label": "StartActivity to Encrypt"
          },
          {
            "id": 2,
            "from": "Encrypt",
            "to": "LogMessage",
            "type": "label",
            "label": "Encrypt to LogMessage"
          },
          {
            "id": 3,
            "from": "LogMessage",
            "to": "Decrypt",
            "type": "label",
            "label": "LogMessage to Decrypt"
          },
          {
            "id": 4,
            "from": "Decrypt",
            "to": "LogMessage1",
            "type": "label",
            "label": "Decrypt to LogMessage1"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Encrypt",
            "name": "Encrypt",
            "description": "Activity to encrypt openpgp messages",
            "activity": {
              "ref": "#encrypt",
              "input": {
                "plaintext": "Hello, World",
                "publickey": "=string.base64ToString($property[\"PublicKey\"])"
              }
            }
          },
          {
            "id": "LogMessage",
            "name": "LogMessage",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=$activity[Encrypt].ciphertext",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Decrypt",
            "name": "Decrypt",
            "description": "Activity to decrypt openpgp messages",
            "activity": {
              "ref": "#decrypt",
              "input": {
                "ciphertext": "=$activity[Encrypt].ciphertext",
                "privatekey": "=string.base64ToString($property[\"PrivateKey\"])"
              }
            }
          },
          {
            "id": "LogMessage1",
            "name": "LogMessage1",
            "description": "Simple Log Message Activity",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=$activity[Decrypt].plaintext",
                "logLevel": ""
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfSwiRW5jcnlwdCI6eyJ4IjoxODEsInkiOjIyMX0sIkxvZ01lc3NhZ2UiOnsieCI6MzgxLCJ5IjoyMzF9LCJEZWNyeXB0Ijp7IngiOjU2NiwieSI6MjI1fSwiTG9nTWVzc2FnZTEiOnsieCI6NzcyLCJ5IjoyMjR9fQ==",
        "metadata": {
          "input": [],
          "output": [],
          "fe_metadata": {}
        }
      }
    }
  ],
  "properties": [
    {
      "name": "PublicKey",
      "type": "string",
      "value": ""
    },
    {
      "name": "PrivateKey",
      "type": "string",
      "value": ""
    }
  ],
  "connections": {},
  "contrib": "",
  "metadata": {
    "endpoints": [],
    "flogoVersion": "2.26.1"
  }
}