{
  "name": "sigverify",
  "version": "1.0.0",
  "title": "Sigverify",
  "author": "TIBCO Software Inc.",
  "type": "flogo:activity",

  "display": {
    "category": "openPGP",
    "visible": true,
    "smallIcon": "icons/openpgp-sigverify@2x.png",
    "largeIcon": "icons/openpgp-sigverify@3x.png",
    "description": "This activity verifies signature any openpgp ciphertext message with a public key"
  },

  "ref": "github.com/mmussett/flogo-enterprise-hub/extensions/openpgp/src/activity/sigverify",
  "inputs": [
    {
      "name": "ciphertext",
      "type": "string",
      "required": true
    },
    {
      "name": "publickey",
      "type": "string",
      "required": true
    }
  ],

  "outputs": [
    {
      "name": "verified",
      "type": "boolean"
    }
  ]
}
